{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Trusted local editor only. No filesystem plugin, shell, HTTP, opener, remote URLs or child preview capabilities.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-outer-size",
    "core:window:allow-outer-position",
    "core:window:allow-is-maximized",
    "core:window:allow-maximize",
    "allow-provider-http-start",
    "allow-provider-http-next",
    "allow-provider-http-cancel",
    "allow-agent-key-status",
    "allow-agent-key-save",
    "allow-agent-key-delete",
    "allow-agent-settings-load",
    "allow-agent-settings-save",
    "allow-set-window-background",
    "allow-collab-lan-start",
    "allow-collab-lan-stop",
    "allow-collab-lan-status",
    "allow-choose-project",
    "allow-choose-file",
    "allow-open-dropped-project",
    "allow-read-dropped-files",
    "allow-is-store-package",
    "allow-list-files",
    "allow-read-file",
    "allow-read-media",
    "allow-image-pick",
    "allow-image-read",
    "allow-image-save-pick",
    "allow-image-save-write",
    "allow-hold-autosave",
    "allow-stage-edit",
    "allow-save-file",
    "allow-delete-file",
    "allow-open-external",
    "updater:default",
    "process:allow-restart",
    "allow-recovery-list",
    "allow-recovery-read",
    "allow-recovery-restore",
    "allow-recovery-discard",
    "allow-close-project",
    "allow-log-write",
    "allow-log-tail",
    "allow-log-dir",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-decorations"
  ]
}
