{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Somnia",
  "version": "0.1.0",
  "identifier": "app.somnia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Somnia",
        "decorations": false,
        "dragDropEnabled": true,
        "shadow": false,
        "transparent": true,
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        "editor"
      ],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://openrouter.ai https://api.openai.com https://api.anthropic.com http://127.0.0.1:11434 http://localhost:11434 https://api.github.com https://raw.githubusercontent.com ws: wss:; frame-src 'self' blob: somnia-ext: http://somnia-ext.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; worker-src 'self' somnia-ext: http://somnia-ext.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420 https://openrouter.ai https://api.openai.com https://api.anthropic.com http://127.0.0.1:11434 http://localhost:11434 https://raw.githubusercontent.com ws: wss:; frame-src 'self' blob: somnia-ext: http://somnia-ext.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; worker-src 'self' somnia-ext: http://somnia-ext.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "HTML document",
        "description": "Open with Somnia",
        "role": "Editor"
      },
      {
        "ext": [
          "svg"
        ],
        "name": "SVG image",
        "description": "Open with Somnia",
        "role": "Editor"
      },
      {
        "ext": [
          "css"
        ],
        "name": "CSS stylesheet",
        "description": "Open with Somnia",
        "role": "Editor"
      },
      {
        "ext": [
          "md"
        ],
        "name": "Markdown document",
        "description": "Open with Somnia",
        "role": "Editor"
      },
      {
        "ext": [
          "docx"
        ],
        "name": "Word document",
        "description": "Open with Somnia",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": [
          "xlsx"
        ],
        "name": "Excel spreadsheet",
        "description": "Open with Somnia",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": [
          "pptx"
        ],
        "name": "PowerPoint presentation",
        "description": "Open with Somnia",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "Open with Somnia",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "gif",
          "avif",
          "bmp",
          "tif",
          "tiff"
        ],
        "name": "Image",
        "description": "Open with Somnia",
        "role": "Viewer",
        "mimeType": "image/png"
      },
      {
        "ext": [
          "mp3",
          "wav",
          "ogg",
          "flac",
          "m4a"
        ],
        "name": "Audio",
        "description": "Open with Somnia",
        "role": "Viewer",
        "mimeType": "audio/mpeg"
      },
      {
        "ext": [
          "mp4",
          "webm",
          "mov",
          "mkv"
        ],
        "name": "Video",
        "description": "Open with Somnia",
        "role": "Viewer",
        "mimeType": "video/mp4"
      }
    ]
  },
  "mainBinaryName": "somnia",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0OTEzN0IwNThCODlBQ0UKUldUT21yaFlzRGVSWlA3UE1GU3l5M3FaWHZQNGJYV0hHZ28zUmxDYlQ4aXdvT1k2ckZoUFRjSUsK",
      "endpoints": [
        "https://github.com/philppplik/somnia/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
