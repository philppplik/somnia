    "test": "playwright test",
    "bench": "tsx scripts/bench.ts",
    "ext": "tsx scripts/somnia-ext.ts",
    "test:core": "tsx --test src/lib/image/*.test.ts src/lib/image-editor/*.test.ts packages/editor-core/src/*.test.ts src/lib/*.test.ts src/lib/extensions/*.test.ts src/lib/collab/*.test.ts src/lib/collab/net/*.test.ts src/lib/agent/providers/*.test.ts src/lib/agent/*.test.ts src/lib/convert/*.test.ts src/components/*.test.tsx src/lib/conversion/*.test.ts src/lib/imgedit/*.test.ts src/lib/imgedit/select/*.test.ts src/components/imgedit/*.test.tsx src/components/imageedit/*.test.tsx src/lib/imageedit/adjust/*.test.ts src/lib/imageedit/filters/*.test.ts src/lib/oauth/*.test.ts test/vector/*.test.mjs src/lib/pdfforms/*.test.ts src/lib/vectorcore/*.test.ts src/lib/pdfannotate/*.test.ts test/pdf/*.test.ts src/lib/vectorio/*.test.ts src/lib/pdftext/*.test.ts src/components/vectoredit/*.test.tsx src/lib/imageedit/*.test.ts src/lib/imageedit/vector/*.test.ts src/lib/pdfview/*.test.ts src/components/versions/*.test.tsx src/lib/visualDiff/*.test.ts src/components/versions/HistoryTab.test.tsx src/store/rasterState.test.ts src/lib/craft/blurPreview.test.ts src/lib/svgedit/*.test.ts src/lib/pdfedit/*.test.ts src/lib/office/*.test.ts",
    "test:e2e": "playwright test",
    "test:auth": "tsx --test src/lib/agent/oauth/*.test.ts",
    "test:updater": "node --test scripts/updater-e2e/lib.test.mjs",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "bench:projects": "tsx scripts/bench-projects.ts",
    "test:documents": "tsx --test src/lib/convert/*.test.ts src/lib/conversion/*.test.ts",
    "craft:build": "sh craft/build.sh"
  },
