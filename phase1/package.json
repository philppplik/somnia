{
  "name": "@somnia/desktop-shell",
  "version": "0.1.0",
  "license": "MIT",
  "somniaRelease": "11.0.0-beta.5",
  "private": true,
  "type": "module",
  "scripts": {
    "licenses": "node scripts/licenses.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "bench": "tsx scripts/bench.ts",
    "ext": "tsx scripts/somnia-ext.ts",
    "test:core": "tsx --test packages/editor-core/src/*.test.ts src/lib/*.test.ts src/lib/extensions/*.test.ts src/lib/collab/*.test.ts src/lib/collab/net/*.test.ts src/lib/agent/providers/*.test.ts src/lib/agent/*.test.ts src/components/*.test.tsx",
    "test:e2e": "playwright test",
    "test:updater": "node --test scripts/updater-e2e/lib.test.mjs",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "bench:projects": "tsx scripts/bench-projects.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@codemirror/autocomplete": "^6.20.3",
