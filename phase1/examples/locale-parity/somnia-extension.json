{
  "id": "somnia.locale-parity",
  "name": "Locale Parity",
  "version": "1.0.0",
  "apiVersion": 1,
  "permissions": [
    "project.read",
    "storage"
  ],
  "contributes": {
    "panels": [
      {
        "id": "parity",
        "title": "Locale Parity",
        "side": "right",
        "html": "<style>\n*{box-sizing:border-box}\nbody{color:#1f2430;line-height:1.35;min-width:220px}\nbutton,select{font:inherit;color:inherit}\n.bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px}\n.bar label{color:#5b6475}\nselect,.btn{border:1px solid #c9cdd8;background:#fff;border-radius:8px;padding:4px 8px;max-width:100%}\n.btn{cursor:pointer;border-radius:999px;padding:4px 12px}.btn:hover{background:#f1f2f6}\n.btn:focus-visible,select:focus-visible,.more:focus-visible{outline:2px solid #4338ca;outline-offset:1px}\nsmall{color:#5b6475}\n.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;margin:8px 0 10px}\n.card{background:#f1f2f6;border-radius:10px;padding:8px 10px;min-width:0}\n.card b{display:block;font-size:17px;line-height:1.2;overflow-wrap:anywhere}\n.card.ok b{color:#0b6b4f}.card.bad b{color:#b3261e}\n.card span{font-size:12px}\nh3{margin:12px 0 6px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#5b6475;overflow-wrap:anywhere}\n.item{border:1px solid #e3e5ec;border-radius:8px;padding:6px 10px;margin-bottom:6px;background:#fff;min-width:0}\n.line{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}\ncode{font-family:ui-monospace,Consolas,monospace;font-size:12px;overflow-wrap:anywhere}\n.tag{font-size:10px;font-weight:700;letter-spacing:.04em;padding:1px 6px;border-radius:999px;white-space:nowrap}\n.t-missing{background:#fdecea;color:#9c1c14}.t-extra{background:#fff3cd;color:#7a5200}\n.t-placeholder{background:#e8e9ff;color:#3730a3}.t-empty{background:#e6eaf0;color:#3b4454}.t-invalid{background:#b3261e;color:#fff}\n.sub{margin-top:2px;font-size:12px;color:#5b6475;overflow-wrap:anywhere}\n.sub code{color:#1f2430}\n.more{border:0;background:none;color:#4338ca;cursor:pointer;padding:2px 0 6px;text-decoration:underline}\n.empty,.err{padding:10px;border-radius:8px;background:#f1f2f6}.err{background:#fdecea;color:#7a1c14}\n.note{margin-top:12px;font-size:12px;color:#5b6475;border-top:1px solid #e3e5ec;padding-top:8px}\n</style>\n<div class=\"bar\" id=\"bar\"></div>\n<div id=\"out\"></div>\n<p class=\"note\">Reads locale JSON files from the open project, including unsaved edits. Nested keys are flattened to a.b.c and array items to a.0. Plural suffixes (_one, _other and so on) are treated as one key, since languages differ in their plural forms. Placeholders checked: {name}, {{name}}, ${name}, %s, %d, %1$s, %(name)s. Values are never compared for translation quality.</p>\n<script>\n(()=>{\nconst $=s=>document.querySelector(s);\nconst h=(t,c,x)=>{const e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e;};\nconst BAD=/(^|\\/)(node_modules|\\.git)\\/|(^|\\/)(package(-lock)?|tsconfig[\\w.-]*|jsconfig|composer|manifest|somnia-extension|\\.eslintrc)\\.json$/i;\nconst LOC2=/^[a-z]{2}(?:[-_][A-Za-z0-9]{2,8}){0,2}$/,LOC3=/^[a-z]{3}(?:[-_][A-Za-z0-9]{2,8}){0,2}$/,HINT=/locale|i18n|lang|translation|message|l10n/i;\nconst isLoc=(s,dir)=>LOC2.test(s)||(LOC3.test(s)&&HINT.test(dir));\nconst PLU=/_(zero|one|two|few|many|other)$/,MAXK=20000;\nlet groups=[],cur=0,base='',saveNote='',info='';\nfunction classify(p){if(!/\\.json$/i.test(p)||BAD.test(p))return null;\n const i=p.lastIndexOf('/'),dir=i<0?'':p.slice(0,i),file=p.slice(i+1,-5);\n if(isLoc(file,dir))return{p,loc:file,key:dir+'|',label:(dir||'(project root)')+'/*.json'};\n const m=/^(.+?)[._-]([A-Za-z0-9_-]+)$/.exec(file);if(m&&isLoc(m[2],dir))return{p,loc:m[2],key:dir+'|'+m[1]+'.',label:(dir?dir+'/':'')+m[1]+'.*.json'};\n const j=dir.lastIndexOf('/'),last=dir.slice(j+1),par=j<0?'':dir.slice(0,j);\n if(last&&isLoc(last,par))return{p,loc:last,key:par+'|ns:'+file,label:(par?par+'/':'')+'*/'+file+'.json'};return null;}\nfunction makeGroups(files){const M=new Map();files.forEach(f=>{const c=classify(f);if(!c)return;let g=M.get(c.key);if(!g){g={label:c.label,items:[]};M.set(c.key,g);}if(!g.items.some(x=>x.loc===c.loc))g.items.push(c);});\n return[...M.values()].filter(g=>g.items.length>1).map(g=>({label:g.label,items:g.items.sort((a,b)=>a.loc<b.loc?-1:1)})).sort((a,b)=>b.items.length-a.items.length||(a.label<b.label?-1:1));}\nfunction flat(o,p,m,d){if(d>20||m.size>MAXK)return;\n if(Array.isArray(o)){o.forEach((x,i)=>flat(x,p?p+'.'+i:String(i),m,d+1));}\n else if(o&&typeof o==='object'){const k=Object.keys(o);k.forEach(n=>flat(o[n],p?p+'.'+n:n,m,d+1));}\n else m.set(p,o==null?'':String(o));}\nfunction norm(m){const r=new Map();m.forEach((v,k)=>{const pl=PLU.test(k);const n=pl?k.replace(PLU,''):k;if(!r.has(n)||!pl)r.set(n,{k:pl?n+'_*':k,v,pl});});return r;}\nfunction ph(s){const r=[];let t=s;\n const take=(re,f)=>{t=t.replace(re,(...a)=>{r.push(f(a));return ' ';});};\n take(/\\$\\{\\s*([\\w.]+)\\s*\\}/g,a=>'${'+a[1]+'}');take(/\\{\\{\\s*([\\w.]+)[^}]*\\}\\}/g,a=>'{{'+a[1]+'}}');\n take(/%\\(([\\w.]+)\\)[sdif]/g,a=>'%('+a[1]+')');take(/%\\d+\\$[sdifx]/g,a=>a[0]);take(/%\\d*\\.?\\d*[sdifx]/g,a=>a[0]);\n take(/\\{\\s*([\\w.]+)\\s*(?=[,}])/g,a=>'{'+a[1]+'}');return r;}\nconst sig=a=>a.slice().sort().join('\\u0001');\nconst show=a=>a.length?[...new Set(a)].join(' '):'(none)';\nfunction compare(bm,lm){const B=norm(bm),L=norm(lm),res={miss:[],ph:[],empty:[],extra:[],total:B.size,ok:0};\n B.forEach((b,n)=>{const l=L.get(n);if(!l){res.miss.push({k:b.k,v:b.v});return;}res.ok++;\n  if(l.v===''&&b.v!=='')res.empty.push({k:b.k});\n  if(!b.pl&&!l.pl){const x=ph(b.v),y=ph(l.v);if(sig(x)!==sig(y))res.ph.push({k:b.k,b:show(x),t:show(y)});}});\n L.forEach((l,n)=>{if(!B.has(n))res.extra.push({k:l.k});});return res;}\nasync function load(it){let t=await somnia.project.readFile(it.p);if(t.charCodeAt(0)===0xFEFF)t=t.slice(1);\n try{const o=JSON.parse(t);if(!o||typeof o!=='object')return{err:'Root is not an object or array.'};const m=new Map();flat(o,'',m,0);return{m};}catch(e){return{err:'Invalid JSON: '+e.message};}}\nfunction bar(){const b=$('#bar');b.textContent='';if(!groups.length){const r=h('button','btn','Rescan');r.onclick=init;b.append(r);return;}\n if(groups.length>1){const s=h('select');s.setAttribute('aria-label','Locale file set');groups.forEach((g,i)=>{const o=h('option','',g.label+' ('+g.items.length+')');o.value=i;s.append(o);});s.value=cur;s.onchange=()=>{cur=+s.value;pick();run();};b.append(s);}\n const l=h('label','','Base');l.setAttribute('for','bs');const s=h('select');s.id='bs';groups[cur].items.forEach(i=>{const o=h('option','',i.loc);o.value=i.loc;s.append(o);});s.value=base;\n s.onchange=async()=>{base=s.value;try{await somnia.storage.set('base',base);saveNote='';}catch(e){saveNote='Base choice not saved: enable storage in Settings > Extensions.';}run();};\n const c=h('button','btn','Compare');c.onclick=init;b.append(l,s,c);}\nasync function pick(){const g=groups[cur],codes=g.items.map(i=>i.loc);let s=null;try{s=await somnia.storage.get('base');}catch(e){}\n base=codes.includes(s)?s:(codes.find(c=>/^en([-_]|$)/i.test(c))||codes[0]);bar();}\nfunction badge(k){return h('span','tag t-'+k,k.toUpperCase());}\nfunction row(k,key,sub){const d=h('div','item'),l=h('div','line');l.append(badge(k),h('code','',key));d.append(l);if(sub)d.append(sub);return d;}\nfunction section(it,r){const out=document.createDocumentFragment();out.append(h('h3','',it.p));\n if(r.err){out.append(row('invalid',it.p,h('div','sub',r.err)));return out;}\n const rows=[];\n r.miss.forEach(x=>{const s=x.v?h('div','sub',base+': '+(x.v.length>80?x.v.slice(0,80)+'...':x.v)):null;rows.push(()=>row('missing',x.k,s));});\n r.ph.forEach(x=>{const s=h('div','sub');const a=h('code','',base+': '+x.b),b=h('code','',it.loc+': '+x.t);s.append(a,document.createTextNode('  |  '),b);rows.push(()=>row('placeholder',x.k,s));});\n r.empty.forEach(x=>rows.push(()=>row('empty',x.k,h('div','sub','Empty, but the base has text'))));\n r.extra.forEach(x=>rows.push(()=>row('extra',x.k,h('div','sub','Not in the base file'))));\n if(!rows.length){out.append(h('div','empty','In sync with '+base+'.'));return out;}\n const N=8;rows.slice(0,N).forEach(f=>out.append(f()));\n if(rows.length>N){const b=h('button','more','+'+(rows.length-N)+' more');b.onclick=()=>{const f=document.createDocumentFragment();rows.slice(N).forEach(g=>f.append(g()));b.replaceWith(f);};out.append(b);}\n return out;}\nfunction summary(r){if(r.err)return['invalid','bad'];const p=[];if(r.miss.length)p.push(r.miss.length+' missing');if(r.extra.length)p.push(r.extra.length+' extra');if(r.ph.length)p.push(r.ph.length+' placeholder');if(r.empty.length)p.push(r.empty.length+' empty');\n return p.length?[p.join(', '),'bad']:['in sync','ok'];}\nasync function run(){const out=$('#out');out.textContent='';\n if(info){out.append(h('div','err',info));return;}\n if(!groups.length){out.append(h('div','empty','No locale files found. Add two or more JSON files such as locales/en.json and locales/de.json (or locales/en/common.json), then press Rescan.'));return;}\n const g=groups[cur];out.append(h('small','','Reading '+g.items.length+' files...'));\n try{const res=await Promise.all(g.items.map(load));out.textContent='';\n  const bi=g.items.findIndex(i=>i.loc===base),bs=res[bi];\n  if(bs.err){out.append(h('div','err',g.items[bi].p+': '+bs.err+' Pick another base or fix the file.'));return;}\n  const others=g.items.map((it,i)=>({it,r:i===bi?null:(res[i].err?{err:res[i].err}:compare(bs.m,res[i].m))})).filter(x=>x.r);\n  out.append(h('small','',base+' is the base: '+norm(bs.m).size+' keys, compared with '+others.length+' other '+(others.length===1?'locale':'locales')+'. '+new Date().toLocaleTimeString()+(saveNote?' '+saveNote:'')));\n  const cards=h('div','cards');others.forEach(({it,r})=>{const[t,c]=summary(r),d=h('div','card '+c);d.append(h('b','',it.loc),h('span','',t));cards.append(d);});out.append(cards);\n  others.forEach(({it,r})=>out.append(section(it,r)));\n }catch(e){out.textContent='';out.append(h('div','err','Could not read the project: '+(e&&e.message?e.message:e)+(/permission/i.test(String(e&&e.message))?' Enable it in Settings > Extensions.':'')));}}\nasync function init(){info='';const label=groups[cur]&&groups[cur].label;\n try{groups=makeGroups((await somnia.project.listFiles()).slice(0,2000));cur=Math.max(0,groups.findIndex(g=>g.label===label));if(groups.length)await pick();else bar();}\n catch(e){groups=[];info='Could not list project files: '+(e&&e.message?e.message:e)+(/permission/i.test(String(e&&e.message))?' Enable it in Settings > Extensions.':'');bar();}run();}\ninit();\n})();\n</script>"
      }
    ]
  }
}
