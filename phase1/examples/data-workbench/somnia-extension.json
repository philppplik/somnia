{
  "id": "somnia.data-workbench",
  "name": "Data Workbench",
  "version": "1.0.0",
  "apiVersion": 1,
  "permissions": [
    "project.read",
    "storage"
  ],
  "contributes": {
    "panels": [
      {
        "id": "workbench",
        "title": "Data Workbench",
        "side": "right",
        "html": "<style>\nhtml,body{margin:0;background:#fff;color:#1f2430;font:13px/1.45 system-ui,sans-serif}\n*{box-sizing:border-box}\n.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center}\nselect,button,textarea{font:inherit;color:#1f2430}\nselect{flex:1 1 140px;min-width:0;padding:6px 8px;border:1px solid #9aa1b2;border-radius:8px;background:#fff}\nbutton{padding:6px 10px;border:1px solid #9aa1b2;border-radius:8px;background:#fff;cursor:pointer}\nbutton.pri{background:#4f46e5;border-color:#4f46e5;color:#fff}\nbutton:hover{background:#eef0f6}button.pri:hover{background:#4338ca}\nbutton:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid #4f46e5;outline-offset:2px}\n.note{color:#4b5262;font-size:12px;margin:6px 0}\n.stats{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}\n.stat{flex:1 1 70px;background:#f1f2f7;border-radius:10px;padding:6px 10px}\n.stat b{display:block;font-size:18px;line-height:1.2}\n.stat.bad b,.stat.bad span{color:#b42318}\n.wrap{overflow-x:auto;border-bottom:1px solid #e3e5ec}\ntable{border-collapse:collapse;width:100%;font-size:12px}\nth,td{text-align:left;padding:4px 8px;border-bottom:1px solid #e3e5ec;white-space:nowrap;max-width:220px;overflow:hidden;text-overflow:ellipsis}\nth{color:#4b5262;font-weight:600;background:#fff}\ntd.bad{color:#b42318;text-decoration:underline wavy #b42318;text-underline-offset:3px}\nh4{margin:14px 0 6px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#4b5262}\nul{margin:0;padding:0;list-style:none}\nli{padding:3px 0;overflow-wrap:anywhere}\nli.ok{color:#05603a}\n.tag{font-weight:700}\ntextarea{width:100%;min-height:96px;margin-top:8px;padding:6px 8px;border:1px solid #9aa1b2;border-radius:8px;font:12px/1.4 ui-monospace,Consolas,monospace;resize:vertical}\n#msg{margin-top:8px;color:#b42318}\n.sr{position:absolute;left:-9999px}\n[hidden]{display:none!important}\n</style>\n<p class=\"note\" id=\"intro\">Reads CSV, TSV and JSON files from the open project. It never writes to your files.</p>\n<div class=\"row\">\n<label class=\"sr\" for=\"file\">Data file</label>\n<select id=\"file\"></select>\n<button id=\"load\" class=\"pri\" type=\"button\">Load</button>\n</div>\n<div id=\"msg\" role=\"status\" aria-live=\"polite\"></div>\n<div id=\"result\" hidden>\n<div class=\"stats\" id=\"stats\"></div>\n<div class=\"wrap\" tabindex=\"0\" role=\"region\" aria-label=\"Table preview\"><table><caption class=\"sr\">Preview of the loaded file</caption><thead></thead><tbody></tbody></table></div>\n<p class=\"note\" id=\"more\"></p>\n<h4>Validation</h4>\n<ul id=\"issues\"></ul>\n<h4>Output</h4>\n<div class=\"row\">\n<button id=\"mkjson\" type=\"button\">Make JSON</button>\n<button id=\"mkhtml\" type=\"button\">Make HTML table</button>\n<button id=\"sel\" type=\"button\">Select text</button>\n</div>\n<label class=\"sr\" for=\"out\">Generated output</label>\n<textarea id=\"out\" readonly wrap=\"off\" placeholder=\"Press Make JSON or Make HTML table.\"></textarea>\n<p class=\"note\" id=\"outnote\">Select the text, then press Ctrl+C to copy it. JSON output turns empty cells into null and number columns into numbers.</p>\n</div>\n<script>\n(function(){\nvar MAX_ROWS=5000,SHOW=100,MAX_ISSUES=60;\nvar NUM=/^[+-]?(\\d+(\\.\\d+)?|\\.\\d+)(e[+-]?\\d+)?$/i,MAIL=/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\nvar $=function(i){return document.getElementById(i)};\nvar st=null;\nfunction el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}\nfunction say(t){$('msg').textContent=t||''}\nfunction parseCSV(text){\n if(text.charCodeAt(0)===65279)text=text.slice(1);\n var first=text.split(/\\r?\\n/)[0]||'',best=',',n=-1;\n [',',';','\\t'].forEach(function(d){var q=false,c=0;for(var i=0;i<first.length;i++){var ch=first[i];if(ch==='\"')q=!q;else if(ch===d&&!q)c++}if(c>n){n=c;best=d}});\n var rows=[],row=[],cur='',q=false,i=0,L=text.length;\n for(;i<L;i++){var c=text[i];\n  if(q){if(c==='\"'){if(text[i+1]==='\"'){cur+='\"';i++}else q=false}else cur+=c}\n  else if(c==='\"'&&cur==='')q=true;\n  else if(c===best){row.push(cur);cur=''}\n  else if(c==='\\n'||c==='\\r'){if(c==='\\r'&&text[i+1]==='\\n')i++;row.push(cur);cur='';rows.push(row);row=[]}\n  else cur+=c}\n if(cur!==''||row.length){row.push(cur);rows.push(row)}\n return rows.filter(function(r){return !(r.length===1&&r[0].trim()==='')});\n}\nfunction uniq(h){var seen={};return h.map(function(x,i){x=String(x).trim()||('column '+(i+1));var b=x,k=2;while(seen[x])x=b+'_'+k++;seen[x]=1;return x})}\nfunction fromCSV(text){\n var r=parseCSV(text);if(!r.length)throw new Error('The file is empty.');\n var heads=uniq(r[0]),cut=r.length-1>MAX_ROWS,body=r.slice(1,MAX_ROWS+1),fc=[];\n var rows=body.map(function(x,i){if(x.length!==heads.length)fc.push({row:i+1,col:'',kind:'fields',text:'has '+x.length+' fields, expected '+heads.length});\n  return heads.map(function(h,j){var v=j<x.length?x[j]:'';return{v:v,s:v}})});\n return{heads:heads,rows:rows,cut:cut,json:false,pre:fc};\n}\nfunction disp(v){if(v==null)return'';if(typeof v==='object')return JSON.stringify(v);return String(v)}\nfunction fromJSON(text){\n var d=JSON.parse(text.charCodeAt(0)===65279?text.slice(1):text),arr;\n if(Array.isArray(d))arr=d;\n else if(d&&typeof d==='object'){var k=Object.keys(d).filter(function(x){return Array.isArray(d[x])})[0];arr=k?d[k]:[d]}\n else arr=[d];\n var cut=arr.length>MAX_ROWS;arr=arr.slice(0,MAX_ROWS);\n if(!arr.length)throw new Error('The JSON file has no rows.');\n var heads=[],idx={};\n function add(h){if(!(h in idx)){idx[h]=heads.length;heads.push(h)}}\n var objs=arr.map(function(x){if(Array.isArray(x)){var o={};x.forEach(function(v,i){o['column '+(i+1)]=v});return o}\n  if(x&&typeof x==='object')return x;return{value:x}});\n objs.forEach(function(o){Object.keys(o).forEach(add)});\n var rows=objs.map(function(o){return heads.map(function(h){var v=Object.prototype.hasOwnProperty.call(o,h)?o[h]:null;return{v:v,s:disp(v)}})});\n return{heads:heads,rows:rows,cut:cut,json:true,pre:[]};\n}\nfunction validate(t){\n var issues=t.pre.slice(),cells={};\n function flag(r,c,kind,text){issues.push({row:r+1,col:t.heads[c],kind:kind,text:text});cells[r+','+c]=text}\n t.heads.forEach(function(h,c){\n  var vals=[];t.rows.forEach(function(r,i){if(r[c].s.trim()!=='')vals.push(i)});\n  var nums=vals.filter(function(i){var x=t.rows[i][c];return typeof x.v==='number'||NUM.test(x.s.trim())}).length;\n  var mails=vals.filter(function(i){return MAIL.test(t.rows[i][c].s.trim())}).length;\n  var isMail=/e-?mail/i.test(h)||(vals.length>1&&mails/vals.length>=0.6);\n  var isNum=!isMail&&vals.length>0&&nums/vals.length>=0.6;\n  t.type[c]=isNum?'number':isMail?'email':'text';\n  t.rows.forEach(function(r,i){var x=r[c],s=x.s.trim();\n   if(s===''){flag(i,c,'empty','is empty');return}\n   if(isNum&&!(typeof x.v==='number'||NUM.test(s)))flag(i,c,'number','is not a number ('+s.slice(0,30)+')');\n   if(isMail&&!MAIL.test(s))flag(i,c,'email','is not a valid email ('+s.slice(0,30)+')')});\n });\n issues.sort(function(a,b){return a.row-b.row});t.issues=issues;t.cells=cells;\n}\nfunction show(){\n var t=st;$('result').hidden=false;\n var s=$('stats');s.textContent='';\n [[t.rows.length,'rows',0],[t.heads.length,'columns',0],[t.issues.length,t.issues.length===1?'issue':'issues',t.issues.length>0]].forEach(function(x){\n  var d=el('div','stat'+(x[2]?' bad':''));d.appendChild(el('b',null,String(x[0])));d.appendChild(el('span',null,x[1]));s.appendChild(d)});\n var th=document.querySelector('thead'),tb=document.querySelector('tbody');th.textContent='';tb.textContent='';\n var hr=el('tr');t.heads.forEach(function(h){var c=el('th',null,h);c.scope='col';hr.appendChild(c)});th.appendChild(hr);\n t.rows.slice(0,SHOW).forEach(function(r,i){var tr=el('tr');r.forEach(function(x,c){\n  var msg=t.cells[i+','+c],td=el('td',msg?'bad':null,x.s===''&&msg?'(empty)':x.s);if(msg){td.title='Row '+(i+1)+': '+t.heads[c]+' '+msg}tr.appendChild(td)});tb.appendChild(tr)});\n var more=t.rows.length>SHOW?'Showing the first '+SHOW+' of '+t.rows.length+' rows. The output below has all rows.':'';\n if(t.cut)more+=(more?' ':'')+'Only the first '+MAX_ROWS+' rows were read.';\n $('more').textContent=more;\n var ul=$('issues');ul.textContent='';\n if(!t.issues.length){var li=el('li','ok');li.appendChild(el('span','tag','OK '));li.appendChild(document.createTextNode('No empty fields, bad numbers or bad emails found.'));ul.appendChild(li)}\n else{t.issues.slice(0,MAX_ISSUES).forEach(function(x){var li=el('li');li.appendChild(el('span','tag','Row '+x.row+(x.col?', '+x.col:'')+': '));li.appendChild(document.createTextNode(x.text));ul.appendChild(li)});\n  if(t.issues.length>MAX_ISSUES)ul.appendChild(el('li',null,'And '+(t.issues.length-MAX_ISSUES)+' more.'));\n  ul.appendChild(el('li','note','Row numbers count data rows, without the header.'))}\n $('out').value='';\n}\nfunction objects(t){return t.rows.map(function(r){var o={};t.heads.forEach(function(h,c){var x=r[c];\n if(t.json)o[h]=x.v;else if(x.s.trim()==='')o[h]=null;else if(t.type[c]==='number'&&NUM.test(x.s.trim()))o[h]=Number(x.s.trim());else o[h]=x.s});return o})}\nfunction esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;')}\nfunction htmlTable(t){\n var o=['<table>','  <thead>','    <tr>'+t.heads.map(function(h){return'<th scope=\"col\">'+esc(h)+'</th>'}).join('')+'</tr>','  </thead>','  <tbody>'];\n t.rows.forEach(function(r){o.push('    <tr>'+r.map(function(x){return'<td>'+esc(x.s)+'</td>'}).join('')+'</tr>')});\n o.push('  </tbody>','</table>');return o.join('\\n');\n}\nfunction load(){\n var f=$('file').value;if(!f)return;say('');\n somnia.project.readFile(f).then(function(text){\n  var t;try{t=/\\.json$/i.test(f)?fromJSON(text):fromCSV(text)}catch(e){$('result').hidden=true;say('Could not read '+f+': '+(e&&e.message||e));return}\n  t.type=[];validate(t);st=t;show();\n  try{somnia.storage.set('lastFile',f).catch(function(){})}catch(e){}\n }).catch(function(e){$('result').hidden=true;say(String(e&&e.message||e))});\n}\nfunction init(){\n somnia.project.listFiles().then(function(list){\n  var data=list.filter(function(n){return /\\.(csv|tsv|json)$/i.test(n)}),sel=$('file');sel.textContent='';\n  data.forEach(function(n){var o=document.createElement('option');o.value=n;o.textContent=n;sel.appendChild(o)});\n  if(!data.length){say('No .csv, .tsv or .json file in the open project.');$('load').disabled=true;return}\n  $('load').disabled=false;\n  var p;try{p=somnia.storage.get('lastFile')}catch(e){p=Promise.resolve(null)}\n  p.catch(function(){return null}).then(function(last){if(last&&data.indexOf(last)>=0)sel.value=last;load()});\n }).catch(function(e){say(String(e&&e.message||e))});\n}\n$('load').onclick=function(){var cur=$('file').value;somnia.project.listFiles().then(function(l){if(l.indexOf(cur)<0)init();else load()}).catch(function(e){say(String(e&&e.message||e))})};\n$('file').onchange=load;\n$('mkjson').onclick=function(){if(st){$('out').value=JSON.stringify(objects(st),null,2)}};\n$('mkhtml').onclick=function(){if(st){$('out').value=htmlTable(st)}};\n$('sel').onclick=function(){var o=$('out');o.focus();o.select()};\ninit();\n})();\n</script>"
      }
    ]
  }
}
