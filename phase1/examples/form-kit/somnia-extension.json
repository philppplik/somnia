{
  "id": "somnia.form-kit",
  "name": "Form Kit",
  "version": "1.0.0",
  "apiVersion": 1,
  "permissions": [
    "project.read"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "html",
        "label": "Form: text field with label and hint",
        "body": "<div class=\"field\">\n  <label for=\"full-name\">Full name</label>\n  <input id=\"full-name\" name=\"full-name\" type=\"text\" autocomplete=\"name\" aria-describedby=\"full-name-hint\">\n  <p id=\"full-name-hint\" class=\"hint\">As it appears on your ID.</p>\n</div>"
      },
      {
        "language": "html",
        "label": "Form: fieldset with radio group",
        "body": "<fieldset class=\"field\">\n  <legend>Preferred contact method</legend>\n  <label><input type=\"radio\" name=\"contact\" value=\"email\" checked> Email</label>\n  <label><input type=\"radio\" name=\"contact\" value=\"phone\"> Phone</label>\n  <label><input type=\"radio\" name=\"contact\" value=\"post\"> Post</label>\n</fieldset>"
      },
      {
        "language": "html",
        "label": "Form: field with error hint",
        "body": "<div class=\"field\">\n  <label for=\"email-error\">Email</label>\n  <input id=\"email-error\" name=\"email\" type=\"email\" autocomplete=\"email\" inputmode=\"email\" aria-invalid=\"true\" aria-describedby=\"email-error-msg\">\n  <p id=\"email-error-msg\" class=\"error\" role=\"alert\">Error: enter an email address like name@example.com.</p>\n</div>"
      },
      {
        "language": "html",
        "label": "Form: email field",
        "body": "<div class=\"field\">\n  <label for=\"contact-email\">Email</label>\n  <input id=\"contact-email\" name=\"email\" type=\"email\" autocomplete=\"email\" inputmode=\"email\" spellcheck=\"false\">\n</div>"
      },
      {
        "language": "html",
        "label": "Form: password field",
        "body": "<div class=\"field\">\n  <label for=\"account-password\">Password</label>\n  <input id=\"account-password\" name=\"password\" type=\"password\" autocomplete=\"current-password\" aria-describedby=\"account-password-hint\">\n  <p id=\"account-password-hint\" class=\"hint\">Use new-password in autocomplete on sign-up forms.</p>\n</div>"
      },
      {
        "language": "html",
        "label": "Form: phone field",
        "body": "<div class=\"field\">\n  <label for=\"contact-phone\">Phone</label>\n  <input id=\"contact-phone\" name=\"phone\" type=\"tel\" autocomplete=\"tel\" inputmode=\"tel\">\n</div>"
      },
      {
        "language": "css",
        "label": "Form: field styles",
        "body": ".field { display: grid; gap: 0.25rem; margin-bottom: 1rem; border: 0; padding: 0; }\n.field label, .field legend { font-weight: 600; }\n.field input { padding: 0.5rem 0.75rem; border: 1px solid #6b7280; border-radius: 0.5rem; font: inherit; }\n.field input:focus-visible { outline: 2px solid #4f46e5; outline-offset: 2px; }\n.field input[aria-invalid=\"true\"] { border-color: #b42318; border-width: 2px; }\n.hint { margin: 0; color: #4b5563; font-size: 0.875rem; }\n.error { margin: 0; color: #b42318; font-size: 0.875rem; font-weight: 600; }"
      }
    ],
    "panels": [
      {
        "id": "check",
        "title": "Form Kit",
        "side": "right",
        "html": "<style>\nhtml,body{margin:0;background:#fff;color:#1f2430;font:13px/1.45 system-ui,sans-serif}\n*{box-sizing:border-box}\nh4{margin:14px 0 6px;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#4b5262}\nh4:first-child{margin-top:0}\n.card{border:1px solid #d5d8e2;border-radius:10px;padding:6px 10px;margin-bottom:6px}\n.card b{display:block}\n.card code{font:11px ui-monospace,Consolas,monospace;color:#4b5262;overflow-wrap:anywhere}\n.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center}\nselect,button{font:inherit;color:#1f2430}\nselect{flex:1 1 140px;min-width:0;padding:6px 8px;border:1px solid #9aa1b2;border-radius:8px;background:#fff}\nbutton{padding:6px 10px;border:1px solid #9aa1b2;border-radius:8px;background:#fff;cursor:pointer}\nbutton.pri{background:#4f46e5;border-color:#4f46e5;color:#fff}\nbutton:hover{background:#eef0f6}button.pri:hover{background:#4338ca}\nbutton:focus-visible,select:focus-visible{outline:2px solid #4f46e5;outline-offset:2px}\n.note{color:#4b5262;font-size:12px;margin:6px 0}\n#res{list-style:none;margin:8px 0 0;padding:0}\n#res li{border:1px solid #d5d8e2;border-radius:10px;padding:6px 10px;margin-bottom:6px;overflow-wrap:anywhere}\n#res li.ok{color:#05603a;border-color:#a6d8bf}\n#res li.err{color:#b42318;border-color:#f0b4ae}\n#res li.warn{color:#8a4b00;border-color:#e8c78f}\n.tag{font-weight:700}\n.tip{border-left:4px solid #4f46e5;background:#f1f2f7;border-radius:6px;padding:6px 10px}\n.tip b{display:block;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#4b5262}\n#msg{margin-top:8px;color:#b42318}\n.sr{position:absolute;left:-9999px}\n</style>\n<h4>Snippets (insert via Insert menu)</h4>\n<div class=\"card\"><b>Text field with label + hint</b><code>label, input, aria-describedby</code></div>\n<div class=\"card\"><b>Fieldset: radio group</b><code>fieldset + legend</code></div>\n<div class=\"card\"><b>Field with error hint</b><code>aria-invalid, role=alert</code></div>\n<div class=\"card\"><b>Email, password and tel fields</b><code>autocomplete + inputmode</code></div>\n<div class=\"card\"><b>Form field styles (CSS)</b><code>visible focus, error text</code></div>\n<h4 id=\"chk\">Form check</h4>\n<div class=\"row\">\n<label class=\"sr\" for=\"file\">HTML file to check</label>\n<select id=\"file\"></select>\n<button id=\"run\" class=\"pri\" type=\"button\">Check</button>\n</div>\n<p class=\"note\">Somnia panels cannot see which tab is open, so pick the file. The check reads unsaved changes and does not run any script in the file.</p>\n<div id=\"msg\" role=\"status\" aria-live=\"polite\"></div>\n<ul id=\"res\" aria-labelledby=\"chk\"></ul>\n<div class=\"tip\"><b>Tip</b>Use a visible label, not only a placeholder.</div>\n<script>\n(function(){\nvar $=function(i){return document.getElementById(i)};\nfunction say(t){$('msg').textContent=t||''}\nfunction mask(s){var m=function(x){return x.replace(/[^\\n]/g,' ')};return s.replace(/<!--[\\s\\S]*?-->/g,m).replace(/<(script|style)\\b[\\s\\S]*?<\\/\\1\\s*>/gi,m)}\nfunction lineList(src){var s=mask(src),re=/<(input|select|textarea)\\b/gi,out=[],m;while((m=re.exec(s)))out.push(s.slice(0,m.index).split('\\n').length);return out}\nfunction text(e){return(e.textContent||'').trim()}\nfunction labelled(c,doc){\n if((c.getAttribute('aria-label')||'').trim())return true;\n var by=(c.getAttribute('aria-labelledby')||'').split(/\\s+/).filter(Boolean);\n if(by.some(function(id){var t=doc.getElementById(id);return t&&text(t)}))return true;\n var p=c.parentElement;while(p){if(p.tagName==='LABEL'&&text(p))return true;p=p.parentElement}\n if(c.id){var ls=doc.querySelectorAll('label[for]');for(var i=0;i<ls.length;i++)if(ls[i].getAttribute('for')===c.id&&text(ls[i]))return true}\n return false;\n}\nfunction lines(list){var l=list.map(function(x){return x.line}).filter(Boolean);return l.length?' (line '+l.join(', ')+')':''}\nfunction plural(n,w){return n+' '+w+(n===1?'':'s')}\nfunction analyze(src){\n var doc=new DOMParser().parseFromString(src,'text/html'),all=Array.prototype.slice.call(doc.querySelectorAll('input,select,textarea')),ln=lineList(src);\n var aligned=ln.length===all.length;\n var items=all.map(function(e,i){return{el:e,line:aligned?ln[i]:0,type:(e.getAttribute('type')||'text').toLowerCase()}});\n var ctl=items.filter(function(x){return !(x.el.tagName==='INPUT'&&/^(hidden|submit|button|reset|image)$/.test(x.type))});\n var res=[];\n if(!ctl.length){return[{k:'warn',t:'No form fields found in this file.'}]}\n var bad=ctl.filter(function(x){return !labelled(x.el,doc)});\n if(bad.length){res.push({k:'err',t:plural(bad.length,'field')+' without a label'+lines(bad)});\n  var ph=bad.filter(function(x){return x.el.getAttribute('placeholder')});\n  if(ph.length)res.push({k:'warn',t:plural(ph.length,'field')+(ph.length===1?' uses':' use')+' only a placeholder'+lines(ph)+'. It disappears while typing.'})}\n else res.push({k:'ok',t:plural(ctl.length,'field')+' '+(ctl.length===1?'has':'have')+' a label'});\n var groups={};ctl.forEach(function(x){if((x.type==='radio'||x.type==='checkbox')&&x.el.name){var k=x.type+':'+x.el.name;(groups[k]=groups[k]||[]).push(x)}});\n var gcount=0,gbad=[];\n Object.keys(groups).forEach(function(k){var g=groups[k];if(g.length<2)return;gcount++;\n  var fs=g[0].el.closest('fieldset'),rg=g[0].el.closest('[role=radiogroup],[role=group]');\n  var same=fs&&g.every(function(x){return x.el.closest('fieldset')===fs});\n  if(!same&&!(rg&&((rg.getAttribute('aria-label')||'').trim()||rg.getAttribute('aria-labelledby'))))gbad.push({name:k,line:g[0].line})});\n gbad.forEach(function(g){var p=g.name.split(':');res.push({k:'warn',t:'1 '+p[0]+' group without fieldset ('+p[1]+(g.line?', line '+g.line:'')+')'})});\n if(gcount&&!gbad.length)res.push({k:'ok',t:plural(gcount,'radio/checkbox group')+' inside a fieldset'});\n var fsl=Array.prototype.slice.call(doc.querySelectorAll('fieldset')).filter(function(f){var l=f.firstElementChild;var has=false;for(var i=0;i<f.children.length;i++)if(f.children[i].tagName==='LEGEND'&&text(f.children[i]))has=true;return !has});\n if(fsl.length)res.push({k:'warn',t:plural(fsl.length,'fieldset')+' without a legend'});\n var need=[];\n ctl.forEach(function(x){var e=x.el,n=((e.name||'')+' '+(e.id||'')),kind=null;\n  if(e.tagName!=='INPUT')return;\n  if(x.type==='email'||(x.type==='text'&&/e-?mail/i.test(n)))kind='email';\n  else if(x.type==='tel'||(x.type==='text'&&/phone|tel\\b|mobile/i.test(n)))kind='tel';\n  else if(x.type==='password')kind='password';\n  if(!kind)return;var ac=(e.getAttribute('autocomplete')||'').trim().toLowerCase();\n  if(!ac||ac==='off')need.push({kind:kind,line:x.line,off:ac==='off'})});\n var any=ctl.some(function(x){var e=x.el;return e.tagName==='INPUT'&&(/^(email|tel|password)$/.test(x.type)||/e-?mail|phone|mobile/i.test((e.name||'')+(e.id||'')))});\n ['email','tel','password'].forEach(function(k){var l=need.filter(function(x){return x.kind===k});\n  if(l.length)res.push({k:'warn',t:'Missing autocomplete on '+k+(l.length>1?' fields':'')+lines(l)+(l.some(function(x){return x.off})?'. \"off\" blocks autofill and password managers.':'')})});\n if(any&&!need.length)res.push({k:'ok',t:'Email, tel and password fields have autocomplete'});\n var ids={};Array.prototype.slice.call(doc.querySelectorAll('[id]')).forEach(function(e){ids[e.id]=1});\n var dang=ctl.filter(function(x){var d=(x.el.getAttribute('aria-describedby')||'').split(/\\s+/).filter(Boolean);return d.some(function(i){return !ids[i]})});\n if(dang.length)res.push({k:'err',t:plural(dang.length,'aria-describedby')+' point'+(dang.length===1?'s':'')+' to a missing id'+lines(dang)});\n res.push({k:'info',t:plural(ctl.length,'field')+' checked'+(aligned?'':'. Line numbers are not available for this file.')});\n return res;\n}\nfunction render(res){var ul=$('res');ul.textContent='';\n res.forEach(function(r){var li=document.createElement('li');li.className=r.k;\n  var tag=document.createElement('span');tag.className='tag';tag.textContent={ok:'OK ',err:'Error: ',warn:'Warning: ',info:'Info: '}[r.k];li.appendChild(tag);li.appendChild(document.createTextNode(r.t));ul.appendChild(li)})}\nfunction run(){var f=$('file').value;if(!f)return;say('');\n somnia.project.readFile(f).then(function(src){render(analyze(src))}).catch(function(e){$('res').textContent='';say(String(e&&e.message||e))})}\nfunction init(){\n somnia.project.listFiles().then(function(list){\n  var h=list.filter(function(n){return /\\.(html?|xhtml)$/i.test(n)}),sel=$('file'),cur=sel.value;sel.textContent='';\n  h.forEach(function(n){var o=document.createElement('option');o.value=n;o.textContent=n;sel.appendChild(o)});\n  if(!h.length){say('No HTML file in the open project.');$('run').disabled=true;return}\n  $('run').disabled=false;sel.value=h.indexOf(cur)>=0?cur:(h.indexOf('index.html')>=0?'index.html':h[0]);run();\n }).catch(function(e){say(String(e&&e.message||e))})}\n$('run').onclick=function(){var c=$('file').value;somnia.project.listFiles().then(function(l){if(l.indexOf(c)<0)init();else run()}).catch(function(e){say(String(e&&e.message||e))})};\n$('file').onchange=run;\ninit();\n})();\n</script>"
      }
    ]
  }
}
