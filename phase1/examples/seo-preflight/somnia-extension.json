{
  "id": "somnia.seo-preflight",
  "name": "SEO Preflight",
  "version": "1.0.0",
  "apiVersion": 1,
  "permissions": [
    "project.read"
  ],
  "contributes": {
    "panels": [
      {
        "id": "audit",
        "title": "SEO Preflight",
        "side": "right",
        "html": "<style>\n:root{color-scheme:light dark;--bg:#f8f9fb;--card:#fff;--ink:#1f2430;--mute:#5b6270;--line:#e3e6ee;--acc:#4f46e5;--accbg:#ece9ff;--err:#b42318;--errbg:#fde8e6;--note:#92400e;--notebg:#fdf0d5;--ok:#166534;--okbg:#dcf5e3;--code:#f1f2f8}\n@media (prefers-color-scheme:dark){:root{--bg:#15171d;--card:#1e2129;--ink:#eceef4;--mute:#a4abba;--line:#323744;--acc:#a5a0ff;--accbg:#2b2a52;--err:#ff9d94;--errbg:#472220;--note:#f6c673;--notebg:#43341a;--ok:#86e0a0;--okbg:#1b3a27;--code:#161920}}\n*{box-sizing:border-box}\nbody{margin:0;padding:12px;background:var(--bg);color:var(--ink);font:13px/1.45 system-ui,sans-serif}\nh1{font-size:18px;margin:2px 0 4px;line-height:1.2}\nh2{font-size:12px;margin:0;color:var(--mute);text-transform:uppercase;letter-spacing:.04em;font-weight:600}\np{margin:0}\n.top{display:flex;gap:8px;align-items:flex-start;justify-content:space-between;flex-wrap:wrap}\n.eyebrow{font-size:11px;color:var(--mute);text-transform:uppercase;letter-spacing:.05em}\n.lead{color:var(--mute);margin:4px 0 10px}\nbutton,select{font:inherit;color:inherit}\nbutton{cursor:pointer}\nbutton:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid var(--acc);outline-offset:2px}\n.primary{background:#4f46e5;color:#fff;border:0;border-radius:999px;padding:6px 14px;font-weight:600}\n.primary[disabled]{opacity:.6;cursor:default}\n.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(86px,1fr));gap:8px;margin-bottom:10px}\n.metric{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:8px 10px}\n.metric b{display:block;font-size:22px;line-height:1.1;white-space:nowrap}\n.metric span{color:var(--mute);font-size:12px}\n.pills{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}\n.pill{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:3px 10px;font-size:12px}\n.pill[aria-pressed=true]{background:var(--accbg);border-color:var(--acc);color:var(--acc);font-weight:600}\n.filebar{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin:6px 0 8px}\n.filebar label{color:var(--mute);font-size:12px}\nselect{max-width:100%;border:1px solid var(--line);background:var(--card);border-radius:8px;padding:3px 6px}\n.list{display:grid;gap:8px;padding:0;margin:8px 0;list-style:none}\n.item{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:9px 10px;min-width:0}\n.head{display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap}\n.badge{flex:none;font-size:11px;font-weight:700;border-radius:999px;padding:1px 8px}\n.badge.error{background:var(--errbg);color:var(--err)}\n.badge.missing{background:var(--errbg);color:var(--err)}\n.badge.ok{background:var(--okbg);color:var(--ok)}\n.badge.notice{background:var(--notebg);color:var(--note)}\n.title{font-weight:600;flex:1 1 140px;min-width:0;overflow-wrap:anywhere}\n.where{font:11px ui-monospace,Consolas,monospace;color:var(--mute);margin-top:4px;overflow-wrap:anywhere}\ncode.el{display:block;margin-top:6px;background:var(--code);border-radius:8px;padding:5px 7px;font:11px ui-monospace,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;max-height:5.5em;overflow:auto}\n.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:9px 10px;margin:8px 0;min-width:0}\n.card>summary{font-weight:600;color:var(--ink);font-size:13px;overflow-wrap:anywhere}\n.card .sub{color:var(--mute);font-weight:400;font-size:12px}\n.checks{list-style:none;padding:0;margin:8px 0 0;display:grid;gap:6px}\n.checks li{border-top:1px solid var(--line);padding-top:6px}\n.pv{background:var(--code);border-radius:10px;padding:8px 10px;margin-top:8px;overflow-wrap:anywhere}\n.pv .pt{color:#4f46e5;font-size:15px;font-weight:600;line-height:1.25}\n@media (prefers-color-scheme:dark){.pv .pt{color:var(--acc)}}\n.pv .pu{color:var(--mute);font-size:11px;margin:2px 0}\n.pv .pd{font-size:12px}\n.pv .pm{color:var(--mute);font-size:11px;margin-top:4px}\ndetails{margin-top:6px}\nsummary{cursor:pointer;color:var(--acc);font-size:12px}\ndetails p{margin-top:4px;color:var(--mute)}\n.note{font-size:12px;background:var(--card);border:1px dashed var(--line);border-radius:14px;padding:9px 10px;color:var(--mute);margin:8px 0}\n.empty{text-align:center;padding:16px 8px}\n.err{color:var(--err)}\n.foot{display:flex;justify-content:space-between;gap:6px 12px;flex-wrap:wrap;border-top:1px solid var(--line);margin-top:10px;padding-top:8px;color:var(--mute);font-size:11px}\n</style>\n<main aria-labelledby=\"t\">\n<div class=\"top\"><div><div class=\"eyebrow\">Code studio / Web project</div><h1 id=\"t\">SEO Preflight</h1></div>\n<button type=\"button\" class=\"primary\" id=\"run\">Re-check</button></div>\n<p class=\"lead\">Checks the metadata in your HTML files. No rankings, no online lookups.</p>\n<div class=\"metrics\" id=\"metrics\" role=\"group\" aria-label=\"Summary\"></div>\n<div class=\"pills\" id=\"views\" role=\"group\" aria-label=\"View\"></div>\n<p class=\"eyebrow\" id=\"listhead\" aria-live=\"polite\"></p>\n<div id=\"out\"></div>\n<div class=\"note\" id=\"skipnote\" hidden></div>\n<div class=\"note\">The length hints are editorial guide values, not ranking rules. The text preview is a rough sketch of title, address and description. It is not what Google will show; search engines pick their own titles and snippets.</div>\n<div class=\"foot\"><span>Read only &middot; Offline &middot; No automatic changes</span><span id=\"stamp\">Snapshot &middot; refresh manually</span></div>\n</main>\n<script>\n(function(){\n'use strict';\nvar VIEWS=[['pages','Pages'],['missing','Missing'],['dups','Duplicates'],['preview','Preview']];\nvar $=function(i){return document.getElementById(i)};\nfunction h(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}\nvar state={pages:[],skipped:[],dups:[],view:'pages',error:'',busy:false,done:false};\nfunction norm(s){return (s||'').replace(/\\s+/g,' ').trim()}\nfunction meta(doc,sel,attr){var e=doc.querySelector(sel);return e?norm(e.getAttribute(attr||'content')):null}\nfunction count(s){return Array.from(s).length}\nfunction check(id,label,status,detail,sel,why){return {id:id,label:label,status:status,detail:detail,sel:sel,why:why}}\nfunction analyse(path,text){\n var doc=new DOMParser().parseFromString(text,'text/html');\n var isDoc=/<html[\\s>]/i.test(text)||/<head[\\s>]/i.test(text);\n if(!isDoc)return null;\n var P={path:path,checks:[],noindex:false};\n var te=doc.querySelector('head title')||doc.querySelector('title');\n var title=te?norm(te.textContent):'';\n P.title=title;\n if(!title)P.checks.push(check('title','Page title','missing','No title element, or it is empty.','title','The title is the main label of the page in browser tabs and search results.'));\n else if(count(title)<10||count(title)>60)P.checks.push(check('title','Page title','notice',title+' ('+count(title)+' characters; about 10 to 60 is a common guide)','title','Very short or very long titles are often rewritten or cut off in results.'));\n else P.checks.push(check('title','Page title','ok',title,'title',''));\n var desc=meta(doc,'meta[name=\"description\" i]');\n P.desc=desc||'';\n if(!desc)P.checks.push(check('desc','Meta description','missing','No short summary is set.','meta[name=description]','The description is a common source for the text under a result. Without one, search engines pick text from the page.'));\n else if(count(desc)<50||count(desc)>160)P.checks.push(check('desc','Meta description','notice',count(desc)+' characters; about 50 to 160 is a common guide','meta[name=description]','Very short or very long descriptions may be replaced or cut off.'));\n else P.checks.push(check('desc','Meta description','ok',count(desc)+' characters','meta[name=description]',''));\n var cans=doc.querySelectorAll('link[rel~=\"canonical\" i]');\n var can=cans.length?norm(cans[0].getAttribute('href')):'';\n P.canonical=can;\n if(cans.length>1)P.checks.push(check('canonical','Canonical link','missing',cans.length+' canonical links. Only one is allowed.','link[rel=canonical]','When several canonical links disagree, search engines ignore them.'));\n else if(!cans.length)P.checks.push(check('canonical','Canonical link','notice','None set. Optional for simple sites.','link[rel=canonical]','A canonical link names the preferred address when the same page is reachable under several URLs.'));\n else if(!can)P.checks.push(check('canonical','Canonical link','missing','The href is empty.','link[rel=canonical]','An empty canonical link has no effect.'));\n else if(!/^https?:\\/\\//i.test(can))P.checks.push(check('canonical','Canonical link','notice','Relative address: '+can+'. Use the full URL when you publish.','link[rel=canonical]','Canonical links should be absolute URLs. This tool does not open them.'));\n else P.checks.push(check('canonical','Canonical link','ok',can,'link[rel=canonical]',''));\n var rb=meta(doc,'meta[name=\"robots\" i]'),gb=meta(doc,'meta[name=\"googlebot\" i]');\n var rv=((rb||'')+','+(gb||'')).toLowerCase();\n if(/noindex|none/.test(rv)){P.noindex=true;P.checks.push(check('robots','Robots meta','notice','Page is excluded from search ('+(rb||gb)+'). Intended?','meta[name=robots]','noindex asks search engines to leave this page out of results.'))}\n else P.checks.push(check('robots','Robots meta','ok',rb||gb?(rb||gb):'Not set (default: indexable)','meta[name=robots]',''));\n [['og:title','Open Graph title'],['og:description','Open Graph description'],['og:image','Open Graph image']].forEach(function(o){\n  var v=meta(doc,'meta[property=\"'+o[0]+'\" i]');\n  if(o[0]==='og:image')P.og=v||'';\n  if(!v)P.checks.push(check(o[0],o[1],'notice','Not set. Link previews on social sites will use guesses.','meta[property=\"'+o[0]+'\"]','Open Graph tags control how the page looks when shared in chats and social posts.'));\n  else P.checks.push(check(o[0],o[1],'ok',v.length>80?v.slice(0,77)+'...':v,'meta[property=\"'+o[0]+'\"]',''));\n });\n var hs=[].filter.call(doc.querySelectorAll('h1'),function(e){return !e.closest('[hidden]')});\n var h1=hs.length?norm(hs[0].textContent):'';\n P.h1=h1;\n if(!hs.length||!h1)P.checks.push(check('h1','Main heading (h1)','missing',hs.length?'The h1 is empty.':'No h1 on the page.','h1','A clear h1 states the topic of the page. This is a content guideline, not a hard rule.'));\n else if(hs.length>1)P.checks.push(check('h1','Main heading (h1)','notice',hs.length+' h1 elements. Valid HTML, but one is the usual choice.','h1','Several h1 headings can blur the topic of the page.'));\n else P.checks.push(check('h1','Main heading (h1)','ok',h1.length>80?h1.slice(0,77)+'...':h1,'h1',''));\n var lang=norm(doc.documentElement.getAttribute('lang'));\n if(!lang)P.checks.push(check('lang','Page language','missing','The html element has no lang attribute.','html[lang]','lang helps search engines and browsers pick the right language.'));\n else P.checks.push(check('lang','Page language','ok',lang,'html[lang]',''));\n return P;\n}\nfunction dupGroups(pages){\n var out=[];\n [['title','Same title'],['desc','Same description'],['canonical','Same canonical link'],['h1','Same h1']].forEach(function(k){\n  var map={};\n  pages.forEach(function(p){var v=norm(p[k[0]]).toLowerCase();if(v)(map[v]=map[v]||[]).push(p)});\n  Object.keys(map).forEach(function(v){var l=map[v];if(l.length>1)out.push({kind:k[1],value:l[0][k[0]],files:l.map(function(p){return p.path})})});\n });\n return out;\n}\nasync function scan(){\n state.busy=true;state.error='';render();\n var pages=[],skipped=[];\n try{\n  var all=await somnia.project.listFiles();\n  var html=all.filter(function(p){return /\\.(html?|xhtml)$/i.test(p)});\n  for(var i=0;i<html.length;i++){\n   var t;\n   try{t=await somnia.project.readFile(html[i])}catch(e){skipped.push(html[i]+': could not be read');continue}\n   if(typeof t!=='string'){skipped.push(html[i]+': no text content');continue}\n   if(t.length>1500000){skipped.push(html[i]+': larger than 1.5 MB, skipped');continue}\n   var p=analyse(html[i],t);\n   if(!p)skipped.push(html[i]+': partial page (no html or head), skipped');else pages.push(p);\n  }\n }catch(e){state.error=e&&e.message?e.message:String(e);pages=[]}\n state.pages=pages;state.skipped=skipped;state.dups=dupGroups(pages);state.done=true;state.busy=false;state.stamp=new Date().toLocaleTimeString();\n render();\n}\nfunction checkRow(c,file){\n var li=h('li'),hd=h('div','head');\n hd.appendChild(h('span','badge '+c.status,c.status==='ok'?'OK':c.status==='missing'?'Missing':'Notice'));\n hd.appendChild(h('span','title',c.label));li.appendChild(hd);\n if(file)li.appendChild(h('div','where',file));\n li.appendChild(h('div','where',c.detail));\n li.appendChild(h('div','where',c.sel));\n if(c.why&&c.status!=='ok'){var d=h('details');d.appendChild(h('summary',null,'Why it matters'));d.appendChild(h('p',null,c.why));li.appendChild(d)}\n return li;\n}\nfunction cut(s,n){var a=Array.from(s);return a.length>n?a.slice(0,n-1).join('').trim()+'\\u2026':s}\nfunction render(){\n var run=$('run');run.disabled=state.busy;run.textContent=state.busy?'Checking...':'Re-check';\n var P=state.pages,all=[],ok=0;P.forEach(function(p){p.checks.forEach(function(c){all.push(c);if(c.status==='ok')ok++})});\n var m=$('metrics');m.textContent='';\n [[all.length-ok,'Notices'],[P.length,'HTML files'],[ok+'/'+all.length,'Checks met']].forEach(function(x){var d=h('div','metric');d.appendChild(h('b',null,String(x[0])));d.appendChild(h('span',null,x[1]));m.appendChild(d)});\n var miss=all.filter(function(c){return c.status==='missing'}).length;\n var counts={pages:'',missing:' '+miss,dups:' '+state.dups.length,preview:''};\n var v=$('views');v.textContent='';\n VIEWS.forEach(function(x){var b=h('button','pill',x[1]+counts[x[0]]);b.type='button';b.setAttribute('aria-pressed',String(state.view===x[0]));b.onclick=function(){state.view=x[0];render()};v.appendChild(b)});\n var out=$('out');out.textContent='';\n var head={pages:'Checks per page',missing:'Missing items',dups:'Shared between files',preview:'Text preview'}[state.view];\n $('listhead').textContent=state.done&&!state.error?head:'';\n if(state.error){var e=h('div','card');e.appendChild(h('p','err','Could not read the project: '+state.error));e.appendChild(h('p',null,'This extension needs the project.read permission. Check Settings > Extensions.'));out.appendChild(e)}\n else if(state.done&&!P.length){out.appendChild(h('div','card empty','No full HTML pages in the open project.'))}\n else if(state.view==='pages'){\n  P.forEach(function(p,i){\n   var bad=p.checks.filter(function(c){return c.status!=='ok'}).length;\n   var d=h('details','card');if(bad&&i<3)d.open=true;\n   var s=h('summary',null,p.path+' ');s.appendChild(h('span','sub',(p.checks.length-bad)+' of '+p.checks.length+' checks met'));d.appendChild(s);\n   var ul=h('ul','checks');p.checks.forEach(function(c){ul.appendChild(checkRow(c))});d.appendChild(ul);out.appendChild(d);\n  });\n }else if(state.view==='missing'){\n  var any=false,ul=h('ul','list');\n  P.forEach(function(p){p.checks.forEach(function(c){if(c.status==='missing'){any=true;var li=h('li','item');li.appendChild(checkRow(c,p.path));ul.appendChild(li)}})});\n  out.appendChild(any?ul:h('div','card empty','Nothing missing. Notices may still remain on the Pages view.'));\n }else if(state.view==='dups'){\n  if(!state.dups.length)out.appendChild(h('div','card empty','No title, description, canonical or h1 is shared between files.'));\n  state.dups.forEach(function(g){\n   var c=h('div','card'),hd=h('div','head');hd.appendChild(h('span','badge notice','Notice'));hd.appendChild(h('span','title',g.kind+' in '+g.files.length+' files'));c.appendChild(hd);\n   c.appendChild(h('code','el',cut(g.value,160)));\n   g.files.forEach(function(f){c.appendChild(h('div','where',f))});\n   var d=h('details');d.appendChild(h('summary',null,'Why it matters'));d.appendChild(h('p',null,'Search engines and people cannot tell these pages apart. Give each page its own text, unless the pages really are copies.'));c.appendChild(d);\n   out.appendChild(c);\n  });\n }else{\n  P.forEach(function(p){\n   var c=h('div','card');c.appendChild(h('div','eyebrow','Text preview \\u00b7 not a Google snippet'));\n   var pv=h('div','pv');\n   pv.appendChild(h('div','pt',p.title?cut(p.title,60):'(no title)'));\n   pv.appendChild(h('div','pu',p.canonical||p.path));\n   pv.appendChild(h('div','pd',p.desc?cut(p.desc,160):'No meta description. Search engines will choose text from the page.'));\n   pv.appendChild(h('div','pm','Title '+Array.from(p.title).length+' characters \\u00b7 description '+Array.from(p.desc).length+' characters'+(p.noindex?' \\u00b7 noindex':'')));\n   c.appendChild(h('div','where',p.path));c.appendChild(pv);out.appendChild(c);\n  });\n }\n var sn=$('skipnote');sn.hidden=!state.skipped.length;sn.textContent='';\n if(state.skipped.length){sn.appendChild(h('div',null,'Notes:'));state.skipped.slice(0,8).forEach(function(s){sn.appendChild(h('div',null,'- '+s))});if(state.skipped.length>8)sn.appendChild(h('div',null,'- and '+(state.skipped.length-8)+' more'))}\n $('stamp').textContent=state.stamp?'Snapshot at '+state.stamp+' \\u00b7 refresh manually':'Snapshot \\u00b7 refresh manually';\n}\n$('run').onclick=scan;\nrender();scan();\n})();\n</script>"
      }
    ]
  }
}
