{
  "id": "somnia.accessibility-audit",
  "name": "Accessibility Audit",
  "version": "1.0.0",
  "apiVersion": 1,
  "permissions": [
    "project.read"
  ],
  "contributes": {
    "panels": [
      {
        "id": "audit",
        "title": "Accessibility Audit",
        "side": "right",
        "html": "<style>\n:root{color-scheme:light dark;--bg:#f8f9fb;--card:#fff;--ink:#1f2430;--mute:#5b6270;--line:#e3e6ee;--acc:#4f46e5;--accbg:#ece9ff;--err:#b42318;--errbg:#fde8e6;--note:#92400e;--notebg:#fdf0d5;--ok:#166534;--okbg:#dcf5e3;--code:#f1f2f8}\n@media (prefers-color-scheme:dark){:root{--bg:#15171d;--card:#1e2129;--ink:#eceef4;--mute:#a4abba;--line:#323744;--acc:#a5a0ff;--accbg:#2b2a52;--err:#ff9d94;--errbg:#472220;--note:#f6c673;--notebg:#43341a;--ok:#86e0a0;--okbg:#1b3a27;--code:#161920}}\n*{box-sizing:border-box}\nbody{margin:0;padding:12px;background:var(--bg);color:var(--ink);font:13px/1.45 system-ui,sans-serif}\nh1{font-size:18px;margin:2px 0 4px;line-height:1.2}\nh2{font-size:12px;margin:0;color:var(--mute);text-transform:uppercase;letter-spacing:.04em;font-weight:600}\np{margin:0}\n.top{display:flex;gap:8px;align-items:flex-start;justify-content:space-between;flex-wrap:wrap}\n.eyebrow{font-size:11px;color:var(--mute);text-transform:uppercase;letter-spacing:.05em}\n.lead{color:var(--mute);margin:4px 0 10px}\nbutton,select{font:inherit;color:inherit}\nbutton{cursor:pointer}\nbutton:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid var(--acc);outline-offset:2px}\n.primary{background:#4f46e5;color:#fff;border:0;border-radius:999px;padding:6px 14px;font-weight:600}\n.primary[disabled]{opacity:.6;cursor:default}\n.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(86px,1fr));gap:8px;margin-bottom:10px}\n.metric{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:8px 10px}\n.metric b{display:block;font-size:22px;line-height:1.1}\n.metric span{color:var(--mute);font-size:12px}\n.pills{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}\n.pill{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:3px 10px;font-size:12px}\n.pill[aria-pressed=true]{background:var(--accbg);border-color:var(--acc);color:var(--acc);font-weight:600}\n.filebar{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin:6px 0 8px}\n.filebar label{color:var(--mute);font-size:12px}\nselect{max-width:100%;border:1px solid var(--line);background:var(--card);border-radius:8px;padding:3px 6px}\n.list{display:grid;gap:8px;padding:0;margin:8px 0;list-style:none}\n.item{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:9px 10px;min-width:0}\n.head{display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap}\n.badge{flex:none;font-size:11px;font-weight:700;border-radius:999px;padding:1px 8px}\n.badge.error{background:var(--errbg);color:var(--err)}\n.badge.notice{background:var(--notebg);color:var(--note)}\n.title{font-weight:600;flex:1 1 140px;min-width:0;overflow-wrap:anywhere}\n.where{font:11px ui-monospace,Consolas,monospace;color:var(--mute);margin-top:4px;overflow-wrap:anywhere}\ncode.el{display:block;margin-top:6px;background:var(--code);border-radius:8px;padding:5px 7px;font:11px ui-monospace,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;max-height:5.5em;overflow:auto}\ndetails{margin-top:6px}\nsummary{cursor:pointer;color:var(--acc);font-size:12px}\ndetails p{margin-top:4px;color:var(--mute)}\n.note{font-size:12px;background:var(--card);border:1px dashed var(--line);border-radius:14px;padding:9px 10px;color:var(--mute);margin:8px 0}\n.empty{text-align:center;padding:16px 8px}\n.err{color:var(--err)}\n.foot{display:flex;justify-content:space-between;gap:6px 12px;flex-wrap:wrap;border-top:1px solid var(--line);margin-top:10px;padding-top:8px;color:var(--mute);font-size:11px}\n</style>\n<main aria-labelledby=\"t\">\n<div class=\"top\"><div><div class=\"eyebrow\">Code studio / Web project</div><h1 id=\"t\">Accessibility Audit</h1></div>\n<button type=\"button\" class=\"primary\" id=\"run\">Re-check</button></div>\n<p class=\"lead\">Static check of your HTML files. Reports findings, not a WCAG pass or fail.</p>\n<div class=\"metrics\" id=\"metrics\" role=\"group\" aria-label=\"Summary\"></div>\n<div class=\"pills\" id=\"cats\" role=\"group\" aria-label=\"Filter by category\"></div>\n<div class=\"filebar\" id=\"filebar\" hidden><label for=\"file\">File</label><select id=\"file\"></select></div>\n<p class=\"eyebrow\" id=\"listhead\" aria-live=\"polite\"></p>\n<ul class=\"list\" id=\"list\"></ul>\n<div class=\"note\" id=\"skipnote\" hidden></div>\n<div class=\"note\">Not covered here: color contrast, keyboard use, focus order, the quality of alt text, and anything that scripts add at run time. Check those by hand or with a browser tool.</div>\n<div class=\"foot\"><span>Read only &middot; Offline &middot; No automatic changes</span><span id=\"stamp\">Snapshot &middot; refresh manually</span></div>\n</main>\n<script>\n(function(){\n'use strict';\nvar CATS=[['all','All'],['labels','Alt & labels'],['ids','IDs & ARIA'],['landmarks','Landmarks']];\nvar RULES={\n'img-alt':['labels','error','Image without alt attribute','Screen readers read out the file name when alt is missing.','Describe the image in alt. For purely decorative images use alt=\"\" on purpose.'],\n'img-alt-file':['labels','notice','Alt text looks like a file name','Alt text that repeats a file name tells people nothing about the image.','Describe what the image shows or why it is there.'],\n'input-image':['labels','error','Image button without alt text','An input of type image acts as a button. Without alt it has no name.','Add alt (for example \"Search\") or aria-label.'],\n'area-alt':['labels','error','Image map area without alt text','A clickable area without alt has no name for assistive technology.','Add alt that says where the area leads.'],\n'control-name':['labels','error','Form field without an accessible name','There is no label, aria-label, title or valid aria-labelledby. A placeholder is not a label.','Add a label element linked with for and id, or wrap the field in a label.'],\n'button-name':['labels','error','Button without an accessible name','The button has no text, aria-label or labelled image, so its purpose is unknown.','Add visible text or an aria-label.'],\n'link-name':['labels','error','Link without an accessible name','A link with no text or label is announced as just \"link\".','Add link text, an image with alt, or an aria-label.'],\n'label-target':['ids','error','Label points to a missing field','The for attribute of this label does not match any id in the file, so the label is not connected to a field.','Fix the for value or the id of the field.'],\n'dup-id':['ids','error','Duplicate ID','Two or more elements share one id. Labels, links and ARIA references then point at the wrong element or only the first.','Make each id unique in the file.'],\n'labelledby':['ids','error','aria-labelledby points to a missing ID','The id list has an entry that is not in this file. The name may be empty or incomplete.','Fix the id or remove the attribute.'],\n'aria-ref':['ids','notice','ARIA reference target not found','An id referenced by this attribute is not in the file. It may be created by a script, so check it manually.','Fix the id or remove the attribute if it is not needed.'],\n'aria-empty':['ids','notice','ARIA reference is empty','The attribute is present but lists no id.','Add an id or remove the attribute.'],\n'aria-hidden-focus':['ids','error','Focusable element hidden with aria-hidden','Keyboard users can reach this element, but screen readers are told to ignore it.','Remove aria-hidden, or make the element not focusable (hidden, disabled or tabindex=\"-1\").'],\n'main-missing':['landmarks','notice','No main landmark','A main element lets screen reader users jump straight to the page content.','Wrap the primary content in one main element.'],\n'main-multiple':['landmarks','error','More than one visible main landmark','A page should have one main landmark. Extra ones confuse landmark navigation.','Keep one main. Mark others hidden if they are alternates.'],\n'landmark-label':['landmarks','notice','Several landmarks of one type without labels','Users cannot tell these apart in a landmark list.','Give each an aria-label, for example \"Main\" and \"Footer\".'],\n'page-lang':['landmarks','notice','Page has no lang attribute','Screen readers use lang to choose the pronunciation.','Add lang to the html element, for example lang=\"en\".'],\n'page-title':['landmarks','notice','Page has no title','The title is the first thing a screen reader announces and shows in tabs.','Add a short title that describes the page.']\n};\nvar $=function(i){return document.getElementById(i)};\nfunction h(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}\nvar state={findings:[],files:[],skipped:[],cat:'all',file:'all',error:'',busy:false,done:false};\n\nfunction blank(s){return s.replace(/[^\\n]/g,' ')}\nfunction tokenLines(src){\n var s=src.replace(/<!--[\\s\\S]*?-->/g,blank).replace(/(<(script|style|textarea|title)\\b[^>]*>)([\\s\\S]*?)(<\\/\\2\\s*>)/gi,function(m,a,b,c,d){return a+blank(c)+d});\n var out=[],re=/<([a-zA-Z][a-zA-Z0-9:-]*)/g,m,line=1,last=0;\n while((m=re.exec(s))){for(var i=last;i<m.index;i++){if(s.charCodeAt(i)===10)line++}last=m.index;out.push([m[1].toLowerCase(),line])}\n return out;\n}\nfunction lineMap(doc,src){\n var toks=tokenLines(src),map=new Map(),j=0,els=doc.querySelectorAll('*');\n for(var i=0;i<els.length;i++){\n  var tag=els[i].localName;\n  if(j<toks.length&&toks[j][0]===tag){map.set(els[i],toks[j][1]);j++;continue}\n  for(var k=j+1;k<Math.min(toks.length,j+6);k++){if(toks[k][0]===tag){map.set(els[i],toks[k][1]);j=k+1;break}}\n }\n return map;\n}\nfunction snippet(el){\n var s='<'+el.localName,a=el.attributes;\n for(var i=0;i<a.length;i++){var v=a[i].value;if(v.length>60)v=v.slice(0,57)+'...';s+=' '+a[i].name+'=\"'+v+'\"'}\n s+='>';return s.length>200?s.slice(0,197)+'...>':s;\n}\nfunction hiddenUp(el){for(var n=el;n&&n.nodeType===1;n=n.parentElement){if(n.hasAttribute('hidden')||n.getAttribute('aria-hidden')==='true')return true}return false}\nfunction txt(el){return (el.textContent||'').replace(/\\s+/g,' ').trim()}\nfunction ids(v){return (v||'').split(/\\s+/).filter(Boolean)}\nfunction refText(doc,v){var t='';ids(v).forEach(function(i){var e=doc.getElementById(i);if(e)t+=' '+txt(e)+(e.getAttribute('aria-label')||'')});return t.trim()}\nfunction imgNamed(el){var i=el.querySelector('img[alt]:not([alt=\"\"]),svg[aria-label],svg title,[role=img][aria-label]');return !!i}\nfunction hasName(doc,el,inner){\n if(el.hasAttribute('aria-labelledby'))return true; /* judged by the ARIA rules */\n if((el.getAttribute('aria-label')||'').trim())return true;\n if((el.getAttribute('title')||'').trim())return true;\n if(inner&&(txt(el)||imgNamed(el)))return true;\n return false;\n}\nfunction controlNamed(doc,el){\n if(hasName(doc,el,false))return true;\n var id=el.getAttribute('id');\n if(id){var ls=doc.querySelectorAll('label[for]');for(var i=0;i<ls.length;i++){if(ls[i].getAttribute('for')===id&&(txt(ls[i])||imgNamed(ls[i])))return true}}\n var w=el.closest('label');\n return !!(w&&(txt(w).length>0||imgNamed(w)));\n}\nfunction analyse(path,text){\n var doc=new DOMParser().parseFromString(text,'text/html');\n var lines=lineMap(doc,text),out=[];\n var fullDoc=/<html[\\s>]/i.test(text)||/<body[\\s>]/i.test(text);\n function add(rule,el,extra){var r=RULES[rule];out.push({rule:rule,cat:r[0],sev:r[1],title:r[2]+(extra?': '+extra:''),why:r[3],fix:r[4],file:path,line:el?lines.get(el)||0:0,el:el?snippet(el):''})}\n doc.querySelectorAll('img:not([alt])').forEach(function(e){var r=e.getAttribute('role');if(r==='presentation'||r==='none'||hiddenUp(e))return;add('img-alt',e)});\n doc.querySelectorAll('img[alt]').forEach(function(e){if(/^[^\\s]+\\.(png|jpe?g|gif|webp|avif|svg|bmp)$/i.test(e.getAttribute('alt').trim()))add('img-alt-file',e)});\n doc.querySelectorAll('input[type=image]').forEach(function(e){if(!(e.getAttribute('alt')||'').trim()&&!hasName(doc,e,false))add('input-image',e)});\n doc.querySelectorAll('area[href]').forEach(function(e){if(!(e.getAttribute('alt')||'').trim()&&!hasName(doc,e,false))add('area-alt',e)});\n doc.querySelectorAll('input:not([type=hidden]):not([type=submit]):not([type=reset]):not([type=button]):not([type=image]),select,textarea').forEach(function(e){if(hiddenUp(e))return;if(!controlNamed(doc,e))add('control-name',e)});\n doc.querySelectorAll('input[type=button],input[type=reset]').forEach(function(e){if(!(e.getAttribute('value')||'').trim()&&!hasName(doc,e,false))add('button-name',e)});\n doc.querySelectorAll('button').forEach(function(e){if(!hiddenUp(e)&&!hasName(doc,e,true))add('button-name',e)});\n doc.querySelectorAll('a[href]').forEach(function(e){if(!hiddenUp(e)&&!hasName(doc,e,true))add('link-name',e)});\n doc.querySelectorAll('label[for]').forEach(function(e){var f=e.getAttribute('for');if(f&&!doc.getElementById(f))add('label-target',e,f)});\n var seen={};\n doc.querySelectorAll('[id]').forEach(function(e){var i=e.getAttribute('id');if(!i)return;(seen[i]=seen[i]||[]).push(e)});\n Object.keys(seen).forEach(function(i){var l=seen[i];if(l.length>1){add('dup-id',l[0],'#'+i+' (x'+l.length+')');var f=out[out.length-1];var ln=l.map(function(x){return lines.get(x)}).filter(Boolean).filter(function(v,i,a){return a.indexOf(v)===i});if(ln.length>1)f.lineList=ln}});\n ['aria-labelledby','aria-describedby','aria-controls','aria-owns','aria-activedescendant','aria-details','aria-errormessage','aria-flowto'].forEach(function(attr){\n  doc.querySelectorAll('['+attr+']').forEach(function(e){\n   var l=ids(e.getAttribute(attr));\n   if(!l.length){add('aria-empty',e,attr);return}\n   var miss=l.filter(function(i){return !doc.getElementById(i)});\n   if(miss.length)add(attr==='aria-labelledby'?'labelledby':'aria-ref',e,(attr==='aria-labelledby'?'':attr+' ')+'\"'+miss.join(' ')+'\"');\n  });\n });\n doc.querySelectorAll('[aria-hidden=\"true\"]').forEach(function(e){\n  var ti=e.getAttribute('tabindex');\n  var foc=(/^(button|select|textarea)$/.test(e.localName)||(e.localName==='a'&&e.hasAttribute('href'))||(e.localName==='input'&&e.getAttribute('type')!=='hidden')||(ti!==null&&ti!=='-1'))&&!e.hasAttribute('disabled')&&ti!=='-1';\n  if(foc)add('aria-hidden-focus',e);\n });\n if(fullDoc){\n  var mains=[].filter.call(doc.querySelectorAll('main,[role=main]'),function(e){return !e.hasAttribute('hidden')});\n  if(!mains.length)add('main-missing',null);\n  else if(mains.length>1)add('main-multiple',mains[1],mains.length+' found');\n  ['nav','aside'].forEach(function(t){\n   var l=[].filter.call(doc.querySelectorAll(t),function(e){return !hiddenUp(e)});\n   var un=l.filter(function(e){return !(e.getAttribute('aria-label')||'').trim()&&!e.hasAttribute('aria-labelledby')});\n   if(l.length>1&&un.length)add('landmark-label',un[0],t+' x'+l.length);\n  });\n  if(/<html[\\s>]/i.test(text)&&!(doc.documentElement.getAttribute('lang')||'').trim())add('page-lang',doc.documentElement);\n  if(/<head[\\s>]/i.test(text)&&!txt(doc.querySelector('title')||doc.createElement('i')))add('page-title',null);\n }\n return {findings:out,fragment:!fullDoc};\n}\nasync function scan(){\n state.busy=true;state.error='';render();\n var findings=[],files=[],skipped=[];\n try{\n  var all=await somnia.project.listFiles();\n  var html=all.filter(function(p){return /\\.(html?|xhtml)$/i.test(p)});\n  for(var i=0;i<html.length;i++){\n   var p=html[i],t;\n   try{t=await somnia.project.readFile(p)}catch(e){skipped.push(p+': could not be read');continue}\n   if(typeof t!=='string'){skipped.push(p+': no text content');continue}\n   if(t.length>1500000){skipped.push(p+': larger than 1.5 MB, skipped');continue}\n   var r=analyse(p,t);\n   files.push(p);\n   if(r.fragment)skipped.push(p+': partial page, page-level checks (main, lang, title) skipped');\n   r.findings.sort(function(a,b){return a.line-b.line});\n   findings=findings.concat(r.findings);\n  }\n  state.total=all.length;\n }catch(e){state.error=e&&e.message?e.message:String(e);findings=[];files=[]}\n state.findings=findings;state.files=files;state.skipped=skipped;state.done=true;state.busy=false;\n state.stamp=new Date().toLocaleTimeString();\n if(state.file!=='all'&&files.indexOf(state.file)<0)state.file='all';\n render();\n}\nfunction render(){\n var run=$('run');run.disabled=state.busy;run.textContent=state.busy?'Checking...':'Re-check';\n var F=state.findings,errs=F.filter(function(f){return f.sev==='error'}).length;\n var m=$('metrics');m.textContent='';\n [[F.length,'Findings'],[state.files.length,'HTML files'],[F.length-errs,'Check manually']].forEach(function(x){var d=h('div','metric');d.appendChild(h('b',null,String(x[0])));d.appendChild(h('span',null,x[1]));m.appendChild(d)});\n var cats=$('cats');cats.textContent='';\n CATS.forEach(function(c){var n=c[0]==='all'?F.length:F.filter(function(f){return f.cat===c[0]}).length;var b=h('button','pill',c[1]+' '+n);b.type='button';b.setAttribute('aria-pressed',String(state.cat===c[0]));b.onclick=function(){state.cat=c[0];render()};cats.appendChild(b)});\n var fb=$('filebar'),sel=$('file');\n fb.hidden=state.files.length<2;\n if(!fb.hidden){sel.textContent='';[['all','All files']].concat(state.files.map(function(f){return [f,f]})).forEach(function(o){var op=h('option',null,o[1]);op.value=o[0];sel.appendChild(op)});sel.value=state.file}\n var list=$('list');list.textContent='';\n var shown=F.filter(function(f){return (state.cat==='all'||f.cat===state.cat)&&(state.file==='all'||f.file===state.file)});\n $('listhead').textContent=state.done&&!state.error?'Findings'+(state.file==='all'?'':' - '+state.file)+' ('+shown.length+')':'';\n if(state.error){var e=h('li','item');e.appendChild(h('p','err','Could not read the project: '+state.error));e.appendChild(h('p',null,'This extension needs the project.read permission. Check Settings > Extensions.'));list.appendChild(e)}\n else if(state.done&&!state.files.length){list.appendChild(h('li','item empty','No HTML files in the open project.'))}\n else if(state.done&&!shown.length){list.appendChild(h('li','item empty',F.length?'No findings in this filter.':'No findings in '+state.files.length+' file'+(state.files.length===1?'':'s')+'. That does not mean the pages are accessible; see the limits below.'))}\n shown.slice(0,300).forEach(function(f){\n  var li=h('li','item'),hd=h('div','head');\n  hd.appendChild(h('span','badge '+f.sev,f.sev==='error'?'Error':'Notice'));\n  hd.appendChild(h('span','title',f.title));li.appendChild(hd);\n  li.appendChild(h('div','where',f.file+(f.lineList?' (lines '+f.lineList.join(', ')+')':f.line?' (line '+f.line+')':'')));\n  if(f.el)li.appendChild(h('code','el',f.el));\n  var d=h('details');d.appendChild(h('summary',null,'Why it matters and how to fix'));d.appendChild(h('p',null,f.why));d.appendChild(h('p',null,'Fix: '+f.fix));li.appendChild(d);\n  list.appendChild(li);\n });\n if(shown.length>300)list.appendChild(h('li','note','Showing the first 300 of '+shown.length+' findings. Use the filters to narrow down.'));\n var sn=$('skipnote');sn.hidden=!state.skipped.length;sn.textContent='';\n if(state.skipped.length){sn.appendChild(h('div',null,'Notes:'));state.skipped.slice(0,8).forEach(function(s){sn.appendChild(h('div',null,'- '+s))});if(state.skipped.length>8)sn.appendChild(h('div',null,'- and '+(state.skipped.length-8)+' more'))}\n $('stamp').textContent=state.stamp?'Snapshot at '+state.stamp+' \\u00b7 refresh manually':'Snapshot \\u00b7 refresh manually';\n}\n$('run').onclick=scan;$('file').onchange=function(){state.file=this.value;render()};\nrender();scan();\n})();\n</script>"
      }
    ]
  }
}
