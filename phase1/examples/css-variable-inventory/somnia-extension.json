{
  "id": "somnia.css-variable-inventory",
  "name": "CSS Variable Inventory",
  "version": "1.0.0",
  "apiVersion": 1,
  "permissions": [
    "project.read"
  ],
  "contributes": {
    "panels": [
      {
        "id": "inventory",
        "title": "CSS Variable Inventory",
        "side": "right",
        "html": "<style>\n*{box-sizing:border-box}\nbody{color:#1f2430;line-height:1.35;min-width:220px}\nbutton,input{font:inherit;color:inherit}\n.bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}\n.bar small{color:#5b6475;flex:1 1 120px;min-width:0}\n.btn{border:1px solid #c9cdd8;background:#fff;border-radius:999px;padding:4px 12px;cursor:pointer}\n.btn:hover{background:#f1f2f6}\n.btn:focus-visible,.row:focus-visible,input:focus-visible{outline:2px solid #4338ca;outline-offset:1px}\n.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:10px}\n.card{background:#f1f2f6;border-radius:10px;padding:8px 10px}\n.card b{display:block;font-size:20px;line-height:1.1}\n.card.cm b{color:#b3261e}.card.cu b{color:#8a5a00}\n.chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}\n.chip{border:1px solid #c9cdd8;background:#fff;border-radius:999px;padding:3px 10px;cursor:pointer}\n.chip[aria-pressed=true]{background:#4338ca;border-color:#4338ca;color:#fff}\ninput[type=search]{width:100%;border:1px solid #c9cdd8;border-radius:8px;padding:5px 8px;margin-bottom:8px;background:#fff}\n.head,.row{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr) 3.2em 4.6em;grid-template-areas:\"t v u s\";gap:6px;align-items:center}\n.head{font-size:12px;color:#5b6475;padding:0 6px 4px;border-bottom:1px solid #e3e5ec}\n.row{width:100%;text-align:left;background:none;border:0;border-bottom:1px solid #eef0f4;padding:6px;cursor:pointer;border-radius:6px}\n.row:hover{background:#f6f7fa}\n.row[aria-expanded=true]{background:#eef0ff}\n.t{grid-area:t;font-family:ui-monospace,Consolas,monospace;font-size:12px;overflow-wrap:anywhere;display:flex;gap:6px;align-items:center}\n.v{grid-area:v;font-family:ui-monospace,Consolas,monospace;font-size:12px;overflow-wrap:anywhere}\n.u{grid-area:u}.s{grid-area:s;font-size:12px;font-weight:600}\n.s.ok{color:#0b6b4f}.s.missing,.v.missing{color:#b3261e}.s.unused{color:#8a5a00}\n.sw{flex:none;width:12px;height:12px;border-radius:3px;border:1px solid rgba(0,0,0,.35)}\n.det{margin:4px 0 8px;border:1px solid #d9dcf5;border-radius:8px;padding:8px 10px;background:#fff;font-size:12px}\n.det h4{margin:6px 0 2px;font-size:12px;color:#5b6475}.det h4:first-child{margin-top:0}\n.det code{font-family:ui-monospace,Consolas,monospace;overflow-wrap:anywhere}\n.det ul{margin:0;padding:0;list-style:none}.det li{padding:1px 0}\n.more{border:0;background:none;color:#4338ca;cursor:pointer;padding:2px 0;text-decoration:underline}\n.empty,.err{padding:10px;border-radius:8px;background:#f1f2f6}.err{background:#fdecea;color:#7a1c14}\n.note{margin-top:12px;font-size:12px;color:#5b6475;border-top:1px solid #e3e5ec;padding-top:8px}\n@media(max-width:340px){.head{display:none}.row{grid-template-columns:minmax(0,1fr) auto auto;grid-template-areas:\"t t t\" \"v u s\"}.cards{gap:6px}.card{padding:6px 8px}}\n</style>\n<div class=\"bar\"><button class=\"btn\" id=\"rf\">Refresh</button><small id=\"st\" role=\"status\">Scanning...</small></div>\n<div id=\"out\"></div>\n<p class=\"note\">Static scan of CSS, SCSS, Less, style blocks and style attributes. It does not model the cascade, scopes, @media or @supports, so a token defined in several places is listed once with its first value. Variables set or read from JavaScript are not seen: check \"unused\" before you delete anything.</p>\n<script>\n(()=>{\nconst $=s=>document.querySelector(s);\nconst h=(t,c,x)=>{const e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e;};\nconst FILE=/\\.(css|scss|less|html?|svg)$/i,SKIP=/(^|\\/)(node_modules|\\.git)\\/|\\.min\\./i,MAXF=400,MAXB=1500000;\nconst blank=s=>s.replace(/\\/\\*[\\s\\S]*?\\*\\//g,m=>m.replace(/[^\\n]/g,' '));\nconst blankH=s=>s.replace(/<!--[\\s\\S]*?-->/g,m=>m.replace(/[^\\n]/g,' '));\nconst mkLine=t=>{const nl=[];for(let i=0;i<t.length;i++)if(t.charCodeAt(i)===10)nl.push(i);return o=>{let a=0,b=nl.length;while(a<b){const m=(a+b)>>1;if(nl[m]<o)a=m+1;else b=m;}return a+1;};};\nfunction readVal(c,s){let d=0,q='',i=s;for(;i<c.length;i++){const ch=c[i];if(q){if(ch==='\\\\')i++;else if(ch===q)q='';continue;}if(ch==='\"'||ch===\"'\")q=ch;else if(ch==='(')d++;else if(ch===')')d--;else if((ch===';'||ch==='}')&&d<=0)break;}\n return c.slice(s,i).replace(/!important\\s*$/i,'').replace(/\\s+/g,' ').trim().slice(0,300);}\nfunction scan(css,off,file,ln,out){let m;\n const U=/var\\(\\s*(--[\\w-]+)\\s*(,?)/g;while((m=U.exec(css)))out.uses.push({n:m[1],f:file,l:ln(off+m.index),fb:!!m[2]});\n const D=/(^|[;{}\\s])(--[\\w-]+)\\s*:/g;\n while((m=D.exec(css))){const s=m.index+m[0].length;out.defs.push({n:m[2],v:readVal(css,s),f:file,l:ln(off+m.index+m[1].length)});D.lastIndex=s;}\n const P=/@property\\s+(--[\\w-]+)\\s*\\{([^}]*)\\}/g;\n while((m=P.exec(css))){const iv=/initial-value\\s*:\\s*([^;]*)/.exec(m[2]);out.defs.push({n:m[1],v:iv?iv[1].trim():'@property',f:file,l:ln(m.index)});}}\nfunction scanFile(path,text,out){\n if(/\\.(html?|svg)$/i.test(path)){\n  const src=blankH(text),ln=mkLine(src),doc=new DOMParser().parseFromString(text,'text/html');\n  const tags=[];const T=/<style\\b[^>]*>/gi;let m;while((m=T.exec(src)))tags.push(m.index+m[0].length);\n  doc.querySelectorAll('style').forEach((el,i)=>{const t=el.textContent||'';scan(blank(t),tags[i]==null?0:tags[i],path,tags[i]==null?()=>1:ln,out);});\n  let cur=0;doc.querySelectorAll('[style]').forEach(el=>{const a=el.getAttribute('style')||'';if(a.indexOf('--')<0&&a.indexOf('var(')<0)return;\n   const at=src.indexOf(a,cur);if(at>=0)cur=at;scan(blank(a),Math.max(at,0),path,at>=0?ln:()=>1,out);});\n }else{let t=text;if(/\\.(scss|less)$/i.test(path))t=t.replace(/(^|[^:\\w])\\/\\/[^\\n]*/g,'$1');t=blank(t);scan(t,0,path,mkLine(t),out);}}\nfunction analyse(out){const M=new Map();\n const get=n=>{let e=M.get(n);if(!e){e={n,defs:[],uses:[]};M.set(n,e);}return e;};\n out.defs.forEach(d=>get(d.n).defs.push(d));out.uses.forEach(u=>get(u.n).uses.push(u));\n const list=[...M.values()];\n list.forEach(e=>{e.st=e.defs.length?(e.uses.length?'ok':'unused'):'missing';e.col=colorOf(M,e.n);});\n const rank={missing:0,unused:1,ok:2};list.sort((a,b)=>rank[a.st]-rank[b.st]||(a.n<b.n?-1:1));return list;}\nfunction colorOf(M,n){let v='',seen=0;for(let k=n;seen<6;seen++){const e=M.get(k);if(!e||!e.defs.length)return null;v=e.defs[0].v;const m=/^var\\(\\s*(--[\\w-]+)\\s*(?:,[^)]*)?\\)$/.exec(v);if(!m)break;k=m[1];}\n if(!v||/var\\(/.test(v)||/^(inherit|initial|unset|revert|revert-layer|currentcolor|transparent)$/i.test(v))return null;\n return window.CSS&&CSS.supports&&CSS.supports('color',v)?v:null;}\nlet all=[],filter='all',q='',open='',info='';\nconst FL=[['all','All'],['missing','Missing'],['unused','Unused'],['color','Colors']];\nconst clip=x=>x.length>48?x.slice(0,47)+'\\u2026':x;\nfunction loc(o){return o.l?o.f+':'+o.l:o.f;}\nfunction listBox(title,items,fmt){const box=document.createDocumentFragment();box.append(h('h4','',title));const ul=h('ul'),max=30;\n const add=(a,b)=>{for(let i=a;i<b&&i<items.length;i++){const li=h('li');li.append(fmt(items[i]));ul.append(li);}};\n add(0,max);box.append(ul);\n if(items.length>max){const b=h('button','more','+'+(items.length-max)+' more');b.onclick=()=>{b.remove();add(max,items.length);};box.append(b);}return box;}\nfunction detail(e){const d=h('div','det');\n if(e.defs.length)d.append(listBox('Defined in',e.defs,x=>{const c=h('code','',loc(x)+'  ');c.append(document.createTextNode('= '+(x.v||'(empty)')));return c;}));\n else d.append(h('h4','','Not defined in the scanned files'));\n if(e.uses.length)d.append(listBox('Used in',e.uses,x=>h('code','',loc(x)+(x.fb?'  (has fallback)':''))));\n else d.append(h('h4','','Never used with var()'));return d;}\nfunction render(){const out=$('#out');out.textContent='';\n if(info){out.append(h('div',/permission|read/i.test(info)?'err':'empty',info));return;}\n if(!all.length){out.append(h('div','empty','No CSS custom properties found. Add --name: value declarations or var(--name) uses to a CSS, HTML, SCSS or Less file, then press Refresh.'));return;}\n const cnt=k=>all.filter(e=>k==='defined'?e.defs.length:e.st===k).length;\n const cards=h('div','cards');[['defined','defined',''],['missing','missing','cm'],['unused','unused','cu']].forEach(([k,l,c])=>{const d=h('div','card '+c);d.append(h('b','',String(cnt(k))),h('span','',l));cards.append(d);});out.append(cards);\n const chips=h('div','chips');chips.setAttribute('role','group');chips.setAttribute('aria-label','Filter tokens');\n FL.forEach(([k,l])=>{const b=h('button','chip',l);b.setAttribute('aria-pressed',String(filter===k));b.onclick=()=>{filter=k;render();};chips.append(b);});out.append(chips);\n const s=h('input');s.type='search';s.placeholder='Filter by name or value';s.setAttribute('aria-label','Filter by name or value');s.value=q;\n s.oninput=()=>{q=s.value;const p=s.selectionStart;render();const n=$('#out input');n.focus();n.setSelectionRange(p,p);};out.append(s);\n const rows=all.filter(e=>(filter==='all'||(filter==='color'?e.col:e.st===filter))&&(!q||(e.n+' '+(e.defs[0]?e.defs[0].v:'')).toLowerCase().includes(q.toLowerCase())));\n if(!rows.length){out.append(h('div','empty','No tokens match.'));return;}\n const hd=h('div','head');['Token','Value','Uses',''].forEach(x=>hd.append(h('span','',x)));out.append(hd);\n rows.forEach(e=>{const r=h('button','row');r.setAttribute('aria-expanded',String(open===e.n));\n  const t=h('span','t');if(e.col){const w=h('i','sw');w.style.background=e.col;w.setAttribute('aria-hidden','true');t.append(w);}t.append(document.createTextNode(e.n));\n  const v=h('span','v'+(e.defs.length?'':' missing'),e.defs.length?clip(e.defs[0].v||'(empty)')+(e.defs.length>1?'  x'+e.defs.length:''):'undefined');\n  r.append(t,v,h('span','u',String(e.uses.length)),h('span','s '+e.st,e.st==='ok'?'ok':e.st));\n  r.onclick=()=>{open=open===e.n?'':e.n;render();};out.append(r);\n  if(open===e.n)out.append(detail(e));});}\nasync function run(){$('#st').textContent='Scanning...';info='';\n try{const files=(await somnia.project.listFiles()).filter(f=>FILE.test(f)&&!SKIP.test(f)).slice(0,MAXF);const out={defs:[],uses:[]};let skipped=0;\n  for(const f of files){const t=await somnia.project.readFile(f);if(t.length>MAXB){skipped++;continue;}scanFile(f,t,out);}\n  all=analyse(out);$('#st').textContent=files.length-skipped+' files, '+all.length+' tokens, '+new Date().toLocaleTimeString()+(skipped?', '+skipped+' too large':'');\n }catch(e){all=[];info='Could not read the project: '+(e&&e.message?e.message:e)+(/permission/i.test(String(e&&e.message))?' Enable it in Settings > Extensions.':'');$('#st').textContent='Scan failed';}\n render();}\n$('#rf').onclick=run;run();\n})();\n</script>"
      }
    ]
  }
}
