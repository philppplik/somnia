{
  "id": "somnia.local-link-check",
  "name": "Local Link & Asset Check",
  "version": "1.0.0",
  "apiVersion": 1,
  "permissions": [
    "project.read"
  ],
  "contributes": {
    "panels": [
      {
        "id": "audit",
        "title": "Local Link & Asset Check",
        "side": "right",
        "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Local Link & Asset Check</title><style>*{box-sizing:border-box}body{margin:0;padding:12px;background:#f8f9fb;color:#202126;font:13px/1.5 system-ui,sans-serif}header,.card{background:white;border-radius:25px;padding:18px;margin-bottom:12px}h1{font-size:21px;line-height:1.2;margin:6px 0 10px;letter-spacing:-.5px}p{margin:8px 0;color:#606574}.eyebrow{font-size:10px;letter-spacing:.08em;color:#727684;text-transform:uppercase}button,select{font:inherit;border:1px solid #d9dbe4;border-radius:16px;padding:8px 11px;max-width:100%;background:#fff;color:#292d37}button{cursor:pointer}button.primary{background:#5040e9;color:white;border:0}button:disabled{opacity:.6;cursor:wait}:focus-visible{outline:3px solid #6255ef;outline-offset:3px}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:14px 0}.metric{border-radius:17px;background:#f8f9fb;padding:10px;overflow-wrap:anywhere}.metric b{display:block;font-size:22px}.metric span{font-size:11px;color:#616674}.filters{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}label{display:flex;flex-direction:column;gap:4px;min-width:110px;flex:1;font-size:11px;color:#606574}.row{border:1px solid #e6e7ef;border-radius:17px;padding:12px;margin:8px 0;overflow-wrap:anywhere}.row strong{display:block}.meta{font:11px/1.5 ui-monospace,monospace;color:#606574;white-space:pre-wrap}.badge{display:inline-block;background:#eeecff;color:#4933d9;border-radius:8px;padding:2px 7px;font-size:11px;margin-bottom:5px}.missing,.issue{background:#fff3e8;color:#884306}.unchecked{background:#f0f1f5;color:#515661}.detail{font-size:12px;color:#606574;margin-top:5px}.empty{text-align:center;padding:18px;color:#606574}footer{font-size:11px;color:#656a77;padding:0 6px 14px}#status{overflow-wrap:anywhere}.outline .row{border:0;border-bottom:1px solid #ececf2;border-radius:0;padding:10px 0}.outline .badge{margin-right:7px}.outline strong{display:inline;font-weight:500}.error{color:#923d19} @media(max-width:300px){header,.card{padding:13px}.metrics{grid-template-columns:1fr}.metric{display:flex;align-items:center;gap:9px}.metric b{font-size:19px}}</style></head><body><header><div class=\"eyebrow\">Code studio / project snapshot</div><h1>Local Link & Asset Check</h1><p>Resolve local references. External and dynamic targets stay unchecked.</p><button id=\"refresh\" class=\"primary\" type=\"button\">Refresh snapshot \u21bb</button><div class=\"metrics\"><div class=\"metric\"><b id=\"m1\">0</b><span>Missing</span></div><div class=\"metric\"><b id=\"m2\">0</b><span>Local references</span></div><div class=\"metric\"><b id=\"m3\">0</b><span>Unchecked</span></div></div><p id=\"status\" role=\"status\" aria-live=\"polite\">Ready</p></header><section class=\"card\"><div class=\"filters\"><label>File<select id=\"file\"><option value=\"\">All files</option></select></label><label>Status<select id=\"kind\"><option value=\"\">All references</option><option value=\"missing\">Missing</option><option value=\"ok\">Found</option><option value=\"unchecked\">Unchecked</option></select></label></div><div id=\"results\" class=\"\"></div></section><footer>Case-sensitive snapshot paths. Root-relative paths use the project root. No HTTP checks, directory-index guesses or deployment rewrites.<br>Read only \u00b7 Offline \u00b7 Unsaved editor text included \u00b7 Refresh manually</footer><script>const $=id=>document.getElementById(id);const text=(tag,value,cls)=>{const e=document.createElement(tag);e.textContent=value;if(cls)e.className=cls;return e};let records=[],files=[];const htmlFile=p=>/\\.html?$/i.test(p);function metric(id,n){$(id).textContent=String(n)}function options(id,values){const old=$(id).value;$(id).replaceChildren(new Option('All files',''),...values.map(v=>new Option(v,v)));if(values.includes(old))$(id).value=old}function filtered(){return records.filter(r=>!$('file').value||r.file===$('file').value)}async function refresh(){ $('refresh').disabled=true;$('status').className='';$('status').textContent='Reading project snapshot\u2026';records=[];render();try{files=await somnia.project.listFiles();options('file',files.filter(htmlFile));await analyze();render();$('status').textContent='Snapshot updated \u00b7 '+files.filter(htmlFile).length+' HTML files';}catch(e){records=[];render();$('status').className='error';$('status').textContent='Could not read the snapshot. Enable project.read and try again. '+String(e.message||e)}finally{$('refresh').disabled=false}}$('refresh').addEventListener('click',refresh);$('file').addEventListener('change',render);$('kind').addEventListener('change',render);\n// URL resolution uses a synthetic project root, never a network request.\nconst origin='https:'+ '//snapshot.invalid';\nconst docURL=p=>new URL(p.split('/').map(encodeURIComponent).join('/'),origin+'/');\nconst dynamic=v=>/\\{\\{|\\}\\}|<%|%>|\\$\\{|[<>]|\\\\/.test(v);\nfunction candidates(value){ // srcset tokenization: commas inside data URLs are URL characters.\n const out=[];let i=0;while(i<value.length){while(/[\\s,]/.test(value[i]||'')&&i<value.length)i++;if(i>=value.length)break;let url='';while(i<value.length&&!/\\s/.test(value[i]))url+=value[i++];if(url.endsWith(',')){out.push({url:url.replace(/,+$/,''),valid:true});continue}let d='',depth=0;while(i<value.length){const c=value[i++];if(c==='(')depth++;if(c===')')depth--;if(c===','&&depth===0)break;d+=c}const tokens=d.trim().split(/\\s+/).filter(Boolean);let w=false,x=false,h=false,valid=true;for(const t of tokens){if(/^[1-9]\\d*w$/.test(t)&&!w&&!x)w=true;else if(/^(?:\\d+(?:\\.\\d+)?|\\.\\d+)x$/.test(t)&&Number(t.slice(0,-1))>0&&!w&&!x&&!h)x=true;else if(/^[1-9]\\d*h$/.test(t)&&!h&&!x)h=true;else valid=false}if(h&&!w)valid=false;out.push({url,valid})}return out;\n}\nasync function analyze(){const paths=new Set(files);const docs=new Map();for(const f of files.filter(htmlFile))docs.set(f,new DOMParser().parseFromString(await somnia.project.readFile(f),'text/html'));\n async function resolve(file,raw,base,attr,element,valid=true,externalBase=false){const r={file,raw,attr,element,status:'unchecked',message:'',target:''};records.push(r);if(!valid){r.message='Invalid srcset descriptor; not checked';return}if(dynamic(raw)||dynamic(base)){r.message='Dynamic or ambiguous target; not checked';return}if(externalBase||/^[a-z][a-z0-9+.-]*:|^\\/\\//i.test(raw)){r.message='External URL or scheme; no network checks';return}let u;try{u=new URL(raw,base)}catch{r.message='Invalid URL; not checked';return}if(u.origin!==origin){r.message='External URL or scheme; no network checks';return}let path;try{if(/%2f|%5c/i.test(u.pathname))throw Error();path=decodeURIComponent(u.pathname.slice(1));}catch{r.message='Ambiguous percent-encoded path; not checked';return}r.target=path;let fragment;try{fragment=decodeURIComponent(u.hash.slice(1))}catch{r.message='Invalid fragment encoding; not checked';return}if(!paths.has(path)){if(!path||path.endsWith('/')||!/(?:^|\\/)[^/]+\\.[^/]+$/.test(path)){r.message='Directory or server route absent from snapshot; not checked';return}r.status='missing';r.message='File not found in project snapshot';return}if(!fragment){r.status='ok';r.message='File exists in snapshot';return}if(fragment.includes(':~:text=')){r.message='Browser text fragment; not checked';return}if(!htmlFile(path)&&!/\\.svg$/i.test(path)){r.message='File exists; fragment type not checked';return}let doc=docs.get(path);if(!doc){doc=new DOMParser().parseFromString(await somnia.project.readFile(path),'image/svg+xml');if(doc.querySelector('parsererror')){r.message='SVG could not be parsed; fragment not checked';return}docs.set(path,doc)}const found=Array.from(doc.querySelectorAll('[id],a[name]')).some(el=>el.getAttribute('id')===fragment||(el.localName==='a'&&el.getAttribute('name')===fragment));r.status=found?'ok':'missing';r.message=found?'Fragment exists in snapshot':'Fragment not found in target file';r.target+=' #'+fragment;\n }\n for(const [file,doc] of Array.from(docs).filter(([f])=>htmlFile(f))){let base=docURL(file).href,externalBase=false;const baseEl=doc.querySelector('base[href]');if(baseEl){const v=baseEl.getAttribute('href');externalBase=/^[a-z][a-z0-9+.-]*:|^\\/\\//i.test(v.trim());if(dynamic(v))base=v;else try{base=new URL(v,base).href}catch{base=v}}let n=0;for(const el of doc.querySelectorAll('[href],[src],[srcset]')){n++;if(el.localName==='base')continue;for(const attr of ['href','src','srcset'])if(el.hasAttribute(attr)){const raw=el.getAttribute(attr);if(attr==='srcset'){for(const c of candidates(raw))await resolve(file,c.url,base,attr,el.localName+'['+n+']',c.valid,externalBase)}else await resolve(file,raw.trim(),base,attr,el.localName+'['+n+']',true,externalBase)}}}\n}\nfunction render(){metric('m1',records.filter(r=>r.status==='missing').length);metric('m2',records.filter(r=>r.status!=='unchecked').length);metric('m3',records.filter(r=>r.status==='unchecked').length);const list=$('results');list.replaceChildren();const rows=filtered().filter(r=>!$('kind').value||r.status===$('kind').value);for(const r of rows){const item=text('article','', 'row');item.append(text('span',r.status==='missing'?'Missing':r.status==='ok'?'Found':'Unchecked','badge '+r.status),text('strong',r.message),text('div',r.file+' \u00b7 '+r.element,'meta'),text('div',r.attr+': '+r.raw,'meta'));if(r.target)item.append(text('div','Target: '+r.target,'detail'));list.append(item)}if(!rows.length)list.append(text('div','No references match these filters.','empty'))}\nrefresh();</script></body></html>"
      }
    ]
  }
}
