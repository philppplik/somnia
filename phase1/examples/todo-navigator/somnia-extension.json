{
  "id": "somnia.todo-navigator",
  "name": "TODO Navigator",
  "version": "1.0.0",
  "apiVersion": 1,
  "permissions": [
    "project.read",
    "storage"
  ],
  "contributes": {
    "panels": [
      {
        "id": "navigator",
        "title": "TODO Navigator",
        "side": "right",
        "html": "<style>\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0}\nbody{padding:12px;color:#18181b;font:13px/1.45 \"Segoe UI\",system-ui,Arial,sans-serif;background:transparent}\nbutton,input,select{font:inherit;color:inherit}\nbutton{border:0;cursor:pointer}\nbutton:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid #4f46e5;outline-offset:2px}\n.head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px}\nh1{margin:0;font-size:18px;font-weight:650;letter-spacing:-.3px}\n.primary{background:#4f46e5;color:#fff;border-radius:18px;padding:6px 13px;font-size:12px}\n.primary:hover{background:#4338ca}\n.primary[disabled]{opacity:.6;cursor:default}\n.intro{margin:6px 0 12px;color:#52525a;font-size:12px}\n.chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}\n.chip{border-radius:16px;padding:5px 11px;background:#e9e9f0;color:#3f3f46;font-size:11px;white-space:nowrap}\n.chip[aria-pressed=true]{background:#e0ddfb;color:#3730a3;font-weight:600}\n.row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px}\n.row label{display:flex;flex-direction:column;gap:2px;font-size:11px;color:#52525a;flex:1 1 120px;min-width:0}\n.row input,.row select{width:100%;border:1px solid #c9c9d3;border-radius:8px;padding:6px 8px;background:#fff;font-size:12px;min-width:0}\nh2{margin:14px 0 6px;font-size:11px;font-weight:600;letter-spacing:.02em;color:#3f3f46;overflow-wrap:anywhere}\n.list{list-style:none;margin:0;padding:0}\n.item{border:1px solid #e1e1ea;border-radius:12px;padding:8px 11px;margin-bottom:7px;background:#fff}\n.msg{display:flex;gap:8px;align-items:flex-start}\n.msg span.t{overflow-wrap:anywhere;min-width:0}\n.badge{flex:none;font-size:10px;font-weight:700;border-radius:10px;padding:2px 8px;margin-top:2px}\n.TODO{background:#e3e1fb;color:#3730a3}\n.FIXME{background:#fde4e4;color:#991b1b}\n.HACK{background:#fff0d9;color:#7a4a00}\n.owner{color:#52525a}\n.loc{margin:3px 0 0;font:11px/1.5 Consolas,\"Courier New\",monospace;color:#52525a;overflow-wrap:anywhere}\n.count{font-size:11px;color:#52525a;margin:0 0 6px}\n.empty,.err{padding:10px 12px;border-radius:10px;font-size:12px}\n.empty{background:#f1f2f6;color:#3f3f46}\n.err{background:#fdecec;color:#991b1b;margin-bottom:8px}\n.rules{margin-top:14px;background:#f1f2f6;border-radius:12px;padding:10px 12px;font-size:12px}\n.rules summary{cursor:pointer;font-weight:600}\n.rules summary:focus-visible{outline:2px solid #4f46e5;outline-offset:2px}\n.rules ul{margin:8px 0 0;padding-left:18px}\n.rules li{margin:3px 0}\n.note{margin-top:14px;padding-top:8px;border-top:1px solid #e6e6ee;font-size:11px;color:#52525a;display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 10px}\n</style>\n<div class=\"head\"><h1>TODO Navigator</h1><button id=\"scan\" class=\"primary\" type=\"button\">Rescan &#8635;</button></div>\n<p class=\"intro\">TODO, FIXME and HACK comments in HTML, CSS, JS and Markdown files.</p>\n<div id=\"err\" role=\"alert\" hidden></div>\n<div class=\"chips\" id=\"chips\" role=\"group\" aria-label=\"Filter by type\"></div>\n<div class=\"row\">\n <label>Search<input id=\"q\" type=\"search\" placeholder=\"Search comments\"></label>\n <label>Group by<select id=\"g\"><option value=\"file\">File</option><option value=\"type\">Type</option><option value=\"none\">No grouping</option></select></label>\n</div>\n<p class=\"count\" id=\"count\" role=\"status\" aria-live=\"polite\"></p>\n<div id=\"out\"></div>\n<details class=\"rules\"><summary>What is collected</summary><ul id=\"rules\"></ul></details>\n<div class=\"note\"><span>Read-only &middot; Offline &middot; Changes nothing</span><span id=\"status\" role=\"status\" aria-live=\"polite\">Not scanned yet</span></div>\n<script>\n(()=>{\n'use strict';\nconst KEY='filter',MAX_FILES=500,MAX_BYTES=1500000,MAX_ITEMS=1000;\nconst TYPES=['TODO','FIXME','HACK'];\nconst F={type:'all',group:'file',query:''};\nlet items=null;\nconst $=id=>document.getElementById(id);\nfunction h(tag,cls,...kids){const e=document.createElement(tag);if(cls)e.className=cls;for(const k of kids.flat()){if(k==null)continue;e.append(typeof k==='object'?k:document.createTextNode(String(k)));}return e;}\nconst MARK=/(?:^|[^A-Za-z0-9_])(TODO|FIXME|HACK)\\b(?:\\(([^)]*)\\))?[\\s:\\-\\u2013\\u2014]*(.*)$/;\n/* Approximate comment finders. They return [start,end] ranges of comment text. Strings end at a line break, so a stray quote in a regex cannot hide the rest of a file. */\nfunction jsComments(s,from,to,out){\n let i=from;\n while(i<to){const c=s[i],d=s[i+1];\n  if(c==='/'&&d==='/'){let e=s.indexOf('\\n',i);if(e<0||e>to)e=to;out.push([i+2,e]);i=e;}\n  else if(c==='/'&&d==='*'){let e=s.indexOf('*/',i+2);if(e<0||e>to)e=to;out.push([i+2,e]);i=e+2;}\n  else if(c==='\"'||c===\"'\"){i++;while(i<to&&s[i]!==c&&s[i]!=='\\n'){if(s[i]==='\\\\')i++;i++;}i++;}\n  else if(c==='`'){i++;while(i<to&&s[i]!=='`'){if(s[i]==='\\\\')i++;i++;}i++;}\n  else i++;}\n}\nfunction cssComments(s,from,to,out){\n let i=from;\n while(i<to){const c=s[i];\n  if(c==='/'&&s[i+1]==='*'){let e=s.indexOf('*/',i+2);if(e<0||e>to)e=to;out.push([i+2,e]);i=e+2;}\n  else if(c==='\"'||c===\"'\"){i++;while(i<to&&s[i]!==c&&s[i]!=='\\n'){if(s[i]==='\\\\')i++;i++;}i++;}\n  else i++;}\n}\nfunction htmlComments(s,out){\n const re=/<!--|<script\\b[^>]*>|<style\\b[^>]*>/gi;let m;\n while((m=re.exec(s))){\n  const tok=m[0].toLowerCase();\n  if(tok==='<!--'){let e=s.indexOf('-->',re.lastIndex);if(e<0)e=s.length;out.push([re.lastIndex,e]);re.lastIndex=e+3;}\n  else{const isScript=tok.startsWith('<script');const close=isScript?'</script':'</style';\n   let e=s.toLowerCase().indexOf(close,re.lastIndex);if(e<0)e=s.length;\n   const type=(/\\btype\\s*=\\s*[\"']?([^\"'\\s>]+)/i.exec(m[0])||[])[1]||'';\n   if(!isScript)cssComments(s,re.lastIndex,e,out);\n   else if(!type||/javascript|ecmascript|module/i.test(type))jsComments(s,re.lastIndex,e,out);\n   re.lastIndex=e;}\n }\n}\nfunction collect(file,src){\n const ext=(/\\.([a-z0-9]+)$/i.exec(file)||[])[1].toLowerCase();\n const starts=[0];for(let i=0;i<src.length;i++)if(src.charCodeAt(i)===10)starts.push(i+1);\n const lineAt=pos=>{let lo=0,hi=starts.length-1;while(lo<hi){const mid=(lo+hi+1)>>1;if(starts[mid]<=pos)lo=mid;else hi=mid-1;}return lo+1;};\n const ranges=[];\n if(ext==='md'||ext==='markdown')ranges.push([0,src.length]);\n else if(ext==='css')cssComments(src,0,src.length,ranges);\n else if(ext==='js'||ext==='mjs'||ext==='cjs')jsComments(src,0,src.length,ranges);\n else htmlComments(src,ranges);\n const out=[];\n for(const [a,b] of ranges){\n  let pos=a;\n  for(const raw of src.slice(a,b).split('\\n')){\n   const m=MARK.exec(raw);\n   if(m){let msg=m[3].replace(/\\s*(\\*\\/|-->)\\s*$/,'').replace(/^\\*+\\s*/,'').trim();\n    out.push({type:m[1],file,line:lineAt(pos),owner:m[2]?m[2].trim():'',msg:msg.length>200?msg.slice(0,199)+'\\u2026':msg||'(no description)'});}\n   pos+=raw.length+1;\n  }\n }\n return out;\n}\nfunction showError(msg){const e=$('err');e.className='err';e.hidden=!msg;e.textContent=msg||'';}\nasync function loadFilter(){\n try{const raw=await somnia.storage.get(KEY);if(!raw)return;const o=JSON.parse(raw);\n  if(o.type==='all'||TYPES.includes(o.type))F.type=o.type;\n  if(['file','type','none'].includes(o.group))F.group=o.group;\n  if(typeof o.query==='string')F.query=o.query.slice(0,100);\n }catch(e){/* storage missing or revoked: defaults apply */}\n}\nasync function saveFilter(){try{await somnia.storage.set(KEY,JSON.stringify(F));}catch(e){showError('Filter was not saved: '+(e&&e.message||e));}}\nfunction rules(){\n const ul=$('rules');ul.textContent='';\n ['Files: .html, .htm, .css, .js, .mjs, .cjs, .md and .markdown, including unsaved edits.',\n  'Markers: the uppercase words TODO, FIXME and HACK, optionally followed by (owner) and a colon, at the start of a comment line or after a non-word character.',\n  'HTML, CSS and JS: only inside comments (<!-- -->, /* */, //). Comment finding is approximate, not a full parser.',\n  'Inline <script> and <style> blocks in HTML are checked for comments too. Scripts of the project never run.',\n  'Markdown: every line is checked, because Markdown has no comment syntax for notes.',\n  'Line numbers are the line where the marker appears, starting at 1.',\n  'Lowercase \"todo\" and words such as TODOS are ignored.'\n ].forEach(t=>ul.append(h('li',null,t)));\n}\nfunction visible(){\n const q=F.query.trim().toLowerCase();\n return items.filter(it=>(F.type==='all'||it.type===F.type)&&(!q||(it.msg+' '+it.owner+' '+it.file).toLowerCase().includes(q)));\n}\nfunction itemEl(it,showFile){\n const t=h('span','t',it.msg,it.owner?[' ',h('span','owner','('+it.owner+')')]:null);\n return h('li','item',h('div','msg',h('span','badge '+it.type,it.type),t),h('div','loc',it.file+':'+it.line));\n}\nfunction render(){\n $('g').value=F.group;$('q').value=F.query;\n const chips=$('chips');chips.textContent='';\n const out=$('out');out.textContent='';\n if(!items){return;}\n const counts={all:items.length};TYPES.forEach(t=>counts[t]=items.filter(i=>i.type===t).length);\n [['all','All'],...TYPES.map(t=>[t,t])].forEach(([k,l])=>{\n  const b=h('button','chip',l+' '+counts[k]);b.type='button';b.setAttribute('aria-pressed',String(F.type===k));\n  b.addEventListener('click',()=>{F.type=k;saveFilter();render();});chips.append(b);});\n const list=visible();\n $('count').textContent=items.length?('Showing '+list.length+' of '+items.length):'';\n if(!items.length){out.append(h('div','empty','No TODO, FIXME or HACK comments found.'));return;}\n if(!list.length){out.append(h('div','empty','Nothing matches this filter.'));return;}\n const shown=list.slice(0,MAX_ITEMS);\n const groups=new Map();\n shown.forEach(it=>{const k=F.group==='file'?it.file:F.group==='type'?it.type:'';if(!groups.has(k))groups.set(k,[]);groups.get(k).push(it);});\n const keys=[...groups.keys()];\n if(F.group==='type')keys.sort((a,b)=>TYPES.indexOf(a)-TYPES.indexOf(b));\n keys.forEach(k=>{\n  if(F.group!=='none')out.append(h('h2',null,k+' ('+groups.get(k).length+')'));\n  const ul=h('ul','list');groups.get(k).forEach(it=>ul.append(itemEl(it)));out.append(ul);});\n if(list.length>MAX_ITEMS)out.append(h('div','empty','Showing the first '+MAX_ITEMS+' results. Narrow the search to see more.'));\n}\nasync function scan(){\n const btn=$('scan');btn.disabled=true;showError('');$('status').textContent='Scanning\\u2026';\n try{\n  const all=await somnia.project.listFiles();\n  const files=all.filter(f=>/\\.(html?|css|m?js|cjs|md|markdown)$/i.test(f)).slice(0,MAX_FILES);\n  const found=[];let skipped=0;\n  for(const f of files){\n   const src=await somnia.project.readFile(f);\n   if(src.length>MAX_BYTES){skipped++;continue;}\n   found.push(...collect(f,src));\n   await new Promise(r=>setTimeout(r,0));\n  }\n  found.sort((a,b)=>a.file.localeCompare(b.file)||a.line-b.line);\n  items=found;render();\n  $('status').textContent='Scanned '+(files.length-skipped)+' file'+(files.length-skipped===1?'':'s')+(skipped?' ('+skipped+' too large, skipped)':'')+' at '+new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});\n }catch(e){showError('Scan failed: '+(e&&e.message||e));$('status').textContent='Scan failed';}\n finally{btn.disabled=false;}\n}\n$('scan').addEventListener('click',scan);\n$('q').addEventListener('input',e=>{F.query=e.target.value.slice(0,100);saveFilter();render();$('q').focus();});\n$('g').addEventListener('change',e=>{F.group=e.target.value;saveFilter();render();});\nrules();\nloadFilter().then(()=>{render();return scan();});\n})();\n</script>"
      }
    ]
  }
}
