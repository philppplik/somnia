//! Experimental headless adapter. No DOM, egui, filesystem or UI thread access.
use wasm_bindgen::prelude::*;
use std::sync::Arc;

/// Error carrier across the wasm boundary. Native test builds have no JS strings: `JsValue::from_str`
/// panics off wasm32, so native tests get an opaque marker instead. The `do_*` internals keep the message.
#[cfg(target_arch = "wasm32")]
fn js_err(msg: &str) -> JsValue { JsValue::from_str(msg) }
#[cfg(not(target_arch = "wasm32"))]
fn js_err(_msg: &str) -> JsValue { JsValue::NULL }
use wordcraft_doc::para::OBJ;
use wordcraft_doc::{Block, CharProps, Document, Pos, StoryRef};
use wordcraft_layout::{DocLayout, LayoutCache, LayoutOptions};

/// Block ids at or above this value address a paragraph inside a top-level table cell: `CELL_BASE + n` is the
/// n-th cell paragraph in document order (see `cell_paras`). Ids are recomputed from the document on every use,
/// so they are only stable until a table's structure changes; the host refreshes `blocks()` after every edit.
const CELL_BASE: usize = 1 << 20;
/// The block list names at most this many cell paragraphs (the rest stay read-only for the host).
const CELL_LIST_MAX: usize = 20_000;

/// A structural snapshot: the body (blocks are shared, not copied), the header/footer stories, the last section, media, comments, properties, styles and list definitions.
type Snap = (wordcraft_doc::Blocks, std::collections::BTreeMap<u32, wordcraft_doc::Part>, wordcraft_doc::SectionProps, std::collections::BTreeMap<String, Arc<Vec<u8>>>, std::collections::BTreeMap<u32, wordcraft_doc::Comment>, wordcraft_doc::CoreProps, wordcraft_doc::StyleSheet, wordcraft_doc::Numbering);
const COMMENT_MAX_CHARS: usize = 2000;
const SORT_MAX_PARAS: usize = 500;
const COVER_MAX_CHARS: usize = 120;
const BOOKMARK_MAX_NAME: usize = 40;
const BOOKMARK_MAX_COUNT: usize = 500;
const COMMENT_MAX_COUNT: usize = 500;
const PDF_MAX_PAGES: usize = 2000;
const PDF_MAX_BYTES: usize = 100 * 1024 * 1024;
const LINK_MAX_CHARS: usize = 2048;
const HF_MAX_CHARS: usize = 500;
/// Page sizes the page setup offers: name, portrait width and height in points.
const PAGE_SIZES: [(&str, f32, f32); 4] = [("a4", 595.3, 841.9), ("letter", 612.0, 792.0), ("legal", 612.0, 1008.0), ("a5", 419.5, 595.3)];
const IMG_MAX_BYTES: usize = 5 * 1024 * 1024;
const IMG_MAX_SIDE: u32 = 8000;
const IMG_MAX_PIXELS: u64 = 25_000_000;
const IMG_MAX_COUNT: usize = 200;
const IMG_MIN_PT: f32 = 10.0;
const IMG_MAX_PT: f32 = 2000.0;

/// Extension and pixel size of a PNG or JPEG, read from the file signature and header only (no decoding).
fn sniff_image(b: &[u8]) -> Result<(&'static str, u32, u32), String> {
    const PNG: [u8; 8] = [0x89, b'P', b'N', b'G', 0x0D, 0x0A, 0x1A, 0x0A];
    if b.len() >= 24 && b[..8] == PNG && &b[12..16] == b"IHDR" {
        let w = u32::from_be_bytes([b[16], b[17], b[18], b[19]]);
        let h = u32::from_be_bytes([b[20], b[21], b[22], b[23]]);
        return Ok(("png", w, h));
    }
    if b.len() >= 4 && b[0] == 0xFF && b[1] == 0xD8 {
        let mut i = 2usize;
        while i + 4 <= b.len() {
            if b[i] != 0xFF {
                return Err("the JPEG header is damaged".into());
            }
            let m = b[i + 1];
            if m == 0xFF {
                i += 1;
                continue;
            }
            if m == 0xD9 || m == 0xDA {
                break;
            }
            if m == 0x01 || (0xD0..=0xD7).contains(&m) {
                i += 2;
                continue;
            }
            let len = u16::from_be_bytes([b[i + 2], b[i + 3]]) as usize;
            if len < 2 {
                return Err("the JPEG header is damaged".into());
            }
            if (0xC0..=0xCF).contains(&m) && m != 0xC4 && m != 0xC8 && m != 0xCC {
                if i + 9 > b.len() {
                    break;
                }
                let h = u16::from_be_bytes([b[i + 5], b[i + 6]]) as u32;
                let w = u16::from_be_bytes([b[i + 7], b[i + 8]]) as u32;
                return Ok(("jpg", w, h));
            }
            i += 2 + len;
        }
        return Err("the JPEG has no readable size".into());
    }
    Err("only PNG and JPEG images can be inserted".into())
}

/// Media key, display size (points) and alt text of a paragraph that holds exactly one image and nothing else.
fn image_only(p: &wordcraft_doc::Paragraph) -> Option<(&str, f32, f32, &str)> {
    if p.text.as_str() != OBJ.to_string() {
        return None;
    }
    match p.objects.as_slice() {
        [wordcraft_doc::InlineObject::Image { media, w, h, alt, .. }] => Some((media.as_str(), *w, *h, alt.as_str())),
        _ => None,
    }
}

/// Distance between a floating picture and the text around it, points.
const IMG_WRAP_DIST: f32 = 10.0;
fn wrap_name(w: wordcraft_doc::para::Wrap) -> &'static str {
    use wordcraft_doc::para::Wrap;
    match w {
        Wrap::Inline => "inline",
        Wrap::Square | Wrap::Tight | Wrap::Through => "square",
        Wrap::TopAndBottom => "topAndBottom",
        Wrap::BehindText => "behind",
        Wrap::InFrontOfText => "front",
    }
}
/// Horizontal offset (from the column edge) of a floating picture `w` wide for `align`.
fn float_x(align: &str, text_w: f32, w: f32) -> f32 {
    match align {
        "right" => (text_w - w).max(0.0),
        "center" => ((text_w - w) / 2.0).max(0.0),
        _ => 0.0,
    }
}
/// Wrap mode and horizontal alignment of an image paragraph: a floating picture reads its offset, an inline one the paragraph alignment.
fn image_wrap_state(p: &wordcraft_doc::Paragraph, text_w: f32) -> (&'static str, &'static str) {
    use wordcraft_doc::InlineObject;
    match p.objects.first() {
        Some(InlineObject::Image { w, float, .. }) if float.wrap != wordcraft_doc::para::Wrap::Inline => {
            let free = (text_w - *w).max(0.0);
            let a = if free < 1.0 || float.x < free / 4.0 { "left" } else if float.x > free * 0.75 { "right" } else { "center" };
            (wrap_name(float.wrap), a)
        }
        _ => ("inline", match p.props.align { Some(wordcraft_doc::Align::Center) => "center", Some(wordcraft_doc::Align::Right) => "right", _ => "left" }),
    }
}

#[wasm_bindgen]
pub struct DocSession {
    doc: Document,
    cache: LayoutCache,
    pages: DocLayout,
    snaps: std::collections::HashMap<u32, Snap>,
    next_snap: u32,
    /// Red and blue squiggles under spelling and grammar issues (English word list).
    proofing: bool,
    /// Hidden text is drawn (dimmed by the layout) instead of skipped.
    show_hidden: bool,
    /// Paragraph, tab and space marks are drawn on the pages.
    show_marks: bool,
    /// Tracked changes are drawn as coloured markup (otherwise as plain text).
    show_markup: bool,
    /// Edits are recorded as tracked insertions and deletions by `track_author` at `track_date`.
    track: bool,
    track_author: String,
    track_date: String,
}

impl DocSession {
    fn from_bytes(bytes: &[u8]) -> Result<Self, String> {
        if bytes.len() > 16 * 1024 * 1024 {
            return Err("adapter input limit: 16 MiB".into());
        }
        let doc = wordcraft_docx::read(bytes).map_err(|e| e.to_string())?;
        Ok(Self { doc, cache: LayoutCache::new(), pages: DocLayout::default(), snaps: Default::default(), next_snap: 1, proofing: false, show_hidden: false, show_marks: false, show_markup: true, track: false, track_author: String::new(), track_date: String::new() })
    }
    fn do_insert(&mut self, block: usize, offset: usize, text: &str) -> Result<(), String> {
        if text.len() > 1024 * 1024 {
            return Err("adapter edit limit: 1 MiB".into());
        }
        self.doc.insert_text(&self.pos_of(block, offset), text, &CharProps::default()).map_err(|e| e.to_string())?;
        // Invalidate placed pages; paragraph cache is revision-aware upstream.
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Top-level body blocks. A paragraph is `editable` only when it has no inline objects
    /// (images, fields, equations, comment anchors), because their offsets are not text.
    /// How the section that follows each paragraph that ends a section starts (`nextPage`, `continuous`, ...), by body index.
    fn section_break_kinds(&self) -> std::collections::HashMap<usize, &'static str> {
        use wordcraft_doc::section::SectionStart as S;
        let name = |s: S| match s {
            S::NextPage => "nextPage",
            S::Continuous => "continuous",
            S::EvenPage => "evenPage",
            S::OddPage => "oddPage",
            S::NextColumn => "nextColumn",
        };
        let mut out = std::collections::HashMap::new();
        let mut next = self.doc.last_section.start;
        for (i, b) in self.doc.body.iter().enumerate().rev() {
            if let Block::Para(p) = &**b {
                if let Some(sec) = &p.section {
                    out.insert(i, name(next));
                    next = sec.start;
                }
            }
        }
        out
    }
    /// Starts a new section after top-level block `block` (or after the table holding a cell paragraph): an empty paragraph that ends
    /// the section so far is inserted, and the text that follows starts as `kind` (`nextPage`, `continuous`, `evenPage`, `oddPage`).
    /// The new section keeps the page setup, headers and footers of the one it splits. At most 100 sections.
    fn do_insert_section_break(&mut self, block: usize, kind: &str) -> Result<(), String> {
        use wordcraft_doc::section::SectionStart as S;
        let start = match kind {
            "nextPage" => S::NextPage,
            "continuous" => S::Continuous,
            "evenPage" => S::EvenPage,
            "oddPage" => S::OddPage,
            _ => return Err("a section break starts on the next page, continuously, or on an even or odd page".into()),
        };
        let top = if block >= CELL_BASE { self.cell_paras().nth(block - CELL_BASE).ok_or_else(|| format!("no cell paragraph {block}"))?[0] } else { block };
        if top >= self.doc.body.len() {
            return Err(format!("no block {block}"));
        }
        if matches!(&*self.doc.body[top], Block::Para(p) if p.section.is_some()) {
            return Err("this paragraph already ends a section".into());
        }
        let count = self.doc.body.iter().filter(|b| matches!(&***b, Block::Para(p) if p.section.is_some())).count() + 1;
        if count >= 100 {
            return Err("a document holds at most 100 sections".into());
        }
        if self.doc.body.len() >= 100_000 {
            return Err("the document has too many blocks".into());
        }
        // The section that contains `top` ends at the next paragraph with section properties, or is the last section.
        let end = (top + 1..self.doc.body.len()).find(|i| matches!(&*self.doc.body[*i], Block::Para(p) if p.section.is_some()));
        let mut first = match end {
            Some(i) => match &*self.doc.body[i] {
                Block::Para(p) => p.section.clone().ok_or("section lost")?,
                _ => return Err("section lost".into()),
            },
            None => Box::new(self.doc.last_section.clone()),
        };
        // The part before the break keeps the section's own start and numbering restart; the part after starts as `kind`.
        let mut marker = wordcraft_doc::Paragraph::new();
        let later = |sec: &mut wordcraft_doc::SectionProps| {
            sec.start = start;
            sec.page_num_start = None;
        };
        match end {
            Some(i) => {
                if let Block::Para(p) = Arc::make_mut(&mut self.doc.body[i]) {
                    if let Some(sec) = p.section.as_mut() {
                        later(sec);
                    }
                }
            }
            None => later(&mut self.doc.last_section),
        }
        marker.section = Some(first);
        self.doc.body.insert(top + 1, Arc::new(Block::Para(marker)));
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Removes the section break that ends at paragraph `block` (top level). The sections on both sides merge and take the properties of the
    /// later one; the following text starts the way the removed break's section started. An empty break paragraph is deleted.
    fn do_remove_section_break(&mut self, block: usize) -> Result<(), String> {
        if block >= CELL_BASE || block >= self.doc.body.len() {
            return Err(format!("no block {block}"));
        }
        let removed = match &*self.doc.body[block] {
            Block::Para(p) => p.section.clone().ok_or("this paragraph does not end a section")?,
            _ => return Err("this block is not a paragraph".into()),
        };
        let end = (block + 1..self.doc.body.len()).find(|i| matches!(&*self.doc.body[*i], Block::Para(p) if p.section.is_some()));
        match end {
            Some(i) => {
                if let Block::Para(p) = Arc::make_mut(&mut self.doc.body[i]) {
                    if let Some(sec) = p.section.as_mut() {
                        sec.start = removed.start;
                    }
                }
            }
            None => self.doc.last_section.start = removed.start,
        }
        let empty = matches!(&*self.doc.body[block], Block::Para(p) if p.text.is_empty() && p.objects.is_empty());
        if empty && self.doc.body.len() > 1 {
            self.doc.body.remove(block);
        } else if let Block::Para(p) = Arc::make_mut(&mut self.doc.body[block]) {
            p.section = None;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    fn block_list(&self) -> String {
        let breaks = self.section_break_kinds();
        let items: Vec<_> = self
            .doc
            .body
            .iter()
            .enumerate()
            .map(|(i, b)| match &**b {
                Block::Para(p) => {
                    let editable = !p.text.contains(OBJ) && p.objects.is_empty();
                    let rp = self.doc.styles.resolve_para(&p.props);
                    // Heading level 0..8 (style or direct outline level); body text (9) is not an outline entry.
                    let outline = rp.outline_level.filter(|l| *l < 9);
                    let mut v = serde_json::json!({"index": i, "kind": "para", "text": if editable { p.text.clone() } else { p.plain_text() }, "editable": editable, "outline": outline});
                    if let Some(k) = breaks.get(&i) {
                        v["sectionBreak"] = serde_json::json!(k);
                    }
                    if let Some((_, w, h, alt)) = image_only(p) {
                        let (wrap, align) = image_wrap_state(p, self.doc.last_section.text_width());
                        let crop = match p.objects.first() {
                            Some(wordcraft_doc::InlineObject::Image { crop, .. }) => crop.map(|c| ((c * 1000.0).round() / 10.0) as f64),
                            _ => [0.0; 4].map(f64::from),
                        };
                        v["image"] = serde_json::json!({"w": w, "h": h, "alt": alt, "wrap": wrap, "align": align, "crop": crop});
                    }
                    v
                }
                Block::Table(_) => serde_json::json!({"index": i, "kind": "table", "editable": false}),
            })
            .collect();
        let mut items = items;
        // Paragraphs inside table cells follow as `cell` entries addressed by `CELL_BASE + n`.
        for (slot, path) in self.cell_paras().enumerate().take(CELL_LIST_MAX) {
            let [b, r, c, k] = path;
            if let Some(p) = self.para_by_path(path) {
                let editable = !p.text.contains(OBJ) && p.objects.is_empty();
                items.push(serde_json::json!({"index": CELL_BASE + slot, "kind": "cell", "text": if editable { p.text.clone() } else { p.plain_text() }, "editable": editable, "table": b, "row": r, "cell": c, "para": k, "outline": null}));
            }
        }
        serde_json::Value::Array(items).to_string()
    }
    /// `[block, row, cell, paragraph]` of every paragraph directly inside a cell of a top-level table, in document order.
    fn cell_paras(&self) -> impl Iterator<Item = [usize; 4]> + '_ {
        self.doc
            .body
            .iter()
            .enumerate()
            .filter_map(|(b, blk)| match &**blk {
                Block::Table(t) => Some((b, t)),
                _ => None,
            })
            .flat_map(|(b, t)| {
                t.rows.iter().enumerate().flat_map(move |(r, row)| {
                    // Continuation cells of a vertical merge are hidden: they own no addressable paragraphs.
                    row.cells.iter().enumerate().filter(|(_, cell)| cell.props.vmerge != wordcraft_doc::props::VMerge::Continue).flat_map(move |(c, cell)| {
                        cell.blocks.iter().enumerate().filter_map(move |(k, x)| matches!(&**x, Block::Para(_)).then_some([b, r, c, k]))
                    })
                })
            })
    }
    /// The paragraph a block id addresses: a top-level paragraph, or a cell paragraph for ids from `CELL_BASE`.
    fn para_at(&self, id: usize) -> Option<&wordcraft_doc::Paragraph> {
        if id < CELL_BASE {
            return match self.doc.body.get(id).map(|b| &**b) {
                Some(Block::Para(p)) => Some(p),
                _ => None,
            };
        }
        let path = self.cell_paras().nth(id - CELL_BASE)?;
        self.para_by_path(path)
    }
    /// The paragraph at `[block, row, cell, paragraph]`.
    fn para_by_path(&self, [b, r, c, k]: [usize; 4]) -> Option<&wordcraft_doc::Paragraph> {
        match self.doc.body.get(b).map(|x| &**x) {
            Some(Block::Table(t)) => match t.rows.get(r)?.cells.get(c)?.blocks.get(k).map(|x| &**x) {
                Some(Block::Para(p)) => Some(p),
                _ => None,
            },
            _ => None,
        }
    }
    /// Replaces the paragraph a block id addresses. A cell paragraph is replaced by cloning its table.
    fn put_para(&mut self, id: usize, p: wordcraft_doc::Paragraph) -> Result<(), String> {
        if id < CELL_BASE {
            let slot = self.doc.body.get_mut(id).ok_or_else(|| format!("no block {id}"))?;
            *slot = Arc::new(Block::Para(p));
            return Ok(());
        }
        let [b, r, c, k] = self.cell_paras().nth(id - CELL_BASE).ok_or_else(|| format!("no cell paragraph {id}"))?;
        let Some(Block::Table(t)) = self.doc.body.get(b).map(|x| &**x) else { return Err(format!("block {b} is not a table")) };
        let mut t2 = t.clone();
        let slot = t2.rows.get_mut(r).and_then(|row| row.cells.get_mut(c)).and_then(|cell| cell.blocks.get_mut(k)).ok_or_else(|| format!("no cell paragraph {id}"))?;
        *slot = Arc::new(Block::Para(p));
        self.doc.body[b] = Arc::new(Block::Table(t2));
        Ok(())
    }
    /// A document position for a block id (top-level paragraph or cell paragraph).
    fn pos_of(&self, id: usize, off: usize) -> Pos {
        if id >= CELL_BASE {
            if let Some([b, r, c, k]) = self.cell_paras().nth(id - CELL_BASE) {
                return Pos::new(StoryRef::Body, wordcraft_doc::Path(vec![b as u32, r as u32, c as u32, k as u32]), off);
            }
        }
        Pos::body(id, off)
    }
    /// A paragraph range is valid when it stays in one id space (top level or cells) and is short.
    fn id_span_ok(first: usize, last: usize) -> bool {
        last >= first && last - first < 2000 && ((first < CELL_BASE) == (last < CELL_BASE))
    }
    /// Applies several non-overlapping replacements (UTF-8 byte ranges in the ORIGINAL paragraph text,
    /// sorted ascending) to one top-level paragraph. Everything is done on a clone and committed only
    /// if every hunk is valid, so a failure leaves the document unchanged. Text outside the hunks keeps
    /// its runs untouched. Inserted text takes the formatting of the first replaced character; a pure
    /// insertion takes the character before it (Word behaviour), or the character after at paragraph start.
    fn do_replace_many(&mut self, block: usize, hunks: &[(usize, usize, String)]) -> Result<(), String> {
        if hunks.is_empty() {
            return Ok(());
        }
        if hunks.len() > 10_000 {
            return Err("too many hunks".into());
        }
        let mut total = 0usize;
        for (_, _, t) in hunks {
            total += t.len();
            if t.chars().any(|c| c == OBJ || c == '\n' || c == '\r') {
                return Err("replacement text must not contain line breaks or object marks".into());
            }
        }
        if total > 1024 * 1024 {
            return Err("adapter edit limit: 1 MiB".into());
        }
        let Some(orig) = self.para_at(block) else { return Err(format!("block {block} is not a paragraph")) };
        if orig.text.contains(OBJ) || !orig.objects.is_empty() {
            return Err(format!("paragraph {block} contains inline objects and cannot be edited as text"));
        }
        let mut prev_end = 0usize;
        for (start, end, _) in hunks {
            if start > end || *start < prev_end {
                return Err("hunks must be ascending, non-overlapping, with start <= end".into());
            }
            for off in [*start, *end] {
                if off > orig.text.len() || !orig.text.is_char_boundary(off) {
                    return Err(format!("offset {off} is not a character boundary inside paragraph {block}"));
                }
            }
            prev_end = *end;
        }
        let mut p = orig.clone();
        if self.track {
            let (rid_ins, rid_del) = (self.track_rev(wordcraft_doc::RevisionKind::Insert), self.track_rev(wordcraft_doc::RevisionKind::Delete));
            let author = self.track_author.clone();
            for (start, end, text) in hunks.iter().rev() {
                let (start, end) = (*start, *end);
                let mut props = if start < end {
                    p.props_of_char(start).clone()
                } else if start > 0 {
                    let prev = p.text[..start].char_indices().next_back().map(|(i, _)| i).unwrap_or(0);
                    p.props_of_char(prev).clone()
                } else if !p.text.is_empty() {
                    p.props_of_char(0).clone()
                } else {
                    p.mark.clone()
                };
                // Deleted text stays (marked); text this author inserted just goes away. The new text goes in front of what it replaces.
                if start < end {
                    let ranges: Vec<(usize, usize, bool, bool)> = p
                        .run_ranges()
                        .filter(|(r, _)| r.end > start && r.start < end)
                        .map(|(r, c)| {
                            let own = c.ins.and_then(|i| self.doc.revisions.get(i as usize)).is_some_and(|rv| rv.author == author);
                            (r.start.max(start), r.end.min(end), own, c.del.is_some())
                        })
                        .collect();
                    for (x, y, own, deleted) in ranges.into_iter().rev() {
                        if own {
                            p.delete(x, y).map_err(|e| e.to_string())?;
                        } else if !deleted {
                            p.format(x, y, &|c| c.del = Some(rid_del)).map_err(|e| e.to_string())?;
                        }
                    }
                }
                if !text.is_empty() {
                    props.ins = Some(rid_ins);
                    props.del = None;
                    p.insert_text(start, text, &props).map_err(|e| e.to_string())?;
                }
            }
            self.put_para(block, p)?;
            self.pages = DocLayout::default();
            return Ok(());
        }
        for (start, end, text) in hunks.iter().rev() {
            let (start, end) = (*start, *end);
            let props = if start < end {
                p.props_of_char(start).clone()
            } else if start > 0 {
                let prev = p.text[..start].char_indices().next_back().map(|(i, _)| i).unwrap_or(0);
                p.props_of_char(prev).clone()
            } else if !p.text.is_empty() {
                p.props_of_char(0).clone()
            } else {
                p.mark.clone()
            };
            p.delete(start, end).map_err(|e| e.to_string())?;
            if !text.is_empty() {
                p.insert_text(start, text, &props).map_err(|e| e.to_string())?;
            }
        }
        self.put_para(block, p)?;
        self.pages = DocLayout::default();
        Ok(())
    }
    /// The id of a revision record for the tracking author and time, reusing an identical one.
    fn track_rev(&mut self, kind: wordcraft_doc::RevisionKind) -> u32 {
        let (author, date) = (self.track_author.clone(), self.track_date.clone());
        if let Some((i, _)) = self.doc.revisions.iter().enumerate().rev().find(|(_, r)| r.kind == kind && r.author == author && r.date == date) {
            return i as u32;
        }
        self.doc.revisions.push(wordcraft_doc::Revision { kind, author, date });
        (self.doc.revisions.len() - 1) as u32
    }
    /// Every paragraph that can hold a change, with its block id: top-level paragraphs, then table-cell paragraphs.
    fn review_blocks(&self) -> Vec<usize> {
        let mut ids: Vec<usize> = self.doc.body.iter().enumerate().filter(|(_, b)| matches!(&***b, Block::Para(_))).map(|(i, _)| i).collect();
        ids.extend((0..self.cell_paras().count()).map(|n| CELL_BASE + n));
        ids
    }
    /// `{"track": bool, "changes": [{id, kind, author, date, block, start, end, text}]}`, at most 500 changes. A change is a run of text
    /// with one revision mark in one paragraph.
    fn do_review_state(&self) -> String {
        let mut out = Vec::new();
        'all: for block in self.review_blocks() {
            let Some(p) = self.para_at(block) else { continue };
            let mut open: Option<(usize, usize, u32, &'static str)> = None;
            let flush = |o: &mut Option<(usize, usize, u32, &'static str)>, out: &mut Vec<serde_json::Value>| {
                if let Some((s, e, id, kind)) = o.take() {
                    let rv = self.doc.revisions.get(id as usize);
                    let text: String = p.text.get(s..e).unwrap_or("").chars().take(200).collect();
                    out.push(serde_json::json!({"id": id, "kind": kind, "author": rv.map(|r| r.author.clone()).unwrap_or_default(), "date": rv.map(|r| r.date.clone()).unwrap_or_default(), "block": block, "start": s, "end": e, "text": text}));
                }
            };
            for (r, c) in p.run_ranges() {
                let mark = match (c.ins, c.del) {
                    (_, Some(d)) => Some((d, "delete")),
                    (Some(i), None) => Some((i, "insert")),
                    _ => None,
                };
                match mark {
                    Some((id, kind)) => {
                        if let Some(o) = open.as_mut().filter(|o| o.2 == id && o.3 == kind && o.1 == r.start) {
                            o.1 = r.end;
                        } else {
                            flush(&mut open, &mut out);
                            open = Some((r.start, r.end, id, kind));
                        }
                    }
                    None => flush(&mut open, &mut out),
                }
            }
            flush(&mut open, &mut out);
            if out.len() >= 500 {
                out.truncate(500);
                break 'all;
            }
        }
        serde_json::json!({"track": self.track, "changes": out}).to_string()
    }
    /// Accepts or rejects the marked text of paragraph `block` between `start` and `end`.
    fn resolve_range(p: &mut wordcraft_doc::Paragraph, from: usize, to: usize, accept: bool) -> Result<(), String> {
        let ranges: Vec<(usize, usize, bool, bool)> = p.run_ranges().filter(|(r, _)| r.end > from && r.start < to).map(|(r, c)| (r.start.max(from), r.end.min(to), c.ins.is_some(), c.del.is_some())).collect();
        for (a, b, ins, del) in ranges.into_iter().rev() {
            if (del && accept) || (ins && !accept) {
                p.delete(a, b).map_err(|e| e.to_string())?;
            } else if ins || del {
                p.format(a, b, &|c| {
                    c.ins = None;
                    c.del = None;
                })
                .map_err(|e| e.to_string())?;
            }
        }
        Ok(())
    }
    fn do_resolve_change(&mut self, block: usize, start: usize, end: usize, accept: bool) -> Result<(), String> {
        let Some(orig) = self.para_at(block) else { return Err(format!("block {block} is not a paragraph")) };
        if start >= end || end > orig.text.len() || !orig.text.is_char_boundary(start) || !orig.text.is_char_boundary(end) {
            return Err("that change is not in the document any more".into());
        }
        if !orig.run_ranges().any(|(r, c)| r.end > start && r.start < end && (c.ins.is_some() || c.del.is_some())) {
            return Err("there is no tracked change there".into());
        }
        let mut p = orig.clone();
        Self::resolve_range(&mut p, start, end, accept)?;
        self.put_para(block, p)?;
        self.pages = DocLayout::default();
        Ok(())
    }
    fn do_resolve_all(&mut self, accept: bool) -> Result<usize, String> {
        let mut n = 0;
        for block in self.review_blocks() {
            let Some(orig) = self.para_at(block) else { continue };
            if !orig.run_ranges().any(|(_, c)| c.ins.is_some() || c.del.is_some()) {
                continue;
            }
            let len = orig.text.len();
            let mut p = orig.clone();
            Self::resolve_range(&mut p, 0, len, accept)?;
            self.put_para(block, p)?;
            n += 1;
        }
        self.pages = DocLayout::default();
        Ok(n)
    }
    fn plain_para(&self, block: usize) -> Result<&wordcraft_doc::Paragraph, String> {
        if block < CELL_BASE && matches!(self.doc.body.get(block).map(|b| &**b), Some(Block::Table(_))) {
            return Err(format!("block {block} is a table, not a paragraph"));
        }
        match self.para_at(block) {
            None => Err(format!("no block {block}")),
            Some(p) if p.text.contains(OBJ) || !p.objects.is_empty() => Err(format!("paragraph {block} contains inline objects and cannot be edited as text")),
            Some(p) if p.section.is_some() => Err(format!("paragraph {block} carries a section break and cannot be split or merged")),
            Some(p) => Ok(p),
        }
    }
    /// Splits a top-level paragraph at a UTF-8 offset. The new paragraph copies the paragraph properties.
    fn do_split(&mut self, block: usize, off: usize) -> Result<(), String> {
        let mut p = self.plain_para(block)?.clone();
        if off > p.text.len() || !p.text.is_char_boundary(off) {
            return Err(format!("offset {off} is not a character boundary inside paragraph {block}"));
        }
        let tail = p.split_off(off).map_err(|e| e.to_string())?;
        if block >= CELL_BASE {
            let [b, r, c, k] = self.cell_paras().nth(block - CELL_BASE).ok_or_else(|| format!("no cell paragraph {block}"))?;
            let Some(Block::Table(t)) = self.doc.body.get(b).map(|x| &**x) else { return Err("not a table".into()) };
            let mut t2 = t.clone();
            let cell = t2.rows.get_mut(r).and_then(|row| row.cells.get_mut(c)).ok_or("no such cell")?;
            if cell.blocks.len() >= 1000 {
                return Err("a table cell holds at most 1000 paragraphs".into());
            }
            cell.blocks[k] = Arc::new(Block::Para(p));
            cell.blocks.insert(k + 1, Arc::new(Block::Para(tail)));
            self.doc.body[b] = Arc::new(Block::Table(t2));
            self.pages = DocLayout::default();
            return Ok(());
        }
        self.doc.body[block] = Arc::new(Block::Para(p));
        self.doc.body.insert(block + 1, Arc::new(Block::Para(tail)));
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Joins paragraph `block` onto the end of `block - 1`; the first paragraph keeps its properties.
    fn do_merge(&mut self, block: usize) -> Result<(), String> {
        if block >= CELL_BASE {
            let tail = self.plain_para(block)?.clone();
            let [b, r, c, k] = self.cell_paras().nth(block - CELL_BASE).ok_or_else(|| format!("no cell paragraph {block}"))?;
            if k == 0 {
                return Err("there is no previous paragraph in this cell".into());
            }
            let mut head = self.para_by_path([b, r, c, k - 1]).ok_or("the previous block in this cell is not a paragraph")?.clone();
            if head.text.contains(OBJ) || !head.objects.is_empty() || head.section.is_some() {
                return Err("the previous paragraph cannot be joined".into());
            }
            head.append(tail);
            let Some(Block::Table(t)) = self.doc.body.get(b).map(|x| &**x) else { return Err("not a table".into()) };
            let mut t2 = t.clone();
            let cell = t2.rows.get_mut(r).and_then(|row| row.cells.get_mut(c)).ok_or("no such cell")?;
            cell.blocks[k - 1] = Arc::new(Block::Para(head));
            cell.blocks.remove(k);
            self.doc.body[b] = Arc::new(Block::Table(t2));
            self.pages = DocLayout::default();
            return Ok(());
        }
        if block == 0 {
            return Err("there is no previous paragraph".into());
        }
        let tail = self.plain_para(block)?.clone();
        let mut head = self.plain_para(block - 1)?.clone();
        head.append(tail);
        self.doc.body[block - 1] = Arc::new(Block::Para(head));
        self.doc.body.remove(block);
        self.pages = DocLayout::default();
        Ok(())
    }
    /// A paragraph whose text can be formatted by byte range: not a table, no inline objects.
    fn fmt_para(&self, block: usize) -> Result<&wordcraft_doc::Paragraph, String> {
        match self.para_at(block) {
            None => Err(format!("block {block} is not a paragraph")),
            Some(p) if p.text.contains(OBJ) || !p.objects.is_empty() => Err(format!("paragraph {block} contains inline objects and cannot be formatted as text")),
            Some(p) => Ok(p),
        }
    }
    /// Non-empty per-paragraph byte ranges `(block, start, end)` covered by a selection that starts at
    /// `(sb, so)` and ends at `(eb, eo)`. Every paragraph in the span must be formattable and every offset
    /// a character boundary, otherwise nothing is returned (callers then change nothing).
    fn span_ranges(&self, sb: usize, so: usize, eb: usize, eo: usize) -> Result<Vec<(usize, usize, usize)>, String> {
        if eb < sb || (eb == sb && eo < so) {
            return Err("selection end is before its start".into());
        }
        if !Self::id_span_ok(sb, eb) {
            return Err("selection spans too many paragraphs or leaves the table".into());
        }
        let mut out = Vec::new();
        for b in sb..=eb {
            let p = self.fmt_para(b)?;
            let start = if b == sb { so } else { 0 };
            let end = if b == eb { eo } else { p.text.len() };
            for off in [start, end] {
                if off > p.text.len() || !p.text.is_char_boundary(off) {
                    return Err(format!("offset {off} is not a character boundary inside paragraph {b}"));
                }
            }
            if start < end {
                out.push((b, start, end));
            }
        }
        Ok(out)
    }
    fn highlight_of(name: &str) -> Result<wordcraft_doc::props::Highlight, String> {
        use wordcraft_doc::props::Highlight;
        Ok(match name {
            "none" => Highlight::None,
            "yellow" => Highlight::Yellow,
            "green" => Highlight::BrightGreen,
            "cyan" => Highlight::Turquoise,
            "pink" => Highlight::Pink,
            "gray" => Highlight::Gray25,
            _ => return Err("format field highlight must be none, yellow, green, cyan, pink or gray".into()),
        })
    }
    fn highlight_name(h: wordcraft_doc::props::Highlight) -> &'static str {
        use wordcraft_doc::props::Highlight;
        match h {
            Highlight::None => "none",
            Highlight::Yellow => "yellow",
            Highlight::BrightGreen => "green",
            Highlight::Turquoise => "cyan",
            Highlight::Pink => "pink",
            Highlight::Gray25 => "gray",
            _ => "other",
        }
    }
    /// A hyperlink target: http, https or mailto, up to 2048 characters, no spaces or control characters, or `#name` for a bookmark
    /// (a letter or underscore, then letters, digits or underscores, at most 40 characters; the bookmark need not exist yet).
    fn link_ok(l: &str) -> Result<String, String> {
        if let Some(name) = l.strip_prefix('#') {
            let ok = name.chars().next().is_some_and(|c| c.is_ascii_alphabetic() || c == '_') && name.chars().count() <= BOOKMARK_MAX_NAME && name.chars().all(|c| c.is_ascii_alphanumeric() || c == '_');
            return if ok { Ok(l.to_string()) } else { Err(format!("a link to a bookmark is # and its name: a letter first, then letters, digits or underscores, at most {BOOKMARK_MAX_NAME}")) };
        }
        let low = l.to_ascii_lowercase();
        let rest = ["https://", "http://", "mailto:"].iter().find(|p| low.starts_with(*p)).map(|p| &l[p.len()..]);
        if l.chars().count() > LINK_MAX_CHARS || l.chars().any(|c| c.is_control() || c.is_whitespace()) || rest.is_none_or(|r| r.is_empty()) {
            return Err(format!("a link must start with http://, https:// or mailto: and be at most {LINK_MAX_CHARS} characters without spaces"));
        }
        Ok(l.to_string())
    }
    /// Sets bold / italic / underline (each `true` or `false`) on a selection. The patch is a JSON object
    /// such as `{"bold":true}`; unknown or non-boolean fields are refused. All paragraphs are changed on
    /// clones and committed together, so a failure leaves the document unchanged.
    fn do_format(&mut self, sb: usize, so: usize, eb: usize, eo: usize, patch_json: &str) -> Result<(), String> {
        let v: serde_json::Value = serde_json::from_str(patch_json).map_err(|e| format!("bad format patch: {e}"))?;
        let obj = v.as_object().ok_or_else(|| "format patch must be an object".to_string())?;
        let mut bold: Option<bool> = None;
        let mut italic: Option<bool> = None;
        let mut underline: Option<wordcraft_doc::props::Underline> = None;
        let mut font: Option<String> = None;
        let mut size: Option<f32> = None;
        let mut color: Option<wordcraft_doc::props::TextColor> = None;
        let mut strike: Option<bool> = None;
        let mut small_caps: Option<bool> = None;
        let mut all_caps: Option<bool> = None;
        let mut underline_color: Option<Option<wordcraft_doc::props::Rgb>> = None;
        let mut char_shading: Option<Option<wordcraft_doc::props::Rgb>> = None;
        let mut double_strike: Option<bool> = None;
        let mut hidden: Option<bool> = None;
        let mut no_proof: Option<bool> = None;
        let mut lang: Option<Option<String>> = None;
        let mut spacing: Option<f32> = None;
        let mut scale: Option<f32> = None;
        let mut vert: Option<wordcraft_doc::props::VertAlign> = None;
        let mut highlight: Option<wordcraft_doc::props::Highlight> = None;
        let mut link: Option<Option<String>> = None;
        let mut char_style: Option<Option<String>> = None;
        let mut clear = false;
        for (k, val) in obj {
            match k.as_str() {
                "charStyle" => {
                    let id = val.as_str().ok_or_else(|| "format field charStyle must be text".to_string())?;
                    if id.is_empty() {
                        char_style = Some(None);
                    } else if self.doc.styles.get(id).is_some_and(|st| st.kind == wordcraft_doc::StyleKind::Character && !st.hidden) {
                        char_style = Some(Some(id.to_string()));
                    } else {
                        return Err("format field charStyle must name a character style of the document".into());
                    }
                    continue;
                }
                "vertAlign" => {
                    use wordcraft_doc::props::VertAlign;
                    vert = Some(match val.as_str() {
                        Some("baseline") => VertAlign::Baseline,
                        Some("superscript") => VertAlign::Superscript,
                        Some("subscript") => VertAlign::Subscript,
                        _ => return Err("format field vertAlign must be baseline, superscript or subscript".into()),
                    });
                    continue;
                }
                "highlight" => {
                    highlight = Some(Self::highlight_of(val.as_str().ok_or_else(|| "format field highlight must be text".to_string())?)?);
                    continue;
                }
                "link" => {
                    let l = val.as_str().ok_or_else(|| "format field link must be text".to_string())?;
                    link = Some(if l.is_empty() { None } else { Some(Self::link_ok(l)?) });
                    continue;
                }
                "font" => {
                    let f = val.as_str().ok_or_else(|| "format field font must be text".to_string())?;
                    if f.is_empty() || f.chars().count() > 64 || f.chars().any(|c| c.is_control()) {
                        return Err("format field font must be 1-64 printable characters".into());
                    }
                    font = Some(f.to_string());
                    continue;
                }
                "size" => {
                    let n = val.as_f64().ok_or_else(|| "format field size must be a number".to_string())?;
                    if !n.is_finite() || !(1.0..=400.0).contains(&n) {
                        return Err("format field size must be between 1 and 400 points".into());
                    }
                    size = Some(((n * 2.0).round() / 2.0) as f32);
                    continue;
                }
                "underlineStyle" => {
                    use wordcraft_doc::props::Underline as U;
                    underline = Some(match val.as_str() {
                        Some("single") => U::Single,
                        Some("double") => U::Double,
                        Some("thick") => U::Thick,
                        Some("dotted") => U::Dotted,
                        Some("dashed") => U::Dash,
                        Some("wave") => U::Wave,
                        _ => return Err("format field underlineStyle must be single, double, thick, dotted, dashed or wave".into()),
                    });
                    continue;
                }
                "underlineColor" => {
                    let c = val.as_str().ok_or_else(|| "format field underlineColor must be text".to_string())?;
                    underline_color = Some(if c == "auto" { None } else { Self::parse_para_rgb(val).map_err(|_| "format field underlineColor must be auto or RRGGBB".to_string())? });
                    continue;
                }
                "charShading" => {
                    char_shading = Some(Self::parse_para_rgb(val).map_err(|_| "format field charShading must be none or RRGGBB".to_string())?);
                    continue;
                }
                "scale" => {
                    let n = val.as_u64().filter(|n| (20..=400).contains(n)).ok_or_else(|| "format field scale must be a whole number from 20 to 400 percent".to_string())?;
                    scale = Some(n as f32);
                    continue;
                }
                "lang" => {
                    let l = val.as_str().ok_or_else(|| "format field lang must be text".to_string())?;
                    lang = Some(match l {
                        "none" => None,
                        "en-US" | "en-GB" | "de-DE" | "es-ES" | "fr-FR" | "pt-BR" => Some(l.to_string()),
                        _ => return Err("format field lang must be none, en-US, en-GB, de-DE, es-ES, fr-FR or pt-BR".into()),
                    });
                    continue;
                }
                "spacing" => {
                    let n = val.as_f64().filter(|n| n.is_finite() && (-5.0..=30.0).contains(n)).ok_or_else(|| "format field spacing must be a number from -5 to 30 points".to_string())?;
                    spacing = Some(((n * 20.0).round() / 20.0) as f32);
                    continue;
                }
                "color" => {
                    let c = val.as_str().ok_or_else(|| "format field color must be text".to_string())?;
                    color = Some(if c == "auto" {
                        wordcraft_doc::props::TextColor::Auto
                    } else if c.len() == 6 && c.bytes().all(|b| b.is_ascii_hexdigit()) {
                        let n = u32::from_str_radix(c, 16).map_err(|e| e.to_string())?;
                        wordcraft_doc::props::TextColor::Rgb(wordcraft_doc::props::Rgb((n >> 16) as u8, (n >> 8) as u8, n as u8))
                    } else {
                        return Err("format field color must be auto or RRGGBB".into());
                    });
                    continue;
                }
                _ => {}
            }
            let flag = val.as_bool().ok_or_else(|| format!("format field {k} must be true or false"))?;
            match k.as_str() {
                "bold" => bold = Some(flag),
                "italic" => italic = Some(flag),
                "strike" => strike = Some(flag),
                "smallCaps" => small_caps = Some(flag),
                "allCaps" => all_caps = Some(flag),
                "doubleStrike" => double_strike = Some(flag),
                "hidden" => hidden = Some(flag),
                "noProof" => no_proof = Some(flag),
                "clear" => {
                    if !flag {
                        return Err("format field clear must be true".into());
                    }
                    clear = true;
                }
                "underline" => {
                    underline = Some(if flag { wordcraft_doc::props::Underline::Single } else { wordcraft_doc::props::Underline::None })
                }
                _ => return Err(format!("unknown format field {k}")),
            }
        }
        if obj.is_empty() {
            return Ok(());
        }
        let ranges = self.span_ranges(sb, so, eb, eo)?;
        let mut done: Vec<(usize, wordcraft_doc::Paragraph)> = Vec::with_capacity(ranges.len());
        for (b, start, end) in ranges {
            let mut p = self.fmt_para(b)?.clone();
            p.format(start, end, &|cp: &mut CharProps| {
                if clear {
                    // Direct character formatting goes; the link and tracked-change marks stay.
                    let keep = (cp.link.take(), cp.ins, cp.del, cp.style.take());
                    *cp = CharProps::default();
                    cp.link = keep.0;
                    cp.ins = keep.1;
                    cp.del = keep.2;
                    cp.style = keep.3;
                }
                if let Some(v) = &char_style {
                    cp.style = v.clone();
                }
                if let Some(v) = strike {
                    cp.strike = Some(v);
                    if v {
                        cp.double_strike = None;
                    }
                }
                if let Some(v) = hidden {
                    cp.hidden = Some(v);
                }
                if let Some(v) = no_proof {
                    cp.no_proof = Some(v);
                }
                if let Some(v) = &lang {
                    cp.lang = v.clone();
                }
                if let Some(v) = small_caps {
                    cp.small_caps = Some(v);
                }
                if let Some(v) = all_caps {
                    cp.caps = Some(v);
                }
                if let Some(v) = double_strike {
                    cp.double_strike = Some(v);
                    if v {
                        cp.strike = None;
                    }
                }
                if let Some(v) = spacing {
                    cp.spacing = Some(v);
                }
                if let Some(v) = scale {
                    cp.scale = Some(v);
                }
                if let Some(v) = vert {
                    cp.vert_align = Some(v);
                }
                if let Some(v) = highlight {
                    cp.highlight = Some(v);
                }
                if let Some(v) = &link {
                    cp.link = v.clone();
                }
                if let Some(v) = bold {
                    cp.bold = Some(v);
                }
                if let Some(v) = italic {
                    cp.italic = Some(v);
                }
                if let Some(v) = underline {
                    cp.underline = Some(v);
                }
                if let Some(v) = underline_color {
                    cp.underline_color = v;
                }
                if let Some(v) = char_shading {
                    cp.shading = v;
                }
                if let Some(v) = &font {
                    cp.font = Some(v.clone());
                }
                if let Some(v) = size {
                    cp.size = Some(v);
                }
                if let Some(v) = color {
                    cp.color = Some(v);
                }
            })
            .map_err(|e| e.to_string())?;
            done.push((b, p));
        }
        for (b, p) in done {
            self.put_para(b, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    fn extra_of(rc: &wordcraft_doc::resolve::ResolvedChar, cp: &CharProps) -> (bool, bool, wordcraft_doc::props::VertAlign, &'static str, String) {
        // The resolved highlight is a colour; the direct property names the palette entry.
        let hl = cp.highlight.map(Self::highlight_name).unwrap_or("none");
        (rc.strike, rc.small_caps, rc.vert_align, hl, rc.link.clone().unwrap_or_default())
    }
    /// Effective (style + direct) bold / italic / underline over a selection, each `"on"`, `"off"` or
    /// `"mixed"`. A collapsed selection reports what typing at that point would get.
    fn do_format_state(&self, sb: usize, so: usize, eb: usize, eo: usize) -> Result<String, String> {
        let mut seen: Vec<(bool, bool, bool)> = Vec::new();
        let mut look: Vec<(String, f32, wordcraft_doc::props::TextColor)> = Vec::new();
        // strike, small caps, vertical alignment, highlight name, link ("" for none).
        let mut extra: Vec<(bool, bool, wordcraft_doc::props::VertAlign, &'static str, String)> = Vec::new();
        // all caps, double strike, character spacing.
        let mut more: Vec<(bool, bool, f32, bool, bool)> = Vec::new();
        let mut scales: Vec<f32> = Vec::new();
        // The language tag of each run ("" for none).
        let mut langs: Vec<String> = Vec::new();
        // underline style name, underline colour (hex or "auto"), character shading (hex or "none").
        let mut under: Vec<(&'static str, String, String)> = Vec::new();
        if sb == eb && so == eo {
            let p = self.fmt_para(sb)?;
            if so > p.text.len() || !p.text.is_char_boundary(so) {
                return Err(format!("offset {so} is not a character boundary inside paragraph {sb}"));
            }
            let rc = self.doc.styles.resolve_char(p.props.style.as_deref(), p.props_at(so));
            seen.push((rc.bold, rc.italic, rc.underline != wordcraft_doc::props::Underline::None));
            look.push((rc.font.clone(), rc.size, rc.color));
            extra.push(Self::extra_of(&rc, p.props_at(so)));
            more.push((rc.caps, rc.double_strike, rc.spacing, rc.hidden, rc.no_proof));
            langs.push(rc.lang.clone().unwrap_or_default());
            scales.push(rc.scale);
            under.push(Self::under_of(&rc));
        } else {
            for (b, start, end) in self.span_ranges(sb, so, eb, eo)? {
                let p = self.fmt_para(b)?;
                for (r, cp) in p.run_ranges() {
                    if r.start < end && r.end > start {
                        let rc = self.doc.styles.resolve_char(p.props.style.as_deref(), cp);
                        seen.push((rc.bold, rc.italic, rc.underline != wordcraft_doc::props::Underline::None));
                        look.push((rc.font.clone(), rc.size, rc.color));
                        extra.push(Self::extra_of(&rc, cp));
                        more.push((rc.caps, rc.double_strike, rc.spacing, rc.hidden, rc.no_proof));
                        langs.push(rc.lang.clone().unwrap_or_default());
                        scales.push(rc.scale);
                        under.push(Self::under_of(&rc));
                    }
                }
            }
        }
        fn tri(seen: &[(bool, bool, bool)], f: impl Fn(&(bool, bool, bool)) -> bool) -> &'static str {
            if !seen.is_empty() && seen.iter().all(|x| f(x)) {
                "on"
            } else if seen.iter().any(|x| f(x)) {
                "mixed"
            } else {
                "off"
            }
        }
        // font / size / color: the shared value, or null when the selection mixes values (or is empty).
        let same = |f: &dyn Fn(&(String, f32, wordcraft_doc::props::TextColor)) -> bool| !look.is_empty() && look.iter().all(|x| f(x));
        let first = look.first();
        let font = first.filter(|x| same(&|y| y.0 == x.0)).map(|x| x.0.clone());
        let size = first.filter(|x| same(&|y| y.1 == x.1)).map(|x| x.1);
        let color = first.filter(|x| same(&|y| y.2 == x.2)).map(|x| match x.2 {
            wordcraft_doc::props::TextColor::Auto => "auto".to_string(),
            wordcraft_doc::props::TextColor::Rgb(c) => c.hex(),
        });
        let all_same = |f: &dyn Fn(&(bool, bool, wordcraft_doc::props::VertAlign, &'static str, String)) -> bool| !extra.is_empty() && extra.iter().all(|x| f(x));
        let tri_b = |f: &dyn Fn(&(bool, bool, wordcraft_doc::props::VertAlign, &'static str, String)) -> bool| if all_same(f) { "on" } else if extra.iter().any(|x| f(x)) { "mixed" } else { "off" };
        let e0 = extra.first();
        let vert = e0.filter(|x| all_same(&|y| y.2 == x.2)).map(|x| match x.2 {
            wordcraft_doc::props::VertAlign::Baseline => "baseline",
            wordcraft_doc::props::VertAlign::Superscript => "superscript",
            wordcraft_doc::props::VertAlign::Subscript => "subscript",
        });
        let hl = e0.filter(|x| all_same(&|y| y.3 == x.3)).map(|x| x.3);
        let lk = e0.filter(|x| all_same(&|y| y.4 == x.4)).map(|x| x.4.clone());
        let tri_m = |f: &dyn Fn(&(bool, bool, f32, bool, bool)) -> bool| if !more.is_empty() && more.iter().all(|x| f(x)) { "on" } else if more.iter().any(|x| f(x)) { "mixed" } else { "off" };
        let spacing = more.first().filter(|x| more.iter().all(|y| y.2.to_bits() == x.2.to_bits())).map(|x| x.2);
        let scale = scales.first().filter(|x| scales.iter().all(|y| y.to_bits() == x.to_bits())).copied();
        let u0 = under.first();
        let u_style = u0.filter(|x| under.iter().all(|y| y.0 == x.0)).map(|x| x.0);
        let u_color = u0.filter(|x| under.iter().all(|y| y.1 == x.1)).map(|x| x.1.clone());
        let c_shade = u0.filter(|x| under.iter().all(|y| y.2 == x.2)).map(|x| x.2.clone());
        Ok(serde_json::json!({"underlineStyle": u_style, "underlineColor": u_color, "charShading": c_shade, "allCaps": tri_m(&|x| x.0), "doubleStrike": tri_m(&|x| x.1), "hidden": tri_m(&|x| x.3), "noProof": tri_m(&|x| x.4), "lang": langs.first().filter(|x| langs.iter().all(|y| y == *x)).map(|x| if x.is_empty() { "none" } else { x.as_str() }), "spacing": spacing, "scale": scale,
            "bold": tri(&seen, |x| x.0), "italic": tri(&seen, |x| x.1), "underline": tri(&seen, |x| x.2), "font": font, "size": size, "color": color,
            "strike": tri_b(&|x| x.0), "smallCaps": tri_b(&|x| x.1), "vertAlign": vert, "highlight": hl, "link": lk}).to_string())
    }
    fn under_of(rc: &wordcraft_doc::resolve::ResolvedChar) -> (&'static str, String, String) {
        use wordcraft_doc::props::Underline as U;
        let name = match rc.underline {
            U::None => "none",
            U::Double | U::DoubleWave => "double",
            U::Thick => "thick",
            U::Dotted => "dotted",
            U::Dash | U::DotDash | U::DotDotDash => "dashed",
            U::Wave => "wave",
            U::Single | U::Words => "single",
        };
        (name, rc.underline_color.map_or_else(|| "auto".to_string(), |c| c.hex()), rc.shading.map_or_else(|| "none".to_string(), |c| c.hex()))
    }
    /// `"none"` clears; `RRGGBB` sets.
    fn parse_para_rgb(val: &serde_json::Value) -> Result<Option<wordcraft_doc::props::Rgb>, String> {
        let c = val.as_str().ok_or("paragraph shading must be text")?;
        if c == "none" {
            return Ok(None);
        }
        if c.len() == 6 && c.bytes().all(|b| b.is_ascii_hexdigit()) {
            let n = u32::from_str_radix(c, 16).map_err(|e| e.to_string())?;
            return Ok(Some(wordcraft_doc::props::Rgb((n >> 16) as u8, (n >> 8) as u8, n as u8)));
        }
        Err("paragraph shading must be none or RRGGBB".into())
    }
    /// `"none"` clears; `{style, width 0.25..12, color RRGGBB}` sets a box border on all four sides.
    fn parse_para_border(val: &serde_json::Value) -> Result<Option<wordcraft_doc::props::Border>, String> {
        use wordcraft_doc::props::{Border, BorderStyle};
        if val.as_str() == Some("none") {
            return Ok(None);
        }
        let o = val.as_object().ok_or("paragraph border must be none or an object")?;
        if o.keys().any(|k| !matches!(k.as_str(), "style" | "width" | "color")) {
            return Err("unknown paragraph border field".into());
        }
        let style = match o.get("style").and_then(|v| v.as_str()) {
            Some("single") => BorderStyle::Single,
            Some("double") => BorderStyle::Double,
            Some("dotted") => BorderStyle::Dotted,
            Some("dashed") => BorderStyle::Dashed,
            Some("thick") => BorderStyle::Thick,
            _ => return Err("paragraph border style must be single, double, dotted, dashed or thick".into()),
        };
        let width = o.get("width").and_then(|v| v.as_f64()).ok_or("paragraph border width must be a number")?;
        if !width.is_finite() || !(0.25..=12.0).contains(&width) {
            return Err("paragraph border width must be between 0.25 and 12".into());
        }
        let color = Self::parse_para_rgb(o.get("color").ok_or("paragraph border color is required")?)?.ok_or("paragraph border color must be RRGGBB")?;
        Ok(Some(Border { style, width: ((width * 8.0).round() / 8.0) as f32, color: Some(color), space: 4.0 }))
    }
    /// Tab stops from a patch: at most 20, each `{pos 0..1440, align, leader}`, positions at least 0.5 pt apart.
    fn parse_tabs(val: &serde_json::Value) -> Result<Vec<wordcraft_doc::props::TabStop>, String> {
        use wordcraft_doc::props::{TabAlign, TabLeader, TabStop};
        let arr = val.as_array().ok_or("paragraph field tabs must be a list")?;
        if arr.len() > 20 {
            return Err("a paragraph has at most 20 tab stops".into());
        }
        let mut out: Vec<TabStop> = Vec::with_capacity(arr.len());
        for t in arr {
            let o = t.as_object().ok_or("a tab stop must be an object")?;
            let pos = o.get("pos").and_then(|v| v.as_f64()).filter(|p| p.is_finite() && (0.0..=1440.0).contains(p)).ok_or("a tab stop position must be between 0 and 1440 pt")? as f32;
            let align = match o.get("align").and_then(|v| v.as_str()).unwrap_or("left") {
                "left" => TabAlign::Left,
                "center" => TabAlign::Center,
                "right" => TabAlign::Right,
                "decimal" => TabAlign::Decimal,
                "bar" => TabAlign::Bar,
                _ => return Err("a tab stop alignment must be left, center, right, decimal or bar".into()),
            };
            let leader = match o.get("leader").and_then(|v| v.as_str()).unwrap_or("none") {
                "none" => TabLeader::None,
                "dot" => TabLeader::Dot,
                "hyphen" => TabLeader::Hyphen,
                "underscore" => TabLeader::Underscore,
                "middleDot" => TabLeader::MiddleDot,
                _ => return Err("a tab stop leader must be none, dot, hyphen, underscore or middleDot".into()),
            };
            if o.keys().any(|k| !["pos", "align", "leader"].contains(&k.as_str())) {
                return Err("a tab stop has only pos, align and leader".into());
            }
            out.push(TabStop { pos, align, leader });
        }
        out.sort_by(|a, b| a.pos.total_cmp(&b.pos));
        if out.windows(2).any(|w| w[1].pos - w[0].pos < 0.5) {
            return Err("tab stops must be at least 0.5 pt apart".into());
        }
        Ok(out)
    }
    /// Paragraph formatting for the whole paragraphs `first..=last` (selection coordinates are not needed:
    /// alignment, indents and spacing belong to a paragraph). Any non-paragraph block in the span, or an
    /// invalid value, refuses the whole call. Changes are made on clones and committed together.
    fn do_para_format(&mut self, first: usize, last: usize, patch_json: &str) -> Result<(), String> {
        use wordcraft_doc::props::{Align, LineSpacing};
        let v: serde_json::Value = serde_json::from_str(patch_json).map_err(|e| format!("bad paragraph patch: {e}"))?;
        let obj = v.as_object().ok_or_else(|| "paragraph patch must be an object".to_string())?;
        if obj.is_empty() {
            return Ok(());
        }
        let num = |k: &str, val: &serde_json::Value, lo: f64, hi: f64| -> Result<f32, String> {
            let n = val.as_f64().ok_or_else(|| format!("paragraph field {k} must be a number"))?;
            if !n.is_finite() || n < lo || n > hi {
                return Err(format!("paragraph field {k} must be between {lo} and {hi}"));
            }
            Ok(((n * 20.0).round() / 20.0) as f32)
        };
        let mut flags: Vec<(&str, bool)> = Vec::new();
        let mut line_rule: Option<LineSpacing> = None;
        let mut tabs: Option<Vec<wordcraft_doc::props::TabStop>> = None;
        let mut ir: Option<f32> = None;
        let mut align: Option<Align> = None;
        let mut shading: Option<Option<wordcraft_doc::props::Rgb>> = None;
        let mut border: Option<Option<wordcraft_doc::props::Border>> = None;
        let mut drop_cap: Option<u8> = None;
        let (mut il, mut ifirst, mut sb, mut sa, mut ls): (Option<f32>, Option<f32>, Option<f32>, Option<f32>, Option<f32>) = (None, None, None, None, None);
        for (k, val) in obj {
            match k.as_str() {
                "align" => {
                    align = Some(match val.as_str() {
                        Some("left") => Align::Left,
                        Some("center") => Align::Center,
                        Some("right") => Align::Right,
                        Some("justify") => Align::Justify,
                        _ => return Err("paragraph field align must be left, center, right or justify".into()),
                    })
                }
                "indentLeft" => il = Some(num(k, val, 0.0, 1440.0)?),
                "dropCap" => drop_cap = Some(val.as_u64().filter(|n| *n <= 10).ok_or("paragraph field dropCap must be a whole number from 0 to 10")? as u8),
                "shading" => shading = Some(Self::parse_para_rgb(val)?),
                "border" => border = Some(Self::parse_para_border(val)?),
                "tabs" => tabs = Some(Self::parse_tabs(val)?),
                "indentRight" => ir = Some(num(k, val, 0.0, 1440.0)?),
                "lineRule" => {
                    let o = val.as_object().ok_or("lineRule must be an object {rule, value}")?;
                    if o.keys().any(|x| x != "rule" && x != "value") {
                        return Err("lineRule takes rule and value".into());
                    }
                    let v = o.get("value").and_then(|x| x.as_f64()).filter(|x| x.is_finite()).ok_or("lineRule value must be a number")? as f32;
                    line_rule = Some(match o.get("rule").and_then(|x| x.as_str()) {
                        Some("multiple") if (0.5..=10.0).contains(&v) => LineSpacing::Multiple(v),
                        Some("atLeast") if (1.0..=1584.0).contains(&v) => LineSpacing::AtLeast(v),
                        Some("exactly") if (1.0..=1584.0).contains(&v) => LineSpacing::Exactly(v),
                        Some("multiple") => return Err("a line spacing multiple is 0.5 to 10".into()),
                        Some("atLeast" | "exactly") => return Err("an exact or minimum line height is 1 to 1584 points".into()),
                        _ => return Err("the line rule is multiple, atLeast or exactly".into()),
                    });
                }
                "pageBreakBefore" | "keepNext" | "keepLines" | "widowControl" | "contextualSpacing" | "suppressLineNumbers" => {
                    flags.push((k.as_str(), val.as_bool().ok_or_else(|| format!("paragraph field {k} must be true or false"))?));
                }
                "indentFirst" => ifirst = Some(num(k, val, -1440.0, 1440.0)?),
                "spaceBefore" => sb = Some(num(k, val, 0.0, 1584.0)?),
                "spaceAfter" => sa = Some(num(k, val, 0.0, 1584.0)?),
                "lineSpacing" => ls = Some(num(k, val, 0.5, 10.0)?),
                _ => return Err(format!("unknown paragraph field {k}")),
            }
        }
        if !Self::id_span_ok(first, last) {
            return Err("paragraph range is out of bounds".into());
        }
        let mut done: Vec<(usize, wordcraft_doc::Paragraph)> = Vec::with_capacity(last - first + 1);
        for b in first..=last {
            let mut p = match self.para_at(b) {
                Some(p) => p.clone(),
                None => return Err(format!("block {b} is not a paragraph")),
            };
            if let Some(a) = align {
                p.props.align = Some(a);
            }
            if let Some(x) = il {
                p.props.indent_left = Some(x);
            }
            if let Some(n) = drop_cap {
                p.props.drop_cap = if n == 0 { None } else { Some(n) };
            }
            if let Some(x) = shading {
                p.props.shading = x;
            }
            if let Some(x) = border {
                p.props.borders = x.map(|b| wordcraft_doc::props::Borders { top: Some(b), left: Some(b), bottom: Some(b), right: Some(b), between: None, inside_v: None });
            }
            if let Some(x) = ifirst {
                p.props.indent_first = Some(x);
            }
            if let Some(x) = ir {
                p.props.indent_right = Some(x);
            }
            if let Some(t) = &tabs {
                p.props.tabs = Some(t.clone());
            }
            for (k, v) in &flags {
                match *k {
                    "pageBreakBefore" => p.props.page_break_before = Some(*v),
                    "keepNext" => p.props.keep_next = Some(*v),
                    "keepLines" => p.props.keep_lines = Some(*v),
                    "contextualSpacing" => p.props.contextual_spacing = Some(*v),
                    "suppressLineNumbers" => p.props.suppress_line_numbers = Some(*v),
                    _ => p.props.widow_control = Some(*v),
                }
            }
            if let Some(x) = sb {
                p.props.space_before = Some(x);
            }
            if let Some(x) = sa {
                p.props.space_after = Some(x);
            }
            if let Some(x) = ls {
                p.props.line_spacing = Some(LineSpacing::Multiple(x));
            }
            if let Some(x) = line_rule {
                p.props.line_spacing = Some(x);
            }
            done.push((b, p));
        }
        for (b, p) in done {
            self.put_para(b, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Effective paragraph formatting over `first..=last`: each field is the shared value or null when mixed.
    /// `lineSpacing` is the multiple, or null when mixed or set as an exact / at-least height.
    fn do_para_state(&self, first: usize, last: usize) -> Result<String, String> {
        use wordcraft_doc::props::{Align, LineSpacing};
        if !Self::id_span_ok(first, last) {
            return Err("paragraph range is out of bounds".into());
        }
        let mut rows = Vec::new();
        let mut no_line_numbers = Vec::new();
        for b in first..=last {
            match self.para_at(b) {
                Some(p) => {
                    rows.push(self.doc.styles.resolve_para(&p.props));
                    no_line_numbers.push(p.props.suppress_line_numbers == Some(true));
                }
                None => return Err(format!("block {b} is not a paragraph")),
            }
        }
        fn same_str(v: &[&str]) -> Option<String> {
            let first = *v.first()?;
            v.iter().all(|x| *x == first).then(|| first.to_string())
        }
        fn same<T: PartialEq + Copy>(rows: &[wordcraft_doc::resolve::ResolvedPara], f: impl Fn(&wordcraft_doc::resolve::ResolvedPara) -> T) -> Option<T> {
            let first = f(rows.first()?);
            rows.iter().all(|r| f(r) == first).then_some(first)
        }
        let align = same(&rows, |r| r.align).map(|a| match a {
            Align::Center => "center",
            Align::Right => "right",
            Align::Justify | Align::Distribute => "justify",
            Align::Left => "left",
        });
        let ls = same(&rows, |r| match r.line_spacing {
            LineSpacing::Multiple(m) => Some(m.to_bits()),
            _ => None,
        })
        .flatten()
        .map(f32::from_bits);
        Ok(serde_json::json!({
            "align": align,
            "indentLeft": same(&rows, |r| r.indent_left.to_bits()).map(f32::from_bits),
            "indentFirst": same(&rows, |r| r.indent_first.to_bits()).map(f32::from_bits),
            "indentRight": same(&rows, |r| r.indent_right.to_bits()).map(f32::from_bits),
            "tabs": if rows.windows(2).all(|w| w[0].tabs == w[1].tabs) { rows.first().map(|r| serde_json::to_value(&r.tabs).unwrap_or(serde_json::Value::Null)) } else { None },
            "pageBreakBefore": same(&rows, |r| r.page_break_before),
            "keepNext": same(&rows, |r| r.keep_next),
            "keepLines": same(&rows, |r| r.keep_lines),
            "widowControl": same(&rows, |r| r.widow_control),
            "contextualSpacing": same(&rows, |r| r.contextual_spacing),
            "suppressLineNumbers": no_line_numbers.first().filter(|f| no_line_numbers.iter().all(|x| x == *f)),
            "lineRule": same(&rows, |r| match r.line_spacing {
                LineSpacing::Multiple(m) => ("multiple", m.to_bits()),
                LineSpacing::AtLeast(v) => ("atLeast", v.to_bits()),
                LineSpacing::Exactly(v) => ("exactly", v.to_bits()),
            })
            .map(|(k, b)| serde_json::json!({"rule": k, "value": f32::from_bits(b)})),
            "dropCap": same(&rows, |r| r.drop_cap),
            "shading": same(&rows, |r| r.shading).map(|c| c.map(|c| format!("{:02X}{:02X}{:02X}", c.0, c.1, c.2)).unwrap_or_else(|| "none".into())),
            "border": same(&rows, |r| r.borders.map_or(false, |b| b.top.is_some() || b.left.is_some() || b.bottom.is_some() || b.right.is_some())).map(|on| if on { "box" } else { "none" }),
            "spaceBefore": same(&rows, |r| r.space_before.to_bits()).map(f32::from_bits),
            "spaceAfter": same(&rows, |r| r.space_after.to_bits()).map(f32::from_bits),
            "lineSpacing": ls,
            "style": same_str(&rows.iter().map(|r| r.style.as_str()).collect::<Vec<_>>()),
            "list": same_str(&rows.iter().map(|r| self.list_kind(r.numbering)).collect::<Vec<_>>()),
            "listStyle": same_str(&rows.iter().map(|r| self.list_style(r.numbering)).collect::<Vec<_>>()),
            "listLevel": same(&rows, |r| match r.numbering { Some(n) if n.num != 0 => Some(n.level), _ => None }).flatten(),
        })
        .to_string())
    }
    /// `"none"`, `"bullet"` or `"numbered"` for a resolved numbering reference.
    /// The list kinds a user can pick: bullet, dash, square, numbered (1.), numberedParen (1)), upperLetter (A.), lowerLetter (a)), lowerRoman (i.), outline (I. A. 1.), legal (1.1.1.).
    fn list_kind_of(kind: &str) -> Option<wordcraft_doc::numbering::ListKind> {
        use wordcraft_doc::numbering::ListKind;
        Some(match kind {
            "dash" => ListKind::BulletChar('\u{2013}'),
            "square" => ListKind::BulletChar('\u{25AA}'),
            "bullet" | "numbered" | "numberedParen" | "upperLetter" | "lowerLetter" | "lowerRoman" | "outline" | "legal" => ListKind::parse(kind)?,
            _ => return None,
        })
    }
    /// The picker name of a list's first level, `other` for a list from a file that matches none, `none` outside a list.
    fn list_style(&self, n: Option<wordcraft_doc::props::NumRef>) -> &'static str {
        let Some(n) = n.filter(|n| n.num != 0) else { return "none" };
        let Some(l) = self.doc.numbering.level(n.num, 0) else { return "none" };
        // "numbered" and "legal" share their first level; the second level tells them apart. Try the stricter match first.
        for strict in [true, false] {
            for name in ["bullet", "dash", "square", "numbered", "numberedParen", "upperLetter", "lowerLetter", "lowerRoman", "outline", "legal"] {
                if let Some(lk) = Self::list_kind_of(name) {
                    let want = wordcraft_doc::numbering::levels_for(lk);
                    if want.first().is_some_and(|w| w.format == l.format && w.text == l.text) && (!strict || self.list_second_level_matches(n.num, &want)) {
                        return name;
                    }
                }
            }
        }
        "other"
    }
    /// True when level 1 of list `num` has the format and label text of `want[1]` (or neither side has a level 1).
    fn list_second_level_matches(&self, num: u32, want: &[wordcraft_doc::numbering::Level]) -> bool {
        match (self.doc.numbering.level(num, 1), want.get(1)) {
            (Some(a), Some(b)) => a.format == b.format && a.text == b.text,
            (None, None) => true,
            _ => false,
        }
    }
    fn list_kind(&self, n: Option<wordcraft_doc::props::NumRef>) -> &'static str {
        match n {
            Some(n) if n.num != 0 => match self.doc.numbering.level(n.num, n.level.min(8)) {
                Some(l) if l.format == wordcraft_doc::section::NumFormat::Bullet => "bullet",
                Some(_) => "numbered",
                None => "none",
            },
            _ => "none",
        }
    }
    /// Copies built-in styles that the document lacks (and their `basedOn` chain) into `styles`.
    fn ensure_style(styles: &mut wordcraft_doc::StyleSheet, id: &str) -> Result<(), String> {
        let mut next = Some(id.to_string());
        let mut guard = 0;
        while let Some(cur) = next.take() {
            guard += 1;
            if guard > 8 || styles.get(&cur).is_some() {
                continue;
            }
            let st = wordcraft_doc::StyleSheet::builtin().get(&cur).cloned().ok_or_else(|| format!("unknown style {cur}"))?;
            next = st.based_on.clone();
            styles.upsert(st);
        }
        Ok(())
    }
    fn para_span(&self, first: usize, last: usize) -> Result<Vec<wordcraft_doc::Paragraph>, String> {
        if !Self::id_span_ok(first, last) {
            return Err("paragraph range is out of bounds".into());
        }
        (first..=last)
            .map(|b| match self.para_at(b) {
                Some(p) => Ok(p.clone()),
                None => Err(format!("block {b} is not a paragraph")),
            })
            .collect()
    }
    /// Applies a paragraph style from a fixed list to `first..=last`; the document gains the built-in style if it lacks it.
    fn do_set_style(&mut self, first: usize, last: usize, id: &str) -> Result<(), String> {
        const OK: [&str; 8] = ["Normal", "Title", "Subtitle", "Heading1", "Heading2", "Heading3", "Heading4", "Quote"];
        let custom = !OK.contains(&id) && self.doc.styles.get(id).is_some_and(|st| st.kind == wordcraft_doc::StyleKind::Paragraph && !st.hidden);
        if !OK.contains(&id) && !custom {
            return Err(format!("style {id} is not offered"));
        }
        let mut paras = self.para_span(first, last)?;
        let mut styles = self.doc.styles.clone();
        if !custom {
            Self::ensure_style(&mut styles, id)?;
        }
        for p in paras.iter_mut() {
            p.props.style = if id == "Normal" { None } else { Some(id.to_string()) };
        }
        self.doc.styles = styles;
        for (i, p) in paras.into_iter().enumerate() {
            self.put_para(first + i, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// `kind`: `"bullet"`, `"numbered"` or `"none"`. A numbered list continues the list directly above when there is one.
    fn do_set_list(&mut self, first: usize, last: usize, kind: &str) -> Result<(), String> {
        use wordcraft_doc::numbering::ListKind;
        use wordcraft_doc::props::NumRef;
        let mut paras = self.para_span(first, last)?;
        let mut numbering = self.doc.numbering.clone();
        let mut styles = self.doc.styles.clone();
        let num = match kind {
            "none" => 0,
            _ => {
                let lk = Self::list_kind_of(kind).ok_or_else(|| format!("unknown list style {kind}"))?;
                if lk.is_bullet() {
                    numbering.find_kind(lk).unwrap_or_else(|| numbering.add_list(lk))
                } else {
                    // Continue the list right above when it already has this style, else start a new one.
                    let want = wordcraft_doc::numbering::levels_for(lk);
                    let above = if first > 0 && first < CELL_BASE {
                        self.para_at(first - 1).and_then(|p| self.doc.styles.resolve_para(&p.props).numbering)
                    } else {
                        None
                    };
                    match above {
                        Some(n) if n.num != 0 && numbering.level(n.num, 0).zip(want.first()).is_some_and(|(a, b)| a.format == b.format && a.text == b.text) && numbering.level(n.num, 1).zip(want.get(1)).map_or(true, |(a, b)| a.format == b.format && a.text == b.text) => n.num,
                        _ => numbering.add_list(lk),
                    }
                }
            }
        };
        if num != 0 {
            Self::ensure_style(&mut styles, "ListParagraph")?;
        }
        for p in paras.iter_mut() {
            let cur = self.doc.styles.resolve_para(&p.props).numbering;
            if num == 0 {
                if cur.is_some_and(|n| n.num != 0) {
                    p.props.numbering = Some(NumRef { num: 0, level: 0 });
                }
                if p.props.style.as_deref() == Some("ListParagraph") {
                    p.props.style = None;
                }
            } else {
                let level = cur.filter(|n| n.num != 0).map(|n| n.level).unwrap_or(0);
                p.props.numbering = Some(NumRef { num, level });
                if p.props.style.is_none() {
                    p.props.style = Some("ListParagraph".into());
                }
            }
        }
        self.doc.numbering = numbering;
        self.doc.styles = styles;
        for (i, p) in paras.into_iter().enumerate() {
            self.put_para(first + i, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    fn num_format_name(f: wordcraft_doc::section::NumFormat) -> Option<&'static str> {
        use wordcraft_doc::section::NumFormat as F;
        Some(match f {
            F::Decimal => "decimal",
            F::UpperRoman => "upperRoman",
            F::LowerRoman => "lowerRoman",
            F::UpperLetter => "upperLetter",
            F::LowerLetter => "lowerLetter",
            F::DecimalZero => "decimalZero",
            F::Bullet => "bullet",
            _ => return None,
        })
    }
    fn num_format_of(name: &str) -> Option<wordcraft_doc::section::NumFormat> {
        use wordcraft_doc::section::NumFormat as F;
        Some(match name {
            "decimal" => F::Decimal,
            "upperRoman" => F::UpperRoman,
            "lowerRoman" => F::LowerRoman,
            "upperLetter" => F::UpperLetter,
            "lowerLetter" => F::LowerLetter,
            "decimalZero" => F::DecimalZero,
            "bullet" => F::Bullet,
            _ => return None,
        })
    }
    /// The list at paragraph `block`: its nine levels (format, label text, start). `Err` outside a list.
    fn do_list_options(&self, block: usize) -> Result<String, String> {
        let p = self.para_at(block).ok_or("no such paragraph")?;
        let n = self.doc.styles.resolve_para(&p.props).numbering.filter(|n| n.num != 0).ok_or("the paragraph is not in a list")?;
        let num = self.doc.numbering.num(n.num).ok_or("the list no longer exists")?;
        let abs = self.doc.numbering.abstract_of(n.num).ok_or("the list no longer exists")?;
        let levels: Vec<_> = abs
            .levels
            .iter()
            .enumerate()
            .map(|(i, l)| {
                let start = num.start_overrides.iter().find(|(lv, _)| *lv as usize == i).map(|(_, s)| *s).unwrap_or(l.start);
                serde_json::json!({"format": Self::num_format_name(l.format).unwrap_or("other"), "text": l.text, "start": start, "indent": l.indent, "hanging": l.hanging})
            })
            .collect();
        Ok(serde_json::json!({"level": n.level, "levels": levels}).to_string())
    }
    /// Changes one level of the list at paragraph `block`: `{"level":0-8,"start":0-9999,"format":..,"text":..}` (start, format and text are optional).
    /// The list gets its own copy of the definition, so other lists that shared it do not change. Invalid values change nothing.
    fn do_set_list_options(&mut self, block: usize, patch_json: &str) -> Result<(), String> {
        if patch_json.len() > 2_000 {
            return Err("the list options are too large".into());
        }
        let v: serde_json::Value = serde_json::from_str(patch_json).map_err(|e| format!("list options are not valid JSON: {e}"))?;
        let obj = v.as_object().ok_or("list options must be an object")?;
        if let Some(k) = obj.keys().find(|k| !matches!(k.as_str(), "level" | "start" | "format" | "text" | "indent" | "hanging")) {
            return Err(format!("unknown list option {k}"));
        }
        let level = obj.get("level").and_then(|x| x.as_u64()).filter(|l| *l < 9).ok_or("level must be 0 to 8")? as usize;
        let start = match obj.get("start") {
            None => None,
            Some(x) => Some(x.as_u64().filter(|s| *s <= 9999).ok_or("start must be 0 to 9999")? as u32),
        };
        let format = match obj.get("format") {
            None => None,
            Some(x) => Some(x.as_str().and_then(Self::num_format_of).ok_or("unknown number format")?),
        };
        let pt = |key: &str| -> Result<Option<f32>, String> {
            match obj.get(key) {
                None => Ok(None),
                Some(x) => x.as_f64().filter(|v| v.is_finite() && (0.0..=720.0).contains(v)).map(|v| Some(v as f32)).ok_or_else(|| format!("{key} must be 0 to 720 points")),
            }
        };
        let indent = pt("indent")?;
        let hanging = pt("hanging")?;
        let text = match obj.get("text") {
            None => None,
            Some(x) => Some(x.as_str().ok_or("text must be text")?.to_string()),
        };
        let p = self.para_at(block).ok_or("no such paragraph")?;
        let n = self.doc.styles.resolve_para(&p.props).numbering.filter(|n| n.num != 0).ok_or("the paragraph is not in a list")?;
        let mut numbering = self.doc.numbering.clone();
        let cur = numbering.level(n.num, level as u8).cloned().ok_or("the list no longer exists")?;
        let new_indent = indent.unwrap_or(cur.indent);
        let new_hanging = hanging.unwrap_or(cur.hanging);
        if new_hanging > new_indent {
            return Err("the hanging indent cannot be larger than the indent".into());
        }
        let new_format = format.unwrap_or(cur.format);
        let new_text = text.unwrap_or_else(|| cur.text.clone());
        if new_text.chars().count() > 32 || new_text.chars().any(|c| c.is_control()) {
            return Err("the label is limited to 32 characters of plain text".into());
        }
        if matches!(new_format, wordcraft_doc::section::NumFormat::Bullet) {
            if new_text.chars().count() != 1 || new_text == "%" {
                return Err("a bullet is a single character".into());
            }
        } else {
            let mut chars = new_text.chars().peekable();
            let mut has_own = false;
            while let Some(c) = chars.next() {
                if c == '%' {
                    match chars.next().and_then(|d| d.to_digit(10)) {
                        Some(d) if d >= 1 && d as usize <= level + 1 => has_own |= d as usize == level + 1,
                        _ => return Err(format!("a label can only use %1 to %{}", level + 1)),
                    }
                }
            }
            if !has_own {
                return Err(format!("the label must contain %{}", level + 1));
            }
        }
        let old_abs = numbering.num(n.num).ok_or("the list no longer exists")?.abstract_id;
        let mut abs = numbering.abstracts.iter().find(|a| a.id == old_abs).cloned().ok_or("the list no longer exists")?;
        abs.id = numbering.abstracts.iter().map(|a| a.id + 1).max().unwrap_or(0);
        abs.levels[level].format = new_format;
        abs.levels[level].text = new_text;
        abs.levels[level].indent = new_indent;
        abs.levels[level].hanging = new_hanging;
        let new_id = abs.id;
        numbering.abstracts.push(abs);
        if let Some(num) = numbering.nums.iter_mut().find(|x| x.id == n.num) {
            num.abstract_id = new_id;
            if let Some(st) = start {
                num.start_overrides.retain(|(lv, _)| *lv as usize != level);
                num.start_overrides.push((level as u8, st));
            }
        }
        self.doc.numbering = numbering;
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Continues the numbering of the nearest numbered list above `first`: the paragraphs `first..=last` that are in a numbered list, and
    /// every later top-level paragraph of the same list, move to that list. Refuses outside a numbered list, in tables, and when no other numbered list is above.
    fn do_continue_list(&mut self, first: usize, last: usize) -> Result<(), String> {
        use wordcraft_doc::props::NumRef;
        if first >= CELL_BASE || last >= CELL_BASE {
            return Err("continuing a list is not available in tables".into());
        }
        let paras = self.para_span(first, last)?;
        let old = match self.doc.styles.resolve_para(&paras[0].props).numbering.filter(|n| n.num != 0) {
            Some(n) if self.list_kind(Some(n)) == "numbered" => n.num,
            _ => return Err("the paragraph is not in a numbered list".into()),
        };
        let mut target = None;
        let mut id = first;
        while id > 0 && first - id < 100_000 {
            id -= 1;
            if let Some(p) = self.para_at(id) {
                if let Some(n) = self.doc.styles.resolve_para(&p.props).numbering.filter(|n| n.num != 0 && n.num != old) {
                    if self.list_kind(Some(n)) == "numbered" {
                        target = Some(n.num);
                        break;
                    }
                }
            }
        }
        let target = target.ok_or("there is no other numbered list above")?;
        let mut changed: Vec<(usize, wordcraft_doc::Paragraph)> = Vec::new();
        for (i, p) in paras.into_iter().enumerate() {
            let mut p = p;
            if let Some(n) = self.doc.styles.resolve_para(&p.props).numbering.filter(|n| n.num == old) {
                p.props.numbering = Some(NumRef { num: target, level: n.level });
                changed.push((first + i, p));
            }
        }
        let mut id = last + 1;
        let end = self.doc.body.len().min(100_000);
        while id < end {
            if let Some(p) = self.para_at(id) {
                if let Some(n) = self.doc.styles.resolve_para(&p.props).numbering.filter(|n| n.num == old) {
                    let mut p = p.clone();
                    p.props.numbering = Some(NumRef { num: target, level: n.level });
                    changed.push((id, p));
                }
            }
            id += 1;
        }
        for (id, p) in changed {
            self.put_para(id, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// The paragraph and character styles a user can see, with the properties the styles editor edits (first 300).
    fn do_styles_list(&self) -> String {
        let hex = |c: &Option<wordcraft_doc::props::TextColor>| match c {
            Some(wordcraft_doc::props::TextColor::Rgb(r)) => serde_json::Value::String(format!("{:02X}{:02X}{:02X}", r.0, r.1, r.2)),
            _ => serde_json::Value::Null,
        };
        let mut shown: Vec<&wordcraft_doc::Style> = self
            .doc
            .styles
            .styles
            .iter()
            .filter(|st| matches!(st.kind, wordcraft_doc::StyleKind::Paragraph | wordcraft_doc::StyleKind::Character) && !st.hidden && (!st.builtin || st.quick || st.id == "Normal"))
            .collect();
        shown.sort_by_key(|st| st.builtin);
        let items: Vec<_> = shown
            .into_iter()
            .take(300)
            .map(|st| {
                let para = st.kind == wordcraft_doc::StyleKind::Paragraph;
                serde_json::json!({
                    "id": st.id, "name": st.name, "kind": if para { "paragraph" } else { "character" }, "builtin": st.builtin,
                    "basedOn": st.based_on, "font": st.chr.font, "size": st.chr.size, "bold": st.chr.bold, "italic": st.chr.italic, "color": hex(&st.chr.color),
                    "align": if para { st.para.align.map(|a| match a { wordcraft_doc::Align::Left => "left", wordcraft_doc::Align::Center => "center", wordcraft_doc::Align::Right => "right", _ => "justify" }) } else { None },
                    "spaceBefore": if para { st.para.space_before } else { None }, "spaceAfter": if para { st.para.space_after } else { None },
                    "lineSpacing": if para { match st.para.line_spacing { Some(wordcraft_doc::props::LineSpacing::Multiple(m)) => Some(m), _ => None } } else { None },
                })
            })
            .collect();
        serde_json::Value::Array(items).to_string()
    }
    /// Creates (no `id`) or changes (with `id`) a paragraph or character style. Fields: `name`, `kind` (new styles only), `basedOn`
    /// (style id or null), `font`, `size`, `bold`, `italic`, `color` (RRGGBB), and for paragraph styles `align`, `spaceBefore`, `spaceAfter`,
    /// `lineSpacing` (multiple of single). `null` clears a property. Returns the style id. Invalid values change nothing.
    fn do_upsert_style(&mut self, json: &str) -> Result<String, String> {
        use wordcraft_doc::props::{Align, LineSpacing, Rgb, TextColor};
        use wordcraft_doc::StyleKind;
        if json.len() > 2_000 {
            return Err("the style is too large".into());
        }
        let v: serde_json::Value = serde_json::from_str(json).map_err(|e| format!("the style is not valid JSON: {e}"))?;
        let obj = v.as_object().ok_or("the style must be an object")?;
        let mut styles = self.doc.styles.clone();
        let existing = match obj.get("id") {
            None => None,
            Some(x) => {
                let id = x.as_str().ok_or("id must be text")?;
                let st = styles.get(id).filter(|st| matches!(st.kind, StyleKind::Paragraph | StyleKind::Character)).ok_or("no such style")?;
                Some(st.clone())
            }
        };
        let mut st = match &existing {
            Some(e) => e.clone(),
            None => {
                let name = obj.get("name").and_then(|n| n.as_str()).ok_or("a new style needs a name")?;
                let kind = match obj.get("kind").and_then(|k| k.as_str()) {
                    Some("paragraph") => StyleKind::Paragraph,
                    Some("character") => StyleKind::Character,
                    _ => return Err("kind must be paragraph or character".into()),
                };
                let n = styles.styles.iter().filter(|s| !s.builtin).count();
                if n >= 200 {
                    return Err("a document has at most 200 custom styles".into());
                }
                let id = styles.new_id(name.trim());
                wordcraft_doc::Style {
                    id,
                    name: name.trim().to_string(),
                    kind,
                    based_on: if kind == StyleKind::Paragraph { Some("Normal".into()) } else { None },
                    next: None,
                    quick: true,
                    builtin: false,
                    priority: Some(100),
                    ..Default::default()
                }
            }
        };
        let para = st.kind == StyleKind::Paragraph;
        let num = |x: &serde_json::Value, lo: f64, hi: f64, what: &str| -> Result<Option<f32>, String> {
            if x.is_null() {
                return Ok(None);
            }
            x.as_f64().filter(|n| n.is_finite() && (lo..=hi).contains(n)).map(|n| Some(n as f32)).ok_or_else(|| format!("{what} must be {lo} to {hi}"))
        };
        for (k, val) in obj {
            match k.as_str() {
                "id" | "kind" => {}
                "name" => {
                    let name = val.as_str().ok_or("name must be text")?.trim().to_string();
                    if name.is_empty() || name.chars().count() > 60 || name.chars().any(|c| c.is_control()) {
                        return Err("a style name is 1-60 characters of plain text".into());
                    }
                    if existing.as_ref().is_some_and(|e| e.builtin && e.name != name) {
                        return Err("a built-in style cannot be renamed".into());
                    }
                    if styles.styles.iter().any(|o| o.id != st.id && o.name.to_lowercase() == name.to_lowercase()) {
                        return Err("another style already has this name".into());
                    }
                    st.name = name;
                }
                "basedOn" => {
                    st.based_on = if val.is_null() {
                        None
                    } else {
                        let b = val.as_str().ok_or("basedOn must be a style id or null")?;
                        let base = styles.get(b).ok_or("the base style does not exist")?;
                        if base.kind != st.kind {
                            return Err("a style can only be based on a style of the same kind".into());
                        }
                        // No cycles: the base chain must not lead back to this style.
                        if b == st.id || styles.chain(b).iter().any(|c| c.id == st.id) {
                            return Err("a style cannot be based on itself".into());
                        }
                        Some(b.to_string())
                    };
                }
                "font" => {
                    st.chr.font = if val.is_null() {
                        None
                    } else {
                        let f = val.as_str().ok_or("font must be text")?;
                        if f.is_empty() || f.chars().count() > 64 || f.chars().any(|c| c.is_control()) {
                            return Err("font must be 1-64 printable characters".into());
                        }
                        Some(f.to_string())
                    };
                }
                "size" => st.chr.size = num(val, 1.0, 400.0, "size")?.map(|n| (n * 2.0).round() / 2.0),
                "bold" | "italic" => {
                    let b = if val.is_null() { None } else { Some(val.as_bool().ok_or_else(|| format!("{k} must be true, false or null"))?) };
                    if k == "bold" {
                        st.chr.bold = b;
                    } else {
                        st.chr.italic = b;
                    }
                }
                "color" => {
                    st.chr.color = if val.is_null() {
                        None
                    } else {
                        let c = val.as_str().filter(|c| c.len() == 6 && c.bytes().all(|b| b.is_ascii_hexdigit())).ok_or("color must be RRGGBB")?;
                        let n = u32::from_str_radix(c, 16).map_err(|e| e.to_string())?;
                        Some(TextColor::Rgb(Rgb((n >> 16) as u8, (n >> 8) as u8, n as u8)))
                    };
                }
                "align" | "spaceBefore" | "spaceAfter" | "lineSpacing" if !para => return Err(format!("{k} belongs to paragraph styles")),
                "align" => {
                    st.para.align = if val.is_null() {
                        None
                    } else {
                        Some(match val.as_str() {
                            Some("left") => Align::Left,
                            Some("center") => Align::Center,
                            Some("right") => Align::Right,
                            Some("justify") => Align::Justify,
                            _ => return Err("align must be left, center, right or justify".into()),
                        })
                    };
                }
                "spaceBefore" => st.para.space_before = num(val, 0.0, 1584.0, "spaceBefore")?,
                "spaceAfter" => st.para.space_after = num(val, 0.0, 1584.0, "spaceAfter")?,
                "lineSpacing" => st.para.line_spacing = num(val, 0.5, 5.0, "lineSpacing")?.map(LineSpacing::Multiple),
                _ => return Err(format!("unknown style field {k}")),
            }
        }
        let id = st.id.clone();
        styles.upsert(st);
        self.doc.styles = styles;
        self.pages = DocLayout::default();
        Ok(id)
    }
    /// Deletes a custom style: paragraphs and runs that used it fall back to Normal / no character style, and styles based on it
    /// move to its own base. Built-in styles stay.
    fn do_delete_style(&mut self, id: &str) -> Result<(), String> {
        let st = self.doc.styles.get(id).filter(|s| matches!(s.kind, wordcraft_doc::StyleKind::Paragraph | wordcraft_doc::StyleKind::Character)).ok_or("no such style")?.clone();
        if st.builtin {
            return Err("a built-in style cannot be deleted".into());
        }
        let mut ids: Vec<usize> = (0..self.doc.body.len().min(100_000)).collect();
        ids.extend((0..self.cell_paras().count().min(CELL_LIST_MAX)).map(|k| CELL_BASE + k));
        let mut changed: Vec<(usize, wordcraft_doc::Paragraph)> = Vec::new();
        for i in ids {
            let Some(p) = self.para_at(i) else { continue };
            let uses_para = p.props.style.as_deref() == Some(id);
            let uses_char = p.runs.iter().any(|r| r.props.style.as_deref() == Some(id)) || p.mark.style.as_deref() == Some(id);
            if !uses_para && !uses_char {
                continue;
            }
            let mut p = p.clone();
            if uses_para {
                p.props.style = None;
            }
            for r in p.runs.iter_mut() {
                if r.props.style.as_deref() == Some(id) {
                    r.props.style = None;
                }
            }
            if p.mark.style.as_deref() == Some(id) {
                p.mark.style = None;
            }
            changed.push((i, p));
        }
        let mut styles = self.doc.styles.clone();
        styles.styles.retain(|s| s.id != id);
        for s in styles.styles.iter_mut() {
            if s.based_on.as_deref() == Some(id) {
                s.based_on = st.based_on.clone();
            }
            if s.next.as_deref() == Some(id) {
                s.next = None;
            }
        }
        self.doc.styles = styles;
        for (i, p) in changed {
            self.put_para(i, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// True for a paragraph this editor treats as part of a table of contents: style TOC Heading or TOC 1-9, no inline objects, no section break.
    fn is_toc_para(b: &Block) -> bool {
        match b {
            Block::Para(p) => {
                let ok = p.props.style.as_deref().is_some_and(|s| s == "TOCHeading" || s.strip_prefix("TOC").and_then(|n| n.parse::<u8>().ok()).is_some_and(|n| (1..=9).contains(&n)));
                ok && p.section.is_none() && p.objects.is_empty()
            }
            _ => false,
        }
    }
    /// The headings (outline level, text, block index) a contents list is made from: top-level paragraphs with an outline level, not in a TOC style.
    fn toc_entries(&self, levels: u8) -> Result<Vec<(u8, String, usize)>, String> {
        let mut out = Vec::new();
        for (i, b) in self.doc.body.iter().enumerate() {
            let Block::Para(p) = &**b else { continue };
            if p.props.style.as_deref().is_some_and(|s| s.starts_with("TOC")) {
                continue;
            }
            let Some(l) = self.doc.styles.resolve_para(&p.props).outline_level.filter(|l| (*l as usize) < 9 && *l < levels) else { continue };
            let t: String = p.plain_text().chars().filter(|c| !c.is_control() && *c != OBJ).collect();
            let t: String = t.trim().chars().take(200).collect();
            if t.is_empty() {
                continue;
            }
            if out.len() >= 500 {
                return Err("the document has more than 500 headings for a contents list".into());
            }
            out.push((l, t, i));
        }
        Ok(out)
    }
    /// The contents paragraphs: an optional title and one entry per heading, with a right tab and dot leader before the page number when `pages` is given.
    fn toc_paras(&self, entries: &[(u8, String, usize)], pages: Option<&[usize]>, title: &str) -> Vec<wordcraft_doc::Paragraph> {
        let sec = &self.doc.last_section;
        let n = sec.columns.count.clamp(1, 45) as f32;
        let width = if n > 1.0 { (sec.text_width() - sec.columns.space.max(0.0) * (n - 1.0)) / n } else { sec.text_width() };
        let mut out = Vec::new();
        if !title.is_empty() {
            out.push(wordcraft_doc::Paragraph::with_text(title, CharProps::default()).styled("TOCHeading"));
        }
        for (i, (l, t, _)) in entries.iter().enumerate() {
            let text = match pages {
                Some(pg) => format!("{t}\t{}", pg.get(i).copied().unwrap_or(1)),
                None => t.clone(),
            };
            let mut p = wordcraft_doc::Paragraph::with_text(&text, CharProps::default()).styled(&format!("TOC{}", l + 1));
            if pages.is_some() {
                p.props.tabs = Some(vec![wordcraft_doc::props::TabStop { pos: width.max(36.0), align: wordcraft_doc::props::TabAlign::Right, leader: wordcraft_doc::props::TabLeader::Dot }]);
            }
            out.push(p);
        }
        out
    }
    /// Replaces `remove` blocks at `at` with a fresh contents list (title, levels 1..=`levels`, page numbers or not).
    /// Page numbers come from the layout and are computed twice, because the list itself moves the headings.
    fn build_toc(&mut self, at: usize, remove: usize, levels: u8, title: &str, pages: bool) -> Result<(), String> {
        if !(1..=9).contains(&levels) {
            return Err("a contents list uses 1 to 9 heading levels".into());
        }
        if title.chars().count() > 100 || title.chars().any(|c| c.is_control()) {
            return Err("the contents title is limited to 100 characters of plain text".into());
        }
        let first = self.toc_entries(levels)?;
        if first.is_empty() {
            return Err("the document has no headings to list".into());
        }
        if self.doc.body.len() + first.len() + 1 >= 100_000 {
            return Err("the document has too many blocks".into());
        }
        let mut styles = self.doc.styles.clone();
        if !title.is_empty() {
            Self::ensure_style(&mut styles, "TOCHeading")?;
        }
        for n in 1..=levels {
            Self::ensure_style(&mut styles, &format!("TOC{n}"))?;
        }
        self.doc.styles = styles;
        for _ in 0..remove {
            self.doc.body.remove(at);
        }
        for (k, p) in self.toc_paras(&first, None, title).into_iter().enumerate() {
            self.doc.body.insert(at + k, wordcraft_doc::para_block(p));
        }
        if pages {
            for _ in 0..2 {
                self.paginate();
                let entries = self.toc_entries(levels)?;
                let nums: Vec<usize> = entries.iter().map(|(_, _, i)| self.pages.caret(&Pos::body(*i, 0)).map_or(1, |c| c.page + 1)).collect();
                for (k, p) in self.toc_paras(&entries, Some(&nums), title).into_iter().enumerate() {
                    self.doc.body[at + k] = wordcraft_doc::para_block(p);
                }
            }
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// The contents run around top-level block `at` (or the first one in the document): (start, length, title, levels, has page numbers).
    fn find_toc(&self, at: usize) -> Result<(usize, usize, String, u8, bool), String> {
        let body = &self.doc.body;
        let top = if at >= CELL_BASE { self.cell_paras().nth(at - CELL_BASE).ok_or("no such paragraph")?[0] } else { at };
        let seed = if top < body.len() && Self::is_toc_para(&body[top]) { top } else { body.iter().position(|b| Self::is_toc_para(b)).ok_or("the document has no table of contents")? };
        let mut start = seed;
        while start > 0 && Self::is_toc_para(&body[start - 1]) {
            start -= 1;
        }
        let mut end = seed;
        while end + 1 < body.len() && Self::is_toc_para(&body[end + 1]) {
            end += 1;
        }
        let (mut title, mut levels, mut pages) = (String::new(), 0u8, false);
        for (i, b) in body[start..=end].iter().enumerate() {
            let Block::Para(p) = &**b else { continue };
            match p.props.style.as_deref().and_then(|s| s.strip_prefix("TOC")).and_then(|n| n.parse::<u8>().ok()) {
                Some(n) => {
                    levels = levels.max(n);
                    pages |= p.text.contains('\t');
                }
                None if i == 0 => title = p.plain_text().chars().take(100).collect(),
                None => {}
            }
        }
        Ok((start, end - start + 1, title, if levels == 0 { 3 } else { levels }, pages))
    }
    /// Inserts a contents list built from the headings before top-level block `block` (after the table when `block` is in a cell).
    fn do_insert_toc(&mut self, block: usize, levels: u8, title: &str, pages: bool) -> Result<(), String> {
        let top = if block >= CELL_BASE { self.cell_paras().nth(block - CELL_BASE).ok_or("no such paragraph")?[0] + 1 } else { block };
        if top > self.doc.body.len() {
            return Err(format!("no block {block}"));
        }
        self.build_toc(top, 0, levels, title.trim(), pages)
    }
    /// Rebuilds the contents list at `block` (or the first one) from the current headings, keeping its title, depth and page numbers setting.
    fn do_update_toc(&mut self, block: usize) -> Result<(), String> {
        let (start, len, title, levels, pages) = self.find_toc(block)?;
        self.build_toc(start, len, levels, &title, pages)
    }
    /// Removes the contents list at `block` (or the first one).
    fn do_remove_toc(&mut self, block: usize) -> Result<(), String> {
        let (start, len, ..) = self.find_toc(block)?;
        for _ in 0..len {
            self.doc.body.remove(start);
        }
        if self.doc.body.is_empty() {
            self.doc.body.push(wordcraft_doc::para_block(wordcraft_doc::Paragraph::new()));
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Restarts numbering at `first`: the paragraphs `first..=last` that are in a numbered list, and every later top-level
    /// paragraph of the same list, move to a new list instance that starts again at 1. Refuses when `first` is not in a numbered list.
    fn do_restart_list(&mut self, first: usize, last: usize) -> Result<(), String> {
        use wordcraft_doc::props::NumRef;
        let paras = self.para_span(first, last)?;
        let old = match self.doc.styles.resolve_para(&paras[0].props).numbering.filter(|n| n.num != 0) {
            Some(n) if self.list_kind(Some(n)) == "numbered" => n.num,
            _ => return Err("the paragraph is not in a numbered list".into()),
        };
        let mut numbering = self.doc.numbering.clone();
        let fresh = numbering.restart(old).ok_or("the list no longer exists")?;
        let mut changed: Vec<(usize, wordcraft_doc::Paragraph)> = Vec::new();
        for (i, p) in paras.into_iter().enumerate() {
            let mut p = p;
            if let Some(n) = self.doc.styles.resolve_para(&p.props).numbering.filter(|n| n.num == old) {
                p.props.numbering = Some(NumRef { num: fresh, level: n.level });
                changed.push((first + i, p));
            }
        }
        if first < CELL_BASE {
            let mut id = last + 1;
            let end = self.doc.body.len().min(100_000);
            while id < end && changed.len() < 100_000 {
                if let Some(p) = self.para_at(id) {
                    if let Some(n) = self.doc.styles.resolve_para(&p.props).numbering.filter(|n| n.num == old) {
                        let mut p = p.clone();
                        p.props.numbering = Some(NumRef { num: fresh, level: n.level });
                        changed.push((id, p));
                    }
                }
                id += 1;
            }
        }
        self.doc.numbering = numbering;
        for (id, p) in changed {
            self.put_para(id, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Moves list paragraphs in `first..=last` by `delta` levels (clamped 0..=8). Refuses when none is in a list.
    fn do_list_level(&mut self, first: usize, last: usize, delta: i32) -> Result<(), String> {
        use wordcraft_doc::props::NumRef;
        if !(-8..=8).contains(&delta) {
            return Err("level change must be between -8 and 8".into());
        }
        let mut paras = self.para_span(first, last)?;
        let mut any = false;
        for p in paras.iter_mut() {
            if let Some(n) = self.doc.styles.resolve_para(&p.props).numbering.filter(|n| n.num != 0) {
                any = true;
                let lv = (n.level as i32 + delta).clamp(0, 8) as u8;
                p.props.numbering = Some(NumRef { num: n.num, level: lv });
            }
        }
        if !any {
            return Err("the selection is not in a list".into());
        }
        for (i, p) in paras.into_iter().enumerate() {
            self.put_para(first + i, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Table structure edit relative to the cell holding paragraph `block` (a cell id). `op` is `row_above`, `row_below`,
    /// `delete_row`, `col_left`, `col_right`, `delete_col`, `merge_right`, `split_cell`, `merge_down` or `split_down`. The table is cloned, edited and swapped in, so a refusal
    /// leaves the document untouched. Block ids of cell paragraphs shift afterwards; the host re-reads `blocks()`.
    /// Sets the width in points (20-1000) of the grid column under cell paragraph `block`. The cell must not span columns.
    fn do_set_col_width(&mut self, block: usize, width: f32) -> Result<(), String> {
        if !width.is_finite() || !(20.0..=1000.0).contains(&width) {
            return Err("a column is 20 to 1000 points wide".into());
        }
        if block < CELL_BASE {
            return Err("the caret is not inside a table cell".into());
        }
        let [b, r, c, _] = self.cell_paras().nth(block - CELL_BASE).ok_or_else(|| format!("no cell paragraph {block}"))?;
        let Some(Block::Table(t)) = self.doc.body.get(b).map(|x| &**x) else { return Err("the caret is not inside a table".into()) };
        let mut t2 = t.clone();
        let row = t2.rows.get(r).ok_or("no such row")?;
        let g: usize = row.cells.iter().take(c).map(|x| x.span()).sum();
        if row.cells.get(c).ok_or("no such cell")?.span() != 1 {
            return Err("pick a cell that is not merged across columns".into());
        }
        if t2.grid.len() != t2.cols() || g >= t2.grid.len() {
            return Err("this table has no usable column grid".into());
        }
        t2.grid[g] = width;
        for row in t2.rows.iter_mut() {
            let mut x = 0;
            for cell in row.cells.iter_mut() {
                if x == g && cell.span() == 1 {
                    cell.props.width = Some(width);
                }
                x += cell.span();
            }
        }
        self.doc.body[b] = Arc::new(Block::Table(t2));
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Styles the cell under `block` (`scope` "cell") or every cell of its table ("table") from a JSON object with any of:
    /// `fill` ("RRGGBB" or "none"), `border` ({"width":0.25-12,"color":"RRGGBB"|"auto"} or "none"), `rowHeight` (0 = automatic, else 1-400 pt minimum)
    /// and `padding` (0-72 pt, all four sides). Unknown keys, bad types and out-of-range values change nothing.
    fn do_style_table(&mut self, block: usize, scope: &str, json: &str) -> Result<(), String> {
        use wordcraft_doc::props::{Border, BorderStyle, Borders, HeightRule, Rgb};
        if json.len() > 512 {
            return Err("the style is too long".into());
        }
        let v: serde_json::Value = serde_json::from_str(json).map_err(|_| "the style is not valid JSON".to_string())?;
        let obj = v.as_object().ok_or("the style must be an object")?;
        if obj.is_empty() {
            return Err("nothing to change".into());
        }
        let mut fill: Option<Option<Rgb>> = None;
        let mut border: Option<Border> = None;
        let mut row_h: Option<f32> = None;
        let mut pad: Option<f32> = None;
        for (k, val) in obj {
            match k.as_str() {
                "fill" => {
                    let s = val.as_str().ok_or("fill must be text")?;
                    fill = Some(if s == "none" { None } else { Some(Rgb::parse(s).ok_or("fill must be RRGGBB or none")?) });
                }
                "border" => {
                    border = Some(match val {
                        serde_json::Value::String(s) if s == "none" => Border { style: BorderStyle::None, width: 0.0, color: None, space: 0.0 },
                        serde_json::Value::Object(o) => {
                            if o.keys().any(|k| k != "width" && k != "color") {
                                return Err("unknown border field".into());
                            }
                            let w = o.get("width").and_then(|x| x.as_f64()).ok_or("border width is missing")? as f32;
                            if !w.is_finite() || !(0.25..=12.0).contains(&w) {
                                return Err("a border is 0.25 to 12 points wide".into());
                            }
                            let color = match o.get("color").and_then(|x| x.as_str()) {
                                Some("auto") | None => None,
                                Some(c) => Some(Rgb::parse(c).ok_or("border colour must be RRGGBB or auto")?),
                            };
                            Border { style: BorderStyle::Single, width: w, color, space: 0.0 }
                        }
                        _ => return Err("border must be \"none\" or {width, color}".into()),
                    });
                }
                "rowHeight" => {
                    let h = val.as_f64().ok_or("row height must be a number")? as f32;
                    if !h.is_finite() || h < 0.0 || h > 400.0 || (h > 0.0 && h < 1.0) {
                        return Err("a row height is 0 (automatic) or 1 to 400 points".into());
                    }
                    row_h = Some(h);
                }
                "padding" => {
                    let p = val.as_f64().ok_or("padding must be a number")? as f32;
                    if !p.is_finite() || !(0.0..=72.0).contains(&p) {
                        return Err("padding is 0 to 72 points".into());
                    }
                    pad = Some(p);
                }
                _ => return Err(format!("unknown style field {k}")),
            }
        }
        if scope != "cell" && scope != "table" {
            return Err("scope is cell or table".into());
        }
        if block < CELL_BASE {
            return Err("the caret is not inside a table cell".into());
        }
        let [b, r, c, _] = self.cell_paras().nth(block - CELL_BASE).ok_or_else(|| format!("no cell paragraph {block}"))?;
        let Some(Block::Table(t)) = self.doc.body.get(b).map(|x| &**x) else { return Err("the caret is not inside a table".into()) };
        let mut t2 = t.clone();
        for (ri, row) in t2.rows.iter_mut().enumerate() {
            if scope == "cell" && ri != r {
                continue;
            }
            if let Some(h) = row_h {
                row.props.height = if h == 0.0 { None } else { Some(h) };
                row.props.height_rule = if h == 0.0 { HeightRule::Auto } else { HeightRule::AtLeast };
            }
            for (ci, cell) in row.cells.iter_mut().enumerate() {
                if scope == "cell" && ci != c {
                    continue;
                }
                if let Some(f) = fill {
                    cell.props.shading = f;
                }
                if let Some(bd) = border {
                    cell.props.borders = Some(Borders { top: Some(bd), left: Some(bd), bottom: Some(bd), right: Some(bd), between: None, inside_v: None });
                }
                if let Some(p) = pad {
                    cell.props.margins = Some([p, p, p, p]);
                }
            }
        }
        self.doc.body[b] = Arc::new(Block::Table(t2));
        self.pages = DocLayout::default();
        Ok(())
    }
    /// The table, row and cell a cell-paragraph block id belongs to.
    fn table_spot(&self, block: usize) -> Result<[usize; 4], String> {
        if block < CELL_BASE {
            return Err("the caret is not inside a table cell".into());
        }
        let spot = self.cell_paras().nth(block - CELL_BASE).ok_or_else(|| format!("no cell paragraph {block}"))?;
        match self.doc.body.get(spot[0]).map(|x| &**x) {
            Some(Block::Table(_)) => Ok(spot),
            _ => Err("the caret is not inside a table".into()),
        }
    }
    /// `null` (back to the default) or `{top,left,bottom,right}` in points, each 0 to 72; every side must be given.
    fn pad_of(val: &serde_json::Value) -> Result<Option<[f32; 4]>, String> {
        if val.is_null() {
            return Ok(None);
        }
        let o = val.as_object().ok_or("padding must be null or an object with top, left, bottom and right")?;
        let mut out = [0.0f32; 4];
        for (i, k) in ["top", "left", "bottom", "right"].iter().enumerate() {
            let x = o.get(*k).and_then(|x| x.as_f64()).ok_or_else(|| format!("padding needs a number for {k}"))? as f32;
            if !x.is_finite() || !(0.0..=72.0).contains(&x) {
                return Err("padding is 0 to 72 points on each side".into());
            }
            out[i] = (x * 20.0).round() / 20.0;
        }
        if o.len() != 4 {
            return Err("padding takes only top, left, bottom and right".into());
        }
        Ok(Some(out))
    }
    fn pad_json(m: Option<[f32; 4]>) -> serde_json::Value {
        match m {
            Some(m) => serde_json::json!({"top": m[0], "left": m[1], "bottom": m[2], "right": m[3]}),
            None => serde_json::Value::Null,
        }
    }
    /// Layout of the table holding cell paragraph `block`: alignment, width, repeated header row (this row), rows kept whole, the cell's vertical alignment and alt text.
    fn do_table_layout_state(&self, block: usize) -> Result<String, String> {
        use wordcraft_doc::props::{HeightRule, VAlign};
        let [b, r, c, _] = self.table_spot(block)?;
        let Some(Block::Table(t)) = self.doc.body.get(b).map(|x| &**x) else { return Err("not a table".into()) };
        let row = t.rows.get(r).ok_or("no such row")?;
        let cell = row.cells.get(c).ok_or("no such cell")?;
        let align = match t.props.align {
            Some(wordcraft_doc::Align::Left) => serde_json::json!("left"),
            Some(wordcraft_doc::Align::Center) => serde_json::json!("center"),
            Some(wordcraft_doc::Align::Right) => serde_json::json!("right"),
            _ => serde_json::Value::Null,
        };
        Ok(serde_json::json!({
            "align": align,
            "widthPct": t.props.width_pct,
            "headerRow": row.props.header,
            "keepRows": t.rows.iter().all(|x| x.props.cant_split),
            "cellValign": match cell.props.valign { VAlign::Top => "top", VAlign::Center => "center", VAlign::Bottom => "bottom" },
            "caption": t.props.caption.clone().unwrap_or_default(),
            "rowRule": match row.props.height_rule { HeightRule::Auto => "auto", HeightRule::AtLeast => "atLeast", HeightRule::Exact => "exact" },
            "rowHeight": row.props.height,
            "cellPadding": Self::pad_json(t.props.cell_margins),
            "cellMargins": Self::pad_json(cell.props.margins),
            "cellShading": cell.props.shading.map(|c| c.hex()),
        })
        .to_string())
    }
    /// `{"align"?: "left"|"center"|"right"|null, "widthPct"?: null|10-100, "headerRow"?: bool (this row repeats at the top of each page),
    /// "keepRows"?: bool (no row splits across pages), "cellValign"?: "top"|"center"|"bottom", "caption"?: text up to 500 characters}`.
    /// Anything invalid refuses the whole patch.
    fn do_set_table_layout(&mut self, block: usize, json: &str) -> Result<(), String> {
        use wordcraft_doc::props::{HeightRule, VAlign};
        if json.len() > 2048 {
            return Err("the table layout is too long".into());
        }
        let v: serde_json::Value = serde_json::from_str(json).map_err(|_| "the table layout is not valid JSON".to_string())?;
        let obj = v.as_object().ok_or("the table layout must be an object")?;
        if obj.is_empty() {
            return Err("nothing to change".into());
        }
        let [b, r, c, _] = self.table_spot(block)?;
        let mut align: Option<Option<wordcraft_doc::Align>> = None;
        let mut width: Option<Option<f32>> = None;
        let (mut header, mut keep, mut valign, mut caption) = (None, None, None, None);
        let mut row_height: Option<(HeightRule, Option<f32>)> = None;
        let mut all_rows = false;
        let (mut pad, mut cmar): (Option<Option<[f32; 4]>>, Option<Option<[f32; 4]>>) = (None, None);
        let mut shade: Option<(Option<wordcraft_doc::props::Rgb>, &'static str)> = None;
        for (k, val) in obj {
            match k.as_str() {
                "align" => {
                    align = Some(match val {
                        serde_json::Value::Null => None,
                        serde_json::Value::String(x) if x == "left" => Some(wordcraft_doc::Align::Left),
                        serde_json::Value::String(x) if x == "center" => Some(wordcraft_doc::Align::Center),
                        serde_json::Value::String(x) if x == "right" => Some(wordcraft_doc::Align::Right),
                        _ => return Err("table alignment is left, center, right or null".into()),
                    })
                }
                "widthPct" => {
                    width = Some(match val {
                        serde_json::Value::Null => None,
                        _ => {
                            let x = val.as_f64().ok_or("the table width must be a number or null")? as f32;
                            if !x.is_finite() || !(10.0..=100.0).contains(&x) {
                                return Err("a table is 10 to 100 percent wide".into());
                            }
                            Some(x)
                        }
                    })
                }
                "headerRow" => header = Some(val.as_bool().ok_or("headerRow must be true or false")?),
                "keepRows" => keep = Some(val.as_bool().ok_or("keepRows must be true or false")?),
                "cellValign" => {
                    valign = Some(match val.as_str() {
                        Some("top") => VAlign::Top,
                        Some("center") => VAlign::Center,
                        Some("bottom") => VAlign::Bottom,
                        _ => return Err("cell alignment is top, center or bottom".into()),
                    })
                }
                "rowHeight" => {
                    let o = val.as_object().ok_or("rowHeight must be an object")?;
                    if o.keys().any(|k| k != "rule" && k != "value") {
                        return Err("rowHeight takes only rule and value".into());
                    }
                    row_height = Some(match o.get("rule").and_then(|x| x.as_str()) {
                        Some("auto") if !o.contains_key("value") => (HeightRule::Auto, None),
                        Some(rule @ ("atLeast" | "exact")) => {
                            let x = o.get("value").and_then(|x| x.as_f64()).ok_or("a row height needs a value in points")? as f32;
                            if !x.is_finite() || !(1.0..=1584.0).contains(&x) {
                                return Err("a row is 1 to 1584 points high".into());
                            }
                            (if rule == "exact" { HeightRule::Exact } else { HeightRule::AtLeast }, Some((x * 20.0).round() / 20.0))
                        }
                        _ => return Err("the row height rule is auto (no value), atLeast or exact".into()),
                    });
                }
                "allRows" => all_rows = val.as_bool().ok_or("allRows must be true or false")?,
                "cellPadding" => pad = Some(Self::pad_of(val)?),
                "cellMargins" => cmar = Some(Self::pad_of(val)?),
                "shading" => {
                    let o = val.as_object().ok_or("shading must be an object with color and scope")?;
                    if o.len() != 2 {
                        return Err("shading takes only color and scope".into());
                    }
                    let color = Self::parse_para_rgb(o.get("color").ok_or("shading needs a color")?).map_err(|_| "the fill is none or RRGGBB".to_string())?;
                    let scope = match o.get("scope").and_then(|x| x.as_str()) {
                        Some("cell") => "cell",
                        Some("row") => "row",
                        Some("column") => "column",
                        Some("table") => "table",
                        _ => return Err("the fill scope is cell, row, column or table".into()),
                    };
                    shade = Some((color, scope));
                }
                "caption" => {
                    let t = val.as_str().ok_or("caption must be text")?;
                    Self::hf_validate(t).map_err(|_| "alt text is limited to 500 characters without line breaks".to_string())?;
                    caption = Some(t.to_string());
                }
                _ => return Err(format!("unknown table layout field {k}")),
            }
        }
        if all_rows && row_height.is_none() {
            return Err("allRows only goes with rowHeight".into());
        }
        let Some(Block::Table(t)) = self.doc.body.get(b).map(|x| &**x) else { return Err("not a table".into()) };
        let mut t2 = t.clone();
        if let Some((rule, h)) = row_height {
            if all_rows {
                for row in t2.rows.iter_mut() {
                    row.props.height_rule = rule;
                    row.props.height = h;
                }
            } else {
                let row = t2.rows.get_mut(r).ok_or("no such row")?;
                row.props.height_rule = rule;
                row.props.height = h;
            }
        }
        if let Some(a) = align {
            t2.props.align = a;
        }
        if let Some(w) = width {
            t2.props.width_pct = w;
        }
        if let Some(cap) = caption {
            t2.props.caption = if cap.is_empty() { None } else { Some(cap) };
        }
        if let Some(h) = header {
            t2.rows.get_mut(r).ok_or("no such row")?.props.header = h;
        }
        if let Some(k) = keep {
            for row in t2.rows.iter_mut() {
                row.props.cant_split = k;
            }
        }
        if let Some(va) = valign {
            t2.rows.get_mut(r).and_then(|row| row.cells.get_mut(c)).ok_or("no such cell")?.props.valign = va;
        }
        if let Some(m) = pad {
            t2.props.cell_margins = m;
        }
        if let Some(m) = cmar {
            t2.rows.get_mut(r).and_then(|row| row.cells.get_mut(c)).ok_or("no such cell")?.props.margins = m;
        }
        if let Some((fill, scope)) = shade {
            let g = t2.grid_col(r, c);
            let cols: Vec<(usize, usize)> = (0..t2.rows.len())
                .flat_map(|ri| (0..t2.rows[ri].cells.len()).map(move |ci| (ri, ci)))
                .filter(|&(ri, ci)| match scope {
                    "cell" => ri == r && ci == c,
                    "row" => ri == r,
                    "column" => t2.cell_at_grid(ri, g) == Some(ci),
                    _ => true,
                })
                .collect();
            for (ri, ci) in cols {
                t2.rows[ri].cells[ci].props.shading = fill;
            }
        }
        self.doc.body[b] = Arc::new(Block::Table(t2));
        self.pages = DocLayout::default();
        Ok(())
    }
    fn do_table_edit(&mut self, block: usize, op: &str) -> Result<(), String> {
        use wordcraft_doc::props::VMerge;
        if block < CELL_BASE {
            return Err("the caret is not inside a table cell".into());
        }
        let [b, r, c, _] = self.cell_paras().nth(block - CELL_BASE).ok_or_else(|| format!("no cell paragraph {block}"))?;
        let Some(Block::Table(t)) = self.doc.body.get(b).map(|x| &**x) else { return Err("the caret is not inside a table".into()) };
        if op == "delete_table" {
            // The whole table goes; a paragraph always stays on at least one side so text can still be typed there.
            self.doc.body.remove(b);
            let para_at = |i: usize| matches!(self.doc.body.get(i).map(|x| &**x), Some(Block::Para(_)));
            if !(b > 0 && para_at(b - 1)) && !para_at(b) {
                self.doc.body.insert(b, wordcraft_doc::para_block(wordcraft_doc::Paragraph::new()));
            }
            self.pages = DocLayout::default();
            return Ok(());
        }
        if op == "table_to_text" {
            // One paragraph per row, cells joined by tabs. Merged cells, objects and nested tables would lose their meaning, so they refuse.
            let mut paras = Vec::new();
            for row in &t.rows {
                if row.cells.iter().any(|x| x.span() != 1 || x.props.vmerge != VMerge::None) {
                    return Err("a table with merged cells cannot be turned into text".into());
                }
                let mut parts = Vec::new();
                for cell in &row.cells {
                    let mut texts = Vec::new();
                    for blk in &cell.blocks {
                        let Block::Para(p) = &**blk else { return Err("a table with a table inside a cell cannot be turned into text".into()) };
                        if !p.object_offsets().is_empty() {
                            return Err("a table with pictures or other objects in its cells cannot be turned into text".into());
                        }
                        texts.push(p.plain_text().replace(['\t', '\n', '\r'], " "));
                    }
                    parts.push(texts.join(" "));
                }
                let line = parts.join("\t");
                paras.push(wordcraft_doc::para_block(if line.is_empty() {
                    wordcraft_doc::Paragraph::new()
                } else {
                    wordcraft_doc::Paragraph::with_text(&line, wordcraft_doc::props::CharProps::default())
                }));
            }
            if paras.is_empty() {
                return Err("the table has no rows".into());
            }
            self.doc.body.splice(b..b + 1, paras);
            self.pages = DocLayout::default();
            return Ok(());
        }
        let mut t2 = t.clone();
        let row = t2.rows.get(r).ok_or("no such row")?;
        let grid_start: usize = row.cells.iter().take(c).map(|x| x.span()).sum();
        let span = row.cells.get(c).ok_or("no such cell")?.span();
        match op {
            "row_above" | "row_below" => {
                let n = t2.rows.len();
                t2.insert_row(if op == "row_above" { r } else { r + 1 }, r);
                if t2.rows.len() == n {
                    return Err("the table has reached its row limit".into());
                }
            }
            "delete_row" => {
                if t2.rows.len() <= 1 {
                    return Err("a table needs at least one row".into());
                }
                // A vertical merge that starts in this row hands its content and its start to the row below.
                let mut x = 0;
                let starts: Vec<(usize, usize)> = t2.rows[r].cells.iter().enumerate().filter_map(|(i, cell)| {
                    let at = x;
                    x += cell.span();
                    (cell.props.vmerge == VMerge::Restart).then_some((i, at))
                }).collect();
                for (i, at) in starts {
                    let span_i = t2.rows[r].cells[i].span();
                    let blocks = t2.rows[r].cells[i].blocks.clone();
                    let Some(next) = t2.rows.get(r + 1) else { continue };
                    let mut gx = 0;
                    let mut found = None;
                    for (k, cell) in next.cells.iter().enumerate() {
                        if gx == at {
                            found = Some(k);
                            break;
                        }
                        gx += cell.span();
                    }
                    let Some(k) = found else { continue };
                    if t2.rows[r + 1].cells[k].props.vmerge != VMerge::Continue || t2.rows[r + 1].cells[k].span() != span_i {
                        continue;
                    }
                    // The merge goes on below when the row after next still continues it.
                    let goes_on = t2.rows.get(r + 2).is_some_and(|row2| {
                        let mut gx = 0;
                        row2.cells.iter().any(|cell| {
                            let hit = gx == at && cell.props.vmerge == VMerge::Continue && cell.span() == span_i;
                            gx += cell.span();
                            hit
                        })
                    });
                    let target = &mut t2.rows[r + 1].cells[k];
                    target.blocks = blocks;
                    target.props.vmerge = if goes_on { VMerge::Restart } else { VMerge::None };
                }
                t2.delete_row(r);
            }
            "sort_asc" | "sort_desc" => {
                // Rows below a header row are ordered by the text of the caret's column: numbers first (by value), then text without regard to case. Equal rows keep their order.
                let cols = t2.rows.first().map_or(0, |x| x.cells.len());
                if t2.rows.iter().any(|row| row.cells.len() != cols || row.cells.iter().any(|x| x.span() != 1 || x.props.vmerge != VMerge::None)) {
                    return Err("a table with merged cells cannot be sorted".into());
                }
                let skip = usize::from(t2.props.look.header_row || t2.rows[0].props.header);
                if t2.rows.len() < skip + 2 {
                    return Err("sorting needs at least two rows below the header".into());
                }
                let mut keyed: Vec<(Option<f64>, String, usize)> = t2.rows[skip..]
                    .iter()
                    .enumerate()
                    .map(|(i, row)| {
                        let text = row.cells[c]
                            .blocks
                            .iter()
                            .filter_map(|blk| if let Block::Para(p) = &**blk { Some(p.plain_text()) } else { None })
                            .collect::<Vec<_>>()
                            .join(" ");
                        let text = text.trim().to_string();
                        (text.parse::<f64>().ok().filter(|x| x.is_finite()), text.to_lowercase(), i)
                    })
                    .collect();
                keyed.sort_by(|a, b| {
                    let o = match (a.0, b.0) {
                        (Some(x), Some(y)) => x.partial_cmp(&y).unwrap_or(std::cmp::Ordering::Equal),
                        (Some(_), None) => std::cmp::Ordering::Less,
                        (None, Some(_)) => std::cmp::Ordering::Greater,
                        (None, None) => a.1.cmp(&b.1),
                    };
                    if op == "sort_desc" { o.reverse() } else { o }
                });
                let old: Vec<_> = t2.rows.drain(skip..).collect();
                for (_, _, i) in keyed {
                    t2.rows.push(old[i].clone());
                }
            }
            "even_cols" => {
                let n = t2.grid.len();
                if n == 0 || t2.grid.len() != t2.cols() {
                    return Err("this table has no usable column grid".into());
                }
                let each = t2.grid.iter().sum::<f32>() / n as f32;
                if !each.is_finite() || !(20.0..=1000.0).contains(&each) {
                    return Err("the columns would be too narrow or too wide".into());
                }
                for g in t2.grid.iter_mut() {
                    *g = each;
                }
                for row in t2.rows.iter_mut() {
                    for cell in row.cells.iter_mut() {
                        cell.props.width = Some(each * cell.span() as f32);
                    }
                }
            }
            "col_left" | "col_right" => {
                let n = t2.grid.len();
                t2.insert_col(if op == "col_left" { grid_start } else { grid_start + span });
                if t2.grid.len() == n {
                    return Err("the table has reached its column limit".into());
                }
            }
            "delete_col" => {
                if t2.grid.len() <= 1 {
                    return Err("a table needs at least one column".into());
                }
                // Every row of a vertical merge has the same span and grid position, so the whole merge goes or shrinks together.
                // Horizontally merged cells shrink by one grid column; single-column cells in that column go.
                let rows_before = t2.rows.len();
                t2.delete_col(grid_start);
                if t2.rows.len() != rows_before {
                    return Err("deleting this column would remove a whole row".into());
                }
            }
            "merge_right" => {
                let cells = &t2.rows[r].cells;
                if c + 1 >= cells.len() {
                    return Err("there is no cell to the right to merge with".into());
                }
                if cells[c].props.vmerge != VMerge::None || cells[c + 1].props.vmerge != VMerge::None {
                    return Err("cells that are merged vertically cannot be merged yet".into());
                }
                t2.merge_right(r, c, c + 1);
            }
            "split_cell" => {
                if t2.rows[r].cells[c].props.vmerge != VMerge::None {
                    return Err("cells that are merged vertically cannot be split yet".into());
                }
                if span < 2 {
                    return Err("only a merged cell can be split".into());
                }
                t2.split_cell(r, c, 2);
            }
            "merge_down" => {
                let find = |t: &wordcraft_doc::Table, row: usize| -> Option<usize> {
                    let mut x = 0;
                    for (i, cell) in t.rows.get(row).map_or(&[][..], |r| &r.cells[..]).iter().enumerate() {
                        if x == grid_start {
                            return Some(i);
                        }
                        x += cell.span();
                    }
                    None
                };
                let mut last = r;
                while let (Some(i), true) = (find(&t2, last + 1), last + 1 < t2.rows.len()) {
                    if t2.rows[last + 1].cells[i].props.vmerge == VMerge::Continue && t2.rows[last + 1].cells[i].span() == span {
                        last += 1;
                    } else {
                        break;
                    }
                }
                let next = last + 1;
                let i = match (next < t2.rows.len()).then(|| find(&t2, next)).flatten() {
                    Some(i) if t2.rows[next].cells[i].span() == span && t2.rows[next].cells[i].props.vmerge == VMerge::None => i,
                    _ => return Err("there is no cell of the same width below to merge with".into()),
                };
                if t2.rows[r].cells[c].props.vmerge == VMerge::Continue {
                    return Err("this cell is already part of a merge".into());
                }
                let moved: Vec<_> = t2.rows[next].cells[i].blocks.iter().filter(|b| b.as_para().is_none_or(|p| !p.is_empty())).cloned().collect();
                if t2.rows[r].cells[c].blocks.len() + moved.len() > 1000 {
                    return Err("a table cell holds at most 1000 paragraphs".into());
                }
                {
                    let lower = &mut t2.rows[next].cells[i];
                    lower.blocks = wordcraft_doc::Cell::empty().blocks;
                    lower.props.vmerge = VMerge::Continue;
                }
                let top = &mut t2.rows[r].cells[c];
                if !moved.is_empty() && top.blocks.len() == 1 && top.blocks[0].as_para().is_some_and(wordcraft_doc::Paragraph::is_empty) {
                    top.blocks.clear();
                }
                top.blocks.extend(moved);
                top.props.vmerge = VMerge::Restart;
            }
            "split_down" => {
                if t2.rows[r].cells[c].props.vmerge != VMerge::Restart {
                    return Err("only a vertically merged cell can be split".into());
                }
                t2.rows[r].cells[c].props.vmerge = VMerge::None;
                for row in t2.rows.iter_mut().skip(r + 1) {
                    let mut x = 0;
                    let mut hit = None;
                    for (i, cell) in row.cells.iter().enumerate() {
                        if x == grid_start {
                            hit = Some(i);
                            break;
                        }
                        x += cell.span();
                    }
                    match hit {
                        Some(i) if row.cells[i].props.vmerge == VMerge::Continue && row.cells[i].span() == span => row.cells[i].props.vmerge = VMerge::None,
                        _ => break,
                    }
                }
            }
            _ => return Err(format!("unknown table operation {op}")),
        }
        self.doc.body[b] = Arc::new(Block::Table(t2));
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Inserts an empty `rows` x `cols` table (1-20 by 1-10) after the top-level block holding `block` (a paragraph, a table,
    /// or a cell paragraph, which addresses its table), followed by an empty paragraph so the text can continue after it.
    fn do_insert_table(&mut self, block: usize, rows: usize, cols: usize) -> Result<(), String> {
        if !(1..=20).contains(&rows) || !(1..=10).contains(&cols) {
            return Err("a new table has 1-20 rows and 1-10 columns".into());
        }
        if self.doc.body.len() >= 100_000 {
            return Err("the document has too many blocks".into());
        }
        let top = if block >= CELL_BASE { self.cell_paras().nth(block - CELL_BASE).ok_or_else(|| format!("no cell paragraph {block}"))?[0] } else { block };
        if top >= self.doc.body.len() {
            return Err(format!("no block {block}"));
        }
        let mut styles = self.doc.styles.clone();
        Self::ensure_style(&mut styles, "TableGrid")?;
        let table = wordcraft_doc::Table::new(rows, cols, self.doc.last_section.text_width());
        self.doc.styles = styles;
        self.doc.body.insert(top + 1, Arc::new(Block::Table(table)));
        self.doc.body.insert(top + 2, wordcraft_doc::para_block(wordcraft_doc::Paragraph::new()));
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Turns the plain paragraphs `first..=last` (at most 500) into a table, one row each, cells split at tabs (at most 10 columns).
    /// Paragraphs with objects or a section break, and anything that is not a body paragraph, refuse.
    fn do_text_to_table(&mut self, first: usize, last: usize) -> Result<(), String> {
        if first > last || last >= self.doc.body.len() || last - first + 1 > 500 {
            return Err("choose 1 to 500 paragraphs in the text".into());
        }
        if self.doc.body.len() >= 100_000 {
            return Err("the document has too many blocks".into());
        }
        let mut lines: Vec<Vec<String>> = Vec::new();
        for i in first..=last {
            let Block::Para(p) = &*self.doc.body[i] else { return Err("only paragraphs can be turned into a table".into()) };
            if p.section.is_some() || !p.object_offsets().is_empty() {
                return Err("a paragraph with an object or a section break cannot be turned into a table".into());
            }
            lines.push(p.plain_text().split('\t').map(|x| x.trim().to_string()).collect());
        }
        let cols = lines.iter().map(|l| l.len()).max().unwrap_or(1);
        if cols > 10 {
            return Err("a table made from text has at most 10 columns".into());
        }
        let mut styles = self.doc.styles.clone();
        Self::ensure_style(&mut styles, "TableGrid")?;
        let mut table = wordcraft_doc::Table::new(lines.len(), cols, self.doc.last_section.text_width());
        for (r, line) in lines.iter().enumerate() {
            for (c, text) in line.iter().enumerate() {
                if !text.is_empty() {
                    table.rows[r].cells[c].blocks = vec![wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(text, wordcraft_doc::props::CharProps::default()))];
                }
            }
        }
        self.doc.styles = styles;
        self.doc.body.splice(first..=last, [Arc::new(Block::Table(table))]);
        // A table never ends the body: a paragraph always follows it.
        if !matches!(self.doc.body.get(first + 1).map(|x| &**x), Some(Block::Para(_))) {
            self.doc.body.insert(first + 1, wordcraft_doc::para_block(wordcraft_doc::Paragraph::new()));
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// The story id a section's default header (`footer == false`) or footer points at, for the first section.
    fn hf_story(&self, footer: bool) -> Option<u32> {
        let (_, sect) = self.doc.sections().into_iter().next()?;
        if footer { sect.footers.default } else { sect.headers.default }
    }
    /// Text and page-number flag of a header/footer story that is one plain paragraph (optionally with a PAGE field);
    /// `None` for anything richer, which this editor leaves alone.
    fn hf_simple(&self, id: u32) -> Option<(String, bool)> {
        let part = self.doc.parts.get(&id)?;
        let [blk] = part.blocks.as_slice() else { return None };
        let Block::Para(p) = &**blk else { return None };
        let mut page = false;
        let mut total = false;
        for o in &p.objects {
            match o {
                wordcraft_doc::InlineObject::Field { instr, .. } if instr.trim().eq_ignore_ascii_case("PAGE") && !page => page = true,
                wordcraft_doc::InlineObject::Field { instr, .. } if page && !total && instr.trim().eq_ignore_ascii_case("NUMPAGES") => total = true,
                _ => return None,
            }
        }
        if total {
            // "text PAGE / NUMPAGES": the text is what precedes the first field.
            let head = p.text.split(OBJ).next().unwrap_or("");
            return Some((head.trim_end().to_string(), page));
        }
        Some((p.text.replace(OBJ, "").trim_end().to_string(), page))
    }
    /// True when the footer reads "PAGE / NUMPAGES" (page x of y).
    fn hf_total(&self, id: u32) -> bool {
        let Some(part) = self.doc.parts.get(&id) else { return false };
        let [blk] = part.blocks.as_slice() else { return false };
        let Block::Para(p) = &**blk else { return false };
        p.objects.len() == 2 && self.hf_simple(id).is_some()
    }
    /// `{"size":"a4|letter|legal|a5|custom","landscape":bool,"width","height","margins":{"top","bottom","left","right"}}` of the last section (points).
    fn do_page_setup_state(&self) -> String {
        let s = &self.doc.last_section;
        let (a, b) = if s.page_w >= s.page_h { (s.page_h, s.page_w) } else { (s.page_w, s.page_h) };
        let size = PAGE_SIZES.iter().find(|(_, w, h)| (a - w).abs() < 1.0 && (b - h).abs() < 1.0).map_or("custom", |(n, _, _)| n);
        serde_json::json!({"size": size, "landscape": s.landscape, "width": s.page_w, "height": s.page_h,
            "margins": {"top": s.margin_top, "bottom": s.margin_bottom, "left": s.margin_left, "right": s.margin_right},
            "columns": {"count": s.columns.count.clamp(1, 45), "space": s.columns.space, "separator": s.columns.separator, "uneven": !s.columns.widths.is_empty()},
            "pageColor": self.doc.settings.page_color.map(|c| format!("#{:02X}{:02X}{:02X}", c.0, c.1, c.2)),
            "defaultTab": self.doc.settings.default_tab,
            "valign": match s.valign { wordcraft_doc::props::VAlign::Top => "top", wordcraft_doc::props::VAlign::Center => "center", wordcraft_doc::props::VAlign::Bottom => "bottom" },
            "pageNumbers": {"start": s.page_num_start, "format": Self::num_format_name(s.page_num_format).filter(|n| *n != "bullet" && *n != "decimalZero").unwrap_or("decimal")},
            "pageBorder": s.page_borders.as_ref().and_then(|b| b.top).filter(|b| b.style != wordcraft_doc::props::BorderStyle::None).map(|b| serde_json::json!({"style": match b.style { wordcraft_doc::props::BorderStyle::Double => "double", wordcraft_doc::props::BorderStyle::Thick => "thick", wordcraft_doc::props::BorderStyle::Dotted => "dotted", wordcraft_doc::props::BorderStyle::Dashed => "dashed", _ => "single" }, "width": b.width, "color": b.color.map(|c| format!("#{}", c.hex()))})),
            "lineNumbers": s.line_numbers.as_ref().map(|l| serde_json::json!({"countBy": l.count_by, "restart": match l.restart { wordcraft_doc::section::LineNumberRestart::Page => "page", wordcraft_doc::section::LineNumberRestart::Section => "section", wordcraft_doc::section::LineNumberRestart::Continuous => "continuous" }}))})
        .to_string()
    }
    /// Sets page size, orientation and margins on every section. JSON keys (all optional): `size` ("a4", "letter", "legal", "a5"),
    /// `landscape` (bool) and `margins` ({top,bottom,left,right}, each 0-288 pt). The text area must stay at least 72 pt each way.
    fn do_set_page_setup(&mut self, json: &str) -> Result<(), String> {
        if json.len() > 1024 {
            return Err("the page setup is too long".into());
        }
        let v: serde_json::Value = serde_json::from_str(json).map_err(|_| "the page setup is not valid JSON".to_string())?;
        let obj = v.as_object().ok_or("the page setup must be an object")?;
        if obj.is_empty() {
            return Err("nothing to change".into());
        }
        let cur = self.doc.last_section.clone();
        let (mut w, mut h, mut land) = (cur.page_w, cur.page_h, cur.landscape);
        let mut m = [cur.margin_top, cur.margin_bottom, cur.margin_left, cur.margin_right];
        let mut new_size: Option<(f32, f32)> = None;
        // Columns: (count 1-4, space 0-144 pt, separator line); `None` leaves the columns as they are.
        let mut cols: Option<(u32, f32, bool)> = None;
        // Line numbers: `null` removes them; an object turns them on (count_by 1-100, restart page/section/continuous).
        let mut line_numbers: Option<Option<wordcraft_doc::section::LineNumbering>> = None;
        // Vertical alignment, page numbering and page border (`None` leaves each as it is; the border's inner `None` removes it).
        let mut valign: Option<wordcraft_doc::props::VAlign> = None;
        let mut pnum: Option<(Option<u32>, wordcraft_doc::section::NumFormat)> = None;
        let mut pborder: Option<Option<wordcraft_doc::props::Borders>> = None;
        // Document-wide: the colour behind every page (null = none) and the default tab stop interval.
        let mut page_color: Option<Option<wordcraft_doc::props::Rgb>> = None;
        let mut default_tab: Option<f32> = None;
        for (k, val) in obj {
            match k.as_str() {
                "pageColor" => {
                    page_color = Some(if val.is_null() {
                        None
                    } else {
                        Some(wordcraft_doc::props::Rgb::parse(val.as_str().ok_or("the page colour must be text")?).ok_or("the page colour is #RRGGBB")?)
                    })
                }
                "defaultTab" => {
                    let x = val.as_f64().ok_or("the default tab stop must be a number")? as f32;
                    if !x.is_finite() || !(9.0..=288.0).contains(&x) {
                        return Err("the default tab stop is 9 to 288 points".into());
                    }
                    default_tab = Some((x * 20.0).round() / 20.0);
                }
                "valign" => {
                    valign = Some(match val.as_str() {
                        Some("top") => wordcraft_doc::props::VAlign::Top,
                        Some("center") => wordcraft_doc::props::VAlign::Center,
                        Some("bottom") => wordcraft_doc::props::VAlign::Bottom,
                        _ => return Err("vertical alignment is top, center or bottom".into()),
                    })
                }
                "pageNumbers" => {
                    let o = val.as_object().ok_or("pageNumbers must be an object")?;
                    if o.is_empty() {
                        return Err("pageNumbers needs a field to change".into());
                    }
                    let mut p = (cur.page_num_start, cur.page_num_format);
                    for (pk, pv) in o {
                        match pk.as_str() {
                            "start" => {
                                p.0 = if pv.is_null() { None } else { Some(pv.as_u64().filter(|n| (1..=9999).contains(n)).ok_or("the first page number is 1 to 9999")? as u32) }
                            }
                            "format" => {
                                p.1 = match pv.as_str() {
                                    Some(n @ ("decimal" | "upperRoman" | "lowerRoman" | "upperLetter" | "lowerLetter")) => Self::num_format_of(n).ok_or("unknown page number format")?,
                                    _ => return Err("the page number format is decimal, upperRoman, lowerRoman, upperLetter or lowerLetter".into()),
                                }
                            }
                            _ => return Err(format!("unknown pageNumbers field {pk}")),
                        }
                    }
                    pnum = Some(p);
                }
                "pageBorder" => {
                    use wordcraft_doc::props::{Border, BorderStyle, Borders, Rgb};
                    if val.is_null() {
                        pborder = Some(None);
                        continue;
                    }
                    let o = val.as_object().ok_or("pageBorder must be null or an object")?;
                    let mut b = cur.page_borders.as_ref().and_then(|x| x.top).unwrap_or(Border { style: BorderStyle::Single, width: 1.0, color: None, space: 24.0 });
                    for (bk, bv) in o {
                        match bk.as_str() {
                            "style" => {
                                b.style = match bv.as_str() {
                                    Some("single") => BorderStyle::Single,
                                    Some("double") => BorderStyle::Double,
                                    Some("thick") => BorderStyle::Thick,
                                    Some("dotted") => BorderStyle::Dotted,
                                    Some("dashed") => BorderStyle::Dashed,
                                    _ => return Err("the border style is single, double, thick, dotted or dashed".into()),
                                }
                            }
                            "width" => {
                                let x = bv.as_f64().ok_or("the border width must be a number")? as f32;
                                if !x.is_finite() || !(0.25..=6.0).contains(&x) {
                                    return Err("the border width is 0.25 to 6 points".into());
                                }
                                b.width = x;
                            }
                            "color" => b.color = if bv.is_null() { None } else { Some(Rgb::parse(bv.as_str().ok_or("the border colour must be text")?).ok_or("the border colour is #RRGGBB")?) },
                            _ => return Err(format!("unknown pageBorder field {bk}")),
                        }
                    }
                    if b.style == BorderStyle::None {
                        return Err("the border style is single, double, thick, dotted or dashed".into());
                    }
                    pborder = Some(Some(Borders::box_(b)));
                }
                "lineNumbers" => {
                    use wordcraft_doc::section::{LineNumbering, LineNumberRestart};
                    if val.is_null() {
                        line_numbers = Some(None);
                        continue;
                    }
                    let o = val.as_object().ok_or("lineNumbers must be null or an object")?;
                    let mut l = cur.line_numbers.clone().unwrap_or_else(LineNumbering::default);
                    for (lk, lv) in o {
                        match lk.as_str() {
                            "countBy" => l.count_by = lv.as_u64().filter(|n| (1..=100).contains(n)).ok_or("line numbers count by 1 to 100")? as u32,
                            "restart" => {
                                l.restart = match lv.as_str() {
                                    Some("page") => LineNumberRestart::Page,
                                    Some("section") => LineNumberRestart::Section,
                                    Some("continuous") => LineNumberRestart::Continuous,
                                    _ => return Err("line numbers restart on page, section or continuous".into()),
                                }
                            }
                            _ => return Err(format!("unknown lineNumbers field {lk}")),
                        }
                    }
                    line_numbers = Some(Some(l));
                }
                "columns" => {
                    let o = val.as_object().ok_or("columns must be an object")?;
                    let mut c = (cur.columns.count.clamp(1, 45), cur.columns.space, cur.columns.separator);
                    if o.is_empty() {
                        return Err("columns needs a field to change".into());
                    }
                    for (ck, cv) in o {
                        match ck.as_str() {
                            "count" => c.0 = cv.as_u64().filter(|n| (1..=4).contains(n)).ok_or("columns are 1 to 4")? as u32,
                            "space" => {
                                let x = cv.as_f64().ok_or("the column spacing must be a number")? as f32;
                                if !x.is_finite() || !(0.0..=144.0).contains(&x) {
                                    return Err("the column spacing is 0 to 144 points".into());
                                }
                                c.1 = x;
                            }
                            "separator" => c.2 = cv.as_bool().ok_or("separator must be true or false")?,
                            _ => return Err(format!("unknown columns field {ck}")),
                        }
                    }
                    cols = Some(c);
                }
                "size" => {
                    let name = val.as_str().ok_or("size must be text")?;
                    let (_, pw, ph) = PAGE_SIZES.iter().find(|(n, _, _)| *n == name).ok_or("unknown page size")?;
                    new_size = Some((*pw, *ph));
                }
                "landscape" => land = val.as_bool().ok_or("landscape must be true or false")?,
                "margins" => {
                    let o = val.as_object().ok_or("margins must be an object")?;
                    for (mk, mv) in o {
                        let i = match mk.as_str() {
                            "top" => 0,
                            "bottom" => 1,
                            "left" => 2,
                            "right" => 3,
                            _ => return Err(format!("unknown margin {mk}")),
                        };
                        let x = mv.as_f64().ok_or("a margin must be a number")? as f32;
                        if !x.is_finite() || !(0.0..=288.0).contains(&x) {
                            return Err("a margin is 0 to 288 points".into());
                        }
                        m[i] = x;
                    }
                }
                _ => return Err(format!("unknown page setup field {k}")),
            }
        }
        if let Some((pw, ph)) = new_size {
            w = pw;
            h = ph;
        }
        // Portrait is the short side across; landscape the long side.
        let (short, long) = if w <= h { (w, h) } else { (h, w) };
        let (w, h) = if land { (long, short) } else { (short, long) };
        if w - m[2] - m[3] < 72.0 || h - m[0] - m[1] < 72.0 {
            return Err("the margins leave less than 72 points of text area".into());
        }
        if let Some((n, space, _)) = cols {
            if n > 1 && (w - m[2] - m[3] - space * (n - 1) as f32) / (n as f32) < 36.0 {
                return Err("the columns would be narrower than 36 points".into());
            }
        } else {
            let (n, space) = (cur.columns.count.clamp(1, 45), cur.columns.space);
            if n > 1 && (w - m[2] - m[3] - space.max(0.0) * (n - 1) as f32) / (n as f32) < 36.0 {
                return Err("the existing columns would be narrower than 36 points".into());
            }
        }
        if let Some(c) = page_color {
            self.doc.settings.page_color = c;
        }
        if let Some(x) = default_tab {
            self.doc.settings.default_tab = x;
        }
        let set = |s: &mut wordcraft_doc::SectionProps| {
            s.page_w = w;
            s.page_h = h;
            s.landscape = land;
            s.margin_top = m[0];
            s.margin_bottom = m[1];
            s.margin_left = m[2];
            s.margin_right = m[3];
            if let Some((n, space, sep)) = cols {
                if n != s.columns.count || (space - s.columns.space).abs() > f32::EPSILON {
                    s.columns.widths.clear();
                }
                s.columns.count = n;
                s.columns.space = space;
                s.columns.separator = sep;
            }
            if let Some(l) = &line_numbers {
                s.line_numbers = l.clone();
            }
            if let Some(v) = valign {
                s.valign = v;
            }
            if let Some((start, fmt)) = pnum {
                s.page_num_start = start;
                s.page_num_format = fmt;
            }
            if let Some(b) = &pborder {
                s.page_borders = *b;
            }
        };
        for blk in self.doc.body.iter_mut() {
            if matches!(&**blk, Block::Para(p) if p.section.is_some()) {
                if let Block::Para(p) = Arc::make_mut(blk) {
                    if let Some(s) = p.section.as_mut() {
                        set(s);
                    }
                }
            }
        }
        set(&mut self.doc.last_section);
        self.pages = DocLayout::default();
        Ok(())
    }
    fn do_header_footer_state(&self) -> String {
        let one = |footer: bool| match self.hf_story(footer) {
            None => (String::new(), false, true),
            Some(id) => match self.hf_simple(id) {
                Some((t, pg)) => (t, pg, true),
                None => (self.doc.plain_text(StoryRef::Part(id)), false, false),
            },
        };
        let (h, _, he) = one(false);
        let (f, fp, fe) = one(true);
        let al = |footer: bool| self.hf_story(footer).map_or(if footer { "center" } else { "left" }, |id| self.hf_align(id, footer));
        serde_json::json!({"header": {"text": h, "editable": he, "align": al(false)}, "footer": {"text": f, "pageNumber": fp, "editable": fe, "align": al(true), "pageTotal": self.hf_story(true).map_or(false, |id| self.hf_total(id))}}).to_string()
    }
    /// The alignment of a one-paragraph header/footer story as `left`, `center` or `right` (the default of a new one when unset).
    fn hf_align(&self, id: u32, footer: bool) -> &'static str {
        use wordcraft_doc::Align;
        let a = self.doc.parts.get(&id).and_then(|p| p.blocks.first()).and_then(|b| if let Block::Para(p) = &**b { p.props.align } else { None });
        match a {
            Some(Align::Center) => "center",
            Some(Align::Right) => "right",
            Some(Align::Left) => "left",
            _ => if footer { "center" } else { "left" },
        }
    }
    /// Sets the alignment of the existing simple header and/or footer story (`left`, `center`, `right`). A missing story is refused.
    fn do_set_hf_align(&mut self, header: Option<&str>, footer: Option<&str>) -> Result<(), String> {
        use wordcraft_doc::Align;
        let parse = |v: &str| match v {
            "left" => Ok(Align::Left),
            "center" => Ok(Align::Center),
            "right" => Ok(Align::Right),
            _ => Err("alignment must be left, center or right".to_string()),
        };
        let mut plan: Vec<(u32, Align)> = Vec::new();
        for (v, footer) in [(header, false), (footer, true)] {
            let Some(v) = v else { continue };
            let a = parse(v)?;
            let id = self.hf_story(footer).ok_or(if footer { "there is no footer to align" } else { "there is no header to align" })?;
            if self.hf_simple(id).is_none() {
                return Err("that part has content that cannot be edited here".into());
            }
            plan.push((id, a));
        }
        if plan.is_empty() {
            return Err("nothing to change".into());
        }
        for (id, a) in plan {
            if let Some(part) = self.doc.parts.get_mut(&id) {
                if let Some(first) = part.blocks.first_mut() {
                    if let Block::Para(p) = Arc::make_mut(first) {
                        p.props.align = Some(a);
                    }
                }
            }
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Switches an existing footer page number between "PAGE" and "PAGE / NUMPAGES". Refused without a simple footer that has a page number.
    fn do_set_page_total(&mut self, total: bool) -> Result<(), String> {
        let id = self.hf_story(true).ok_or("there is no footer")?;
        let (text, page) = self.hf_simple(id).ok_or("the footer has content that cannot be edited here")?;
        if !page {
            return Err("the footer has no page number".into());
        }
        let align = match self.hf_align(id, true) { "left" => wordcraft_doc::Align::Left, "right" => wordcraft_doc::Align::Right, _ => wordcraft_doc::Align::Center };
        let p = Self::hf_para(&text, true, align, total)?;
        if let Some(part) = self.doc.parts.get_mut(&id) {
            part.blocks = vec![wordcraft_doc::para_block(p)];
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    fn hf_validate(text: &str) -> Result<(), String> {
        if text.chars().count() > HF_MAX_CHARS {
            return Err(format!("header and footer text is limited to {HF_MAX_CHARS} characters"));
        }
        if text.chars().any(|c| c.is_control() || c == OBJ) {
            return Err("header and footer text cannot contain line breaks or control characters".into());
        }
        Ok(())
    }
    fn hf_para(text: &str, page: bool, align: wordcraft_doc::Align, total: bool) -> Result<wordcraft_doc::Paragraph, String> {
        let mut p = wordcraft_doc::Paragraph::new();
        if !text.is_empty() {
            p.insert_text(0, text, &CharProps::default()).map_err(|e| e.to_string())?;
        }
        if page {
            if !text.is_empty() {
                let end = p.text.len();
                p.insert_text(end, " ", &CharProps::default()).map_err(|e| e.to_string())?;
            }
            let end = p.text.len();
            p.insert_object(end, wordcraft_doc::InlineObject::Field { instr: "PAGE".into(), result: "1".into(), locked: false }, &CharProps::default()).map_err(|e| e.to_string())?;
            if total {
                let end = p.text.len();
                p.insert_text(end, " / ", &CharProps::default()).map_err(|e| e.to_string())?;
                let end = p.text.len();
                p.insert_object(end, wordcraft_doc::InlineObject::Field { instr: "NUMPAGES".into(), result: "1".into(), locked: false }, &CharProps::default()).map_err(|e| e.to_string())?;
            }
        }
        p.props.align = Some(align);
        Ok(p)
    }
    /// Sets the default header and footer text of every section. `None` leaves that part untouched; an empty header
    /// (or an empty footer without page number) removes the story. A richer existing story is refused, not overwritten.
    /// The header/footer story of the first section for `variant` (0 default, 1 first page, 2 even pages).
    fn hf_story_v(&self, footer: bool, variant: u8) -> Option<u32> {
        let (_, sect) = self.doc.sections().into_iter().next()?;
        let set = if footer { &sect.footers } else { &sect.headers };
        match variant {
            1 => set.first,
            2 => set.even,
            _ => set.default,
        }
    }
    /// State of the "different first page" and "different odd and even pages" options and their texts.
    fn do_hf_variants_state(&self) -> String {
        let title = self.doc.sections().first().map_or(false, |(_, s)| s.title_page);
        let one = |footer: bool, v: u8| match self.hf_story_v(footer, v) {
            None => (String::new(), false, true),
            Some(id) => match self.hf_simple(id) {
                Some((t, pg)) => (t, pg, true),
                None => (self.doc.plain_text(StoryRef::Part(id)), false, false),
            },
        };
        let var = |v: u8| {
            let (h, _, he) = one(false, v);
            let (f, fp, fe) = one(true, v);
            serde_json::json!({"header": {"text": h, "editable": he}, "footer": {"text": f, "pageNumber": fp, "editable": fe}})
        };
        serde_json::json!({"titlePage": title, "evenOdd": self.doc.settings.even_odd_headers, "first": var(1), "even": var(2)}).to_string()
    }
    /// Applies `{"titlePage"?, "evenOdd"?, "first"?: {"header"?, "footer"?, "pageNumber"?}, "even"?: {..}}` to every section as one change.
    /// Texts follow the header/footer rules (500 characters, no control characters); an empty text with no page number removes that story.
    /// Anything invalid, or a story with richer content, refuses the whole patch and changes nothing.
    fn do_set_hf_variants(&mut self, patch_json: &str) -> Result<(), String> {
        use wordcraft_doc::PartKind;
        if patch_json.len() > 8192 {
            return Err("the header and footer patch is too large".into());
        }
        let v: serde_json::Value = serde_json::from_str(patch_json).map_err(|_| "the header and footer patch is not valid JSON".to_string())?;
        let obj = v.as_object().ok_or("the header and footer patch must be an object")?;
        for k in obj.keys() {
            if !["titlePage", "evenOdd", "first", "even"].contains(&k.as_str()) {
                return Err(format!("unknown key {k}"));
            }
        }
        let flag = |k: &str| -> Result<Option<bool>, String> {
            match obj.get(k) {
                None => Ok(None),
                Some(serde_json::Value::Bool(b)) => Ok(Some(*b)),
                Some(_) => Err(format!("{k} must be true or false")),
            }
        };
        let (title, even_odd) = (flag("titlePage")?, flag("evenOdd")?);
        let text = |o: &serde_json::Map<String, serde_json::Value>, k: &str| -> Result<Option<String>, String> {
            match o.get(k) {
                None => Ok(None),
                Some(serde_json::Value::String(t)) => {
                    Self::hf_validate(t)?;
                    Ok(Some(t.clone()))
                }
                Some(_) => Err(format!("{k} must be text")),
            }
        };
        // (variant, footer, new paragraph or None to remove) for every story to change.
        let mut plan: Vec<(u8, bool, Option<wordcraft_doc::Paragraph>)> = Vec::new();
        for (key, var) in [("first", 1u8), ("even", 2u8)] {
            let Some(val) = obj.get(key) else { continue };
            let o = val.as_object().ok_or_else(|| format!("{key} must be an object"))?;
            for k in o.keys() {
                if !["header", "footer", "pageNumber"].contains(&k.as_str()) {
                    return Err(format!("unknown key {key}.{k}"));
                }
            }
            let page_number = match o.get("pageNumber") {
                None => None,
                Some(serde_json::Value::Bool(b)) => Some(*b),
                Some(_) => return Err("pageNumber must be true or false".into()),
            };
            if let Some(h) = text(o, "header")? {
                if let Some(id) = self.hf_story_v(false, var) {
                    if self.hf_simple(id).is_none() {
                        return Err("the header has content that cannot be edited here".into());
                    }
                }
                let keep = match self.hf_story_v(false, var).map(|id| self.hf_align(id, false)) { Some("center") => wordcraft_doc::Align::Center, Some("right") => wordcraft_doc::Align::Right, _ => wordcraft_doc::Align::Left };
                plan.push((var, false, if h.is_empty() { None } else { Some(Self::hf_para(&h, false, keep, false)?) }));
            }
            let f = text(o, "footer")?;
            if f.is_some() || page_number.is_some() {
                let existing = self.hf_story_v(true, var);
                let (old_text, old_page) = match existing {
                    None => (String::new(), false),
                    Some(id) => self.hf_simple(id).ok_or("the footer has content that cannot be edited here")?,
                };
                let t = f.unwrap_or(old_text);
                let page = page_number.unwrap_or(old_page);
                let keep = match existing.map(|id| self.hf_align(id, true)) { Some("left") => wordcraft_doc::Align::Left, Some("right") => wordcraft_doc::Align::Right, _ => wordcraft_doc::Align::Center };
                let total = page && existing.map_or(false, |id| self.hf_total(id));
                plan.push((var, true, if t.is_empty() && !page { None } else { Some(Self::hf_para(&t, page, keep, total)?) }));
            }
        }
        if title.is_none() && even_odd.is_none() && plan.is_empty() {
            return Err("nothing to change".into());
        }
        for (var, footer, para) in plan {
            let kind = if footer { PartKind::Footer } else { PartKind::Header };
            let new_id = match (self.hf_story_v(footer, var), para) {
                (Some(id), Some(p)) => {
                    if let Some(part) = self.doc.parts.get_mut(&id) {
                        part.blocks = vec![wordcraft_doc::para_block(p)];
                    }
                    Some(id)
                }
                (None, Some(p)) => Some(self.doc.add_part(kind, vec![wordcraft_doc::para_block(p)])),
                (Some(id), None) => {
                    self.doc.parts.remove(&id);
                    None
                }
                (None, None) => None,
            };
            let set = |s: &mut wordcraft_doc::SectionProps| {
                let hs = if footer { &mut s.footers } else { &mut s.headers };
                match var {
                    1 => hs.first = new_id,
                    _ => hs.even = new_id,
                }
            };
            for blk in self.doc.body.iter_mut() {
                if matches!(&**blk, Block::Para(p) if p.section.is_some()) {
                    if let Block::Para(p) = Arc::make_mut(blk) {
                        if let Some(s) = p.section.as_mut() {
                            set(s);
                        }
                    }
                }
            }
            set(&mut self.doc.last_section);
        }
        if let Some(t) = title {
            for blk in self.doc.body.iter_mut() {
                if matches!(&**blk, Block::Para(p) if p.section.is_some()) {
                    if let Block::Para(p) = Arc::make_mut(blk) {
                        if let Some(s) = p.section.as_mut() {
                            s.title_page = t;
                        }
                    }
                }
            }
            self.doc.last_section.title_page = t;
        }
        if let Some(e) = even_odd {
            self.doc.settings.even_odd_headers = e;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    fn do_set_header_footer(&mut self, header: Option<&str>, footer: Option<&str>, page_number: Option<bool>) -> Result<(), String> {
        use wordcraft_doc::PartKind;
        if let Some(h) = header {
            Self::hf_validate(h)?;
        }
        if let Some(f) = footer {
            Self::hf_validate(f)?;
        }
        // (kind, new paragraph or None to remove) per story to change.
        let mut plan: Vec<(PartKind, Option<wordcraft_doc::Paragraph>)> = Vec::new();
        if let Some(h) = header {
            if let Some(id) = self.hf_story(false) {
                if self.hf_simple(id).is_none() {
                    return Err("the header has content that cannot be edited here".into());
                }
            }
            let keep = match self.hf_story(false).map(|id| self.hf_align(id, false)) { Some("center") => wordcraft_doc::Align::Center, Some("right") => wordcraft_doc::Align::Right, _ => wordcraft_doc::Align::Left };
            plan.push((PartKind::Header, if h.is_empty() { None } else { Some(Self::hf_para(h, false, keep, false)?) }));
        }
        if footer.is_some() || page_number.is_some() {
            let existing = self.hf_story(true);
            let (old_text, old_page) = match existing {
                None => (String::new(), false),
                Some(id) => self.hf_simple(id).ok_or("the footer has content that cannot be edited here")?,
            };
            let text = footer.map(str::to_string).unwrap_or(old_text);
            let page = page_number.unwrap_or(old_page);
            let keep = match existing.map(|id| self.hf_align(id, true)) { Some("left") => wordcraft_doc::Align::Left, Some("right") => wordcraft_doc::Align::Right, _ => wordcraft_doc::Align::Center };
            plan.push((PartKind::Footer, if text.is_empty() && !page { None } else { Some(Self::hf_para(&text, page, keep, page && existing.map_or(false, |id| self.hf_total(id)))?) }));
        }
        for (kind, para) in plan {
            let footer = matches!(kind, PartKind::Footer);
            let current = self.hf_story(footer);
            let new_id = match (current, para) {
                (Some(id), Some(p)) => {
                    if let Some(part) = self.doc.parts.get_mut(&id) {
                        part.blocks = vec![wordcraft_doc::para_block(p)];
                    }
                    Some(id)
                }
                (None, Some(p)) => Some(self.doc.add_part(kind, vec![wordcraft_doc::para_block(p)])),
                (Some(id), None) => {
                    self.doc.parts.remove(&id);
                    None
                }
                (None, None) => None,
            };
            let set = |s: &mut wordcraft_doc::SectionProps| {
                if footer {
                    s.footers.default = new_id;
                } else {
                    s.headers.default = new_id;
                }
            };
            for blk in self.doc.body.iter_mut() {
                if matches!(&**blk, Block::Para(p) if p.section.is_some()) {
                    if let Block::Para(p) = Arc::make_mut(blk) {
                        if let Some(s) = p.section.as_mut() {
                            set(s);
                        }
                    }
                }
            }
            set(&mut self.doc.last_section);
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Inserts a PNG or JPEG as its own paragraph after the top-level block holding `block` (a paragraph, table or cell
    /// paragraph). The picture is scaled to fit the text width. Limits: 5 MB, 8000 px a side, 25 megapixels, 200 images.
    fn do_insert_image(&mut self, block: usize, bytes: &[u8], alt: &str) -> Result<(), String> {
        if bytes.is_empty() || bytes.len() > IMG_MAX_BYTES {
            return Err("an image is limited to 5 MB".into());
        }
        let (ext, wpx, hpx) = sniff_image(bytes)?;
        if wpx == 0 || hpx == 0 || wpx > IMG_MAX_SIDE || hpx > IMG_MAX_SIDE || (wpx as u64) * (hpx as u64) > IMG_MAX_PIXELS {
            return Err("an image is limited to 8000 pixels a side and 25 megapixels".into());
        }
        Self::hf_validate(alt).map_err(|_| "alt text is limited to 500 characters without line breaks".to_string())?;
        if self.doc.body.len() >= 100_000 {
            return Err("the document has too many blocks".into());
        }
        let top = if block >= CELL_BASE { self.cell_paras().nth(block - CELL_BASE).ok_or_else(|| format!("no cell paragraph {block}"))?[0] } else { block };
        if top >= self.doc.body.len() {
            return Err(format!("no block {block}"));
        }
        let known = self.doc.media.values().any(|v| v.as_slice() == bytes);
        if !known && self.doc.media.len() >= IMG_MAX_COUNT {
            return Err("a document holds at most 200 images".into());
        }
        let (mut w, mut h) = (wpx as f32 * 0.75, hpx as f32 * 0.75);
        let fit = (self.doc.last_section.text_width() / w).min(IMG_MAX_PT / h).min(1.0);
        w = (w * fit).max(IMG_MIN_PT);
        h = (h * fit).max(IMG_MIN_PT);
        let mut p = wordcraft_doc::Paragraph::new();
        let key = self.doc.add_media(bytes.to_vec(), ext);
        let obj = wordcraft_doc::InlineObject::Image { media: key, w, h, alt: alt.to_string(), float: Default::default(), crop: [0.0; 4] };
        if let Err(e) = p.insert_object(0, obj, &CharProps::default()) {
            return Err(e.to_string());
        }
        self.doc.body.insert(top + 1, Arc::new(Block::Para(p)));
        if top + 2 == self.doc.body.len() {
            self.doc.body.push(wordcraft_doc::para_block(wordcraft_doc::Paragraph::new()));
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Image-only top-level paragraph `block` as `(index, paragraph)`, or an error.
    fn image_para(&self, block: usize) -> Result<&wordcraft_doc::Paragraph, String> {
        if block >= CELL_BASE {
            return Err("images inside table cells are not supported yet".into());
        }
        match self.doc.body.get(block).map(|b| &**b) {
            Some(Block::Para(p)) if image_only(p).is_some() => Ok(p),
            Some(_) => Err("this block is not an image".into()),
            None => Err(format!("no block {block}")),
        }
    }
    /// Sets the display width of an image paragraph in points (10-2000), keeping the aspect ratio.
    fn do_resize_image(&mut self, block: usize, width: f32) -> Result<(), String> {
        if !width.is_finite() || !(IMG_MIN_PT..=IMG_MAX_PT).contains(&width) {
            return Err("an image is 10 to 2000 points wide".into());
        }
        let mut p = self.image_para(block)?.clone();
        let (_, w0, h0, _) = image_only(&p).ok_or("this block is not an image")?;
        let h = (width * h0 / w0.max(1.0)).clamp(IMG_MIN_PT, IMG_MAX_PT);
        let text_w = self.doc.last_section.text_width();
        let (_, align) = image_wrap_state(&p, text_w);
        if let Some(wordcraft_doc::InlineObject::Image { w, h: hh, float, .. }) = p.objects.get_mut(0) {
            *w = width;
            *hh = h;
            if float.wrap != wordcraft_doc::para::Wrap::Inline {
                float.x = float_x(align, text_w, width);
            }
        }
        self.doc.body[block] = Arc::new(Block::Para(p));
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Sets an image paragraph to a share (25, 50, 75 or 100 percent) of the text width, keeping the aspect ratio.
    fn do_fit_image(&mut self, block: usize, percent: u32) -> Result<(), String> {
        if ![25, 50, 75, 100].contains(&percent) {
            return Err("choose 25, 50, 75 or 100 percent".into());
        }
        let width = (self.doc.last_section.text_width() * percent as f32 / 100.0).clamp(IMG_MIN_PT, IMG_MAX_PT);
        self.do_resize_image(block, width)
    }
    /// Sets how an image paragraph sits in the text: `inline`, `square`, `topAndBottom`, `behind` or `front`, aligned
    /// `left`, `center` or `right`. Inline pictures align through the paragraph; the others float against the column.
    fn do_set_image_wrap(&mut self, block: usize, wrap: &str, align: &str) -> Result<(), String> {
        use wordcraft_doc::para::{Anchor, Float, Wrap};
        let mode = match wrap {
            "inline" => Wrap::Inline,
            "square" => Wrap::Square,
            "topAndBottom" => Wrap::TopAndBottom,
            "behind" => Wrap::BehindText,
            "front" => Wrap::InFrontOfText,
            _ => return Err("the wrap is inline, square, topAndBottom, behind or front".into()),
        };
        let al = match align {
            "left" => wordcraft_doc::Align::Left,
            "center" => wordcraft_doc::Align::Center,
            "right" => wordcraft_doc::Align::Right,
            _ => return Err("the picture alignment is left, center or right".into()),
        };
        let mut p = self.image_para(block)?.clone();
        let text_w = self.doc.last_section.text_width();
        if let Some(wordcraft_doc::InlineObject::Image { w, float, .. }) = p.objects.get_mut(0) {
            *float = if mode == Wrap::Inline {
                Float::default()
            } else {
                Float { wrap: mode, h_rel: Anchor::Column, v_rel: Anchor::Paragraph, x: float_x(align, text_w, *w), y: 0.0, dist: IMG_WRAP_DIST }
            };
        }
        p.props.align = Some(if mode == Wrap::Inline { al } else { wordcraft_doc::Align::Left });
        self.doc.body[block] = Arc::new(Block::Para(p));
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Crops an image paragraph: percent trimmed from the left, top, right and bottom (each 0 to 90, each axis at most
    /// 90 together). The displayed size follows the visible part so the picture is not stretched.
    fn do_set_image_crop(&mut self, block: usize, l: f32, t: f32, r: f32, b: f32) -> Result<(), String> {
        let side = [l, t, r, b];
        if side.iter().any(|v| !v.is_finite() || !(0.0..=90.0).contains(v)) || l + r > 90.0 || t + b > 90.0 {
            return Err("crop each side by 0 to 90 percent, at most 90 percent per axis together".into());
        }
        let mut p = self.image_para(block)?.clone();
        let text_w = self.doc.last_section.text_width();
        let (_, align) = image_wrap_state(&p, text_w);
        let new = side.map(|v| (v * 10.0).round() / 1000.0);
        if let Some(wordcraft_doc::InlineObject::Image { w, h, float, crop, .. }) = p.objects.get_mut(0) {
            let full_w = *w / (1.0 - crop[0] - crop[2]).max(0.05);
            let full_h = *h / (1.0 - crop[1] - crop[3]).max(0.05);
            let nw = full_w * (1.0 - new[0] - new[2]);
            let nh = full_h * (1.0 - new[1] - new[3]);
            if !nw.is_finite() || !nh.is_finite() || !(IMG_MIN_PT..=IMG_MAX_PT).contains(&nw) || !(IMG_MIN_PT..=IMG_MAX_PT).contains(&nh) {
                return Err("the cropped picture would be smaller than 10 points or larger than 2000".into());
            }
            *w = nw;
            *h = nh;
            *crop = new;
            if float.wrap != wordcraft_doc::para::Wrap::Inline {
                float.x = float_x(align, text_w, nw);
            }
        }
        self.doc.body[block] = Arc::new(Block::Para(p));
        self.pages = DocLayout::default();
        Ok(())
    }
    fn do_set_image_alt(&mut self, block: usize, alt: &str) -> Result<(), String> {
        Self::hf_validate(alt).map_err(|_| "alt text is limited to 500 characters without line breaks".to_string())?;
        let mut p = self.image_para(block)?.clone();
        if let Some(wordcraft_doc::InlineObject::Image { alt: a, .. }) = p.objects.get_mut(0) {
            *a = alt.to_string();
        }
        self.doc.body[block] = Arc::new(Block::Para(p));
        Ok(())
    }
    /// Removes an image paragraph (the document keeps at least one block).
    fn do_remove_image(&mut self, block: usize) -> Result<(), String> {
        self.image_para(block)?;
        if self.doc.body.len() <= 1 {
            return Err("the document needs at least one block".into());
        }
        self.doc.body.remove(block);
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Every body paragraph id the host uses: top-level paragraphs, then table-cell paragraphs.
    fn all_para_ids(&self) -> Vec<usize> {
        let mut v: Vec<usize> = self.doc.body.iter().enumerate().filter(|(_, b)| matches!(&***b, Block::Para(_))).map(|(i, _)| i).collect();
        v.extend((0..self.cell_paras().count()).map(|n| CELL_BASE + n));
        v
    }
    /// Where each comment is anchored: (paragraph id, quoted text when start and end share the paragraph).
    fn comment_anchors(&self) -> std::collections::HashMap<u32, (usize, Option<String>)> {
        use wordcraft_doc::InlineObject;
        let mut starts: std::collections::HashMap<u32, (usize, usize)> = Default::default();
        let mut ends: std::collections::HashMap<u32, (usize, usize)> = Default::default();
        for pid in self.all_para_ids() {
            let Some(p) = self.para_at(pid) else { continue };
            for (off, obj) in p.object_offsets().into_iter().zip(p.objects.iter()) {
                match obj {
                    InlineObject::CommentStart { id } => {
                        starts.insert(*id, (pid, off));
                    }
                    InlineObject::CommentEnd { id } => {
                        ends.insert(*id, (pid, off));
                    }
                    _ => {}
                }
            }
        }
        starts
            .into_iter()
            .map(|(id, (pid, so))| {
                let quote = match (ends.get(&id), self.para_at(pid)) {
                    (Some((ep, eo)), Some(p)) if *ep == pid && *eo >= so + OBJ.len_utf8() => {
                        let q: String = p.text.get(so + OBJ.len_utf8()..*eo).unwrap_or("").chars().filter(|c| *c != OBJ).take(200).collect();
                        Some(q)
                    }
                    _ => None,
                };
                (id, (pid, quote))
            })
            .collect()
    }
    fn comment_text(&self, c: &wordcraft_doc::Comment) -> String {
        let t = self.doc.parts.get(&c.part).map(|p| p.blocks.iter().filter_map(|b| b.as_para()).map(|p| p.plain_text()).collect::<Vec<_>>().join("\n")).unwrap_or_default();
        t.chars().take(COMMENT_MAX_CHARS).collect()
    }
    /// The comments (imported and new) with their quoted text and the paragraph they sit in.
    fn do_comments(&self) -> String {
        let anchors = self.comment_anchors();
        let items: Vec<_> = self
            .doc
            .comments
            .iter()
            .take(2000)
            .map(|(id, c)| {
                let a = anchors.get(id);
                serde_json::json!({"id": id, "parent": c.parent, "author": c.author, "initials": c.initials, "date": c.date, "resolved": c.resolved, "text": self.comment_text(c), "quote": a.and_then(|a| a.1.clone()), "block": a.map(|a| a.0)})
            })
            .collect();
        serde_json::Value::Array(items).to_string()
    }
    /// Anchors a new comment on `start..end` (UTF-8 bytes) of one paragraph that has no inline objects.
    fn do_add_comment(&mut self, block: usize, start: usize, end: usize, text: &str, author: &str, date: &str) -> Result<(), String> {
        use wordcraft_doc::{InlineObject, PartKind};
        let body = text.trim();
        if body.is_empty() || body.chars().count() > COMMENT_MAX_CHARS || body.chars().any(|c| c.is_control() && c != '\n') {
            return Err(format!("a comment is 1 to {COMMENT_MAX_CHARS} characters"));
        }
        if author.chars().count() > 60 || author.chars().any(|c| c.is_control()) {
            return Err("the author name is limited to 60 characters".into());
        }
        if date.len() > 40 || date.chars().any(|c| !(c.is_ascii_digit() || "-:.TZ+".contains(c))) {
            return Err("the comment date is not valid".into());
        }
        if self.doc.comments.len() >= COMMENT_MAX_COUNT {
            return Err(format!("a document holds at most {COMMENT_MAX_COUNT} comments"));
        }
        let mut p = self.para_at(block).ok_or_else(|| format!("no paragraph {block}"))?.clone();
        if p.text.contains(OBJ) || !p.objects.is_empty() {
            return Err(format!("paragraph {block} already has an inline object (such as a comment) and cannot take another"));
        }
        if start >= end || end > p.text.len() || !p.text.is_char_boundary(start) || !p.text.is_char_boundary(end) {
            return Err("the comment needs a non-empty selection inside one paragraph".into());
        }
        let id = self.doc.comments.keys().next_back().map(|k| k + 1).unwrap_or(0);
        let props = p.props_at(end.saturating_sub(1)).clone();
        p.insert_object(end, InlineObject::CommentEnd { id }, &props).map_err(|e| e.to_string())?;
        p.insert_object(start, InlineObject::CommentStart { id }, &props).map_err(|e| e.to_string())?;
        let blocks: wordcraft_doc::Blocks = body.split('\n').map(|l| wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(l, CharProps::default()))).collect();
        self.put_para(block, p)?;
        let part = self.doc.add_part(PartKind::Comment, blocks);
        let initials: String = author.split_whitespace().filter_map(|w| w.chars().next()).take(2).flat_map(|c| c.to_uppercase()).collect();
        let a = if author.trim().is_empty() { "Somnia" } else { author.trim() };
        self.doc.comments.insert(id, wordcraft_doc::Comment { author: a.to_string(), initials, date: date.to_string(), parent: None, resolved: false, part });
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Spelling and grammar issues of every paragraph (top level, then table cells), as JSON
    /// `[{block,start,end,kind,word,message,suggestions,fixable}]` with UTF-8 byte offsets. Text marked "do not check", hidden text,
    /// links and text tagged with a language other than English are skipped. `words_json` is the user's own word list
    /// (at most 1000 words of 40 characters), added to the dictionary for the check. At most 400 issues are returned.
    fn do_proof_check(&self, words_json: &str) -> Result<String, String> {
        const MAX_ISSUES: usize = 400;
        let words: Vec<String> = serde_json::from_str(words_json).map_err(|_| "the word list is not valid".to_string())?;
        if words.len() > 1000 || words.iter().any(|w| w.is_empty() || w.chars().count() > 40 || w.chars().any(|c| c.is_control() || c.is_whitespace())) {
            return Err("the word list holds at most 1000 words of 1 to 40 characters".into());
        }
        for w in &words {
            wordcraft_proof::add_word(w);
        }
        let mut out: Vec<serde_json::Value> = Vec::new();
        let ids = (0..self.doc.body.len()).chain((0..self.cell_paras().count().min(CELL_LIST_MAX)).map(|n| CELL_BASE + n));
        'paras: for id in ids {
            let Some(p) = self.para_at(id) else { continue };
            if p.text.trim().is_empty() || p.text.len() > 100_000 {
                continue;
            }
            let text = wordcraft_layout::para::proof_text(p);
            let skip = |a: usize, b: usize| {
                p.run_ranges().any(|(r, c)| {
                    r.start < b
                        && a < r.end
                        && (c.no_proof == Some(true) || c.hidden == Some(true) || c.link.is_some() || c.lang.as_deref().is_some_and(|l| !l.to_ascii_lowercase().starts_with("en")))
                })
            };
            let mut found = wordcraft_proof::check_spelling(&text);
            found.extend(wordcraft_proof::check_grammar(&text));
            found.sort_by_key(|i| (i.start, i.end));
            for i in found {
                if skip(i.start, i.end) {
                    continue;
                }
                let Some(word) = p.text.get(i.start..i.end) else { continue };
                if out.len() >= MAX_ISSUES {
                    break 'paras;
                }
                out.push(serde_json::json!({
                    "block": id, "start": i.start, "end": i.end,
                    "kind": if i.kind == wordcraft_proof::IssueKind::Spelling { "spelling" } else { "grammar" },
                    "word": word, "message": i.message, "suggestions": i.suggestions.iter().take(5).collect::<Vec<_>>(),
                    "fixable": p.objects.is_empty(),
                }));
            }
        }
        Ok(serde_json::Value::Array(out).to_string())
    }
    /// Up to five spelling suggestions for one word, as a JSON array of strings.
    fn do_proof_suggest(&self, word: &str) -> Result<String, String> {
        if word.is_empty() || word.chars().count() > 40 || word.chars().any(|c| c.is_control() || c.is_whitespace()) {
            return Err("a word is 1 to 40 characters without spaces".into());
        }
        Ok(serde_json::json!(wordcraft_proof::suggest(word, 5)).to_string())
    }
    /// The document in another file format: `txt`, `md`, `html`, `rtf` or `odt` (what the format can hold; no layout is kept).
    /// The output is capped at 64 MiB.
    fn check_track_date(date: &str) -> Result<(), String> {
        if date.is_empty() || date.len() > 40 || !date.bytes().all(|b| b.is_ascii_digit() || b"-:TZ.+".contains(&b)) {
            return Err("the tracking date is not valid".into());
        }
        Ok(())
    }
    fn do_set_track(&mut self, on: bool, author: &str, date: &str) -> Result<(), String> {
        let author = author.trim();
        if author.is_empty() || author.chars().count() > 60 || author.chars().any(|c| c.is_control()) {
            return Err("the author name is 1 to 60 printable characters".into());
        }
        Self::check_track_date(date)?;
        self.track = on;
        self.track_author = author.to_string();
        self.track_date = date.to_string();
        self.doc.settings.track_changes = on;
        Ok(())
    }
    fn do_export_format(&self, ext: &str) -> Result<Vec<u8>, String> {
        if !["txt", "md", "html", "rtf", "odt"].contains(&ext) {
            return Err("the export format is txt, md, html, rtf or odt".into());
        }
        let bytes = wordcraft_formats::export(ext, &self.doc).ok_or_else(|| "that format is not available".to_string())??;
        if bytes.is_empty() || bytes.len() > 64 * 1024 * 1024 {
            return Err("the exported file is empty or larger than 64 MiB".into());
        }
        Ok(bytes)
    }
    /// Reads a Markdown, HTML, plain text, RTF or ODT file and writes it as DOCX bytes the normal open path takes.
    fn do_import_format(ext: &str, bytes: &[u8]) -> Result<Vec<u8>, String> {
        if bytes.len() > 16 * 1024 * 1024 {
            return Err("adapter input limit: 16 MiB".into());
        }
        if !["txt", "md", "html", "rtf", "odt"].contains(&ext) {
            return Err("the import format is txt, md, html, rtf or odt".into());
        }
        let doc = wordcraft_formats::import(ext, bytes).ok_or_else(|| "that format is not available".to_string())??;
        let out = wordcraft_docx::write(&doc).map_err(|e| e.to_string())?;
        if out.len() > 16 * 1024 * 1024 {
            return Err("the converted document is larger than 16 MiB".into());
        }
        Ok(out)
    }
    fn do_export_pdf(&self, opts_json: &str) -> Result<Vec<u8>, String> {
        self.do_export_pdf_at(opts_json, "")
    }
    /// A copy of the document whose properties carry the stamp of a save at `date` (ISO 8601 from the host, the worker
    /// has no clock): modified = date, created = date when the file had none, revision + 1. Empty `date` = no stamp.
    /// The open document is never changed.
    fn stamped(&self, date: &str) -> Result<Option<wordcraft_doc::Document>, String> {
        self.stamped_by(date, "")
    }
    /// Like `stamped`, also setting last-modified-by to `author` (at most 60 characters, no control characters) when it is not empty.
    fn stamped_by(&self, date: &str, author: &str) -> Result<Option<wordcraft_doc::Document>, String> {
        if author.chars().count() > 60 || author.chars().any(|c| c.is_control()) {
            return Err("the author name is limited to 60 characters".into());
        }
        if date.is_empty() {
            return Ok(None);
        }
        let b = date.as_bytes();
        let shape = date.len() >= 10 && date.len() <= 40 && b[4] == b'-' && b[7] == b'-' && b[..4].iter().chain(&b[5..7]).chain(&b[8..10]).all(|c| c.is_ascii_digit()) && date.chars().all(|c| c.is_ascii_digit() || "-:.TZ+".contains(c));
        if !shape {
            return Err("the save date is not valid".into());
        }
        let mut d = self.doc.clone();
        d.core.modified = date.to_string();
        if d.core.created.trim().is_empty() {
            d.core.created = date.to_string();
        }
        d.core.revision = d.core.revision.saturating_add(1);
        if !author.trim().is_empty() {
            d.core.last_modified_by = author.trim().to_string();
        }
        Ok(Some(d))
    }
    fn do_export_pdf_at(&self, opts_json: &str, date: &str) -> Result<Vec<u8>, String> {
        let n = self.pages.pages.len();
        if n == 0 {
            return Err("the document has no pages to export".into());
        }
        if n > PDF_MAX_PAGES {
            return Err(format!("adapter PDF limit: {PDF_MAX_PAGES} pages"));
        }
        if opts_json.len() > 32_000 {
            return Err("the PDF options are too large".into());
        }
        let v: serde_json::Value = serde_json::from_str(opts_json).map_err(|e| format!("PDF options are not valid JSON: {e}"))?;
        let o = v.as_object().ok_or("PDF options must be an object")?;
        let mut opts = wordcraft_pdf::PdfOptions::default();
        for (k, val) in o {
            match k.as_str() {
                "markup" => opts.include_markup = val.as_bool().ok_or("PDF option markup must be true or false")?,
                "tagged" => opts.tagged = val.as_bool().ok_or("PDF option tagged must be true or false")?,
                "pages" => {
                    let arr = val.as_array().ok_or("PDF option pages must be a list")?;
                    if arr.is_empty() || arr.len() > PDF_MAX_PAGES {
                        return Err(format!("PDF pages must list 1 to {PDF_MAX_PAGES} pages"));
                    }
                    let mut seen = std::collections::HashSet::new();
                    let mut list = Vec::with_capacity(arr.len());
                    for x in arr {
                        let i = x.as_u64().ok_or("PDF pages must be whole numbers")? as usize;
                        if i >= n {
                            return Err(format!("page {} does not exist", i + 1));
                        }
                        if !seen.insert(i) {
                            return Err(format!("page {} is listed twice", i + 1));
                        }
                        list.push(i);
                    }
                    opts.pages = Some(list);
                }
                _ => return Err(format!("unknown PDF option {k}")),
            }
        }
        let stamped = self.stamped(date)?;
        let bytes = wordcraft_pdf::export_layout(stamped.as_ref().unwrap_or(&self.doc), &self.pages, &opts).map_err(|e| e.to_string())?;
        if bytes.len() > PDF_MAX_BYTES {
            return Err("adapter PDF limit: the file would be larger than 100 MB".into());
        }
        Ok(bytes)
    }
    /// Document properties (title, subject, author, keywords, description, category) as JSON.
    fn do_properties(&self) -> String {
        let c = &self.doc.core;
        serde_json::json!({"title": c.title, "subject": c.subject, "creator": c.creator, "keywords": c.keywords, "description": c.description, "category": c.category}).to_string()
    }
    /// Sets the given document properties; every value is plain text of at most 255 characters (2000 for the description).
    /// Unknown keys and invalid values change nothing.
    fn do_set_properties(&mut self, patch_json: &str) -> Result<(), String> {
        if patch_json.len() > 16_000 {
            return Err("the properties change is too large".into());
        }
        let v: serde_json::Value = serde_json::from_str(patch_json).map_err(|e| format!("properties are not valid JSON: {e}"))?;
        let obj = v.as_object().ok_or("properties must be an object")?;
        let mut next = self.doc.core.clone();
        for (k, val) in obj {
            let t = val.as_str().ok_or_else(|| format!("property {k} must be text"))?.trim().to_string();
            let max = if k == "description" { 2000 } else { 255 };
            if t.chars().count() > max || t.chars().any(|c| c.is_control() && !(k == "description" && c == '\n')) {
                return Err(format!("property {k} is limited to {max} characters of plain text"));
            }
            match k.as_str() {
                "title" => next.title = t,
                "subject" => next.subject = t,
                "creator" => next.creator = t,
                "keywords" => next.keywords = t,
                "description" => next.description = t,
                "category" => next.category = t,
                _ => return Err(format!("unknown property {k}")),
            }
        }
        self.doc.core = next;
        Ok(())
    }
    /// Adds a reply to a comment (replying to a reply goes to its top-level comment). The reply is anchored inside the
    /// parent's range, so it travels with the paragraph, and starts out resolved or open like its parent.
    fn do_reply_comment(&mut self, parent: u32, text: &str, author: &str, date: &str) -> Result<(), String> {
        use wordcraft_doc::{InlineObject, PartKind};
        let body = text.trim();
        if body.is_empty() || body.chars().count() > COMMENT_MAX_CHARS || body.chars().any(|c| c.is_control() && c != '\n') {
            return Err(format!("a comment is 1 to {COMMENT_MAX_CHARS} characters"));
        }
        if author.chars().count() > 60 || author.chars().any(|c| c.is_control()) {
            return Err("the author name is limited to 60 characters".into());
        }
        if date.len() > 40 || date.chars().any(|c| !(c.is_ascii_digit() || "-:.TZ+".contains(c))) {
            return Err("the comment date is not valid".into());
        }
        if self.doc.comments.len() >= COMMENT_MAX_COUNT {
            return Err(format!("a document holds at most {COMMENT_MAX_COUNT} comments"));
        }
        let root = match self.doc.comments.get(&parent) {
            Some(c) => c.parent.unwrap_or(parent),
            None => return Err(format!("no comment {parent}")),
        };
        let resolved = self.doc.comments.get(&root).map(|c| c.resolved).unwrap_or(false);
        let mut found: Option<(usize, usize, usize)> = None;
        for pid in self.all_para_ids() {
            let Some(p) = self.para_at(pid) else { continue };
            let (mut so, mut eo) = (None, None);
            for (off, obj) in p.object_offsets().into_iter().zip(p.objects.iter()) {
                match obj {
                    InlineObject::CommentStart { id } if *id == root => so = Some(off),
                    InlineObject::CommentEnd { id } if *id == root => eo = Some(off),
                    _ => {}
                }
            }
            if let (Some(a), Some(b)) = (so, eo) {
                found = Some((pid, a, b));
                break;
            }
        }
        let (pid, so, eo) = found.ok_or_else(|| format!("comment {root} is not anchored inside one paragraph"))?;
        let mut p = self.para_at(pid).ok_or_else(|| format!("no paragraph {pid}"))?.clone();
        let id = self.doc.comments.keys().next_back().map(|k| k + 1).unwrap_or(0);
        let props = p.props_at(eo.saturating_sub(1)).clone();
        p.insert_object(eo, InlineObject::CommentEnd { id }, &props).map_err(|e| e.to_string())?;
        p.insert_object(so + OBJ.len_utf8(), InlineObject::CommentStart { id }, &props).map_err(|e| e.to_string())?;
        let blocks: wordcraft_doc::Blocks = body.split('\n').map(|l| wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(l, CharProps::default()))).collect();
        self.put_para(pid, p)?;
        let part = self.doc.add_part(PartKind::Comment, blocks);
        let initials: String = author.split_whitespace().filter_map(|w| w.chars().next()).take(2).flat_map(|c| c.to_uppercase()).collect();
        let a = if author.trim().is_empty() { "Somnia" } else { author.trim() };
        self.doc.comments.insert(id, wordcraft_doc::Comment { author: a.to_string(), initials, date: date.to_string(), parent: Some(root), resolved, part });
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Marks a comment and its replies resolved or open again.
    fn do_resolve_comment(&mut self, id: u32, resolved: bool) -> Result<(), String> {
        if !self.doc.comments.contains_key(&id) {
            return Err(format!("no comment {id}"));
        }
        for (cid, c) in self.doc.comments.iter_mut() {
            if *cid == id || c.parent == Some(id) {
                c.resolved = resolved;
            }
        }
        Ok(())
    }
    /// Deletes a comment, its replies, their text and their anchors (the paragraph becomes editable again).
    fn do_delete_comment(&mut self, id: u32) -> Result<(), String> {
        use wordcraft_doc::InlineObject;
        if !self.doc.comments.contains_key(&id) {
            return Err(format!("no comment {id}"));
        }
        let gone: Vec<u32> = self.doc.comments.iter().filter(|(cid, c)| **cid == id || c.parent == Some(id)).map(|(cid, _)| *cid).collect();
        for pid in self.all_para_ids() {
            let Some(p) = self.para_at(pid) else { continue };
            let hit = |o: &InlineObject| matches!(o, InlineObject::CommentStart { id } | InlineObject::CommentEnd { id } if gone.contains(id));
            if !p.objects.iter().any(hit) {
                continue;
            }
            let mut q = p.clone();
            let offs: Vec<usize> = q.object_offsets().into_iter().zip(q.objects.iter()).filter(|(_, o)| hit(o)).map(|(off, _)| off).collect();
            for off in offs.into_iter().rev() {
                q.delete(off, off + OBJ.len_utf8()).map_err(|e| e.to_string())?;
            }
            self.put_para(pid, q)?;
        }
        for cid in gone {
            if let Some(c) = self.doc.comments.remove(&cid) {
                self.doc.parts.remove(&c.part);
            }
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Puts a cover page before everything else: title, subtitle, author and date, then a page break before the first
    /// paragraph that was there. Empty subtitle, author or date are left out. Each text is at most 120 plain characters.
    fn do_insert_cover_page(&mut self, title: &str, subtitle: &str, author: &str, date: &str) -> Result<(), String> {
        for t in [title, subtitle, author, date] {
            if t.chars().count() > COVER_MAX_CHARS || t.chars().any(|c| c.is_control()) {
                return Err(format!("each cover page text is plain and at most {COVER_MAX_CHARS} characters"));
            }
        }
        if title.trim().is_empty() {
            return Err("the cover page needs a title".into());
        }
        if self.doc.body.len() + 8 >= 100_000 {
            return Err("the document has too many blocks".into());
        }
        let mut styles = self.doc.styles.clone();
        Self::ensure_style(&mut styles, "Title")?;
        Self::ensure_style(&mut styles, "Subtitle")?;
        let mk = |text: &str, style: Option<&str>, before: f32, bold: bool| {
            let props = CharProps { bold: if bold { Some(true) } else { None }, ..Default::default() };
            let mut p = wordcraft_doc::Paragraph::with_text(text.trim(), props);
            if let Some(s) = style {
                p = p.styled(s);
            }
            p.props.space_before = Some(before);
            p
        };
        let mut cover = vec![mk(title, Some("Title"), 150.0, false)];
        if !subtitle.trim().is_empty() {
            cover.push(mk(subtitle, Some("Subtitle"), 0.0, false));
        }
        if !author.trim().is_empty() {
            cover.push(mk(author, None, 180.0, true));
        }
        if !date.trim().is_empty() {
            cover.push(mk(date, None, 0.0, false));
        }
        let fixed = match self.doc.body.first().map(|b| &**b) {
            Some(Block::Para(p)) => {
                let mut q = p.clone();
                q.props.page_break_before = Some(true);
                Some(q)
            }
            _ => None,
        };
        self.doc.styles = styles;
        match fixed {
            Some(q) => self.doc.body[0] = wordcraft_doc::para_block(q),
            None => {
                // The document starts with a table: a paragraph of its own carries the page break.
                let mut q = wordcraft_doc::Paragraph::new();
                q.props.page_break_before = Some(true);
                self.doc.body.insert(0, wordcraft_doc::para_block(q));
            }
        }
        for (k, p) in cover.into_iter().enumerate() {
            self.doc.body.insert(k, wordcraft_doc::para_block(p));
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Compares two texts the way people sort lists: digit runs by value ("item 2" before "item 10"), everything else by character.
    fn natural_cmp(a: &str, b: &str) -> std::cmp::Ordering {
        use std::cmp::Ordering;
        use std::iter::Peekable;
        use std::str::Chars;
        fn digits(it: &mut Peekable<Chars>) -> String {
            let mut s = String::new();
            while let Some(&c) = it.peek() {
                if !c.is_ascii_digit() {
                    break;
                }
                s.push(c);
                it.next();
            }
            s
        }
        let (mut x, mut y) = (a.chars().peekable(), b.chars().peekable());
        loop {
            match (x.peek().copied(), y.peek().copied()) {
                (None, None) => return Ordering::Equal,
                (None, _) => return Ordering::Less,
                (_, None) => return Ordering::Greater,
                (Some(c), Some(d)) if c.is_ascii_digit() && d.is_ascii_digit() => {
                    let (p, q) = (digits(&mut x), digits(&mut y));
                    let (p, q) = (p.trim_start_matches('0'), q.trim_start_matches('0'));
                    let o = p.len().cmp(&q.len()).then_with(|| p.cmp(q));
                    if o != Ordering::Equal {
                        return o;
                    }
                }
                (Some(c), Some(d)) => {
                    if c != d {
                        return c.cmp(&d);
                    }
                    x.next();
                    y.next();
                }
            }
        }
    }
    /// Sorts the top-level paragraphs `first..=last` (2 to 500) by their text, ignoring case, with numbers in order. Each paragraph keeps its own
    /// formatting. Refuses a range with a table, a section break or an inline object (comment, bookmark, picture) so nothing is lost or moved wrongly.
    fn do_sort_paragraphs(&mut self, first: usize, last: usize, descending: bool) -> Result<(), String> {
        if first >= last || last >= self.doc.body.len() || last - first + 1 > SORT_MAX_PARAS {
            return Err(format!("choose 2 to {SORT_MAX_PARAS} paragraphs to sort"));
        }
        let mut keyed: Vec<(String, std::sync::Arc<Block>)> = Vec::new();
        for i in first..=last {
            let b = &self.doc.body[i];
            let Block::Para(p) = &**b else { return Err("only paragraphs can be sorted".into()) };
            if p.section.is_some() || p.text.contains(OBJ) || !p.objects.is_empty() {
                return Err("a paragraph with an object or a section break cannot be sorted".into());
            }
            keyed.push((p.plain_text().trim().to_lowercase(), b.clone()));
        }
        keyed.sort_by(|x, y| {
            let o = Self::natural_cmp(&x.0, &y.0);
            if descending { o.reverse() } else { o }
        });
        for (k, (_, b)) in keyed.into_iter().enumerate() {
            self.doc.body[first + k] = b;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Moves the top-level paragraphs `first..=last` one place up (`delta` -1) or down (+1), past the neighbouring block. Each keeps its formatting.
    /// Refuses a table, a section break (moved or passed) or a range of more than 500, and changes nothing then.
    fn do_move_paragraphs(&mut self, first: usize, last: usize, delta: i32) -> Result<(), String> {
        let len = self.doc.body.len();
        if first > last || last >= len || last - first + 1 > SORT_MAX_PARAS || (delta != -1 && delta != 1) {
            return Err("choose up to 500 paragraphs to move one place up or down".into());
        }
        let nb = if delta < 0 { first.checked_sub(1) } else if last + 1 < len { Some(last + 1) } else { None };
        let Some(nb) = nb else { return Err("the paragraphs are already at the edge".into()) };
        for i in (first..=last).chain(std::iter::once(nb)) {
            if let Block::Para(p) = &*self.doc.body[i] {
                if p.section.is_some() {
                    return Err("a section break cannot be moved or passed".into());
                }
            } else if i != nb {
                return Err("only paragraphs can be moved".into());
            }
        }
        if delta < 0 {
            self.doc.body[nb..=last].rotate_left(1);
        } else {
            self.doc.body[first..=nb].rotate_right(1);
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Document-wide paragraph spacing presets (the document defaults every paragraph without its own spacing inherits):
    /// (name, space before pt, space after pt, line multiple).
    const SPACINGS: [(&'static str, f32, f32, f32); 7] =
        [("default", 0.0, 8.0, 1.15), ("none", 0.0, 0.0, 1.0), ("compact", 0.0, 4.0, 1.0), ("tight", 0.0, 6.0, 1.15), ("open", 0.0, 10.0, 1.15), ("relaxed", 0.0, 6.0, 1.5), ("double", 0.0, 8.0, 2.0)];
    /// The preset the document defaults match, or `custom`.
    fn do_paragraph_spacing(&self) -> String {
        use wordcraft_doc::props::LineSpacing;
        let d = &self.doc.styles.default_para;
        let (b, a) = (d.space_before.unwrap_or(0.0), d.space_after.unwrap_or(0.0));
        let l = match d.line_spacing {
            Some(LineSpacing::Multiple(m)) => Some(m),
            None => Some(1.0),
            _ => None,
        };
        let hit = l.and_then(|l| Self::SPACINGS.iter().find(|(_, sb, sa, sl)| (sb - b).abs() < 0.01 && (sa - a).abs() < 0.01 && (sl - l).abs() < 0.01));
        hit.map_or("custom", |h| h.0).to_string()
    }
    fn do_set_paragraph_spacing(&mut self, value: &str) -> Result<(), String> {
        use wordcraft_doc::props::LineSpacing;
        let (_, b, a, l) = *Self::SPACINGS.iter().find(|s| s.0 == value).ok_or_else(|| "the paragraph spacing is not one of default, none, compact, tight, open, relaxed or double".to_string())?;
        let d = &mut self.doc.styles.default_para;
        d.space_before = Some(b);
        d.space_after = Some(a);
        d.line_spacing = Some(LineSpacing::Multiple(l));
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Visible bookmarks (names starting with `_` are Word's own and stay hidden) as JSON `[{name,block,quote}]` in document order.
    fn do_bookmarks(&self) -> String {
        use wordcraft_doc::InlineObject;
        let mut starts: Vec<(String, usize, usize)> = Vec::new();
        let mut ends: std::collections::HashMap<String, (usize, usize)> = Default::default();
        for pid in self.all_para_ids() {
            let Some(p) = self.para_at(pid) else { continue };
            for (off, obj) in p.object_offsets().into_iter().zip(p.objects.iter()) {
                match obj {
                    InlineObject::BookmarkStart { name } if !name.starts_with('_') && starts.len() < BOOKMARK_MAX_COUNT => starts.push((name.clone(), pid, off)),
                    InlineObject::BookmarkEnd { name } => {
                        ends.insert(name.clone(), (pid, off));
                    }
                    _ => {}
                }
            }
        }
        let items: Vec<_> = starts
            .into_iter()
            .map(|(name, pid, so)| {
                let quote = match (ends.get(&name), self.para_at(pid)) {
                    (Some((ep, eo)), Some(p)) if *ep == pid && *eo >= so + OBJ.len_utf8() => {
                        let q: String = p.text.get(so + OBJ.len_utf8()..*eo).unwrap_or("").chars().filter(|c| *c != OBJ).take(200).collect();
                        Some(q)
                    }
                    _ => None,
                };
                serde_json::json!({"name": name, "block": pid, "quote": quote})
            })
            .collect();
        serde_json::Value::Array(items).to_string()
    }
    /// Marks `start..end` (UTF-8 bytes, may be empty) of one paragraph that has no inline objects as a bookmark. A bookmark of the same
    /// name in another paragraph is moved. The paragraph becomes read-only (anchors are inline objects) until the bookmark is deleted.
    fn do_add_bookmark(&mut self, block: usize, start: usize, end: usize, name: &str) -> Result<(), String> {
        use wordcraft_doc::InlineObject;
        let ok = name.chars().next().is_some_and(|c| c.is_ascii_alphabetic()) && name.chars().count() <= BOOKMARK_MAX_NAME && name.chars().all(|c| c.is_ascii_alphanumeric() || c == '_');
        if !ok {
            return Err(format!("a bookmark name starts with a letter and has 1 to {BOOKMARK_MAX_NAME} letters, digits or underscores"));
        }
        let mut p = self.para_at(block).ok_or_else(|| format!("no paragraph {block}"))?.clone();
        if p.text.contains(OBJ) || !p.objects.is_empty() {
            return Err(format!("paragraph {block} already has an inline object (such as a bookmark or comment) and cannot take another"));
        }
        if start > end || end > p.text.len() || !p.text.is_char_boundary(start) || !p.text.is_char_boundary(end) {
            return Err("the bookmark needs a range inside one paragraph".into());
        }
        let existing: Vec<serde_json::Value> = serde_json::from_str(&self.do_bookmarks()).unwrap_or_default();
        if !existing.iter().any(|b| b["name"] == name) && existing.len() >= BOOKMARK_MAX_COUNT {
            return Err(format!("a document holds at most {BOOKMARK_MAX_COUNT} bookmarks"));
        }
        let had = existing.iter().any(|b| b["name"] == name);
        if had {
            self.do_delete_bookmark(name)?;
            p = self.para_at(block).ok_or_else(|| format!("no paragraph {block}"))?.clone();
        }
        let props = if p.text.is_empty() { CharProps::default() } else { p.props_at(end.saturating_sub(1)).clone() };
        p.insert_object(end, InlineObject::BookmarkEnd { name: name.to_string() }, &props).map_err(|e| e.to_string())?;
        p.insert_object(start, InlineObject::BookmarkStart { name: name.to_string() }, &props).map_err(|e| e.to_string())?;
        self.put_para(block, p)?;
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Removes a bookmark's anchors everywhere (the paragraph becomes editable again when it held nothing else).
    fn do_delete_bookmark(&mut self, name: &str) -> Result<(), String> {
        use wordcraft_doc::InlineObject;
        let hit = |o: &InlineObject| matches!(o, InlineObject::BookmarkStart { name: n } | InlineObject::BookmarkEnd { name: n } if n == name);
        let mut found = false;
        for pid in self.all_para_ids() {
            let Some(p) = self.para_at(pid) else { continue };
            if !p.objects.iter().any(hit) {
                continue;
            }
            found = true;
            let mut q = p.clone();
            let offs: Vec<usize> = q.object_offsets().into_iter().zip(q.objects.iter()).filter(|(_, o)| hit(o)).map(|(off, _)| off).collect();
            for off in offs.into_iter().rev() {
                q.delete(off, off + OBJ.len_utf8()).map_err(|e| e.to_string())?;
            }
            self.put_para(pid, q)?;
        }
        if !found {
            return Err(format!("no bookmark {name}"));
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Replaces ranges only when the paragraph still reads exactly `expected` (one atomic step inside the worker), then returns the
    /// paragraph text read back after the edit. A paragraph that changed since the caller read it is refused untouched.
    fn do_replace_checked(&mut self, block: usize, expected: &str, hunks: &[(usize, usize, String)]) -> Result<String, String> {
        let Some(p) = self.para_at(block) else { return Err(format!("block {block} is not a paragraph")) };
        if p.text != expected {
            return Err("stale: the paragraph changed since it was read".into());
        }
        self.do_replace_many(block, hunks)?;
        let Some(p) = self.para_at(block) else { return Err(format!("block {block} is not a paragraph")) };
        Ok(p.text.clone())
    }
    fn do_replace(&mut self, block: usize, start: usize, end: usize, text: &str) -> Result<(), String> {
        self.do_replace_many(block, &[(start, end, text.to_string())])
    }
}

#[wasm_bindgen]
impl DocSession {
    pub fn blocks(&self) -> String {
        self.block_list()
    }
    /// `hunks_json`: `[[start, end, "text"], ...]`, ascending offsets in the original paragraph.
    pub fn replace_ranges(&mut self, block: usize, hunks_json: &str) -> Result<(), JsValue> {
        let v: Vec<(usize, usize, String)> = serde_json::from_str(hunks_json).map_err(|e| js_err(&format!("bad hunks: {e}")))?;
        self.do_replace_many(block, &v).map_err(|e| js_err(&e))
    }
    /// `expected`: the paragraph text the edit was computed from. Returns the paragraph text after the edit; `stale: ...` when it differs.
    pub fn replace_checked(&mut self, block: usize, expected: &str, hunks_json: &str) -> Result<String, JsValue> {
        let v: Vec<(usize, usize, String)> = serde_json::from_str(hunks_json).map_err(|e| js_err(&format!("bad hunks: {e}")))?;
        self.do_replace_checked(block, expected, &v).map_err(|e| js_err(&e))
    }
    pub fn replace_range(&mut self, block: usize, utf8_start: usize, utf8_end: usize, text: &str) -> Result<(), JsValue> {
        self.do_replace(block, utf8_start, utf8_end, text).map_err(|e| js_err(&e))
    }
    /// Page-space hit test (page units, same space as `page_info`). JSON: `null` when nothing is hit,
    /// `{"block":i,"off":utf8,"editable":bool}` for a top-level paragraph, `{"block":null,"editable":false}`
    /// for text inside a table cell or another story. Never guesses: offsets come from the layout.
    pub fn hit_test(&self, page: usize, x: f32, y: f32) -> String {
        match self.pages.hit(page, x, y, StoryRef::Body) {
            None => "null".into(),
            Some(pos) if pos.path.depth() == 0 && pos.path.0.len() == 1 => {
                let b = pos.path.last();
                let editable = matches!(self.doc.body.get(b).map(|b| &**b), Some(Block::Para(p)) if !p.text.contains(OBJ) && p.objects.is_empty());
                serde_json::json!({"block": b, "off": pos.off, "editable": editable}).to_string()
            }
            // A paragraph directly inside a cell of a top-level table.
            Some(pos) if pos.story == StoryRef::Body && pos.path.0.len() == 4 => {
                let want = [pos.path.0[0] as usize, pos.path.0[1] as usize, pos.path.0[2] as usize, pos.path.0[3] as usize];
                match self.cell_paras().position(|c| c == want) {
                    Some(slot) => {
                        let id = CELL_BASE + slot;
                        let editable = self.para_at(id).is_some_and(|p| !p.text.contains(OBJ) && p.objects.is_empty());
                        serde_json::json!({"block": id, "off": pos.off, "editable": editable}).to_string()
                    }
                    None => serde_json::json!({"block": null, "editable": false}).to_string(),
                }
            }
            Some(_) => serde_json::json!({"block": null, "editable": false}).to_string(),
        }
    }
    /// Caret rectangle for a top-level paragraph offset: `{"page","x","top","height"}` or `null`.
    pub fn caret_at(&self, block: usize, utf8_off: usize) -> String {
        match self.pages.caret(&self.pos_of(block, utf8_off)) {
            Some(c) => serde_json::json!({"page": c.page, "x": c.x, "top": c.top, "height": c.height}).to_string(),
            None => "null".into(),
        }
    }
    /// Highlight rectangles inside one top-level paragraph: `[[page,x,y,w,h],...]`.
    pub fn selection_rects(&self, block: usize, a: usize, b: usize) -> String {
        let r: Vec<_> = self
            .pages
            .selection_rects(&self.doc, &self.pos_of(block, a), &self.pos_of(block, b), 0)
            .into_iter()
            .map(|(pg, r)| serde_json::json!([pg, r.x, r.y, r.w, r.h]))
            .collect();
        serde_json::Value::Array(r).to_string()
    }
    /// Sets bold / italic / underline on a selection `(start_block, start_off)..(end_block, end_off)`
    /// (UTF-8 byte offsets). `patch_json`: any subset of `{"bold":true,"italic":false,"underline":true,"font":"Source Serif 4","size":14,"color":"C0392B"|"auto"}`.
    pub fn format_range(&mut self, start_block: usize, start_off: usize, end_block: usize, end_off: usize, patch_json: &str) -> Result<(), JsValue> {
        self.do_format(start_block, start_off, end_block, end_off, patch_json).map_err(|e| js_err(&e))
    }
    /// `{"bold":"on|off|mixed","italic":...,"underline":...}` over a selection (same coordinates as `format_range`).
    pub fn format_state(&self, start_block: usize, start_off: usize, end_block: usize, end_off: usize) -> Result<String, JsValue> {
        self.do_format_state(start_block, start_off, end_block, end_off).map_err(|e| js_err(&e))
    }
    /// Paragraph alignment, indents and spacing for the whole paragraphs `first_block..=last_block`.
    /// `patch_json`: any subset of `{"align":"center","indentLeft":36,"indentFirst":-18,"spaceBefore":0,"spaceAfter":8,"lineSpacing":1.5}` (points; multiple for line spacing).
    pub fn format_paragraphs(&mut self, first_block: usize, last_block: usize, patch_json: &str) -> Result<(), JsValue> {
        self.do_para_format(first_block, last_block, patch_json).map_err(|e| js_err(&e))
    }
    /// JSON of the shared (or null when mixed) effective paragraph formatting over `first_block..=last_block`.
    pub fn paragraph_state(&self, first_block: usize, last_block: usize) -> Result<String, JsValue> {
        self.do_para_state(first_block, last_block).map_err(|e| js_err(&e))
    }
