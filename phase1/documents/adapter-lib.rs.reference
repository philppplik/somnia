    #[test]
    fn styles_editor_creates_modifies_deletes_and_applies() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let list = |s: &DocSession| -> Vec<serde_json::Value> { serde_json::from_str(&s.do_styles_list()).unwrap() };
        let find = |s: &DocSession, id: &str| list(s).into_iter().find(|v| v["id"] == id);
        let id = s.do_upsert_style(r#"{"name":"Callout","kind":"paragraph","font":"Georgia","size":13,"italic":true,"color":"C0392B","align":"center","spaceBefore":6,"spaceAfter":12,"lineSpacing":1.5}"#).unwrap();
        let v = find(&s, &id).unwrap();
        assert_eq!((v["name"].clone(), v["kind"].clone(), v["builtin"].clone(), v["basedOn"].clone()), ("Callout".into(), "paragraph".into(), false.into(), "Normal".into()));
        assert_eq!((v["size"].as_f64(), v["color"].as_str(), v["align"].as_str(), v["lineSpacing"].as_f64()), (Some(13.0), Some("C0392B"), Some("center"), Some(1.5)));
        let cid = s.do_upsert_style(r#"{"name":"Code","kind":"character","font":"Courier New","bold":true}"#).unwrap();
        assert_ne!(id, cid);
        // Apply: paragraph style by id, character style to a range.
        s.do_set_style(0, 0, &id).unwrap();
        s.do_format(0, 0, 0, 1, &format!(r#"{{"charStyle":"{cid}"}}"#)).unwrap();
        assert!(s.do_set_style(0, 0, &cid).is_err(), "a character style is not a paragraph style");
        assert!(s.do_format(0, 0, 0, 1, r#"{"charStyle":"Callout"}"#).is_err(), "a paragraph style is not a character style");
        assert!(s.do_format(0, 0, 0, 1, r#"{"charStyle":"Nope"}"#).is_err());
        let re = DocSession::from_bytes(&wordcraft_docx::write(&s.doc).unwrap()).unwrap();
        assert!(find(&re, &id).is_some() && find(&re, &cid).is_some(), "custom styles survive a save");
        // Modify: only the given fields change, null clears.
        s.do_upsert_style(&format!(r#"{{"id":"{id}","size":15,"italic":null,"basedOn":"Heading1"}}"#)).unwrap();
        let v = find(&s, &id).unwrap();
        assert_eq!((v["size"].as_f64(), v["italic"].clone(), v["font"].as_str(), v["basedOn"].clone()), (Some(15.0), serde_json::Value::Null, Some("Georgia"), "Heading1".into()));
        // Undo gap: a snapshot restores the styles.
        let snap = s.snapshot();
        s.do_upsert_style(&format!(r#"{{"id":"{id}","size":20}}"#)).unwrap();
        s.restore(snap).unwrap();
        assert_eq!(find(&s, &id).unwrap()["size"].as_f64(), Some(15.0));
        // Refusals change nothing.
        let before = s.do_styles_list();
        for bad in [
            "{}", "[]", "nope", r#"{"name":"x"}"#, r#"{"name":"","kind":"paragraph"}"#, r#"{"name":"a\nb","kind":"paragraph"}"#, r#"{"name":"callout","kind":"paragraph"}"#,
            r#"{"name":"Z","kind":"table"}"#, r#"{"id":"Nope","size":10}"#, r#"{"id":"Heading1","name":"Big"}"#, r#"{"name":"Q","kind":"paragraph","size":0}"#, r#"{"name":"Q","kind":"paragraph","size":401}"#,
            r#"{"name":"Q","kind":"paragraph","color":"red"}"#, r#"{"name":"Q","kind":"paragraph","align":"middle"}"#, r#"{"name":"Q","kind":"paragraph","lineSpacing":9}"#,
            r#"{"name":"Q","kind":"paragraph","spaceAfter":-1}"#, r#"{"name":"Q","kind":"paragraph","bold":"yes"}"#, r#"{"name":"Q","kind":"character","align":"left"}"#,
            r#"{"name":"Q","kind":"paragraph","basedOn":"Nope"}"#, r#"{"name":"Q","kind":"paragraph","font":""}"#, r#"{"name":"Q","kind":"paragraph","weird":1}"#,
        ] {
            assert!(s.do_upsert_style(bad).is_err(), "{bad}");
        }
        assert!(s.do_upsert_style(&format!(r#"{{"id":"{id}","basedOn":"{id}"}}"#)).is_err(), "no self base");
        let child = s.do_upsert_style(&format!(r#"{{"name":"Child","kind":"paragraph","basedOn":"{id}"}}"#)).unwrap();
        assert!(s.do_upsert_style(&format!(r#"{{"id":"{id}","basedOn":"{child}"}}"#)).is_err(), "no cycles");
        assert!(s.do_upsert_style(&format!(r#"{{"id":"{id}","basedOn":"{cid}"}}"#)).is_err(), "base must be the same kind");
        // Delete: users fall back, children are re-parented, built-ins stay.
        assert!(s.do_delete_style("Heading1").is_err() && s.do_delete_style("Nope").is_err());
        s.do_delete_style(&id).unwrap();
        assert!(find(&s, &id).is_none());
        assert_eq!(find(&s, &child).unwrap()["basedOn"], "Heading1");
        assert!(s.para_at(0).unwrap().props.style.is_none());
        s.do_delete_style(&cid).unwrap();
        assert!(s.para_at(0).unwrap().runs.iter().all(|r| r.props.style.is_none()));
        let _ = before;
    }
    #[test]
    fn save_records_last_modified_by_on_the_copy_only() {
        let s = DocSession::from_bytes(FIXTURE).unwrap();
        let before = s.doc.core.clone();
        let saved = s.save_at_by("2026-10-14T18:00:00Z", "  Ada Lovelace ").unwrap();
        assert_eq!(s.doc.core, before);
        let re = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(re.doc.core.last_modified_by, "Ada Lovelace");
        // An empty name keeps what the file had.
        let keep = DocSession::from_bytes(&s.save_at_by("2026-10-14T18:00:00Z", "").unwrap()).unwrap();
        assert_eq!(keep.doc.core.last_modified_by, before.last_modified_by);
        for bad in ["bell\u{7}", "line\nbreak", &"x".repeat(61)] {
            assert!(s.save_at_by("2026-10-14T18:00:00Z", bad).is_err(), "{bad:?}");
        }
        assert!(s.save_at_by("nope", "Ada").is_err());
    }
    #[test]
    fn save_stamps_a_clone_with_modified_created_and_revision() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        s.do_set_properties(r#"{"title":"Stamp"}"#).unwrap();
        let before = s.doc.core.clone();
        let saved = s.save_at("2026-10-14T18:00:00.000Z").unwrap();
        assert_eq!(s.doc.core, before, "the open document is untouched");
        let re = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(re.doc.core.modified, "2026-10-14T18:00:00.000Z");
        assert_eq!(re.doc.core.revision, before.revision + 1);
        if before.created.is_empty() {
            assert_eq!(re.doc.core.created, "2026-10-14T18:00:00.000Z");
        } else {
            assert_eq!(re.doc.core.created, before.created);
        }
        assert_eq!(re.doc.core.title, "Stamp");
        // Without a date nothing is stamped.
        let plain = DocSession::from_bytes(&s.save_at("").unwrap()).unwrap();
        assert_eq!(plain.doc.core.revision, before.revision);
        for bad in ["yesterday", "2026-10-14 18:00", "2026/10/14", "2026-10-14T18:00:00Z\n", &"2026-10-14".repeat(5)] {
            assert!(s.save_at(bad).is_err(), "{bad}");
        }
        s.paginate();
        assert!(s.do_export_pdf_at("{}", "2026-10-14T18:00:00Z").unwrap().starts_with(b"%PDF-"));
        assert!(s.do_export_pdf_at("{}", "nope").is_err());
    }
    #[test]
    fn pdf_export_options_pages_markup_tagged_and_refusals() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let pages = s.paginate();
        let all = s.do_export_pdf(r#"{"tagged":false,"markup":true}"#).unwrap();
        assert!(all.starts_with(b"%PDF-"));
        let first = s.do_export_pdf(r#"{"pages":[0]}"#).unwrap();
        assert!(first.starts_with(b"%PDF-"));
        if pages > 1 {
            assert!(first.len() < s.do_export_pdf("{}").unwrap().len());
        }
        let bad = [
            r#"{"pages":[]}"#.to_string(),
            format!(r#"{{"pages":[{pages}]}}"#),
            r#"{"pages":[0,0]}"#.to_string(),
            r#"{"pages":[-1]}"#.to_string(),
            r#"{"pages":"1"}"#.to_string(),
            r#"{"markup":"yes"}"#.to_string(),
            r#"{"colour":true}"#.to_string(),
            "[1]".to_string(),
            "not json".to_string(),
        ];
        for b in &bad {
            assert!(s.do_export_pdf(b).is_err(), "{b}");
        }
    }
    #[test]
    fn pdf_export_writes_a_pdf_with_selectable_text() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        // No layout yet: refused, nothing is written.
        assert!(s.do_export_pdf("{}").is_err());
        let pages = s.paginate();
        assert!(pages >= 1);
        s.do_set_properties(r#"{"title":"Somnia PDF test","creator":"Ada"}"#).unwrap();
        let pdf = s.do_export_pdf("{}").unwrap();
        assert!(pdf.starts_with(b"%PDF-"));
        assert!(pdf.windows(5).any(|w| w == b"%%EOF"));
        assert!(pdf.len() > 1000);
        // Deterministic enough to export twice from the same layout.
        assert!(s.do_export_pdf("{}").unwrap().starts_with(b"%PDF-"));
        // Editing text keeps exporting.
        s.do_set_properties(r#"{"title":""}"#).unwrap();
        s.paginate();
        assert!(s.do_export_pdf("{}").is_ok());
    }
    #[test]
    fn tab_stops_set_report_roundtrip_and_refuse() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        s.do_para_format(0, 0, r#"{"tabs":[{"pos":200,"align":"right","leader":"dot"},{"pos":72,"align":"left"}]}"#).unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.do_para_state(0, 0).unwrap()).unwrap();
        let t = v["tabs"].as_array().unwrap();
        assert_eq!(t.len(), 2);
        assert_eq!(t[0]["pos"], 72.0);
        assert_eq!(t[1]["align"], "right");
        assert_eq!(t[1]["leader"], "dot");
        let re = DocSession::from_bytes(&wordcraft_docx::write(&s.doc).unwrap()).unwrap();
        let r: serde_json::Value = serde_json::from_str(&re.do_para_state(0, 0).unwrap()).unwrap();
        assert_eq!(r["tabs"].as_array().unwrap().len(), 2);
        let before = s.do_para_state(0, 0).unwrap();
        let many: Vec<String> = (0..21).map(|i| format!(r#"{{"pos":{}}}"#, 10 + i * 10)).collect();
        for bad in [
            r#"{"tabs":"x"}"#.to_string(),
            r#"{"tabs":[{"pos":-1}]}"#.to_string(),
            r#"{"tabs":[{"pos":1441}]}"#.to_string(),
            r#"{"tabs":[{"pos":10,"align":"clear"}]}"#.to_string(),
            r#"{"tabs":[{"pos":10,"leader":"wavy"}]}"#.to_string(),
            r#"{"tabs":[{"pos":10},{"pos":10.2}]}"#.to_string(),
            r#"{"tabs":[{"pos":10,"extra":1}]}"#.to_string(),
            format!(r#"{{"tabs":[{}]}}"#, many.join(",")),
        ] {
            assert!(s.do_para_format(0, 0, &bad).is_err(), "{bad}");
        }
        assert_eq!(s.do_para_state(0, 0).unwrap(), before);
        s.do_para_format(0, 0, r#"{"tabs":[]}"#).unwrap();
        let e: serde_json::Value = serde_json::from_str(&s.do_para_state(0, 0).unwrap()).unwrap();
        assert_eq!(e["tabs"].as_array().unwrap().len(), 0);
    }
    #[test]
    fn paragraph_flow_options() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        s.do_para_format(0, 0, r#"{"pageBreakBefore":true,"keepNext":true,"keepLines":true,"widowControl":false,"indentRight":18}"#).unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.do_para_state(0, 0).unwrap()).unwrap();
        assert_eq!((v["pageBreakBefore"].as_bool(), v["keepNext"].as_bool(), v["keepLines"].as_bool(), v["widowControl"].as_bool()), (Some(true), Some(true), Some(true), Some(false)));
        assert_eq!(v["indentRight"], 18.0);
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let re = DocSession::from_bytes(&saved).unwrap();
        let r: serde_json::Value = serde_json::from_str(&re.do_para_state(0, 0).unwrap()).unwrap();
        assert_eq!((r["pageBreakBefore"].as_bool(), r["keepNext"].as_bool(), r["widowControl"].as_bool()), (Some(true), Some(true), Some(false)));
        // Two paragraphs that differ report no shared value.
        let m: serde_json::Value = serde_json::from_str(&s.do_para_state(0, 1).unwrap()).unwrap();
        assert!(m["pageBreakBefore"].is_null());
        // Refusals change nothing.
        let before = s.do_para_state(0, 0).unwrap();
        for bad in [r#"{"keepNext":"yes"}"#, r#"{"indentRight":-1}"#, r#"{"indentRight":1441}"#, r#"{"pageBreakBefore":1}"#, r#"{"keepLinez":true}"#] {
            assert!(s.do_para_format(0, 0, bad).is_err(), "{bad}");
        }
        assert_eq!(s.do_para_state(0, 0).unwrap(), before);
    }
    #[test]
    fn text_effects_links_and_clear() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        s.do_format(0, 0, 0, 3, r#"{"strike":true,"smallCaps":true,"vertAlign":"superscript","highlight":"yellow","link":"https://example.com/a?b=1"}"#).unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.do_format_state(0, 0, 0, 3).unwrap()).unwrap();
        assert_eq!(v["strike"], "on");
        assert_eq!(v["smallCaps"], "on");
        assert_eq!(v["vertAlign"], "superscript");
        assert_eq!(v["highlight"], "yellow");
        assert_eq!(v["link"], "https://example.com/a?b=1");
        // A selection that straddles formatted and plain text reports mixed / no shared value.
        let m: serde_json::Value = serde_json::from_str(&s.do_format_state(0, 0, 0, 6).unwrap()).unwrap();
        assert_eq!(m["strike"], "mixed");
        assert!(m["vertAlign"].is_null() && m["link"].is_null() && m["highlight"].is_null());
        // The link survives a save and reload.
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let re = DocSession::from_bytes(&saved).unwrap();
        let r: serde_json::Value = serde_json::from_str(&re.do_format_state(0, 0, 0, 3).unwrap()).unwrap();
        assert_eq!(r["link"], "https://example.com/a?b=1");
        // Removing the link and clearing formatting.
        s.do_format(0, 0, 0, 3, r#"{"link":""}"#).unwrap();
        s.do_format(0, 0, 0, 3, r#"{"bold":true}"#).unwrap();
        s.do_format(0, 0, 0, 3, r#"{"clear":true}"#).unwrap();
        let c: serde_json::Value = serde_json::from_str(&s.do_format_state(0, 0, 0, 3).unwrap()).unwrap();
        assert_eq!((c["strike"].as_str(), c["bold"].as_str(), c["smallCaps"].as_str()), (Some("off"), Some("off"), Some("off")));
        assert_eq!(c["vertAlign"], "baseline");
        assert_eq!(c["highlight"], "none");
        assert_eq!(c["link"], "");
        // Refusals change nothing.
        let before = s.do_para_state(0, 0).unwrap();
        for bad in [
            r#"{"link":"javascript:alert(1)"}"#,
            r#"{"link":"http://"}"#,
            r#"{"link":"https://a b.com"}"#,
            r#"{"link":"ftp://x.org"}"#,
            r##"{"link":"#"}"##,
            r##"{"link":"#1a"}"##,
            r##"{"link":"#a b"}"##,
            r##"{"link":"#a-b"}"##,
            r#"{"link":5}"#,
            r#"{"highlight":"purple"}"#,
            r#"{"vertAlign":"up"}"#,
            r#"{"clear":false}"#,
            r#"{"strike":"yes"}"#,
        ] {
            assert!(s.do_format(0, 0, 0, 3, bad).is_err(), "{bad}");
        }
        let long = format!(r#"{{"link":"https://{}"}}"#, "a".repeat(LINK_MAX_CHARS));
        assert!(s.do_format(0, 0, 0, 3, &long).is_err());
        assert_eq!(s.do_para_state(0, 0).unwrap(), before);
    }
    #[test]
    fn document_properties_set_roundtrip_and_undo_snapshot() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let snap = s.snapshot();
        s.do_set_properties(r#"{"title":"  Quarterly report ","creator":"Ada Lovelace","keywords":"a, b"}"#).unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.do_properties()).unwrap();
        assert_eq!((v["title"].as_str(), v["creator"].as_str()), (Some("Quarterly report"), Some("Ada Lovelace")));
        let re = DocSession::from_bytes(&wordcraft_docx::write(&s.doc).unwrap()).unwrap();
        let r: serde_json::Value = serde_json::from_str(&re.do_properties()).unwrap();
        assert_eq!(r["title"], "Quarterly report");
        assert_eq!(r["keywords"], "a, b");
        let before = s.do_properties();
        for bad in [r#"{"title":1}"#, r#"{"nope":"x"}"#, r#"[1]"#, r#"{"title":"bell\u0007"}"#] {
            assert!(s.do_set_properties(bad).is_err(), "{bad}");
        }
        assert!(s.do_set_properties(&format!(r#"{{"title":"{}"}}"#, "x".repeat(256))).is_err());
        assert_eq!(s.do_properties(), before);
        s.restore(snap).unwrap();
        let w: serde_json::Value = serde_json::from_str(&s.do_properties()).unwrap();
        assert_ne!(w["title"], "Quarterly report");
    }
    #[test]
    fn sort_paragraphs_orders_naturally_keeps_formatting_and_refuses_unsafe_ranges() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        s.doc.body.clear();
        for t in ["item 10", "Banana", "item 2", "apple", "cherry"] {
            s.doc.body.push(wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(t, CharProps::default())));
        }
        s.do_set_style(1, 1, "Heading1").unwrap();
        let snap = s.snapshot();
        let texts = |s: &DocSession| s.doc.body.iter().map(|b| b.as_para().unwrap().plain_text()).collect::<Vec<_>>();
        s.do_sort_paragraphs(0, 4, false).unwrap();
        assert_eq!(texts(&s), ["apple", "Banana", "cherry", "item 2", "item 10"]);
        let banana = s.doc.body.iter().filter_map(|b| b.as_para()).find(|p| p.plain_text() == "Banana").unwrap();
        assert_eq!(banana.props.style.as_deref(), Some("Heading1"));
        s.do_sort_paragraphs(0, 4, true).unwrap();
        assert_eq!(texts(&s), ["item 10", "item 2", "cherry", "Banana", "apple"]);
        // A sub-range leaves the rest alone.
        s.do_sort_paragraphs(2, 4, false).unwrap();
        assert_eq!(texts(&s), ["item 10", "item 2", "apple", "Banana", "cherry"]);
        // Refusals change nothing.
        let before = texts(&s);
        assert!(s.do_sort_paragraphs(1, 1, false).is_err());
        assert!(s.do_sort_paragraphs(3, 2, false).is_err());
        assert!(s.do_sort_paragraphs(0, 5, false).is_err());
        s.do_add_bookmark(3, 0, 0, "Mark").unwrap();
        assert!(s.do_sort_paragraphs(0, 4, false).is_err());
        s.do_delete_bookmark("Mark").unwrap();
        assert_eq!(texts(&s), before);
        s.restore(snap).unwrap();
        assert_eq!(texts(&s), ["item 10", "Banana", "item 2", "apple", "cherry"]);
        assert_eq!(DocSession::natural_cmp("a007", "a7"), std::cmp::Ordering::Equal);
    }
    #[test]
    fn move_paragraphs_swaps_with_the_neighbour_and_refuses_edges_and_bad_input() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        s.doc.body.clear();
        for t in ["a", "b", "c", "d"] {
            s.doc.body.push(wordcraft_doc::para_block(wordcraft_doc::Paragraph::with_text(t, CharProps::default())));
        }
        let snap = s.snapshot();
        let texts = |s: &DocSession| s.doc.body.iter().map(|b| b.as_para().unwrap().plain_text()).collect::<String>();
        s.do_move_paragraphs(1, 2, -1).unwrap();
        assert_eq!(texts(&s), "bcad");
        s.do_move_paragraphs(0, 1, 1).unwrap();
        assert_eq!(texts(&s), "abcd");
        s.do_move_paragraphs(3, 3, -1).unwrap();
        assert_eq!(texts(&s), "abdc");
        let before = texts(&s);
        assert!(s.do_move_paragraphs(0, 0, -1).is_err());
        assert!(s.do_move_paragraphs(3, 3, 1).is_err());
        assert!(s.do_move_paragraphs(2, 1, 1).is_err());
        assert!(s.do_move_paragraphs(0, 9, 1).is_err());
        assert!(s.do_move_paragraphs(1, 1, 2).is_err());
        assert_eq!(texts(&s), before);
        s.restore(snap).unwrap();
        assert_eq!(texts(&s), "abcd");
    }
    #[test]
    fn cover_page_goes_first_breaks_before_the_old_start_and_undoes() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let (n0, first0) = (s.doc.body.len(), s.doc.body[0].as_para().map(|p| p.plain_text()).unwrap());
        let snap = s.snapshot();
        s.do_insert_cover_page("Annual report", "Year 2026", "Ada Lovelace", "October 15, 2026").unwrap();
        assert_eq!(s.doc.body.len(), n0 + 4);
        let text = |i: usize| s.doc.body[i].as_para().map(|p| p.plain_text()).unwrap();
        assert_eq!((text(0).as_str(), text(1).as_str(), text(2).as_str(), text(3).as_str()), ("Annual report", "Year 2026", "Ada Lovelace", "October 15, 2026"));
        assert_eq!(s.doc.body[0].as_para().unwrap().props.style.as_deref(), Some("Title"));
        assert_eq!(s.doc.body[1].as_para().unwrap().props.style.as_deref(), Some("Subtitle"));
        // The old first paragraph keeps its text and starts a new page.
        assert_eq!(text(4), first0);
        assert_eq!(s.doc.body[4].as_para().unwrap().props.page_break_before, Some(true));
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let re = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(re.doc.body.len(), n0 + 4);
        s.restore(snap).unwrap();
        assert_eq!(s.doc.body.len(), n0);
        // Empty subtitle, author and date are left out; refusals change nothing.
        s.do_insert_cover_page("Only a title", "", " ", "").unwrap();
        assert_eq!(s.doc.body.len(), n0 + 1);
        let n1 = s.doc.body.len();
        let long = "x".repeat(COVER_MAX_CHARS + 1);
        for (t, st, a, d) in [("", "s", "a", "d"), ("  ", "", "", ""), (long.as_str(), "", "", ""), ("t", long.as_str(), "", ""), ("t", "", "bad\u{7}", ""), ("t", "", "", "a\nb")] {
            assert!(s.do_insert_cover_page(t, st, a, d).is_err(), "{t:?} {st:?} {a:?} {d:?}");
        }
        assert_eq!(s.doc.body.len(), n1);
    }
    #[test]
    fn paragraph_spacing_presets_apply_roundtrip_and_undo() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let snap = s.snapshot();
        let before = s.do_paragraph_spacing();
        for v in ["none", "compact", "tight", "open", "relaxed", "double", "default"] {
            s.do_set_paragraph_spacing(v).unwrap();
            assert_eq!(s.do_paragraph_spacing(), v);
        }
        s.do_set_paragraph_spacing("double").unwrap();
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let re = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(re.do_paragraph_spacing(), "double");
        for bad in ["", "Double", "wide", "double "] {
            assert!(s.do_set_paragraph_spacing(bad).is_err(), "{bad}");
        }
        assert_eq!(s.do_paragraph_spacing(), "double");
        s.restore(snap).unwrap();
        assert_eq!(s.do_paragraph_spacing(), before);
    }
    #[test]
    fn link_to_a_bookmark_roundtrips_through_docx() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        s.do_add_bookmark(1, 0, 0, "Target").unwrap();
        s.do_format(0, 0, 0, 3, r##"{"link":"#Target"}"##).unwrap();
        let st: serde_json::Value = serde_json::from_str(&s.do_format_state(0, 0, 0, 1).unwrap()).unwrap();
        assert_eq!(st["link"], "#Target");
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let re = DocSession::from_bytes(&saved).unwrap();
        let st: serde_json::Value = serde_json::from_str(&re.do_format_state(0, 0, 0, 1).unwrap()).unwrap();
        assert_eq!(st["link"], "#Target");
        assert!(serde_json::from_str::<serde_json::Value>(&re.do_bookmarks()).unwrap().as_array().unwrap().iter().any(|b| b["name"] == "Target"));
        // A link can be removed again.
        s.do_format(0, 0, 0, 3, r#"{"link":""}"#).unwrap();
    }
    #[test]
    fn bookmarks_add_move_delete_and_roundtrip() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let before = s.text();
        let snap = s.snapshot();
        assert_eq!(s.do_bookmarks(), "[]");
        s.do_add_bookmark(0, 0, 3, "Intro").unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.do_bookmarks()).unwrap();
        assert_eq!(v.as_array().unwrap().len(), 1);
        assert_eq!(v[0]["name"], "Intro");
        assert_eq!(v[0]["block"], 0);
        assert_eq!(v[0]["quote"], before.chars().take(3).collect::<String>());
        // The paragraph is read-only now and takes no second anchor.
        assert!(s.do_add_bookmark(0, 0, 1, "Other").is_err());
        // The same name in another paragraph moves the bookmark.
        s.do_add_bookmark(1, 0, 0, "Intro").unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.do_bookmarks()).unwrap();
        assert_eq!(v.as_array().unwrap().len(), 1);
        assert_eq!(v[0]["block"], 1);
        assert_eq!(s.text(), before);
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let re = DocSession::from_bytes(&saved).unwrap();
        assert!(serde_json::from_str::<serde_json::Value>(&re.do_bookmarks()).unwrap().as_array().unwrap().iter().any(|b| b["name"] == "Intro"));
        let long = "a".repeat(BOOKMARK_MAX_NAME + 1);
        for bad in ["", "1abc", "has space", "ünï", long.as_str()] {
            assert!(s.do_add_bookmark(2, 0, 1, bad).is_err(), "{bad}");
        }
        assert!(s.do_add_bookmark(9999, 0, 0, "Gone").is_err());
        assert!(s.do_add_bookmark(2, 3, 1, "Back").is_err());
        assert!(s.do_add_bookmark(2, 0, 99999, "Far").is_err());
        s.do_delete_bookmark("Intro").unwrap();
        assert_eq!(s.do_bookmarks(), "[]");
        assert!(s.do_delete_bookmark("Intro").is_err());
        assert_eq!(s.text(), before);
        s.do_add_bookmark(2, 0, 1, "Undo").unwrap();
        s.restore(snap).unwrap();
        assert_eq!(s.do_bookmarks(), "[]");
    }
    #[test]
    fn comment_replies_anchor_inside_parent_and_follow_it() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        s.do_add_comment(0, 0, 3, "Check this", "Ada Lovelace", "2026-10-14T12:00:00Z").unwrap();
        let root = *s.doc.comments.keys().next_back().unwrap();
        s.do_reply_comment(root, "Done", "Grace Hopper", "2026-10-14T13:00:00Z").unwrap();
        let reply = *s.doc.comments.keys().next_back().unwrap();
        // Replying to a reply attaches to the top-level comment.
        s.do_reply_comment(reply, "Thanks", "", "").unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.do_comments()).unwrap();
        let items = v.as_array().unwrap();
        let replies: Vec<_> = items.iter().filter(|c| c["parent"] == root).collect();
        assert_eq!(replies.len(), 2);
        assert!(replies.iter().all(|c| c["block"] == items.iter().find(|x| x["id"] == root).unwrap()["block"]));
        s.do_resolve_comment(root, true).unwrap();
        assert!(s.doc.comments.values().all(|c| c.resolved));
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let re = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(re.doc.comments.len(), s.doc.comments.len());
        // Deleting the top-level comment removes the replies too.
        s.do_delete_comment(root).unwrap();
        assert!(s.doc.comments.is_empty() || !s.doc.comments.values().any(|c| c.parent == Some(root)));
        // Refusals.
        assert!(s.do_reply_comment(9999, "x", "", "").is_err());
        assert!(s.do_reply_comment(root, "x", "", "").is_err());
    }
    #[test]
    fn comments_add_resolve_delete_and_roundtrip() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let before = s.text();
        let n0 = s.doc.comments.len();
        let snap = s.snapshot();
        s.do_add_comment(0, 0, 3, "Check this", "Ada Lovelace", "2026-10-14T12:00:00Z").unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.do_comments()).unwrap();
        let mine = v.as_array().unwrap().iter().find(|c| c["text"] == "Check this").unwrap().clone();
        assert_eq!(mine["quote"], before.chars().take(3).collect::<String>());
        assert_eq!(mine["initials"], "AL");
        assert_eq!(mine["block"], 0);
        assert_eq!(s.doc.comments.len(), n0 + 1);
        // The paragraph now holds anchors, so it is read-only and takes no second comment.
        assert!(s.do_add_comment(0, 0, 2, "Again", "", "").is_err());
        let id = mine["id"].as_u64().unwrap() as u32;
        s.do_resolve_comment(id, true).unwrap();
        assert!(s.doc.comments[&id].resolved);
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let re = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(re.doc.comments.len(), n0 + 1);
        assert!(serde_json::from_str::<serde_json::Value>(&re.do_comments()).unwrap().as_array().unwrap().iter().any(|c| c["text"] == "Check this" && c["resolved"] == true));
        s.do_delete_comment(id).unwrap();
        assert_eq!(s.doc.comments.len(), n0);
        assert_eq!(s.text(), before);
        assert!(s.do_delete_comment(id).is_err());
        // Undo restores the comment (snapshots carry comments).
        let snap2 = s.snapshot();
        s.do_add_comment(0, 0, 3, "Undo me", "", "").unwrap();
        s.restore(snap2).unwrap();
        assert_eq!(s.doc.comments.len(), n0);
        s.restore(snap).unwrap();
        // Refusals change nothing.
        assert!(s.do_add_comment(0, 3, 3, "x", "", "").is_err());
        assert!(s.do_add_comment(0, 0, 3, "   ", "", "").is_err());
        assert!(s.do_add_comment(0, 0, 3, "bad\u{7}", "", "").is_err());
        assert!(s.do_add_comment(0, 0, 3, &"x".repeat(COMMENT_MAX_CHARS + 1), "", "").is_err());
        assert!(s.do_add_comment(0, 0, 3, "x", "", "not a date").is_err());
        assert!(s.do_add_comment(0, 0, 99_999, "x", "", "").is_err());
        assert!(s.do_add_comment(99_999, 0, 1, "x", "", "").is_err());
        assert_eq!(s.doc.comments.len(), n0);
    }
    #[test]
    fn replace_range_roundtrips_and_is_atomic() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let before = s.text();
        s.do_replace(0, 0, "Somnia".len(), "Hello").unwrap();
        assert!(s.text().starts_with("Hello Documents"));
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        assert_eq!(DocSession::from_bytes(&saved).unwrap().text(), s.text());
        let now = s.text();
        assert!(s.do_replace(0, 3, 2, "x").is_err());
        assert!(s.do_replace(0, 0, 99999, "x").is_err());
        assert!(s.do_replace(999, 0, 0, "x").is_err());
        assert!(s.do_replace(0, 0, 0, "a\nb").is_err());
        assert_eq!(now, s.text());
        assert_ne!(before, now);
    }
    fn run_props(s: &DocSession, block: usize) -> Vec<(usize, bool)> {
        let Block::Para(p) = &*s.doc.body[block] else { panic!() };
        p.runs.iter().map(|r| (r.len, r.props.bold.unwrap_or(false))).collect()
    }
    fn state(s: &DocSession, sb: usize, so: usize, eb: usize, eo: usize) -> serde_json::Value {
        serde_json::from_str(&s.do_format_state(sb, so, eb, eo).unwrap()).unwrap()
    }
    #[test]
    fn format_range_sets_state_roundtrips_and_is_atomic() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let n = match &*s.doc.body[0] { Block::Para(p) => p.text.len(), _ => panic!() };
        assert!(n > 2);
        s.do_format(0, 0, 0, n, r#"{"italic":false}"#).unwrap();
        assert_eq!(state(&s, 0, 0, 0, n)["italic"], "off");
        s.do_format(0, 0, 0, 2, r#"{"italic":true,"underline":true}"#).unwrap();
        assert_eq!(state(&s, 0, 0, 0, 2)["italic"], "on");
        assert_eq!(state(&s, 0, 0, 0, 2)["underline"], "on");
        assert_eq!(state(&s, 0, 0, 0, n)["italic"], "mixed");
        assert_eq!(state(&s, 0, 2, 0, n)["italic"], "off");
        let text = s.text();
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let again = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(again.text(), text);
        assert_eq!(state(&again, 0, 0, 0, 2)["italic"], "on");
        assert_eq!(state(&again, 0, 0, 0, n)["italic"], "mixed");
        // Invalid requests change nothing.
        let before = wordcraft_docx::write(&s.doc).unwrap();
        assert!(s.do_format(0, 0, 0, n + 1, r#"{"bold":true}"#).is_err());
        assert!(s.do_format(999, 0, 999, 1, r#"{"bold":true}"#).is_err());
        assert!(s.do_format(0, 3, 0, 1, r#"{"bold":true}"#).is_err());
        assert!(s.do_format(0, 0, 0, 2, r#"{"bold":"yes"}"#).is_err());
        assert!(s.do_format(0, 0, 0, 2, r#"{"colour":true}"#).is_err());
        assert!(s.do_format(0, 0, 0, 2, "not json").is_err());
        assert!(s.do_format_state(999, 0, 999, 0).is_err());
        assert_eq!(wordcraft_docx::write(&s.doc).unwrap(), before);
    }
    #[test]
    fn format_range_sets_font_size_color_roundtrips_and_validates() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let n = match &*s.doc.body[0] { Block::Para(p) => p.text.len(), _ => panic!() };
        assert!(n > 2);
        s.do_format(0, 0, 0, 2, r#"{"font":"Source Serif 4","size":18.26,"color":"c0392b"}"#).unwrap();
        let st = state(&s, 0, 0, 0, 2);
        assert_eq!(st["font"], "Source Serif 4");
        assert_eq!(st["size"], 18.5);
        assert_eq!(st["color"], "C0392B");
        let mixed = state(&s, 0, 0, 0, n);
        assert!(mixed["size"].is_null() && mixed["color"].is_null() && mixed["font"].is_null());
        s.do_format(0, 0, 0, 2, r#"{"color":"auto"}"#).unwrap();
        assert_eq!(state(&s, 0, 0, 0, 2)["color"], "auto");
        s.do_format(0, 0, 0, 2, r#"{"color":"C0392B"}"#).unwrap();
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let again = DocSession::from_bytes(&saved).unwrap();
        let st = state(&again, 0, 0, 0, 2);
        assert_eq!((st["font"].as_str(), st["size"].as_f64(), st["color"].as_str()), (Some("Source Serif 4"), Some(18.5), Some("C0392B")));
        let before = wordcraft_docx::write(&s.doc).unwrap();
        for bad in [r#"{"size":0}"#, r#"{"size":401}"#, r#"{"size":"12"}"#, r#"{"font":""}"#, r#"{"font":5}"#, r#"{"color":"red"}"#, r##"{"color":"#C0392B"}"##, r#"{"color":"12345g"}"#] {
            assert!(s.do_format(0, 0, 0, 2, bad).is_err(), "{bad}");
        }
        let long = format!(r#"{{"font":"{}"}}"#, "x".repeat(65));
        assert!(s.do_format(0, 0, 0, 2, &long).is_err());
        assert_eq!(wordcraft_docx::write(&s.doc).unwrap(), before);
    }
    #[test]
    fn paragraph_format_sets_state_roundtrips_and_is_atomic() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let ps = |s: &DocSession, a: usize, b: usize| -> serde_json::Value { serde_json::from_str(&s.do_para_state(a, b).unwrap()).unwrap() };
        s.do_para_format(0, 0, r#"{"align":"center","indentLeft":36,"indentFirst":-18,"spaceBefore":6,"spaceAfter":12.5,"lineSpacing":1.5}"#).unwrap();
        let st = ps(&s, 0, 0);
        assert_eq!((st["align"].as_str(), st["indentLeft"].as_f64(), st["indentFirst"].as_f64()), (Some("center"), Some(36.0), Some(-18.0)));
        assert_eq!((st["spaceBefore"].as_f64(), st["spaceAfter"].as_f64(), st["lineSpacing"].as_f64()), (Some(6.0), Some(12.5), Some(1.5)));
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let again = DocSession::from_bytes(&saved).unwrap();
        let st2 = ps(&again, 0, 0);
        assert_eq!((st2["align"].as_str(), st2["indentLeft"].as_f64(), st2["spaceAfter"].as_f64(), st2["lineSpacing"].as_f64()), (Some("center"), Some(36.0), Some(12.5), Some(1.5)));
        let before = wordcraft_docx::write(&s.doc).unwrap();
        for bad in [r#"{"align":"middle"}"#, r#"{"align":1}"#, r#"{"indentLeft":-1}"#, r#"{"indentLeft":1441}"#, r#"{"spaceAfter":"3"}"#, r#"{"lineSpacing":0.1}"#, r#"{"lineSpacing":11}"#, r#"{"color":"red"}"#, "nope"] {
            assert!(s.do_para_format(0, 0, bad).is_err(), "{bad}");
        }
        assert!(s.do_para_format(0, 999, r#"{"align":"left"}"#).is_err());
        assert!(s.do_para_format(1, 0, r#"{"align":"left"}"#).is_err());
        assert_eq!(wordcraft_docx::write(&s.doc).unwrap(), before);
        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        let t = v.as_array().unwrap().iter().position(|b| b["kind"] == "table").unwrap();
        assert!(s.do_para_format(0, t, r#"{"align":"right"}"#).is_err());
        assert!(s.do_para_state(0, t).is_err());
        assert_eq!(wordcraft_docx::write(&s.doc).unwrap(), before);
    }
    #[test]
    fn styles_and_lists_apply_roundtrip_and_stay_atomic() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let ps = |s: &DocSession, a: usize, b: usize| -> serde_json::Value { serde_json::from_str(&s.do_para_state(a, b).unwrap()).unwrap() };
        s.do_set_style(0, 0, "Heading2").unwrap();
        assert_eq!(ps(&s, 0, 0)["style"], "Heading2");
        let blocks: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        assert_eq!(blocks[0]["outline"], 1);
        s.do_set_list(0, 1, "bullet").unwrap();
        assert_eq!(ps(&s, 0, 1)["list"], "bullet");
        s.do_list_level(0, 0, 1).unwrap();
        assert_eq!(ps(&s, 0, 0)["listLevel"], 1);
        s.do_list_level(0, 0, -5).unwrap();
        assert_eq!(ps(&s, 0, 0)["listLevel"], 0);
        s.do_set_list(0, 1, "numbered").unwrap();
        assert_eq!(ps(&s, 0, 1)["list"], "numbered");
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let again = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(ps(&again, 0, 0)["style"], "Heading2");
        assert_eq!(ps(&again, 0, 1)["list"], "numbered");
        s.do_set_list(0, 1, "none").unwrap();
        assert_eq!(ps(&s, 0, 1)["list"], "none");
        s.do_set_style(0, 0, "Normal").unwrap();
        assert_eq!(ps(&s, 0, 0)["style"], "Normal");
        let before = wordcraft_docx::write(&s.doc).unwrap();
        assert!(s.do_set_style(0, 0, "NoSuchStyle9").is_err());
        assert!(s.do_set_style(0, 0, "../x").is_err());
        assert!(s.do_set_list(0, 0, "roman").is_err());
        assert!(s.do_list_level(0, 0, 1).is_err());
        assert!(s.do_list_level(0, 0, 99).is_err());
        assert!(s.do_set_style(0, 999, "Title").is_err());
        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        let t = v.as_array().unwrap().iter().position(|b| b["kind"] == "table").unwrap();
        assert!(s.do_set_style(0, t, "Title").is_err());
        assert!(s.do_set_list(0, t, "bullet").is_err());
        assert_eq!(wordcraft_docx::write(&s.doc).unwrap(), before);
    }
    #[test]
    fn format_range_refuses_a_span_with_a_table_without_partial_change() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        let t = v.as_array().unwrap().iter().position(|b| b["kind"] == "table").unwrap();
        assert!(t > 0);
        let before = wordcraft_docx::write(&s.doc).unwrap();
        assert!(s.do_format(0, 0, t, 0, r#"{"bold":true}"#).is_err());
        assert!(s.do_format_state(0, 0, t, 0).is_err());
        assert_eq!(wordcraft_docx::write(&s.doc).unwrap(), before);
    }
    #[test]
    fn multi_hunk_edit_is_atomic_and_keeps_untouched_runs() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let t0 = match &*s.doc.body[0] { Block::Para(p) => p.text.clone(), _ => panic!() };
        let runs_before = run_props(&s, 0);
        // Two far-apart hunks; the text between them must keep its run structure.
        let last = t0.len();
        s.do_replace_many(0, &[(0, 0, "A".into()), (last, last, "Z".into())]).unwrap();
        let t1 = match &*s.doc.body[0] { Block::Para(p) => p.text.clone(), _ => panic!() };
        assert_eq!(t1, format!("A{t0}Z"));
        let runs_after = run_props(&s, 0);
        assert_eq!(runs_after.iter().map(|r| r.0).sum::<usize>(), t1.len());
        // Bold of the original text survives (insertions inherit neighbours).
        assert_eq!(runs_before.iter().any(|r| r.1), runs_after.iter().any(|r| r.1));
        let snapshot = s.text();
        // Second hunk invalid: nothing may change.
        assert!(s.do_replace_many(0, &[(0, 1, "".into()), (5000, 5001, "x".into())]).is_err());
        assert!(s.do_replace_many(0, &[(3, 4, "".into()), (2, 3, "".into())]).is_err());
        assert_eq!(snapshot, s.text());
    }
    #[test]
    fn insertion_at_paragraph_start_inherits_following_run() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let first = run_props(&s, 0)[0];
        s.do_replace(0, 0, 0, "X").unwrap();
        let after = run_props(&s, 0)[0];
        assert_eq!(after.1, first.1, "inserted text must share the formatting of what follows it");
        assert_eq!(after.0, first.0 + 1);
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let again = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(run_props(&again, 0)[0], after, "formatting must survive DOCX export and reopen");
    }
    #[test]
    fn replace_range_refuses_tables_and_non_boundaries() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        let t = v.as_array().unwrap().iter().find(|b| b["kind"] == "table").unwrap()["index"].as_u64().unwrap() as usize;
        assert!(s.do_replace(t, 0, 0, "x").is_err());
        s.do_replace(0, 0, 0, "é").unwrap();
        let old = s.text();
        assert!(s.do_replace(0, 1, 1, "x").is_err());
        assert_eq!(old, s.text());
        s.do_replace(0, 0, 2, "").unwrap();
        assert!(!s.text().starts_with("é"));
    }
    #[test]
    fn unicode_offsets_are_bytes_not_utf16() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        s.do_insert(0, 0, "é").unwrap();
        assert!(s.do_insert(0, 1, "x").is_err());
        s.do_insert(0, 2, "x").unwrap();
        assert!(s.text().starts_with("éx"));
    }
    #[test]
    fn hit_and_caret_roundtrip() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        s.paginate();
        let c: serde_json::Value = serde_json::from_str(&s.caret_at(0, 3)).unwrap();
        let (x, y) = (c["x"].as_f64().unwrap() as f32, (c["top"].as_f64().unwrap() + c["height"].as_f64().unwrap() / 2.0) as f32);
        let h: serde_json::Value = serde_json::from_str(&s.hit_test(c["page"].as_u64().unwrap() as usize, x, y)).unwrap();
        assert_eq!((h["block"].as_u64(), h["off"].as_u64()), (Some(0), Some(3)));
        let r: serde_json::Value = serde_json::from_str(&s.selection_rects(0, 0, 4)).unwrap();
        assert!(!r.as_array().unwrap().is_empty());
    }
    #[test]
    fn split_merge_snapshot_roundtrip() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let before = s.text();
        let snap0 = s.snapshot();
        let n = s.doc.body.len();
        s.do_split(1, 5).unwrap();
        assert_eq!(s.doc.body.len(), n + 1);
        assert_eq!(s.text().replace('\n', ""), before.replace('\n', ""));
        s.do_merge(2).unwrap();
        assert_eq!(s.text(), before);
        s.do_split(1, 5).unwrap();
        s.restore(snap0).unwrap();
        assert_eq!(s.text(), before);
        assert!(s.do_merge(0).is_err());
        assert!(s.do_merge(4).is_err(), "block 3 is a table");
        assert!(s.do_split(3, 0).is_err());
        assert!(s.do_split(1, 99999).is_err());
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        assert_eq!(DocSession::from_bytes(&saved).unwrap().text(), before);
    }

    // ---- corpus + fuzz (package 6) ----
    struct Rng(u64);
    impl Rng {
        fn next(&mut self) -> u64 {
            self.0 ^= self.0 << 13;
            self.0 ^= self.0 >> 7;
            self.0 ^= self.0 << 17;
            self.0
        }
        fn below(&mut self, n: usize) -> usize {
            if n == 0 { 0 } else { (self.next() % n as u64) as usize }
        }
    }
    fn corpus_files() -> Vec<(String, Vec<u8>)> {
        let dir = std::env::var("SOMNIA_CORPUS_DIR").unwrap_or_else(|_| concat!(env!("CARGO_MANIFEST_DIR"), "/../../../corpus").into());
        let mut v = vec![("sample.docx".to_string(), FIXTURE.to_vec())];
        if let Ok(rd) = std::fs::read_dir(&dir) {
            let mut names: Vec<_> = rd.filter_map(|e| e.ok()).map(|e| e.path()).filter(|p| p.extension().map_or(false, |x| x == "docx")).collect();
            names.sort();
            for p in names {
                v.push((p.file_name().unwrap().to_string_lossy().to_string(), std::fs::read(&p).unwrap()));
            }
        }
        v
    }
    /// (editable, text) per top-level block, taken from the adapter's own block list.
    fn model_of(s: &DocSession) -> Vec<(bool, String)> {
        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        v.as_array().unwrap().iter().map(|b| (b["editable"].as_bool().unwrap(), b["text"].as_str().unwrap_or("").to_string())).collect()
    }
    fn structural_ok(s: &DocSession, i: usize) -> bool {
        s.plain_para(i).is_ok()
    }
    #[test]
    fn corpus_opens_paginates_renders_and_roundtrips() {
        let files = corpus_files();
        assert!(files.len() >= 2, "corpus missing: set SOMNIA_CORPUS_DIR or run documents/corpus/gen_corpus.py");
        for (name, bytes) in files {
            let mut s = DocSession::from_bytes(&bytes).unwrap_or_else(|e| panic!("{name}: open failed: {e}"));
            let pages = s.paginate();
            assert!(pages >= 1, "{name}: no pages");
            s.render_png(0, 1.0).unwrap_or_else(|_| panic!("{name}: render failed"));
            let saved = wordcraft_docx::write(&s.doc).unwrap_or_else(|e| panic!("{name}: save failed: {e}"));
            if let Ok(out) = std::env::var("SOMNIA_CORPUS_OUT") {
                std::fs::create_dir_all(&out).unwrap();
                std::fs::write(format!("{out}/{name}"), &saved).unwrap();
            }
            let again = DocSession::from_bytes(&saved).unwrap_or_else(|e| panic!("{name}: reopen failed: {e}"));
            let m = model_of(&s);
            eprintln!("corpus {name}: {} blocks, {} editable, {pages} pages", m.len(), m.iter().filter(|b| b.0).count());
            assert_eq!(m, model_of(&again), "{name}: unedited save->reopen changed block texts");
        }
    }
    #[test]
    fn fuzz_edit_operations_against_a_text_model() {
        let alphabet: Vec<&str> = vec!["a", "b", " ", "é", "ß", "€", "😀", "日", "م", "x y", "Z"];
        let iters: usize = std::env::var("SOMNIA_FUZZ_ITERS").ok().and_then(|v| v.parse().ok()).unwrap_or(150);
        for (fi, (name, bytes)) in corpus_files().into_iter().enumerate() {
            let mut rng = Rng(0x9E3779B97F4A7C15 ^ (fi as u64 + 1) * 0x1234567);
            let mut s = DocSession::from_bytes(&bytes).unwrap();
            let mut model = model_of(&s);
            let mut snaps: Vec<(u32, Vec<(bool, String)>)> = Vec::new();
            for step in 0..iters {
                let ctx = format!("{name} step {step}");
                match rng.below(10) {
                    0..=4 => {
                        let b = rng.below(s.doc.body.len().min(model.len()));
                        let (editable, text) = model[b].clone();
                        let mut cuts = [0usize; 2];
                        for c in cuts.iter_mut() {
                            let idx: Vec<usize> = text.char_indices().map(|(i, _)| i).chain(std::iter::once(text.len())).collect();
                            *c = idx[rng.below(idx.len())];
                        }
                        let (a, z) = (cuts[0].min(cuts[1]), cuts[0].max(cuts[1]));
                        let ins = if rng.below(4) == 0 { String::new() } else { (0..1 + rng.below(3)).map(|_| alphabet[rng.below(alphabet.len())]).collect::<String>() };
                        let r = s.do_replace(b, a, z, &ins);
                        if editable {
                            r.unwrap_or_else(|e| panic!("{ctx}: replace refused: {e}"));
                            model[b].1 = format!("{}{}{}", &text[..a], ins, &text[z..]);
                        } else {
                            assert!(r.is_err(), "{ctx}: replace on a locked block must be refused");
                        }
                    }
                    5 | 6 => {
                        let b = rng.below(s.doc.body.len().min(model.len()));
                        let text = model[b].1.clone();
                        let idx: Vec<usize> = text.char_indices().map(|(i, _)| i).chain(std::iter::once(text.len())).collect();
                        let off = idx[rng.below(idx.len())];
                        let ok = structural_ok(&s, b);
                        let r = s.do_split(b, off);
                        if ok {
                            r.unwrap_or_else(|e| panic!("{ctx}: split refused: {e}"));
                            model[b].1 = text[..off].to_string();
                            model.insert(b + 1, (true, text[off..].to_string()));
                        } else {
                            assert!(r.is_err(), "{ctx}: split on a locked block must be refused");
                        }
                    }
                    7 => {
                        let b = rng.below(s.doc.body.len().min(model.len()));
                        let ok = b > 0 && structural_ok(&s, b) && structural_ok(&s, b - 1);
                        let r = s.do_merge(b);
                        if ok {
                            r.unwrap_or_else(|e| panic!("{ctx}: merge refused: {e}"));
                            let t = model.remove(b);
                            model[b - 1].1.push_str(&t.1);
                        } else {
                            assert!(r.is_err(), "{ctx}: merge of locked neighbours must be refused");
                        }
                    }
                    8 => {
                        if snaps.len() < 4 || rng.below(2) == 0 {
                            snaps.push((s.snapshot(), model.clone()));
                        } else {
                            let (id, m) = snaps[rng.below(snaps.len())].clone();
                            s.restore(id).unwrap();
                            model = m;
                        }
                    }
                    _ => {
                        s.paginate();
                        if !model.is_empty() {
                            let pg = s.pages.pages.len();
                            s.render_png(rng.below(pg), 0.5).unwrap_or_else(|_| panic!("{ctx}: render failed"));
                        }
                    }
                }
                assert_eq!(model_of(&s), model, "{ctx}: engine and model diverged");
                if step % 40 == 39 {
                    let saved = wordcraft_docx::write(&s.doc).unwrap_or_else(|e| panic!("{ctx}: save failed: {e}"));
                    let again = DocSession::from_bytes(&saved).unwrap_or_else(|e| panic!("{ctx}: reopen failed: {e}"));
                    let got = model_of(&again);
                    let exp: Vec<_> = model.iter().filter(|m| m.0).map(|m| m.1.clone()).collect();
                    let got_t: Vec<_> = got.iter().filter(|m| m.0).map(|m| m.1.clone()).collect();
                    assert_eq!(got_t, exp, "{ctx}: save->reopen changed editable text");
                }
            }
        }
    }
}
