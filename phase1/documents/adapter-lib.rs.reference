//! Experimental headless adapter. No DOM, egui, filesystem or UI thread access.
use wasm_bindgen::prelude::*;
use std::sync::Arc;
use wordcraft_doc::para::OBJ;
use wordcraft_doc::{Block, CharProps, Document, Pos, StoryRef};
use wordcraft_layout::{DocLayout, LayoutCache, LayoutOptions};

/// Block ids at or above this value address a paragraph inside a top-level table cell: `CELL_BASE + n` is the
/// n-th cell paragraph in document order (see `cell_paras`). Ids are recomputed from the document on every use,
/// so they are only stable until a table's structure changes; the host refreshes `blocks()` after every edit.
const CELL_BASE: usize = 1 << 20;
/// The block list names at most this many cell paragraphs (the rest stay read-only for the host).
const CELL_LIST_MAX: usize = 20_000;

#[wasm_bindgen]
pub struct DocSession {
    doc: Document,
    cache: LayoutCache,
    pages: DocLayout,
    snaps: std::collections::HashMap<u32, wordcraft_doc::Blocks>,
    next_snap: u32,
}

impl DocSession {
    fn from_bytes(bytes: &[u8]) -> Result<Self, String> {
        if bytes.len() > 16 * 1024 * 1024 {
            return Err("adapter input limit: 16 MiB".into());
        }
        let doc = wordcraft_docx::read(bytes).map_err(|e| e.to_string())?;
        Ok(Self { doc, cache: LayoutCache::new(), pages: DocLayout::default(), snaps: Default::default(), next_snap: 1 })
    }
    fn do_insert(&mut self, block: usize, offset: usize, text: &str) -> Result<(), String> {
        if text.len() > 1024 * 1024 {
            return Err("adapter edit limit: 1 MiB".into());
        }
        self.doc.insert_text(&self.pos_of(block, offset), text, &CharProps::default()).map_err(|e| e.to_string())?;
        // Invalidate placed pages; paragraph cache is revision-aware upstream.
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Top-level body blocks. A paragraph is `editable` only when it has no inline objects
    /// (images, fields, equations, comment anchors), because their offsets are not text.
    fn block_list(&self) -> String {
        let items: Vec<_> = self
            .doc
            .body
            .iter()
            .enumerate()
            .map(|(i, b)| match &**b {
                Block::Para(p) => {
                    let editable = !p.text.contains(OBJ) && p.objects.is_empty();
                    let rp = self.doc.styles.resolve_para(&p.props);
                    // Heading level 0..8 (style or direct outline level); body text (9) is not an outline entry.
                    let outline = rp.outline_level.filter(|l| *l < 9);
                    serde_json::json!({"index": i, "kind": "para", "text": if editable { p.text.clone() } else { p.plain_text() }, "editable": editable, "outline": outline})
                }
                Block::Table(_) => serde_json::json!({"index": i, "kind": "table", "editable": false}),
            })
            .collect();
        let mut items = items;
        // Paragraphs inside table cells follow as `cell` entries addressed by `CELL_BASE + n`.
        for (slot, path) in self.cell_paras().enumerate().take(CELL_LIST_MAX) {
            let [b, r, c, k] = path;
            if let Some(p) = self.para_by_path(path) {
                let editable = !p.text.contains(OBJ) && p.objects.is_empty();
                items.push(serde_json::json!({"index": CELL_BASE + slot, "kind": "cell", "text": if editable { p.text.clone() } else { p.plain_text() }, "editable": editable, "table": b, "row": r, "cell": c, "para": k, "outline": null}));
            }
        }
        serde_json::Value::Array(items).to_string()
    }
    /// `[block, row, cell, paragraph]` of every paragraph directly inside a cell of a top-level table, in document order.
    fn cell_paras(&self) -> impl Iterator<Item = [usize; 4]> + '_ {
        self.doc
            .body
            .iter()
            .enumerate()
            .filter_map(|(b, blk)| match &**blk {
                Block::Table(t) => Some((b, t)),
                _ => None,
            })
            .flat_map(|(b, t)| {
                t.rows.iter().enumerate().flat_map(move |(r, row)| {
                    row.cells
                        .iter()
                        .enumerate()
                        .flat_map(move |(c, cell)| cell.blocks.iter().enumerate().filter_map(move |(k, x)| matches!(&**x, Block::Para(_)).then_some([b, r, c, k])))
                })
            })
    }
    /// The paragraph a block id addresses: a top-level paragraph, or a cell paragraph for ids from `CELL_BASE`.
    fn para_at(&self, id: usize) -> Option<&wordcraft_doc::Paragraph> {
        if id < CELL_BASE {
            return match self.doc.body.get(id).map(|b| &**b) {
                Some(Block::Para(p)) => Some(p),
                _ => None,
            };
        }
        let path = self.cell_paras().nth(id - CELL_BASE)?;
        self.para_by_path(path)
    }
    /// The paragraph at `[block, row, cell, paragraph]`.
    fn para_by_path(&self, [b, r, c, k]: [usize; 4]) -> Option<&wordcraft_doc::Paragraph> {
        match self.doc.body.get(b).map(|x| &**x) {
            Some(Block::Table(t)) => match t.rows.get(r)?.cells.get(c)?.blocks.get(k).map(|x| &**x) {
                Some(Block::Para(p)) => Some(p),
                _ => None,
            },
            _ => None,
        }
    }
    /// Replaces the paragraph a block id addresses. A cell paragraph is replaced by cloning its table.
    fn put_para(&mut self, id: usize, p: wordcraft_doc::Paragraph) -> Result<(), String> {
        if id < CELL_BASE {
            let slot = self.doc.body.get_mut(id).ok_or_else(|| format!("no block {id}"))?;
            *slot = Arc::new(Block::Para(p));
            return Ok(());
        }
        let [b, r, c, k] = self.cell_paras().nth(id - CELL_BASE).ok_or_else(|| format!("no cell paragraph {id}"))?;
        let Some(Block::Table(t)) = self.doc.body.get(b).map(|x| &**x) else { return Err(format!("block {b} is not a table")) };
        let mut t2 = t.clone();
        let slot = t2.rows.get_mut(r).and_then(|row| row.cells.get_mut(c)).and_then(|cell| cell.blocks.get_mut(k)).ok_or_else(|| format!("no cell paragraph {id}"))?;
        *slot = Arc::new(Block::Para(p));
        self.doc.body[b] = Arc::new(Block::Table(t2));
        Ok(())
    }
    /// A document position for a block id (top-level paragraph or cell paragraph).
    fn pos_of(&self, id: usize, off: usize) -> Pos {
        if id >= CELL_BASE {
            if let Some([b, r, c, k]) = self.cell_paras().nth(id - CELL_BASE) {
                return Pos::new(StoryRef::Body, wordcraft_doc::Path(vec![b as u32, r as u32, c as u32, k as u32]), off);
            }
        }
        Pos::body(id, off)
    }
    /// A paragraph range is valid when it stays in one id space (top level or cells) and is short.
    fn id_span_ok(first: usize, last: usize) -> bool {
        last >= first && last - first < 2000 && ((first < CELL_BASE) == (last < CELL_BASE))
    }
    /// Applies several non-overlapping replacements (UTF-8 byte ranges in the ORIGINAL paragraph text,
    /// sorted ascending) to one top-level paragraph. Everything is done on a clone and committed only
    /// if every hunk is valid, so a failure leaves the document unchanged. Text outside the hunks keeps
    /// its runs untouched. Inserted text takes the formatting of the first replaced character; a pure
    /// insertion takes the character before it (Word behaviour), or the character after at paragraph start.
    fn do_replace_many(&mut self, block: usize, hunks: &[(usize, usize, String)]) -> Result<(), String> {
        if hunks.is_empty() {
            return Ok(());
        }
        if hunks.len() > 10_000 {
            return Err("too many hunks".into());
        }
        let mut total = 0usize;
        for (_, _, t) in hunks {
            total += t.len();
            if t.chars().any(|c| c == OBJ || c == '\n' || c == '\r') {
                return Err("replacement text must not contain line breaks or object marks".into());
            }
        }
        if total > 1024 * 1024 {
            return Err("adapter edit limit: 1 MiB".into());
        }
        let Some(orig) = self.para_at(block) else { return Err(format!("block {block} is not a paragraph")) };
        if orig.text.contains(OBJ) || !orig.objects.is_empty() {
            return Err(format!("paragraph {block} contains inline objects and cannot be edited as text"));
        }
        let mut prev_end = 0usize;
        for (start, end, _) in hunks {
            if start > end || *start < prev_end {
                return Err("hunks must be ascending, non-overlapping, with start <= end".into());
            }
            for off in [*start, *end] {
                if off > orig.text.len() || !orig.text.is_char_boundary(off) {
                    return Err(format!("offset {off} is not a character boundary inside paragraph {block}"));
                }
            }
            prev_end = *end;
        }
        let mut p = orig.clone();
        for (start, end, text) in hunks.iter().rev() {
            let (start, end) = (*start, *end);
            let props = if start < end {
                p.props_of_char(start).clone()
            } else if start > 0 {
                let prev = p.text[..start].char_indices().next_back().map(|(i, _)| i).unwrap_or(0);
                p.props_of_char(prev).clone()
            } else if !p.text.is_empty() {
                p.props_of_char(0).clone()
            } else {
                p.mark.clone()
            };
            p.delete(start, end).map_err(|e| e.to_string())?;
            if !text.is_empty() {
                p.insert_text(start, text, &props).map_err(|e| e.to_string())?;
            }
        }
        self.put_para(block, p)?;
        self.pages = DocLayout::default();
        Ok(())
    }
    fn plain_para(&self, block: usize) -> Result<&wordcraft_doc::Paragraph, String> {
        if block >= CELL_BASE {
            return Err("paragraphs inside table cells cannot be split or joined yet".into());
        }
        match self.doc.body.get(block).map(|b| &**b) {
            None => Err(format!("no block {block}")),
            Some(Block::Table(_)) => Err(format!("block {block} is a table, not a paragraph")),
            Some(Block::Para(p)) if p.text.contains(OBJ) || !p.objects.is_empty() => Err(format!("paragraph {block} contains inline objects and cannot be edited as text")),
            Some(Block::Para(p)) if p.section.is_some() => Err(format!("paragraph {block} carries a section break and cannot be split or merged")),
            Some(Block::Para(p)) => Ok(p),
        }
    }
    /// Splits a top-level paragraph at a UTF-8 offset. The new paragraph copies the paragraph properties.
    fn do_split(&mut self, block: usize, off: usize) -> Result<(), String> {
        let mut p = self.plain_para(block)?.clone();
        if off > p.text.len() || !p.text.is_char_boundary(off) {
            return Err(format!("offset {off} is not a character boundary inside paragraph {block}"));
        }
        let tail = p.split_off(off).map_err(|e| e.to_string())?;
        self.doc.body[block] = Arc::new(Block::Para(p));
        self.doc.body.insert(block + 1, Arc::new(Block::Para(tail)));
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Joins paragraph `block` onto the end of `block - 1`; the first paragraph keeps its properties.
    fn do_merge(&mut self, block: usize) -> Result<(), String> {
        if block == 0 {
            return Err("there is no previous paragraph".into());
        }
        let tail = self.plain_para(block)?.clone();
        let mut head = self.plain_para(block - 1)?.clone();
        head.append(tail);
        self.doc.body[block - 1] = Arc::new(Block::Para(head));
        self.doc.body.remove(block);
        self.pages = DocLayout::default();
        Ok(())
    }
    /// A paragraph whose text can be formatted by byte range: not a table, no inline objects.
    fn fmt_para(&self, block: usize) -> Result<&wordcraft_doc::Paragraph, String> {
        match self.para_at(block) {
            None => Err(format!("block {block} is not a paragraph")),
            Some(p) if p.text.contains(OBJ) || !p.objects.is_empty() => Err(format!("paragraph {block} contains inline objects and cannot be formatted as text")),
            Some(p) => Ok(p),
        }
    }
    /// Non-empty per-paragraph byte ranges `(block, start, end)` covered by a selection that starts at
    /// `(sb, so)` and ends at `(eb, eo)`. Every paragraph in the span must be formattable and every offset
    /// a character boundary, otherwise nothing is returned (callers then change nothing).
    fn span_ranges(&self, sb: usize, so: usize, eb: usize, eo: usize) -> Result<Vec<(usize, usize, usize)>, String> {
        if eb < sb || (eb == sb && eo < so) {
            return Err("selection end is before its start".into());
        }
        if !Self::id_span_ok(sb, eb) {
            return Err("selection spans too many paragraphs or leaves the table".into());
        }
        let mut out = Vec::new();
        for b in sb..=eb {
            let p = self.fmt_para(b)?;
            let start = if b == sb { so } else { 0 };
            let end = if b == eb { eo } else { p.text.len() };
            for off in [start, end] {
                if off > p.text.len() || !p.text.is_char_boundary(off) {
                    return Err(format!("offset {off} is not a character boundary inside paragraph {b}"));
                }
            }
            if start < end {
                out.push((b, start, end));
            }
        }
        Ok(out)
    }
    /// Sets bold / italic / underline (each `true` or `false`) on a selection. The patch is a JSON object
    /// such as `{"bold":true}`; unknown or non-boolean fields are refused. All paragraphs are changed on
    /// clones and committed together, so a failure leaves the document unchanged.
    fn do_format(&mut self, sb: usize, so: usize, eb: usize, eo: usize, patch_json: &str) -> Result<(), String> {
        let v: serde_json::Value = serde_json::from_str(patch_json).map_err(|e| format!("bad format patch: {e}"))?;
        let obj = v.as_object().ok_or_else(|| "format patch must be an object".to_string())?;
        let mut bold: Option<bool> = None;
        let mut italic: Option<bool> = None;
        let mut underline: Option<wordcraft_doc::props::Underline> = None;
        let mut font: Option<String> = None;
        let mut size: Option<f32> = None;
        let mut color: Option<wordcraft_doc::props::TextColor> = None;
        for (k, val) in obj {
            match k.as_str() {
                "font" => {
                    let f = val.as_str().ok_or_else(|| "format field font must be text".to_string())?;
                    if f.is_empty() || f.chars().count() > 64 || f.chars().any(|c| c.is_control()) {
                        return Err("format field font must be 1-64 printable characters".into());
                    }
                    font = Some(f.to_string());
                    continue;
                }
                "size" => {
                    let n = val.as_f64().ok_or_else(|| "format field size must be a number".to_string())?;
                    if !n.is_finite() || !(1.0..=400.0).contains(&n) {
                        return Err("format field size must be between 1 and 400 points".into());
                    }
                    size = Some(((n * 2.0).round() / 2.0) as f32);
                    continue;
                }
                "color" => {
                    let c = val.as_str().ok_or_else(|| "format field color must be text".to_string())?;
                    color = Some(if c == "auto" {
                        wordcraft_doc::props::TextColor::Auto
                    } else if c.len() == 6 && c.bytes().all(|b| b.is_ascii_hexdigit()) {
                        let n = u32::from_str_radix(c, 16).map_err(|e| e.to_string())?;
                        wordcraft_doc::props::TextColor::Rgb(wordcraft_doc::props::Rgb((n >> 16) as u8, (n >> 8) as u8, n as u8))
                    } else {
                        return Err("format field color must be auto or RRGGBB".into());
                    });
                    continue;
                }
                _ => {}
            }
            let flag = val.as_bool().ok_or_else(|| format!("format field {k} must be true or false"))?;
            match k.as_str() {
                "bold" => bold = Some(flag),
                "italic" => italic = Some(flag),
                "underline" => {
                    underline = Some(if flag { wordcraft_doc::props::Underline::Single } else { wordcraft_doc::props::Underline::None })
                }
                _ => return Err(format!("unknown format field {k}")),
            }
        }
        if obj.is_empty() {
            return Ok(());
        }
        let ranges = self.span_ranges(sb, so, eb, eo)?;
        let mut done: Vec<(usize, wordcraft_doc::Paragraph)> = Vec::with_capacity(ranges.len());
        for (b, start, end) in ranges {
            let mut p = self.fmt_para(b)?.clone();
            p.format(start, end, &|cp: &mut CharProps| {
                if let Some(v) = bold {
                    cp.bold = Some(v);
                }
                if let Some(v) = italic {
                    cp.italic = Some(v);
                }
                if let Some(v) = underline {
                    cp.underline = Some(v);
                }
                if let Some(v) = &font {
                    cp.font = Some(v.clone());
                }
                if let Some(v) = size {
                    cp.size = Some(v);
                }
                if let Some(v) = color {
                    cp.color = Some(v);
                }
            })
            .map_err(|e| e.to_string())?;
            done.push((b, p));
        }
        for (b, p) in done {
            self.put_para(b, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Effective (style + direct) bold / italic / underline over a selection, each `"on"`, `"off"` or
    /// `"mixed"`. A collapsed selection reports what typing at that point would get.
    fn do_format_state(&self, sb: usize, so: usize, eb: usize, eo: usize) -> Result<String, String> {
        let mut seen: Vec<(bool, bool, bool)> = Vec::new();
        let mut look: Vec<(String, f32, wordcraft_doc::props::TextColor)> = Vec::new();
        if sb == eb && so == eo {
            let p = self.fmt_para(sb)?;
            if so > p.text.len() || !p.text.is_char_boundary(so) {
                return Err(format!("offset {so} is not a character boundary inside paragraph {sb}"));
            }
            let rc = self.doc.styles.resolve_char(p.props.style.as_deref(), p.props_at(so));
            seen.push((rc.bold, rc.italic, rc.underline != wordcraft_doc::props::Underline::None));
            look.push((rc.font.clone(), rc.size, rc.color));
        } else {
            for (b, start, end) in self.span_ranges(sb, so, eb, eo)? {
                let p = self.fmt_para(b)?;
                for (r, cp) in p.run_ranges() {
                    if r.start < end && r.end > start {
                        let rc = self.doc.styles.resolve_char(p.props.style.as_deref(), cp);
                        seen.push((rc.bold, rc.italic, rc.underline != wordcraft_doc::props::Underline::None));
                        look.push((rc.font.clone(), rc.size, rc.color));
                    }
                }
            }
        }
        fn tri(seen: &[(bool, bool, bool)], f: impl Fn(&(bool, bool, bool)) -> bool) -> &'static str {
            if !seen.is_empty() && seen.iter().all(|x| f(x)) {
                "on"
            } else if seen.iter().any(|x| f(x)) {
                "mixed"
            } else {
                "off"
            }
        }
        // font / size / color: the shared value, or null when the selection mixes values (or is empty).
        let same = |f: &dyn Fn(&(String, f32, wordcraft_doc::props::TextColor)) -> bool| !look.is_empty() && look.iter().all(|x| f(x));
        let first = look.first();
        let font = first.filter(|x| same(&|y| y.0 == x.0)).map(|x| x.0.clone());
        let size = first.filter(|x| same(&|y| y.1 == x.1)).map(|x| x.1);
        let color = first.filter(|x| same(&|y| y.2 == x.2)).map(|x| match x.2 {
            wordcraft_doc::props::TextColor::Auto => "auto".to_string(),
            wordcraft_doc::props::TextColor::Rgb(c) => c.hex(),
        });
        Ok(serde_json::json!({"bold": tri(&seen, |x| x.0), "italic": tri(&seen, |x| x.1), "underline": tri(&seen, |x| x.2), "font": font, "size": size, "color": color}).to_string())
    }
    /// Paragraph formatting for the whole paragraphs `first..=last` (selection coordinates are not needed:
    /// alignment, indents and spacing belong to a paragraph). Any non-paragraph block in the span, or an
    /// invalid value, refuses the whole call. Changes are made on clones and committed together.
    fn do_para_format(&mut self, first: usize, last: usize, patch_json: &str) -> Result<(), String> {
        use wordcraft_doc::props::{Align, LineSpacing};
        let v: serde_json::Value = serde_json::from_str(patch_json).map_err(|e| format!("bad paragraph patch: {e}"))?;
        let obj = v.as_object().ok_or_else(|| "paragraph patch must be an object".to_string())?;
        if obj.is_empty() {
            return Ok(());
        }
        let num = |k: &str, val: &serde_json::Value, lo: f64, hi: f64| -> Result<f32, String> {
            let n = val.as_f64().ok_or_else(|| format!("paragraph field {k} must be a number"))?;
            if !n.is_finite() || n < lo || n > hi {
                return Err(format!("paragraph field {k} must be between {lo} and {hi}"));
            }
            Ok(((n * 20.0).round() / 20.0) as f32)
        };
        let mut align: Option<Align> = None;
        let (mut il, mut ifirst, mut sb, mut sa, mut ls): (Option<f32>, Option<f32>, Option<f32>, Option<f32>, Option<f32>) = (None, None, None, None, None);
        for (k, val) in obj {
            match k.as_str() {
                "align" => {
                    align = Some(match val.as_str() {
                        Some("left") => Align::Left,
                        Some("center") => Align::Center,
                        Some("right") => Align::Right,
                        Some("justify") => Align::Justify,
                        _ => return Err("paragraph field align must be left, center, right or justify".into()),
                    })
                }
                "indentLeft" => il = Some(num(k, val, 0.0, 1440.0)?),
                "indentFirst" => ifirst = Some(num(k, val, -1440.0, 1440.0)?),
                "spaceBefore" => sb = Some(num(k, val, 0.0, 1584.0)?),
                "spaceAfter" => sa = Some(num(k, val, 0.0, 1584.0)?),
                "lineSpacing" => ls = Some(num(k, val, 0.5, 10.0)?),
                _ => return Err(format!("unknown paragraph field {k}")),
            }
        }
        if !Self::id_span_ok(first, last) {
            return Err("paragraph range is out of bounds".into());
        }
        let mut done: Vec<(usize, wordcraft_doc::Paragraph)> = Vec::with_capacity(last - first + 1);
        for b in first..=last {
            let mut p = match self.para_at(b) {
                Some(p) => p.clone(),
                None => return Err(format!("block {b} is not a paragraph")),
            };
            if let Some(a) = align {
                p.props.align = Some(a);
            }
            if let Some(x) = il {
                p.props.indent_left = Some(x);
            }
            if let Some(x) = ifirst {
                p.props.indent_first = Some(x);
            }
            if let Some(x) = sb {
                p.props.space_before = Some(x);
            }
            if let Some(x) = sa {
                p.props.space_after = Some(x);
            }
            if let Some(x) = ls {
                p.props.line_spacing = Some(LineSpacing::Multiple(x));
            }
            done.push((b, p));
        }
        for (b, p) in done {
            self.put_para(b, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Effective paragraph formatting over `first..=last`: each field is the shared value or null when mixed.
    /// `lineSpacing` is the multiple, or null when mixed or set as an exact / at-least height.
    fn do_para_state(&self, first: usize, last: usize) -> Result<String, String> {
        use wordcraft_doc::props::{Align, LineSpacing};
        if !Self::id_span_ok(first, last) {
            return Err("paragraph range is out of bounds".into());
        }
        let mut rows = Vec::new();
        for b in first..=last {
            match self.para_at(b) {
                Some(p) => rows.push(self.doc.styles.resolve_para(&p.props)),
                None => return Err(format!("block {b} is not a paragraph")),
            }
        }
        fn same_str(v: &[&str]) -> Option<String> {
            let first = *v.first()?;
            v.iter().all(|x| *x == first).then(|| first.to_string())
        }
        fn same<T: PartialEq + Copy>(rows: &[wordcraft_doc::resolve::ResolvedPara], f: impl Fn(&wordcraft_doc::resolve::ResolvedPara) -> T) -> Option<T> {
            let first = f(rows.first()?);
            rows.iter().all(|r| f(r) == first).then_some(first)
        }
        let align = same(&rows, |r| r.align).map(|a| match a {
            Align::Center => "center",
            Align::Right => "right",
            Align::Justify | Align::Distribute => "justify",
            Align::Left => "left",
        });
        let ls = same(&rows, |r| match r.line_spacing {
            LineSpacing::Multiple(m) => Some(m.to_bits()),
            _ => None,
        })
        .flatten()
        .map(f32::from_bits);
        Ok(serde_json::json!({
            "align": align,
            "indentLeft": same(&rows, |r| r.indent_left.to_bits()).map(f32::from_bits),
            "indentFirst": same(&rows, |r| r.indent_first.to_bits()).map(f32::from_bits),
            "spaceBefore": same(&rows, |r| r.space_before.to_bits()).map(f32::from_bits),
            "spaceAfter": same(&rows, |r| r.space_after.to_bits()).map(f32::from_bits),
            "lineSpacing": ls,
            "style": same_str(&rows.iter().map(|r| r.style.as_str()).collect::<Vec<_>>()),
            "list": same_str(&rows.iter().map(|r| self.list_kind(r.numbering)).collect::<Vec<_>>()),
            "listLevel": same(&rows, |r| match r.numbering { Some(n) if n.num != 0 => Some(n.level), _ => None }).flatten(),
        })
        .to_string())
    }
    /// `"none"`, `"bullet"` or `"numbered"` for a resolved numbering reference.
    fn list_kind(&self, n: Option<wordcraft_doc::props::NumRef>) -> &'static str {
        match n {
            Some(n) if n.num != 0 => match self.doc.numbering.level(n.num, n.level.min(8)) {
                Some(l) if l.format == wordcraft_doc::section::NumFormat::Bullet => "bullet",
                Some(_) => "numbered",
                None => "none",
            },
            _ => "none",
        }
    }
    /// Copies built-in styles that the document lacks (and their `basedOn` chain) into `styles`.
    fn ensure_style(styles: &mut wordcraft_doc::StyleSheet, id: &str) -> Result<(), String> {
        let mut next = Some(id.to_string());
        let mut guard = 0;
        while let Some(cur) = next.take() {
            guard += 1;
            if guard > 8 || styles.get(&cur).is_some() {
                continue;
            }
            let st = wordcraft_doc::StyleSheet::builtin().get(&cur).cloned().ok_or_else(|| format!("unknown style {cur}"))?;
            next = st.based_on.clone();
            styles.upsert(st);
        }
        Ok(())
    }
    fn para_span(&self, first: usize, last: usize) -> Result<Vec<wordcraft_doc::Paragraph>, String> {
        if !Self::id_span_ok(first, last) {
            return Err("paragraph range is out of bounds".into());
        }
        (first..=last)
            .map(|b| match self.para_at(b) {
                Some(p) => Ok(p.clone()),
                None => Err(format!("block {b} is not a paragraph")),
            })
            .collect()
    }
    /// Applies a paragraph style from a fixed list to `first..=last`; the document gains the built-in style if it lacks it.
    fn do_set_style(&mut self, first: usize, last: usize, id: &str) -> Result<(), String> {
        const OK: [&str; 8] = ["Normal", "Title", "Subtitle", "Heading1", "Heading2", "Heading3", "Heading4", "Quote"];
        if !OK.contains(&id) {
            return Err(format!("style {id} is not offered"));
        }
        let mut paras = self.para_span(first, last)?;
        let mut styles = self.doc.styles.clone();
        Self::ensure_style(&mut styles, id)?;
        for p in paras.iter_mut() {
            p.props.style = if id == "Normal" { None } else { Some(id.to_string()) };
        }
        self.doc.styles = styles;
        for (i, p) in paras.into_iter().enumerate() {
            self.put_para(first + i, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// `kind`: `"bullet"`, `"numbered"` or `"none"`. A numbered list continues the list directly above when there is one.
    fn do_set_list(&mut self, first: usize, last: usize, kind: &str) -> Result<(), String> {
        use wordcraft_doc::numbering::ListKind;
        use wordcraft_doc::props::NumRef;
        let mut paras = self.para_span(first, last)?;
        let mut numbering = self.doc.numbering.clone();
        let mut styles = self.doc.styles.clone();
        let num = match kind {
            "none" => 0,
            "bullet" => {
                let found = numbering.find_kind(ListKind::Bullet);
                found.unwrap_or_else(|| numbering.add_list(ListKind::Bullet))
            }
            "numbered" => {
                let above = if first > 0 && first < CELL_BASE {
                    self.para_at(first - 1).and_then(|p| self.doc.styles.resolve_para(&p.props).numbering)
                } else {
                    None
                };
                match above {
                    Some(n) if n.num != 0 && self.list_kind(Some(n)) == "numbered" => n.num,
                    _ => numbering.add_list(ListKind::Numbered),
                }
            }
            _ => return Err("list kind must be bullet, numbered or none".into()),
        };
        if num != 0 {
            Self::ensure_style(&mut styles, "ListParagraph")?;
        }
        for p in paras.iter_mut() {
            let cur = self.doc.styles.resolve_para(&p.props).numbering;
            if num == 0 {
                if cur.is_some_and(|n| n.num != 0) {
                    p.props.numbering = Some(NumRef { num: 0, level: 0 });
                }
                if p.props.style.as_deref() == Some("ListParagraph") {
                    p.props.style = None;
                }
            } else {
                let level = cur.filter(|n| n.num != 0).map(|n| n.level).unwrap_or(0);
                p.props.numbering = Some(NumRef { num, level });
                if p.props.style.is_none() {
                    p.props.style = Some("ListParagraph".into());
                }
            }
        }
        self.doc.numbering = numbering;
        self.doc.styles = styles;
        for (i, p) in paras.into_iter().enumerate() {
            self.put_para(first + i, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Moves list paragraphs in `first..=last` by `delta` levels (clamped 0..=8). Refuses when none is in a list.
    fn do_list_level(&mut self, first: usize, last: usize, delta: i32) -> Result<(), String> {
        use wordcraft_doc::props::NumRef;
        if !(-8..=8).contains(&delta) {
            return Err("level change must be between -8 and 8".into());
        }
        let mut paras = self.para_span(first, last)?;
        let mut any = false;
        for p in paras.iter_mut() {
            if let Some(n) = self.doc.styles.resolve_para(&p.props).numbering.filter(|n| n.num != 0) {
                any = true;
                let lv = (n.level as i32 + delta).clamp(0, 8) as u8;
                p.props.numbering = Some(NumRef { num: n.num, level: lv });
            }
        }
        if !any {
            return Err("the selection is not in a list".into());
        }
        for (i, p) in paras.into_iter().enumerate() {
            self.put_para(first + i, p)?;
        }
        self.pages = DocLayout::default();
        Ok(())
    }
    /// Table structure edit relative to the cell holding paragraph `block` (a cell id). `op` is `row_above`, `row_below`,
    /// `delete_row`, `col_left`, `col_right` or `delete_col`. The table is cloned, edited and swapped in, so a refusal
    /// leaves the document untouched. Block ids of cell paragraphs shift afterwards; the host re-reads `blocks()`.
    fn do_table_edit(&mut self, block: usize, op: &str) -> Result<(), String> {
        use wordcraft_doc::props::VMerge;
        if block < CELL_BASE {
            return Err("the caret is not inside a table cell".into());
        }
        let [b, r, c, _] = self.cell_paras().nth(block - CELL_BASE).ok_or_else(|| format!("no cell paragraph {block}"))?;
        let Some(Block::Table(t)) = self.doc.body.get(b).map(|x| &**x) else { return Err("the caret is not inside a table".into()) };
        let mut t2 = t.clone();
        let row = t2.rows.get(r).ok_or("no such row")?;
        let grid_start: usize = row.cells.iter().take(c).map(|x| x.span()).sum();
        let span = row.cells.get(c).ok_or("no such cell")?.span();
        match op {
            "row_above" | "row_below" => {
                let n = t2.rows.len();
                t2.insert_row(if op == "row_above" { r } else { r + 1 }, r);
                if t2.rows.len() == n {
                    return Err("the table has reached its row limit".into());
                }
            }
            "delete_row" => {
                if t2.rows.len() <= 1 {
                    return Err("a table needs at least one row".into());
                }
                if t2.rows[r].cells.iter().any(|x| x.props.vmerge != VMerge::None) || t2.rows.iter().any(|row| row.cells.iter().any(|x| x.props.vmerge != VMerge::None)) {
                    return Err("rows of a table with vertically merged cells cannot be deleted yet".into());
                }
                t2.delete_row(r);
            }
            "col_left" | "col_right" => {
                let n = t2.grid.len();
                t2.insert_col(if op == "col_left" { grid_start } else { grid_start + span });
                if t2.grid.len() == n {
                    return Err("the table has reached its column limit".into());
                }
            }
            "delete_col" => {
                if t2.grid.len() <= 1 {
                    return Err("a table needs at least one column".into());
                }
                if t2.rows.iter().any(|row| row.cells.iter().any(|x| x.span() > 1 || x.props.vmerge != VMerge::None)) {
                    return Err("columns of a table with merged cells cannot be deleted yet".into());
                }
                t2.delete_col(grid_start);
            }
            _ => return Err(format!("unknown table operation {op}")),
        }
        self.doc.body[b] = Arc::new(Block::Table(t2));
        self.pages = DocLayout::default();
        Ok(())
    }
    fn do_replace(&mut self, block: usize, start: usize, end: usize, text: &str) -> Result<(), String> {
        self.do_replace_many(block, &[(start, end, text.to_string())])
    }
}

#[wasm_bindgen]
impl DocSession {
    pub fn blocks(&self) -> String {
        self.block_list()
    }
    /// `hunks_json`: `[[start, end, "text"], ...]`, ascending offsets in the original paragraph.
    pub fn replace_ranges(&mut self, block: usize, hunks_json: &str) -> Result<(), JsValue> {
        let v: Vec<(usize, usize, String)> = serde_json::from_str(hunks_json).map_err(|e| JsValue::from_str(&format!("bad hunks: {e}")))?;
        self.do_replace_many(block, &v).map_err(|e| JsValue::from_str(&e))
    }
    pub fn replace_range(&mut self, block: usize, utf8_start: usize, utf8_end: usize, text: &str) -> Result<(), JsValue> {
        self.do_replace(block, utf8_start, utf8_end, text).map_err(|e| JsValue::from_str(&e))
    }
    /// Page-space hit test (page units, same space as `page_info`). JSON: `null` when nothing is hit,
    /// `{"block":i,"off":utf8,"editable":bool}` for a top-level paragraph, `{"block":null,"editable":false}`
    /// for text inside a table cell or another story. Never guesses: offsets come from the layout.
    pub fn hit_test(&self, page: usize, x: f32, y: f32) -> String {
        match self.pages.hit(page, x, y, StoryRef::Body) {
            None => "null".into(),
            Some(pos) if pos.path.depth() == 0 && pos.path.0.len() == 1 => {
                let b = pos.path.last();
                let editable = matches!(self.doc.body.get(b).map(|b| &**b), Some(Block::Para(p)) if !p.text.contains(OBJ) && p.objects.is_empty());
                serde_json::json!({"block": b, "off": pos.off, "editable": editable}).to_string()
            }
            // A paragraph directly inside a cell of a top-level table.
            Some(pos) if pos.story == StoryRef::Body && pos.path.0.len() == 4 => {
                let want = [pos.path.0[0] as usize, pos.path.0[1] as usize, pos.path.0[2] as usize, pos.path.0[3] as usize];
                match self.cell_paras().position(|c| c == want) {
                    Some(slot) => {
                        let id = CELL_BASE + slot;
                        let editable = self.para_at(id).is_some_and(|p| !p.text.contains(OBJ) && p.objects.is_empty());
                        serde_json::json!({"block": id, "off": pos.off, "editable": editable}).to_string()
                    }
                    None => serde_json::json!({"block": null, "editable": false}).to_string(),
                }
            }
            Some(_) => serde_json::json!({"block": null, "editable": false}).to_string(),
        }
    }
    /// Caret rectangle for a top-level paragraph offset: `{"page","x","top","height"}` or `null`.
    pub fn caret_at(&self, block: usize, utf8_off: usize) -> String {
        match self.pages.caret(&self.pos_of(block, utf8_off)) {
            Some(c) => serde_json::json!({"page": c.page, "x": c.x, "top": c.top, "height": c.height}).to_string(),
            None => "null".into(),
        }
    }
    /// Highlight rectangles inside one top-level paragraph: `[[page,x,y,w,h],...]`.
    pub fn selection_rects(&self, block: usize, a: usize, b: usize) -> String {
        let r: Vec<_> = self
            .pages
            .selection_rects(&self.doc, &self.pos_of(block, a), &self.pos_of(block, b), 0)
            .into_iter()
            .map(|(pg, r)| serde_json::json!([pg, r.x, r.y, r.w, r.h]))
            .collect();
        serde_json::Value::Array(r).to_string()
    }
    /// Sets bold / italic / underline on a selection `(start_block, start_off)..(end_block, end_off)`
    /// (UTF-8 byte offsets). `patch_json`: any subset of `{"bold":true,"italic":false,"underline":true,"font":"Source Serif 4","size":14,"color":"C0392B"|"auto"}`.
    pub fn format_range(&mut self, start_block: usize, start_off: usize, end_block: usize, end_off: usize, patch_json: &str) -> Result<(), JsValue> {
        self.do_format(start_block, start_off, end_block, end_off, patch_json).map_err(|e| JsValue::from_str(&e))
    }
    /// `{"bold":"on|off|mixed","italic":...,"underline":...}` over a selection (same coordinates as `format_range`).
    pub fn format_state(&self, start_block: usize, start_off: usize, end_block: usize, end_off: usize) -> Result<String, JsValue> {
        self.do_format_state(start_block, start_off, end_block, end_off).map_err(|e| JsValue::from_str(&e))
    }
    /// Paragraph alignment, indents and spacing for the whole paragraphs `first_block..=last_block`.
    /// `patch_json`: any subset of `{"align":"center","indentLeft":36,"indentFirst":-18,"spaceBefore":0,"spaceAfter":8,"lineSpacing":1.5}` (points; multiple for line spacing).
    pub fn format_paragraphs(&mut self, first_block: usize, last_block: usize, patch_json: &str) -> Result<(), JsValue> {
        self.do_para_format(first_block, last_block, patch_json).map_err(|e| JsValue::from_str(&e))
    }
    /// JSON of the shared (or null when mixed) effective paragraph formatting over `first_block..=last_block`.
    pub fn paragraph_state(&self, first_block: usize, last_block: usize) -> Result<String, JsValue> {
        self.do_para_state(first_block, last_block).map_err(|e| JsValue::from_str(&e))
    }
    /// Applies one of Normal, Title, Subtitle, Heading1-4 or Quote to the paragraphs `first_block..=last_block`.
    pub fn set_paragraph_style(&mut self, first_block: usize, last_block: usize, style_id: &str) -> Result<(), JsValue> {
        self.do_set_style(first_block, last_block, style_id).map_err(|e| JsValue::from_str(&e))
    }
    /// `kind`: `bullet`, `numbered` or `none`.
    pub fn set_list(&mut self, first_block: usize, last_block: usize, kind: &str) -> Result<(), JsValue> {
        self.do_set_list(first_block, last_block, kind).map_err(|e| JsValue::from_str(&e))
    }
    /// Moves list paragraphs by `delta` levels (indent / outdent).
    pub fn shift_list_level(&mut self, first_block: usize, last_block: usize, delta: i32) -> Result<(), JsValue> {
        self.do_list_level(first_block, last_block, delta).map_err(|e| JsValue::from_str(&e))
    }
    /// Inserts or deletes a table row or column around the cell paragraph `block`. `op`: `row_above`, `row_below`,
    /// `delete_row`, `col_left`, `col_right`, `delete_col`.
    pub fn edit_table(&mut self, block: usize, op: &str) -> Result<(), JsValue> {
        self.do_table_edit(block, op).map_err(|e| JsValue::from_str(&e))
    }
    pub fn split_block(&mut self, block: usize, utf8_off: usize) -> Result<(), JsValue> {
        self.do_split(block, utf8_off).map_err(|e| JsValue::from_str(&e))
    }
    pub fn merge_with_previous(&mut self, block: usize) -> Result<(), JsValue> {
        self.do_merge(block).map_err(|e| JsValue::from_str(&e))
    }
    /// Cheap structural snapshot of the body (blocks are shared, not copied). Used for undo of split/merge.
    pub fn snapshot(&mut self) -> u32 {
        let id = self.next_snap;
        self.next_snap += 1;
        self.snaps.insert(id, self.doc.body.clone());
        id
    }
    pub fn restore(&mut self, id: u32) -> Result<(), JsValue> {
        let b = self.snaps.get(&id).ok_or_else(|| JsValue::from_str("unknown snapshot"))?.clone();
        self.doc.body = b;
        self.pages = DocLayout::default();
        Ok(())
    }
    #[wasm_bindgen(constructor)]
    pub fn new(bytes: &[u8]) -> Result<DocSession, JsValue> {
        Self::from_bytes(bytes).map_err(|e| JsValue::from_str(&e))
    }
    pub fn text(&self) -> String {
        self.doc.plain_text(StoryRef::Body)
    }
    pub fn insert(&mut self, block: usize, utf8_byte_offset: usize, text: &str) -> Result<(), JsValue> {
        self.do_insert(block, utf8_byte_offset, text).map_err(|e| JsValue::from_str(&e))
    }
    pub fn paginate(&mut self) -> usize {
        self.pages = wordcraft_layout::layout(&self.doc, &mut self.cache, &LayoutOptions::default());
        self.pages.pages.len()
    }
    pub fn page_info(&self) -> String {
        serde_json::json!({"pages": self.pages.pages.iter().map(|p| serde_json::json!({"width":p.w,"height":p.h})).collect::<Vec<_>>(),
            "cacheHits":self.cache.hits,"cacheMisses":self.cache.misses})
        .to_string()
    }
    pub fn render_png(&self, page: usize, scale: f32) -> Result<Vec<u8>, JsValue> {
        if !scale.is_finite() || !(0.1..=2.0).contains(&scale) {
            return Err(JsValue::from_str("scale must be 0.1..2.0"));
        }
        let p = self.pages.pages.get(page).ok_or_else(|| JsValue::from_str("paginate first; invalid page"))?;
        if p.w * scale > 2400.0 || p.h * scale > 2400.0 {
            return Err(JsValue::from_str("adapter raster limit: 2400 px per side"));
        }
        Ok(wordcraft_render::render_page(&self.doc, p, scale, &Default::default()).to_png())
    }
    pub fn save(&self) -> Result<Vec<u8>, JsValue> {
        wordcraft_docx::write(&self.doc).map_err(|e| JsValue::from_str(&e.to_string()))
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    const FIXTURE: &[u8] = include_bytes!("../../../spikes/somnia-documents/fixtures/sample.docx");
    #[test]
    fn open_edit_export_reopen() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        assert!(s.text().contains("Somnia Documents"));
        s.do_insert(0, 0, "Edited: ").unwrap();
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let reopened = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(s.text(), reopened.text());
        assert!(reopened.text().starts_with("Edited: "));
    }
    #[test]
    fn malformed_package_rejected() {
        assert!(DocSession::from_bytes(b"not a zip").is_err());
    }
    #[test]
    fn bad_offset_and_path_rejected_without_mutation() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let old = s.text();
        assert!(s.do_insert(999, 0, "x").is_err());
        assert!(s.do_insert(0, 999999, "x").is_err());
        assert_eq!(old, s.text());
    }
    #[test]
    fn blocks_list_paragraphs_and_tables() {
        let s = DocSession::from_bytes(FIXTURE).unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        let a = v.as_array().unwrap();
        assert!(a.iter().any(|b| b["kind"] == "table" && b["editable"] == false));
        assert!(a[0]["kind"] == "para" && a[0]["text"].as_str().unwrap().contains("Somnia Documents"));
        for (i, b) in a.iter().filter(|b| b["kind"] != "cell").enumerate() {
            assert_eq!(b["index"], i);
        }
    }
    #[test]
    fn table_cell_paragraphs_are_addressable_and_atomic() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        let cells: Vec<_> = v.as_array().unwrap().iter().filter(|b| b["kind"] == "cell").collect();
        assert!(!cells.is_empty());
        let id = cells[0]["index"].as_u64().unwrap() as usize;
        assert!(id >= CELL_BASE);
        let before = cells[0]["text"].as_str().unwrap().to_string();
        s.do_insert(id, 0, "X").unwrap();
        assert_eq!(s.para_at(id).unwrap().text, format!("X{before}"));
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        assert_eq!(DocSession::from_bytes(&saved).unwrap().text(), s.text());
        let now = s.text();
        assert!(s.do_insert(CELL_BASE + 999_999, 0, "x").is_err());
        assert!(s.do_replace(id, 0, 99999, "x").is_err());
        assert!(s.do_split(id, 0).is_err());
        assert!(s.do_merge(id).is_err());
        assert_eq!(now, s.text());
    }
    #[test]
    fn table_rows_and_columns_edit_atomically() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let first = s.cell_paras().next().expect("fixture has a table");
        let table = |s: &DocSession| match &*s.doc.body[first[0]] {
            Block::Table(t) => (t.rows.len(), t.grid.len()),
            _ => panic!(),
        };
        let (rows, cols) = table(&s);
        let id = CELL_BASE;
        s.do_table_edit(id, "row_below").unwrap();
        assert_eq!(table(&s), (rows + 1, cols));
        s.do_table_edit(id, "col_right").unwrap();
        assert_eq!(table(&s), (rows + 1, cols + 1));
        // A fixture with merged cells legitimately refuses deletes; otherwise they restore the original shape.
        let col_ok = s.do_table_edit(id, "delete_col").is_ok();
        let row_ok = s.do_table_edit(id, "delete_row").is_ok();
        if col_ok && row_ok {
            assert_eq!(table(&s), (rows, cols));
        }
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        assert_eq!(DocSession::from_bytes(&saved).unwrap().text(), s.text());
        let now = s.text();
        assert!(s.do_table_edit(0, "row_below").is_err());
        assert!(s.do_table_edit(CELL_BASE + 999_999, "row_below").is_err());
        assert!(s.do_table_edit(id, "explode").is_err());
        assert_eq!(now, s.text());
    }
    #[test]
    fn replace_range_roundtrips_and_is_atomic() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let before = s.text();
        s.do_replace(0, 0, "Somnia".len(), "Hello").unwrap();
        assert!(s.text().starts_with("Hello Documents"));
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        assert_eq!(DocSession::from_bytes(&saved).unwrap().text(), s.text());
        let now = s.text();
        assert!(s.do_replace(0, 3, 2, "x").is_err());
        assert!(s.do_replace(0, 0, 99999, "x").is_err());
        assert!(s.do_replace(999, 0, 0, "x").is_err());
        assert!(s.do_replace(0, 0, 0, "a\nb").is_err());
        assert_eq!(now, s.text());
        assert_ne!(before, now);
    }
    fn run_props(s: &DocSession, block: usize) -> Vec<(usize, bool)> {
        let Block::Para(p) = &*s.doc.body[block] else { panic!() };
        p.runs.iter().map(|r| (r.len, r.props.bold.unwrap_or(false))).collect()
    }
    fn state(s: &DocSession, sb: usize, so: usize, eb: usize, eo: usize) -> serde_json::Value {
        serde_json::from_str(&s.do_format_state(sb, so, eb, eo).unwrap()).unwrap()
    }
    #[test]
    fn format_range_sets_state_roundtrips_and_is_atomic() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let n = match &*s.doc.body[0] { Block::Para(p) => p.text.len(), _ => panic!() };
        assert!(n > 2);
        s.do_format(0, 0, 0, n, r#"{"italic":false}"#).unwrap();
        assert_eq!(state(&s, 0, 0, 0, n)["italic"], "off");
        s.do_format(0, 0, 0, 2, r#"{"italic":true,"underline":true}"#).unwrap();
        assert_eq!(state(&s, 0, 0, 0, 2)["italic"], "on");
        assert_eq!(state(&s, 0, 0, 0, 2)["underline"], "on");
        assert_eq!(state(&s, 0, 0, 0, n)["italic"], "mixed");
        assert_eq!(state(&s, 0, 2, 0, n)["italic"], "off");
        let text = s.text();
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let again = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(again.text(), text);
        assert_eq!(state(&again, 0, 0, 0, 2)["italic"], "on");
        assert_eq!(state(&again, 0, 0, 0, n)["italic"], "mixed");
        // Invalid requests change nothing.
        let before = wordcraft_docx::write(&s.doc).unwrap();
        assert!(s.do_format(0, 0, 0, n + 1, r#"{"bold":true}"#).is_err());
        assert!(s.do_format(999, 0, 999, 1, r#"{"bold":true}"#).is_err());
        assert!(s.do_format(0, 3, 0, 1, r#"{"bold":true}"#).is_err());
        assert!(s.do_format(0, 0, 0, 2, r#"{"bold":"yes"}"#).is_err());
        assert!(s.do_format(0, 0, 0, 2, r#"{"colour":true}"#).is_err());
        assert!(s.do_format(0, 0, 0, 2, "not json").is_err());
        assert!(s.do_format_state(999, 0, 999, 0).is_err());
        assert_eq!(wordcraft_docx::write(&s.doc).unwrap(), before);
    }
    #[test]
    fn format_range_sets_font_size_color_roundtrips_and_validates() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let n = match &*s.doc.body[0] { Block::Para(p) => p.text.len(), _ => panic!() };
        assert!(n > 2);
        s.do_format(0, 0, 0, 2, r#"{"font":"Source Serif 4","size":18.26,"color":"c0392b"}"#).unwrap();
        let st = state(&s, 0, 0, 0, 2);
        assert_eq!(st["font"], "Source Serif 4");
        assert_eq!(st["size"], 18.5);
        assert_eq!(st["color"], "C0392B");
        let mixed = state(&s, 0, 0, 0, n);
        assert!(mixed["size"].is_null() && mixed["color"].is_null() && mixed["font"].is_null());
        s.do_format(0, 0, 0, 2, r#"{"color":"auto"}"#).unwrap();
        assert_eq!(state(&s, 0, 0, 0, 2)["color"], "auto");
        s.do_format(0, 0, 0, 2, r#"{"color":"C0392B"}"#).unwrap();
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let again = DocSession::from_bytes(&saved).unwrap();
        let st = state(&again, 0, 0, 0, 2);
        assert_eq!((st["font"].as_str(), st["size"].as_f64(), st["color"].as_str()), (Some("Source Serif 4"), Some(18.5), Some("C0392B")));
        let before = wordcraft_docx::write(&s.doc).unwrap();
        for bad in [r#"{"size":0}"#, r#"{"size":401}"#, r#"{"size":"12"}"#, r#"{"font":""}"#, r#"{"font":5}"#, r#"{"color":"red"}"#, r##"{"color":"#C0392B"}"##, r#"{"color":"12345g"}"#] {
            assert!(s.do_format(0, 0, 0, 2, bad).is_err(), "{bad}");
        }
        let long = format!(r#"{{"font":"{}"}}"#, "x".repeat(65));
        assert!(s.do_format(0, 0, 0, 2, &long).is_err());
        assert_eq!(wordcraft_docx::write(&s.doc).unwrap(), before);
    }
    #[test]
    fn paragraph_format_sets_state_roundtrips_and_is_atomic() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let ps = |s: &DocSession, a: usize, b: usize| -> serde_json::Value { serde_json::from_str(&s.do_para_state(a, b).unwrap()).unwrap() };
        s.do_para_format(0, 0, r#"{"align":"center","indentLeft":36,"indentFirst":-18,"spaceBefore":6,"spaceAfter":12.5,"lineSpacing":1.5}"#).unwrap();
        let st = ps(&s, 0, 0);
        assert_eq!((st["align"].as_str(), st["indentLeft"].as_f64(), st["indentFirst"].as_f64()), (Some("center"), Some(36.0), Some(-18.0)));
        assert_eq!((st["spaceBefore"].as_f64(), st["spaceAfter"].as_f64(), st["lineSpacing"].as_f64()), (Some(6.0), Some(12.5), Some(1.5)));
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let again = DocSession::from_bytes(&saved).unwrap();
        let st2 = ps(&again, 0, 0);
        assert_eq!((st2["align"].as_str(), st2["indentLeft"].as_f64(), st2["spaceAfter"].as_f64(), st2["lineSpacing"].as_f64()), (Some("center"), Some(36.0), Some(12.5), Some(1.5)));
        let before = wordcraft_docx::write(&s.doc).unwrap();
        for bad in [r#"{"align":"middle"}"#, r#"{"align":1}"#, r#"{"indentLeft":-1}"#, r#"{"indentLeft":1441}"#, r#"{"spaceAfter":"3"}"#, r#"{"lineSpacing":0.1}"#, r#"{"lineSpacing":11}"#, r#"{"color":"red"}"#, "nope"] {
            assert!(s.do_para_format(0, 0, bad).is_err(), "{bad}");
        }
        assert!(s.do_para_format(0, 999, r#"{"align":"left"}"#).is_err());
        assert!(s.do_para_format(1, 0, r#"{"align":"left"}"#).is_err());
        assert_eq!(wordcraft_docx::write(&s.doc).unwrap(), before);
        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        let t = v.as_array().unwrap().iter().position(|b| b["kind"] == "table").unwrap();
        assert!(s.do_para_format(0, t, r#"{"align":"right"}"#).is_err());
        assert!(s.do_para_state(0, t).is_err());
        assert_eq!(wordcraft_docx::write(&s.doc).unwrap(), before);
    }
    #[test]
    fn styles_and_lists_apply_roundtrip_and_stay_atomic() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let ps = |s: &DocSession, a: usize, b: usize| -> serde_json::Value { serde_json::from_str(&s.do_para_state(a, b).unwrap()).unwrap() };
        s.do_set_style(0, 0, "Heading2").unwrap();
        assert_eq!(ps(&s, 0, 0)["style"], "Heading2");
        let blocks: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        assert_eq!(blocks[0]["outline"], 1);
        s.do_set_list(0, 1, "bullet").unwrap();
        assert_eq!(ps(&s, 0, 1)["list"], "bullet");
        s.do_list_level(0, 0, 1).unwrap();
        assert_eq!(ps(&s, 0, 0)["listLevel"], 1);
        s.do_list_level(0, 0, -5).unwrap();
        assert_eq!(ps(&s, 0, 0)["listLevel"], 0);
        s.do_set_list(0, 1, "numbered").unwrap();
        assert_eq!(ps(&s, 0, 1)["list"], "numbered");
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let again = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(ps(&again, 0, 0)["style"], "Heading2");
        assert_eq!(ps(&again, 0, 1)["list"], "numbered");
        s.do_set_list(0, 1, "none").unwrap();
        assert_eq!(ps(&s, 0, 1)["list"], "none");
        s.do_set_style(0, 0, "Normal").unwrap();
        assert_eq!(ps(&s, 0, 0)["style"], "Normal");
        let before = wordcraft_docx::write(&s.doc).unwrap();
        assert!(s.do_set_style(0, 0, "Heading9").is_err());
        assert!(s.do_set_style(0, 0, "../x").is_err());
        assert!(s.do_set_list(0, 0, "roman").is_err());
        assert!(s.do_list_level(0, 0, 1).is_err());
        assert!(s.do_list_level(0, 0, 99).is_err());
        assert!(s.do_set_style(0, 999, "Title").is_err());
        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        let t = v.as_array().unwrap().iter().position(|b| b["kind"] == "table").unwrap();
        assert!(s.do_set_style(0, t, "Title").is_err());
        assert!(s.do_set_list(0, t, "bullet").is_err());
        assert_eq!(wordcraft_docx::write(&s.doc).unwrap(), before);
    }
    #[test]
    fn format_range_refuses_a_span_with_a_table_without_partial_change() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        let t = v.as_array().unwrap().iter().position(|b| b["kind"] == "table").unwrap();
        assert!(t > 0);
        let before = wordcraft_docx::write(&s.doc).unwrap();
        assert!(s.do_format(0, 0, t, 0, r#"{"bold":true}"#).is_err());
        assert!(s.do_format_state(0, 0, t, 0).is_err());
        assert_eq!(wordcraft_docx::write(&s.doc).unwrap(), before);
    }
    #[test]
    fn multi_hunk_edit_is_atomic_and_keeps_untouched_runs() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let t0 = match &*s.doc.body[0] { Block::Para(p) => p.text.clone(), _ => panic!() };
        let runs_before = run_props(&s, 0);
        // Two far-apart hunks; the text between them must keep its run structure.
        let last = t0.len();
        s.do_replace_many(0, &[(0, 0, "A".into()), (last, last, "Z".into())]).unwrap();
        let t1 = match &*s.doc.body[0] { Block::Para(p) => p.text.clone(), _ => panic!() };
        assert_eq!(t1, format!("A{t0}Z"));
        let runs_after = run_props(&s, 0);
        assert_eq!(runs_after.iter().map(|r| r.0).sum::<usize>(), t1.len());
        // Bold of the original text survives (insertions inherit neighbours).
        assert_eq!(runs_before.iter().any(|r| r.1), runs_after.iter().any(|r| r.1));
        let snapshot = s.text();
        // Second hunk invalid: nothing may change.
        assert!(s.do_replace_many(0, &[(0, 1, "".into()), (5000, 5001, "x".into())]).is_err());
        assert!(s.do_replace_many(0, &[(3, 4, "".into()), (2, 3, "".into())]).is_err());
        assert_eq!(snapshot, s.text());
    }
    #[test]
    fn insertion_at_paragraph_start_inherits_following_run() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let first = run_props(&s, 0)[0];
        s.do_replace(0, 0, 0, "X").unwrap();
        let after = run_props(&s, 0)[0];
        assert_eq!(after.1, first.1, "inserted text must share the formatting of what follows it");
        assert_eq!(after.0, first.0 + 1);
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        let again = DocSession::from_bytes(&saved).unwrap();
        assert_eq!(run_props(&again, 0)[0], after, "formatting must survive DOCX export and reopen");
    }
    #[test]
    fn replace_range_refuses_tables_and_non_boundaries() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        let t = v.as_array().unwrap().iter().find(|b| b["kind"] == "table").unwrap()["index"].as_u64().unwrap() as usize;
        assert!(s.do_replace(t, 0, 0, "x").is_err());
        s.do_replace(0, 0, 0, "é").unwrap();
        let old = s.text();
        assert!(s.do_replace(0, 1, 1, "x").is_err());
        assert_eq!(old, s.text());
        s.do_replace(0, 0, 2, "").unwrap();
        assert!(!s.text().starts_with("é"));
    }
    #[test]
    fn unicode_offsets_are_bytes_not_utf16() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        s.do_insert(0, 0, "é").unwrap();
        assert!(s.do_insert(0, 1, "x").is_err());
        s.do_insert(0, 2, "x").unwrap();
        assert!(s.text().starts_with("éx"));
    }
    #[test]
    fn hit_and_caret_roundtrip() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        s.paginate();
        let c: serde_json::Value = serde_json::from_str(&s.caret_at(0, 3)).unwrap();
        let (x, y) = (c["x"].as_f64().unwrap() as f32, (c["top"].as_f64().unwrap() + c["height"].as_f64().unwrap() / 2.0) as f32);
        let h: serde_json::Value = serde_json::from_str(&s.hit_test(c["page"].as_u64().unwrap() as usize, x, y)).unwrap();
        assert_eq!((h["block"].as_u64(), h["off"].as_u64()), (Some(0), Some(3)));
        let r: serde_json::Value = serde_json::from_str(&s.selection_rects(0, 0, 4)).unwrap();
        assert!(!r.as_array().unwrap().is_empty());
    }
    #[test]
    fn split_merge_snapshot_roundtrip() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let before = s.text();
        let snap0 = s.snapshot();
        let n = s.doc.body.len();
        s.do_split(1, 5).unwrap();
        assert_eq!(s.doc.body.len(), n + 1);
        assert_eq!(s.text().replace('\n', ""), before.replace('\n', ""));
        s.do_merge(2).unwrap();
        assert_eq!(s.text(), before);
        s.do_split(1, 5).unwrap();
        s.restore(snap0).unwrap();
        assert_eq!(s.text(), before);
        assert!(s.do_merge(0).is_err());
        assert!(s.do_merge(4).is_err(), "block 3 is a table");
        assert!(s.do_split(3, 0).is_err());
        assert!(s.do_split(1, 99999).is_err());
        let saved = wordcraft_docx::write(&s.doc).unwrap();
        assert_eq!(DocSession::from_bytes(&saved).unwrap().text(), before);
    }

    // ---- corpus + fuzz (package 6) ----
    struct Rng(u64);
    impl Rng {
        fn next(&mut self) -> u64 {
            self.0 ^= self.0 << 13;
            self.0 ^= self.0 >> 7;
            self.0 ^= self.0 << 17;
            self.0
        }
        fn below(&mut self, n: usize) -> usize {
            if n == 0 { 0 } else { (self.next() % n as u64) as usize }
        }
    }
    fn corpus_files() -> Vec<(String, Vec<u8>)> {
        let dir = std::env::var("SOMNIA_CORPUS_DIR").unwrap_or_else(|_| concat!(env!("CARGO_MANIFEST_DIR"), "/../../../corpus").into());
        let mut v = vec![("sample.docx".to_string(), FIXTURE.to_vec())];
        if let Ok(rd) = std::fs::read_dir(&dir) {
            let mut names: Vec<_> = rd.filter_map(|e| e.ok()).map(|e| e.path()).filter(|p| p.extension().map_or(false, |x| x == "docx")).collect();
            names.sort();
            for p in names {
                v.push((p.file_name().unwrap().to_string_lossy().to_string(), std::fs::read(&p).unwrap()));
            }
        }
        v
    }
    /// (editable, text) per top-level block, taken from the adapter's own block list.
    fn model_of(s: &DocSession) -> Vec<(bool, String)> {
        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
        v.as_array().unwrap().iter().map(|b| (b["editable"].as_bool().unwrap(), b["text"].as_str().unwrap_or("").to_string())).collect()
    }
    fn structural_ok(s: &DocSession, i: usize) -> bool {
        s.plain_para(i).is_ok()
    }
    #[test]
    fn corpus_opens_paginates_renders_and_roundtrips() {
        let files = corpus_files();
        assert!(files.len() >= 2, "corpus missing: set SOMNIA_CORPUS_DIR or run documents/corpus/gen_corpus.py");
        for (name, bytes) in files {
            let mut s = DocSession::from_bytes(&bytes).unwrap_or_else(|e| panic!("{name}: open failed: {e}"));
            let pages = s.paginate();
            assert!(pages >= 1, "{name}: no pages");
            s.render_png(0, 1.0).unwrap_or_else(|_| panic!("{name}: render failed"));
            let saved = wordcraft_docx::write(&s.doc).unwrap_or_else(|e| panic!("{name}: save failed: {e}"));
            if let Ok(out) = std::env::var("SOMNIA_CORPUS_OUT") {
                std::fs::create_dir_all(&out).unwrap();
                std::fs::write(format!("{out}/{name}"), &saved).unwrap();
            }
            let again = DocSession::from_bytes(&saved).unwrap_or_else(|e| panic!("{name}: reopen failed: {e}"));
            let m = model_of(&s);
            eprintln!("corpus {name}: {} blocks, {} editable, {pages} pages", m.len(), m.iter().filter(|b| b.0).count());
            assert_eq!(m, model_of(&again), "{name}: unedited save->reopen changed block texts");
        }
    }
    #[test]
    fn fuzz_edit_operations_against_a_text_model() {
        let alphabet: Vec<&str> = vec!["a", "b", " ", "é", "ß", "€", "😀", "日", "م", "x y", "Z"];
        let iters: usize = std::env::var("SOMNIA_FUZZ_ITERS").ok().and_then(|v| v.parse().ok()).unwrap_or(150);
        for (fi, (name, bytes)) in corpus_files().into_iter().enumerate() {
            let mut rng = Rng(0x9E3779B97F4A7C15 ^ (fi as u64 + 1) * 0x1234567);
            let mut s = DocSession::from_bytes(&bytes).unwrap();
            let mut model = model_of(&s);
            let mut snaps: Vec<(u32, Vec<(bool, String)>)> = Vec::new();
            for step in 0..iters {
                let ctx = format!("{name} step {step}");
                match rng.below(10) {
                    0..=4 => {
                        let b = rng.below(model.len());
                        let (editable, text) = model[b].clone();
                        let mut cuts = [0usize; 2];
                        for c in cuts.iter_mut() {
                            let idx: Vec<usize> = text.char_indices().map(|(i, _)| i).chain(std::iter::once(text.len())).collect();
                            *c = idx[rng.below(idx.len())];
                        }
                        let (a, z) = (cuts[0].min(cuts[1]), cuts[0].max(cuts[1]));
                        let ins = if rng.below(4) == 0 { String::new() } else { (0..1 + rng.below(3)).map(|_| alphabet[rng.below(alphabet.len())]).collect::<String>() };
                        let r = s.do_replace(b, a, z, &ins);
                        if editable {
                            r.unwrap_or_else(|e| panic!("{ctx}: replace refused: {e}"));
                            model[b].1 = format!("{}{}{}", &text[..a], ins, &text[z..]);
                        } else {
                            assert!(r.is_err(), "{ctx}: replace on a locked block must be refused");
                        }
                    }
                    5 | 6 => {
                        let b = rng.below(model.len());
                        let text = model[b].1.clone();
                        let idx: Vec<usize> = text.char_indices().map(|(i, _)| i).chain(std::iter::once(text.len())).collect();
                        let off = idx[rng.below(idx.len())];
                        let ok = structural_ok(&s, b);
                        let r = s.do_split(b, off);
                        if ok {
                            r.unwrap_or_else(|e| panic!("{ctx}: split refused: {e}"));
                            model[b].1 = text[..off].to_string();
                            model.insert(b + 1, (true, text[off..].to_string()));
                        } else {
                            assert!(r.is_err(), "{ctx}: split on a locked block must be refused");
                        }
                    }
                    7 => {
                        let b = rng.below(model.len());
                        let ok = b > 0 && structural_ok(&s, b) && structural_ok(&s, b - 1);
                        let r = s.do_merge(b);
                        if ok {
                            r.unwrap_or_else(|e| panic!("{ctx}: merge refused: {e}"));
                            let t = model.remove(b);
                            model[b - 1].1.push_str(&t.1);
                        } else {
                            assert!(r.is_err(), "{ctx}: merge of locked neighbours must be refused");
                        }
                    }
                    8 => {
                        if snaps.len() < 4 || rng.below(2) == 0 {
                            snaps.push((s.snapshot(), model.clone()));
                        } else {
                            let (id, m) = snaps[rng.below(snaps.len())].clone();
                            s.restore(id).unwrap();
                            model = m;
                        }
                    }
                    _ => {
                        s.paginate();
                        if !model.is_empty() {
                            let pg = s.pages.pages.len();
                            s.render_png(rng.below(pg), 0.5).unwrap_or_else(|_| panic!("{ctx}: render failed"));
                        }
                    }
                }
                assert_eq!(model_of(&s), model, "{ctx}: engine and model diverged");
                if step % 40 == 39 {
                    let saved = wordcraft_docx::write(&s.doc).unwrap_or_else(|e| panic!("{ctx}: save failed: {e}"));
                    let again = DocSession::from_bytes(&saved).unwrap_or_else(|e| panic!("{ctx}: reopen failed: {e}"));
                    let got = model_of(&again);
                    let exp: Vec<_> = model.iter().filter(|m| m.0).map(|m| m.1.clone()).collect();
                    let got_t: Vec<_> = got.iter().filter(|m| m.0).map(|m| m.1.clone()).collect();
                    assert_eq!(got_t, exp, "{ctx}: save->reopen changed editable text");
                }
            }
        }
    }
}
