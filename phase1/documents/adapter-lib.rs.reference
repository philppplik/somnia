            assert!(s.do_para_format(0, 0, bad).is_err(), "{bad}");
        }
    }
    #[test]
    fn page_setup_line_numbers_set_change_and_clear() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let st = |s: &DocSession| -> serde_json::Value { serde_json::from_str(&s.do_page_setup_state()).unwrap() };
        assert!(st(&s)["lineNumbers"].is_null());
        s.do_set_page_setup(r#"{"lineNumbers":{"countBy":5,"restart":"continuous"}}"#).unwrap();
        assert_eq!((st(&s)["lineNumbers"]["countBy"].as_u64(), st(&s)["lineNumbers"]["restart"].as_str()), (Some(5), Some("continuous")));
        s.do_set_page_setup(r#"{"lineNumbers":{"restart":"section"}}"#).unwrap();
        assert_eq!((st(&s)["lineNumbers"]["countBy"].as_u64(), st(&s)["lineNumbers"]["restart"].as_str()), (Some(5), Some("section")));
        assert!(s.paginate() >= 1);
        s.do_set_page_setup(r#"{"lineNumbers":null}"#).unwrap();
        assert!(st(&s)["lineNumbers"].is_null());
        for bad in [r#"{"lineNumbers":3}"#, r#"{"lineNumbers":{"countBy":0}}"#, r#"{"lineNumbers":{"countBy":101}}"#, r#"{"lineNumbers":{"restart":"x"}}"#, r#"{"lineNumbers":{"z":1}}"#] {
            assert!(s.do_set_page_setup(bad).is_err(), "{bad}");
        }
    }
    #[test]
    fn paragraph_shading_and_border_set_clear_and_validate() {
        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
        let st = |s: &DocSession| -> serde_json::Value { serde_json::from_str(&s.do_para_state(0, 0).unwrap()).unwrap() };
        assert_eq!((st(&s)["shading"].as_str(), st(&s)["border"].as_str()), (Some("none"), Some("none")));
        s.do_para_format(0, 0, r#"{"shading":"FFF2CC","border":{"style":"single","width":1,"color":"C0392B"}}"#).unwrap();
        assert_eq!((st(&s)["shading"].as_str(), st(&s)["border"].as_str()), (Some("FFF2CC"), Some("box")));
        s.do_para_format(0, 0, r#"{"shading":"none","border":"none"}"#).unwrap();
