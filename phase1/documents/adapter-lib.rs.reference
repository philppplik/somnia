        self.do_set_track(on, author, date).map_err(|e| JsValue::from_str(&e))
    }
    /// Updates the time stamped on the next tracked edits.
    pub fn set_track_date(&mut self, date: &str) -> Result<(), JsValue> {
        Self::check_track_date(date).map_err(|e| JsValue::from_str(&e))?;
        self.track_date = date.to_string();
        Ok(())
    }
