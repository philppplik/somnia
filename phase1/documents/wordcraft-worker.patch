+import { chromium } from 'playwright';
+import fs from 'node:fs';
+import assert from 'node:assert/strict';
+import {spawn} from 'node:child_process';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+const root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');
+const server=spawn('python3',['-m','http.server','8765','--bind','127.0.0.1','--directory',path.join(root,'web')],{stdio:'ignore'});
+const browser=await chromium.launch({executablePath:process.env.CHROME_PATH||'/usr/bin/google-chrome',headless:true,args:['--no-sandbox']});
+try {
+ await new Promise(r=>setTimeout(r,500));
+ const page=await browser.newPage({viewport:{width:1400,height:1100}});
+ const errors=[]; page.on('pageerror',e=>errors.push(String(e)));
+ await page.goto('http://127.0.0.1:8765');
+ await page.waitForFunction(()=>window.done||window.error,{},{timeout:60000});
+ assert.equal(await page.evaluate(()=>window.error),undefined);
+ await page.locator('#page').evaluate(img=>img.decode());
+ await page.screenshot({path:path.join(root,'results','before.png'),fullPage:true});
+ const baseline=await page.evaluate(()=>window.latest);
+ assert.ok(baseline.text.includes('Somnia Documents')); assert.ok(baseline.text.includes('Engine: WordCraft'));
+ const report=await page.evaluate(async()=>{
+  const samples=[];
+  for(let i=0;i<5;i++) {
+   const bytes=await(await fetch('./fixtures/sample.docx')).arrayBuffer();
+   const opened=await rpc('open',{bytes});const rendered=await rpc('render');
+   const edit=await rpc('insert',{block:0,offset:0,text:'Edited: '});
+   const saved=await rpc('save'); const reopened=await rpc('open',{bytes:saved.bytes});
+   samples.push({openMs:opened.openMs,layoutMs:opened.layoutMs,renderMs:rendered.renderMs,editMs:edit.editMs,editLayoutMs:edit.layoutMs,saveMs:saved.saveMs,roundtrip:reopened.text===edit.text,pages:opened.pages});
+  }
+  let invalid=false;try {await rpc('open',{bytes:new Uint8Array([1,2,3]).buffer});}catch(e){invalid=true;}
+  const bytes=await(await fetch('./fixtures/large.docx')).arrayBuffer();
+  let ticks=0;const timer=setInterval(()=>ticks++,5);const t=performance.now();
+  const large=await rpc('open',{bytes});const wallMs=performance.now()-t;clearInterval(timer);
+  const largeRender=await rpc('render');
+  let badOffset=false;try {await rpc('insert',{block:0,offset:999999,text:'x'});}catch(e){badOffset=true;}
+  const validAfterError=await rpc('save');
+  const small=await(await fetch('./fixtures/sample.docx')).arrayBuffer();await rpc('open',{bytes:small});
+  return {samples,invalid,badOffset,validAfterError:validAfterError.bytes.byteLength>0,
+   large:{openMs:large.openMs,layoutMs:large.layoutMs,pages:large.pages,renderMs:largeRender.renderMs,wallMs,mainThreadTicks:ticks},userAgent:navigator.userAgent};
+ });
+ assert.ok(report.samples.every(s=>s.roundtrip));assert.ok(report.invalid&&report.badOffset&&report.validAfterError);
+ assert.ok(report.large.pages>1);assert.ok(report.large.mainThreadTicks>0);
+ await page.locator('#edit').click();await page.waitForFunction(()=>document.querySelector('#text').textContent.startsWith('Edited: '));
+ await page.locator('#page').evaluate(img=>img.decode());
+ await page.screenshot({path:path.join(root,'results','after.png'),fullPage:true});
+ const image=await page.evaluate(async()=>{const r=await rpc('render');return Array.from(new Uint8Array(r.bytes));});
+ fs.writeFileSync(path.join(root,'results','page-one.png'),Buffer.from(image));
+ report.coldInitMs=baseline.initMs;report.coldOpenMs=baseline.openMs;report.coldLayoutMs=baseline.layoutMs;report.errors=errors;
+ assert.deepEqual(errors,[]);
+ fs.writeFileSync(path.join(root,'results','metrics.json'),JSON.stringify(report,null,2));
+ console.log(JSON.stringify(report,null,2));
+} finally {await browser.close();server.kill();}
