@@ -0,0 +1,27 @@
+"""Original CC0 fixtures. Independent OOXML ZIP assembly, not WordCraft's writer."""
+from pathlib import Path
+from zipfile import ZipFile, ZipInfo, ZIP_DEFLATED
+from html import escape
+root = Path(__file__).resolve().parents[1] / 'fixtures'
+root.mkdir(exist_ok=True)
+ct = '''<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/></Types>'''
+rels = '''<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/></Relationships>'''
+def para(text, bold=False):
+    return '<w:p><w:r>' + ('<w:rPr><w:b/></w:rPr>' if bold else '') + '<w:t xml:space="preserve">' + escape(text) + '</w:t></w:r></w:p>'
+def make(name, n):
+    body = para('Somnia Documents - worker proof', True)
+    body += para('Real OOXML package. Read, edit, paginate and rasterise in a dedicated Worker.')
+    body += para('Unicode: Grüße, café, Ελληνικά. No Microsoft fonts or artwork.')
+    body += '<w:tbl><w:tblPr><w:tblW w:w="9000" w:type="dxa"/></w:tblPr><w:tblGrid><w:gridCol w:w="4500"/><w:gridCol w:w="4500"/></w:tblGrid><w:tr>'
+    for t in ['Engine: WordCraft', 'Host: Somnia']:
+        body += '<w:tc><w:tcPr><w:tcW w:w="4500" w:type="dxa"/></w:tcPr>' + para(t) + '</w:tc>'
+    body += '</w:tr></w:tbl>'
+    for i in range(n): body += para(f'Paragraph {i+1}. Local-first documents keep your files on disk. This fixture exercises text shaping, line breaks and pagination without a desktop UI.')
+    body += '<w:sectPr><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440"/></w:sectPr>'
+    xml = '<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:body>' + body + '</w:body></w:document>'
+    with ZipFile(root / name, 'w', ZIP_DEFLATED) as z:
+        for path, content in [('[Content_Types].xml',ct),('_rels/.rels',rels),('word/document.xml',xml)]:
+            info = ZipInfo(path, (2026, 10, 8, 0, 0, 0)); info.compress_type = ZIP_DEFLATED
+            z.writestr(info, content)
+make('sample.docx', 5)
+make('large.docx', 500)
