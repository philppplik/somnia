+"""Collect resolved WASM non-dev dependency license texts from cargo metadata."""
+import json, pathlib, shutil, subprocess
+repo=pathlib.Path(__file__).resolve().parents[3]
+root=repo/'spikes/somnia-documents/notices'
+j=json.loads(subprocess.check_output(['cargo','metadata','--locked','--format-version','1','--filter-platform','wasm32-unknown-unknown'],cwd=repo))
+pkgs={p['id']:p for p in j['packages']};nodes={n['id']:n for n in j['resolve']['nodes']}
+start=next(k for k,p in pkgs.items() if p['name']=='wordcraft-somnia-worker');seen=set()
+def visit(k):
+    if k in seen:return
+    seen.add(k)
+    for d in nodes[k]['deps']:
+        if any(t['kind']!='dev' for t in d['dep_kinds']):visit(d['pkg'])
+visit(start)
+root.mkdir(parents=True,exist_ok=True)
+rows=[]
+for k in sorted(seen):
+    p=pkgs[k];rows.append({a:p[a] for a in ['name','version','license','repository']})
+    if p['source']:
+        folder=pathlib.Path(p['manifest_path']).parent
+        out=root/'dependencies'/(p['name']+'-'+p['version']);out.mkdir(parents=True,exist_ok=True)
+        for f in folder.iterdir():
+            if f.is_file() and any(t in f.name.lower() for t in ['license','copying','notice']):shutil.copy(f,out/f.name)
+(root/'dependency-licenses.json').write_text(json.dumps(rows,indent=2))
+for name in ['LICENSE-MIT','LICENSE-APACHE','NOTICE','ATTRIBUTION.md']:shutil.copy(repo/name,root/name)
+for f in (repo/'assets/fonts').glob('OFL*'):shutil.copy(f,root/f.name)
