+//! Experimental headless adapter. No DOM, egui, filesystem or UI thread access.
+use wasm_bindgen::prelude::*;
+use std::sync::Arc;
+use wordcraft_doc::para::OBJ;
+use wordcraft_doc::{Block, CharProps, Document, Pos, StoryRef};
+use wordcraft_layout::{DocLayout, LayoutCache, LayoutOptions};
+
+/// Block ids at or above this value address a paragraph inside a top-level table cell: `CELL_BASE + n` is the
+/// n-th cell paragraph in document order (see `cell_paras`). Ids are recomputed from the document on every use,
+/// so they are only stable until a table's structure changes; the host refreshes `blocks()` after every edit.
+const CELL_BASE: usize = 1 << 20;
+/// The block list names at most this many cell paragraphs (the rest stay read-only for the host).
+const CELL_LIST_MAX: usize = 20_000;
+
+#[wasm_bindgen]
+pub struct DocSession {
+    doc: Document,
+    cache: LayoutCache,
+    pages: DocLayout,
+    snaps: std::collections::HashMap<u32, wordcraft_doc::Blocks>,
+    next_snap: u32,
+}
+
+impl DocSession {
+    fn from_bytes(bytes: &[u8]) -> Result<Self, String> {
+        if bytes.len() > 16 * 1024 * 1024 {
+            return Err("adapter input limit: 16 MiB".into());
+        }
+        let doc = wordcraft_docx::read(bytes).map_err(|e| e.to_string())?;
+        Ok(Self { doc, cache: LayoutCache::new(), pages: DocLayout::default(), snaps: Default::default(), next_snap: 1 })
+    }
+    fn do_insert(&mut self, block: usize, offset: usize, text: &str) -> Result<(), String> {
+        if text.len() > 1024 * 1024 {
+            return Err("adapter edit limit: 1 MiB".into());
+        }
+        self.doc.insert_text(&self.pos_of(block, offset), text, &CharProps::default()).map_err(|e| e.to_string())?;
+        // Invalidate placed pages; paragraph cache is revision-aware upstream.
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    /// Top-level body blocks. A paragraph is `editable` only when it has no inline objects
+    /// (images, fields, equations, comment anchors), because their offsets are not text.
+    fn block_list(&self) -> String {
+        let items: Vec<_> = self
+            .doc
+            .body
+            .iter()
+            .enumerate()
+            .map(|(i, b)| match &**b {
+                Block::Para(p) => {
+                    let editable = !p.text.contains(OBJ) && p.objects.is_empty();
+                    let rp = self.doc.styles.resolve_para(&p.props);
+                    // Heading level 0..8 (style or direct outline level); body text (9) is not an outline entry.
+                    let outline = rp.outline_level.filter(|l| *l < 9);
+                    serde_json::json!({"index": i, "kind": "para", "text": if editable { p.text.clone() } else { p.plain_text() }, "editable": editable, "outline": outline})
+                }
+                Block::Table(_) => serde_json::json!({"index": i, "kind": "table", "editable": false}),
+            })
+            .collect();
+        let mut items = items;
+        // Paragraphs inside table cells follow as `cell` entries addressed by `CELL_BASE + n`.
+        for (slot, path) in self.cell_paras().enumerate().take(CELL_LIST_MAX) {
+            let [b, r, c, k] = path;
+            if let Some(p) = self.para_by_path(path) {
+                let editable = !p.text.contains(OBJ) && p.objects.is_empty();
+                items.push(serde_json::json!({"index": CELL_BASE + slot, "kind": "cell", "text": if editable { p.text.clone() } else { p.plain_text() }, "editable": editable, "table": b, "row": r, "cell": c, "para": k, "outline": null}));
+            }
+        }
+        serde_json::Value::Array(items).to_string()
+    }
+    /// `[block, row, cell, paragraph]` of every paragraph directly inside a cell of a top-level table, in document order.
+    fn cell_paras(&self) -> impl Iterator<Item = [usize; 4]> + '_ {
+        self.doc
+            .body
+            .iter()
+            .enumerate()
+            .filter_map(|(b, blk)| match &**blk {
+                Block::Table(t) => Some((b, t)),
+                _ => None,
+            })
+            .flat_map(|(b, t)| {
+                t.rows.iter().enumerate().flat_map(move |(r, row)| {
+                    row.cells
+                        .iter()
+                        .enumerate()
+                        .flat_map(move |(c, cell)| cell.blocks.iter().enumerate().filter_map(move |(k, x)| matches!(&**x, Block::Para(_)).then_some([b, r, c, k])))
+                })
+            })
+    }
+    /// The paragraph a block id addresses: a top-level paragraph, or a cell paragraph for ids from `CELL_BASE`.
+    fn para_at(&self, id: usize) -> Option<&wordcraft_doc::Paragraph> {
+        if id < CELL_BASE {
+            return match self.doc.body.get(id).map(|b| &**b) {
+                Some(Block::Para(p)) => Some(p),
+                _ => None,
+            };
+        }
+        let path = self.cell_paras().nth(id - CELL_BASE)?;
+        self.para_by_path(path)
+    }
+    /// The paragraph at `[block, row, cell, paragraph]`.
+    fn para_by_path(&self, [b, r, c, k]: [usize; 4]) -> Option<&wordcraft_doc::Paragraph> {
+        match self.doc.body.get(b).map(|x| &**x) {
+            Some(Block::Table(t)) => match t.rows.get(r)?.cells.get(c)?.blocks.get(k).map(|x| &**x) {
+                Some(Block::Para(p)) => Some(p),
+                _ => None,
+            },
+            _ => None,
+        }
+    }
+    /// Replaces the paragraph a block id addresses. A cell paragraph is replaced by cloning its table.
+    fn put_para(&mut self, id: usize, p: wordcraft_doc::Paragraph) -> Result<(), String> {
+        if id < CELL_BASE {
+            let slot = self.doc.body.get_mut(id).ok_or_else(|| format!("no block {id}"))?;
+            *slot = Arc::new(Block::Para(p));
+            return Ok(());
+        }
+        let [b, r, c, k] = self.cell_paras().nth(id - CELL_BASE).ok_or_else(|| format!("no cell paragraph {id}"))?;
+        let Some(Block::Table(t)) = self.doc.body.get(b).map(|x| &**x) else { return Err(format!("block {b} is not a table")) };
+        let mut t2 = t.clone();
+        let slot = t2.rows.get_mut(r).and_then(|row| row.cells.get_mut(c)).and_then(|cell| cell.blocks.get_mut(k)).ok_or_else(|| format!("no cell paragraph {id}"))?;
+        *slot = Arc::new(Block::Para(p));
+        self.doc.body[b] = Arc::new(Block::Table(t2));
+        Ok(())
+    }
+    /// A document position for a block id (top-level paragraph or cell paragraph).
+    fn pos_of(&self, id: usize, off: usize) -> Pos {
+        if id >= CELL_BASE {
+            if let Some([b, r, c, k]) = self.cell_paras().nth(id - CELL_BASE) {
+                return Pos::new(StoryRef::Body, wordcraft_doc::Path(vec![b as u32, r as u32, c as u32, k as u32]), off);
+            }
+        }
+        Pos::body(id, off)
+    }
+    /// A paragraph range is valid when it stays in one id space (top level or cells) and is short.
+    fn id_span_ok(first: usize, last: usize) -> bool {
+        last >= first && last - first < 2000 && ((first < CELL_BASE) == (last < CELL_BASE))
+    }
+    /// Applies several non-overlapping replacements (UTF-8 byte ranges in the ORIGINAL paragraph text,
+    /// sorted ascending) to one top-level paragraph. Everything is done on a clone and committed only
+    /// if every hunk is valid, so a failure leaves the document unchanged. Text outside the hunks keeps
+    /// its runs untouched. Inserted text takes the formatting of the first replaced character; a pure
+    /// insertion takes the character before it (Word behaviour), or the character after at paragraph start.
+    fn do_replace_many(&mut self, block: usize, hunks: &[(usize, usize, String)]) -> Result<(), String> {
+        if hunks.is_empty() {
+            return Ok(());
+        }
+        if hunks.len() > 10_000 {
+            return Err("too many hunks".into());
+        }
+        let mut total = 0usize;
+        for (_, _, t) in hunks {
+            total += t.len();
+            if t.chars().any(|c| c == OBJ || c == '\n' || c == '\r') {
+                return Err("replacement text must not contain line breaks or object marks".into());
+            }
+        }
+        if total > 1024 * 1024 {
+            return Err("adapter edit limit: 1 MiB".into());
+        }
+        let Some(orig) = self.para_at(block) else { return Err(format!("block {block} is not a paragraph")) };
+        if orig.text.contains(OBJ) || !orig.objects.is_empty() {
+            return Err(format!("paragraph {block} contains inline objects and cannot be edited as text"));
+        }
+        let mut prev_end = 0usize;
+        for (start, end, _) in hunks {
+            if start > end || *start < prev_end {
+                return Err("hunks must be ascending, non-overlapping, with start <= end".into());
+            }
+            for off in [*start, *end] {
+                if off > orig.text.len() || !orig.text.is_char_boundary(off) {
+                    return Err(format!("offset {off} is not a character boundary inside paragraph {block}"));
+                }
+            }
+            prev_end = *end;
+        }
+        let mut p = orig.clone();
+        for (start, end, text) in hunks.iter().rev() {
+            let (start, end) = (*start, *end);
+            let props = if start < end {
+                p.props_of_char(start).clone()
+            } else if start > 0 {
+                let prev = p.text[..start].char_indices().next_back().map(|(i, _)| i).unwrap_or(0);
+                p.props_of_char(prev).clone()
+            } else if !p.text.is_empty() {
+                p.props_of_char(0).clone()
+            } else {
+                p.mark.clone()
+            };
+            p.delete(start, end).map_err(|e| e.to_string())?;
+            if !text.is_empty() {
+                p.insert_text(start, text, &props).map_err(|e| e.to_string())?;
+            }
+        }
+        self.put_para(block, p)?;
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    fn plain_para(&self, block: usize) -> Result<&wordcraft_doc::Paragraph, String> {
+        if block >= CELL_BASE {
+            return Err("paragraphs inside table cells cannot be split or joined yet".into());
+        }
+        match self.doc.body.get(block).map(|b| &**b) {
+            None => Err(format!("no block {block}")),
+            Some(Block::Table(_)) => Err(format!("block {block} is a table, not a paragraph")),
+            Some(Block::Para(p)) if p.text.contains(OBJ) || !p.objects.is_empty() => Err(format!("paragraph {block} contains inline objects and cannot be edited as text")),
+            Some(Block::Para(p)) if p.section.is_some() => Err(format!("paragraph {block} carries a section break and cannot be split or merged")),
+            Some(Block::Para(p)) => Ok(p),
+        }
+    }
+    /// Splits a top-level paragraph at a UTF-8 offset. The new paragraph copies the paragraph properties.
+    fn do_split(&mut self, block: usize, off: usize) -> Result<(), String> {
+        let mut p = self.plain_para(block)?.clone();
+        if off > p.text.len() || !p.text.is_char_boundary(off) {
+            return Err(format!("offset {off} is not a character boundary inside paragraph {block}"));
+        }
+        let tail = p.split_off(off).map_err(|e| e.to_string())?;
+        self.doc.body[block] = Arc::new(Block::Para(p));
+        self.doc.body.insert(block + 1, Arc::new(Block::Para(tail)));
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    /// Joins paragraph `block` onto the end of `block - 1`; the first paragraph keeps its properties.
+    fn do_merge(&mut self, block: usize) -> Result<(), String> {
+        if block == 0 {
+            return Err("there is no previous paragraph".into());
+        }
+        let tail = self.plain_para(block)?.clone();
+        let mut head = self.plain_para(block - 1)?.clone();
+        head.append(tail);
+        self.doc.body[block - 1] = Arc::new(Block::Para(head));
+        self.doc.body.remove(block);
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    /// A paragraph whose text can be formatted by byte range: not a table, no inline objects.
+    fn fmt_para(&self, block: usize) -> Result<&wordcraft_doc::Paragraph, String> {
+        match self.para_at(block) {
+            None => Err(format!("block {block} is not a paragraph")),
+            Some(p) if p.text.contains(OBJ) || !p.objects.is_empty() => Err(format!("paragraph {block} contains inline objects and cannot be formatted as text")),
+            Some(p) => Ok(p),
+        }
+    }
+    /// Non-empty per-paragraph byte ranges `(block, start, end)` covered by a selection that starts at
+    /// `(sb, so)` and ends at `(eb, eo)`. Every paragraph in the span must be formattable and every offset
+    /// a character boundary, otherwise nothing is returned (callers then change nothing).
+    fn span_ranges(&self, sb: usize, so: usize, eb: usize, eo: usize) -> Result<Vec<(usize, usize, usize)>, String> {
+        if eb < sb || (eb == sb && eo < so) {
+            return Err("selection end is before its start".into());
+        }
+        if !Self::id_span_ok(sb, eb) {
+            return Err("selection spans too many paragraphs or leaves the table".into());
+        }
+        let mut out = Vec::new();
+        for b in sb..=eb {
+            let p = self.fmt_para(b)?;
+            let start = if b == sb { so } else { 0 };
+            let end = if b == eb { eo } else { p.text.len() };
+            for off in [start, end] {
+                if off > p.text.len() || !p.text.is_char_boundary(off) {
+                    return Err(format!("offset {off} is not a character boundary inside paragraph {b}"));
+                }
+            }
+            if start < end {
+                out.push((b, start, end));
+            }
+        }
+        Ok(out)
+    }
+    /// Sets bold / italic / underline (each `true` or `false`) on a selection. The patch is a JSON object
+    /// such as `{"bold":true}`; unknown or non-boolean fields are refused. All paragraphs are changed on
+    /// clones and committed together, so a failure leaves the document unchanged.
+    fn do_format(&mut self, sb: usize, so: usize, eb: usize, eo: usize, patch_json: &str) -> Result<(), String> {
+        let v: serde_json::Value = serde_json::from_str(patch_json).map_err(|e| format!("bad format patch: {e}"))?;
+        let obj = v.as_object().ok_or_else(|| "format patch must be an object".to_string())?;
+        let mut bold: Option<bool> = None;
+        let mut italic: Option<bool> = None;
+        let mut underline: Option<wordcraft_doc::props::Underline> = None;
+        let mut font: Option<String> = None;
+        let mut size: Option<f32> = None;
+        let mut color: Option<wordcraft_doc::props::TextColor> = None;
+        for (k, val) in obj {
+            match k.as_str() {
+                "font" => {
+                    let f = val.as_str().ok_or_else(|| "format field font must be text".to_string())?;
+                    if f.is_empty() || f.chars().count() > 64 || f.chars().any(|c| c.is_control()) {
+                        return Err("format field font must be 1-64 printable characters".into());
+                    }
+                    font = Some(f.to_string());
+                    continue;
+                }
+                "size" => {
+                    let n = val.as_f64().ok_or_else(|| "format field size must be a number".to_string())?;
+                    if !n.is_finite() || !(1.0..=400.0).contains(&n) {
+                        return Err("format field size must be between 1 and 400 points".into());
+                    }
+                    size = Some(((n * 2.0).round() / 2.0) as f32);
+                    continue;
+                }
+                "color" => {
+                    let c = val.as_str().ok_or_else(|| "format field color must be text".to_string())?;
+                    color = Some(if c == "auto" {
+                        wordcraft_doc::props::TextColor::Auto
+                    } else if c.len() == 6 && c.bytes().all(|b| b.is_ascii_hexdigit()) {
+                        let n = u32::from_str_radix(c, 16).map_err(|e| e.to_string())?;
+                        wordcraft_doc::props::TextColor::Rgb(wordcraft_doc::props::Rgb((n >> 16) as u8, (n >> 8) as u8, n as u8))
+                    } else {
+                        return Err("format field color must be auto or RRGGBB".into());
+                    });
+                    continue;
+                }
+                _ => {}
+            }
+            let flag = val.as_bool().ok_or_else(|| format!("format field {k} must be true or false"))?;
+            match k.as_str() {
+                "bold" => bold = Some(flag),
+                "italic" => italic = Some(flag),
+                "underline" => {
+                    underline = Some(if flag { wordcraft_doc::props::Underline::Single } else { wordcraft_doc::props::Underline::None })
+                }
+                _ => return Err(format!("unknown format field {k}")),
+            }
+        }
+        if obj.is_empty() {
+            return Ok(());
+        }
+        let ranges = self.span_ranges(sb, so, eb, eo)?;
+        let mut done: Vec<(usize, wordcraft_doc::Paragraph)> = Vec::with_capacity(ranges.len());
+        for (b, start, end) in ranges {
+            let mut p = self.fmt_para(b)?.clone();
+            p.format(start, end, &|cp: &mut CharProps| {
+                if let Some(v) = bold {
+                    cp.bold = Some(v);
+                }
+                if let Some(v) = italic {
+                    cp.italic = Some(v);
+                }
+                if let Some(v) = underline {
+                    cp.underline = Some(v);
+                }
+                if let Some(v) = &font {
+                    cp.font = Some(v.clone());
+                }
+                if let Some(v) = size {
+                    cp.size = Some(v);
+                }
+                if let Some(v) = color {
+                    cp.color = Some(v);
+                }
+            })
+            .map_err(|e| e.to_string())?;
+            done.push((b, p));
+        }
+        for (b, p) in done {
+            self.put_para(b, p)?;
+        }
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    /// Effective (style + direct) bold / italic / underline over a selection, each `"on"`, `"off"` or
+    /// `"mixed"`. A collapsed selection reports what typing at that point would get.
+    fn do_format_state(&self, sb: usize, so: usize, eb: usize, eo: usize) -> Result<String, String> {
+        let mut seen: Vec<(bool, bool, bool)> = Vec::new();
+        let mut look: Vec<(String, f32, wordcraft_doc::props::TextColor)> = Vec::new();
+        if sb == eb && so == eo {
+            let p = self.fmt_para(sb)?;
+            if so > p.text.len() || !p.text.is_char_boundary(so) {
+                return Err(format!("offset {so} is not a character boundary inside paragraph {sb}"));
+            }
+            let rc = self.doc.styles.resolve_char(p.props.style.as_deref(), p.props_at(so));
+            seen.push((rc.bold, rc.italic, rc.underline != wordcraft_doc::props::Underline::None));
+            look.push((rc.font.clone(), rc.size, rc.color));
+        } else {
+            for (b, start, end) in self.span_ranges(sb, so, eb, eo)? {
+                let p = self.fmt_para(b)?;
+                for (r, cp) in p.run_ranges() {
+                    if r.start < end && r.end > start {
+                        let rc = self.doc.styles.resolve_char(p.props.style.as_deref(), cp);
+                        seen.push((rc.bold, rc.italic, rc.underline != wordcraft_doc::props::Underline::None));
+                        look.push((rc.font.clone(), rc.size, rc.color));
+                    }
+                }
+            }
+        }
+        fn tri(seen: &[(bool, bool, bool)], f: impl Fn(&(bool, bool, bool)) -> bool) -> &'static str {
+            if !seen.is_empty() && seen.iter().all(|x| f(x)) {
+                "on"
+            } else if seen.iter().any(|x| f(x)) {
+                "mixed"
+            } else {
+                "off"
+            }
+        }
+        // font / size / color: the shared value, or null when the selection mixes values (or is empty).
+        let same = |f: &dyn Fn(&(String, f32, wordcraft_doc::props::TextColor)) -> bool| !look.is_empty() && look.iter().all(|x| f(x));
+        let first = look.first();
+        let font = first.filter(|x| same(&|y| y.0 == x.0)).map(|x| x.0.clone());
+        let size = first.filter(|x| same(&|y| y.1 == x.1)).map(|x| x.1);
+        let color = first.filter(|x| same(&|y| y.2 == x.2)).map(|x| match x.2 {
+            wordcraft_doc::props::TextColor::Auto => "auto".to_string(),
+            wordcraft_doc::props::TextColor::Rgb(c) => c.hex(),
+        });
+        Ok(serde_json::json!({"bold": tri(&seen, |x| x.0), "italic": tri(&seen, |x| x.1), "underline": tri(&seen, |x| x.2), "font": font, "size": size, "color": color}).to_string())
+    }
+    /// Paragraph formatting for the whole paragraphs `first..=last` (selection coordinates are not needed:
+    /// alignment, indents and spacing belong to a paragraph). Any non-paragraph block in the span, or an
+    /// invalid value, refuses the whole call. Changes are made on clones and committed together.
+    fn do_para_format(&mut self, first: usize, last: usize, patch_json: &str) -> Result<(), String> {
+        use wordcraft_doc::props::{Align, LineSpacing};
+        let v: serde_json::Value = serde_json::from_str(patch_json).map_err(|e| format!("bad paragraph patch: {e}"))?;
+        let obj = v.as_object().ok_or_else(|| "paragraph patch must be an object".to_string())?;
+        if obj.is_empty() {
+            return Ok(());
+        }
+        let num = |k: &str, val: &serde_json::Value, lo: f64, hi: f64| -> Result<f32, String> {
+            let n = val.as_f64().ok_or_else(|| format!("paragraph field {k} must be a number"))?;
+            if !n.is_finite() || n < lo || n > hi {
+                return Err(format!("paragraph field {k} must be between {lo} and {hi}"));
+            }
+            Ok(((n * 20.0).round() / 20.0) as f32)
+        };
+        let mut align: Option<Align> = None;
+        let (mut il, mut ifirst, mut sb, mut sa, mut ls): (Option<f32>, Option<f32>, Option<f32>, Option<f32>, Option<f32>) = (None, None, None, None, None);
+        for (k, val) in obj {
+            match k.as_str() {
+                "align" => {
+                    align = Some(match val.as_str() {
+                        Some("left") => Align::Left,
+                        Some("center") => Align::Center,
+                        Some("right") => Align::Right,
+                        Some("justify") => Align::Justify,
+                        _ => return Err("paragraph field align must be left, center, right or justify".into()),
+                    })
+                }
+                "indentLeft" => il = Some(num(k, val, 0.0, 1440.0)?),
+                "indentFirst" => ifirst = Some(num(k, val, -1440.0, 1440.0)?),
+                "spaceBefore" => sb = Some(num(k, val, 0.0, 1584.0)?),
+                "spaceAfter" => sa = Some(num(k, val, 0.0, 1584.0)?),
+                "lineSpacing" => ls = Some(num(k, val, 0.5, 10.0)?),
+                _ => return Err(format!("unknown paragraph field {k}")),
+            }
+        }
+        if !Self::id_span_ok(first, last) {
+            return Err("paragraph range is out of bounds".into());
+        }
+        let mut done: Vec<(usize, wordcraft_doc::Paragraph)> = Vec::with_capacity(last - first + 1);
+        for b in first..=last {
+            let mut p = match self.para_at(b) {
+                Some(p) => p.clone(),
+                None => return Err(format!("block {b} is not a paragraph")),
+            };
+            if let Some(a) = align {
+                p.props.align = Some(a);
+            }
+            if let Some(x) = il {
+                p.props.indent_left = Some(x);
+            }
+            if let Some(x) = ifirst {
+                p.props.indent_first = Some(x);
+            }
+            if let Some(x) = sb {
+                p.props.space_before = Some(x);
+            }
+            if let Some(x) = sa {
+                p.props.space_after = Some(x);
+            }
+            if let Some(x) = ls {
+                p.props.line_spacing = Some(LineSpacing::Multiple(x));
+            }
+            done.push((b, p));
+        }
+        for (b, p) in done {
+            self.put_para(b, p)?;
+        }
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    /// Effective paragraph formatting over `first..=last`: each field is the shared value or null when mixed.
+    /// `lineSpacing` is the multiple, or null when mixed or set as an exact / at-least height.
+    fn do_para_state(&self, first: usize, last: usize) -> Result<String, String> {
+        use wordcraft_doc::props::{Align, LineSpacing};
+        if !Self::id_span_ok(first, last) {
+            return Err("paragraph range is out of bounds".into());
+        }
+        let mut rows = Vec::new();
+        for b in first..=last {
+            match self.para_at(b) {
+                Some(p) => rows.push(self.doc.styles.resolve_para(&p.props)),
+                None => return Err(format!("block {b} is not a paragraph")),
+            }
+        }
+        fn same_str(v: &[&str]) -> Option<String> {
+            let first = *v.first()?;
+            v.iter().all(|x| *x == first).then(|| first.to_string())
+        }
+        fn same<T: PartialEq + Copy>(rows: &[wordcraft_doc::resolve::ResolvedPara], f: impl Fn(&wordcraft_doc::resolve::ResolvedPara) -> T) -> Option<T> {
+            let first = f(rows.first()?);
+            rows.iter().all(|r| f(r) == first).then_some(first)
+        }
+        let align = same(&rows, |r| r.align).map(|a| match a {
+            Align::Center => "center",
+            Align::Right => "right",
+            Align::Justify | Align::Distribute => "justify",
+            Align::Left => "left",
+        });
+        let ls = same(&rows, |r| match r.line_spacing {
+            LineSpacing::Multiple(m) => Some(m.to_bits()),
+            _ => None,
+        })
+        .flatten()
+        .map(f32::from_bits);
+        Ok(serde_json::json!({
+            "align": align,
+            "indentLeft": same(&rows, |r| r.indent_left.to_bits()).map(f32::from_bits),
+            "indentFirst": same(&rows, |r| r.indent_first.to_bits()).map(f32::from_bits),
+            "spaceBefore": same(&rows, |r| r.space_before.to_bits()).map(f32::from_bits),
+            "spaceAfter": same(&rows, |r| r.space_after.to_bits()).map(f32::from_bits),
+            "lineSpacing": ls,
+            "style": same_str(&rows.iter().map(|r| r.style.as_str()).collect::<Vec<_>>()),
+            "list": same_str(&rows.iter().map(|r| self.list_kind(r.numbering)).collect::<Vec<_>>()),
+            "listLevel": same(&rows, |r| match r.numbering { Some(n) if n.num != 0 => Some(n.level), _ => None }).flatten(),
+        })
+        .to_string())
+    }
+    /// `"none"`, `"bullet"` or `"numbered"` for a resolved numbering reference.
+    fn list_kind(&self, n: Option<wordcraft_doc::props::NumRef>) -> &'static str {
+        match n {
+            Some(n) if n.num != 0 => match self.doc.numbering.level(n.num, n.level.min(8)) {
+                Some(l) if l.format == wordcraft_doc::section::NumFormat::Bullet => "bullet",
+                Some(_) => "numbered",
+                None => "none",
+            },
+            _ => "none",
+        }
+    }
+    /// Copies built-in styles that the document lacks (and their `basedOn` chain) into `styles`.
+    fn ensure_style(styles: &mut wordcraft_doc::StyleSheet, id: &str) -> Result<(), String> {
+        let mut next = Some(id.to_string());
+        let mut guard = 0;
+        while let Some(cur) = next.take() {
+            guard += 1;
+            if guard > 8 || styles.get(&cur).is_some() {
+                continue;
+            }
+            let st = wordcraft_doc::StyleSheet::builtin().get(&cur).cloned().ok_or_else(|| format!("unknown style {cur}"))?;
+            next = st.based_on.clone();
+            styles.upsert(st);
+        }
+        Ok(())
+    }
+    fn para_span(&self, first: usize, last: usize) -> Result<Vec<wordcraft_doc::Paragraph>, String> {
+        if !Self::id_span_ok(first, last) {
+            return Err("paragraph range is out of bounds".into());
+        }
+        (first..=last)
+            .map(|b| match self.para_at(b) {
+                Some(p) => Ok(p.clone()),
+                None => Err(format!("block {b} is not a paragraph")),
+            })
+            .collect()
+    }
+    /// Applies a paragraph style from a fixed list to `first..=last`; the document gains the built-in style if it lacks it.
+    fn do_set_style(&mut self, first: usize, last: usize, id: &str) -> Result<(), String> {
+        const OK: [&str; 8] = ["Normal", "Title", "Subtitle", "Heading1", "Heading2", "Heading3", "Heading4", "Quote"];
+        if !OK.contains(&id) {
+            return Err(format!("style {id} is not offered"));
+        }
+        let mut paras = self.para_span(first, last)?;
+        let mut styles = self.doc.styles.clone();
+        Self::ensure_style(&mut styles, id)?;
+        for p in paras.iter_mut() {
+            p.props.style = if id == "Normal" { None } else { Some(id.to_string()) };
+        }
+        self.doc.styles = styles;
+        for (i, p) in paras.into_iter().enumerate() {
+            self.put_para(first + i, p)?;
+        }
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    /// `kind`: `"bullet"`, `"numbered"` or `"none"`. A numbered list continues the list directly above when there is one.
+    fn do_set_list(&mut self, first: usize, last: usize, kind: &str) -> Result<(), String> {
+        use wordcraft_doc::numbering::ListKind;
+        use wordcraft_doc::props::NumRef;
+        let mut paras = self.para_span(first, last)?;
+        let mut numbering = self.doc.numbering.clone();
+        let mut styles = self.doc.styles.clone();
+        let num = match kind {
+            "none" => 0,
+            "bullet" => {
+                let found = numbering.find_kind(ListKind::Bullet);
+                found.unwrap_or_else(|| numbering.add_list(ListKind::Bullet))
+            }
+            "numbered" => {
+                let above = if first > 0 && first < CELL_BASE {
+                    self.para_at(first - 1).and_then(|p| self.doc.styles.resolve_para(&p.props).numbering)
+                } else {
+                    None
+                };
+                match above {
+                    Some(n) if n.num != 0 && self.list_kind(Some(n)) == "numbered" => n.num,
+                    _ => numbering.add_list(ListKind::Numbered),
+                }
+            }
+            _ => return Err("list kind must be bullet, numbered or none".into()),
+        };
+        if num != 0 {
+            Self::ensure_style(&mut styles, "ListParagraph")?;
+        }
+        for p in paras.iter_mut() {
+            let cur = self.doc.styles.resolve_para(&p.props).numbering;
+            if num == 0 {
+                if cur.is_some_and(|n| n.num != 0) {
+                    p.props.numbering = Some(NumRef { num: 0, level: 0 });
+                }
+                if p.props.style.as_deref() == Some("ListParagraph") {
+                    p.props.style = None;
+                }
+            } else {
+                let level = cur.filter(|n| n.num != 0).map(|n| n.level).unwrap_or(0);
+                p.props.numbering = Some(NumRef { num, level });
+                if p.props.style.is_none() {
+                    p.props.style = Some("ListParagraph".into());
+                }
+            }
+        }
+        self.doc.numbering = numbering;
+        self.doc.styles = styles;
+        for (i, p) in paras.into_iter().enumerate() {
+            self.put_para(first + i, p)?;
+        }
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    /// Moves list paragraphs in `first..=last` by `delta` levels (clamped 0..=8). Refuses when none is in a list.
+    fn do_list_level(&mut self, first: usize, last: usize, delta: i32) -> Result<(), String> {
+        use wordcraft_doc::props::NumRef;
+        if !(-8..=8).contains(&delta) {
+            return Err("level change must be between -8 and 8".into());
+        }
+        let mut paras = self.para_span(first, last)?;
+        let mut any = false;
+        for p in paras.iter_mut() {
+            if let Some(n) = self.doc.styles.resolve_para(&p.props).numbering.filter(|n| n.num != 0) {
+                any = true;
+                let lv = (n.level as i32 + delta).clamp(0, 8) as u8;
+                p.props.numbering = Some(NumRef { num: n.num, level: lv });
+            }
+        }
+        if !any {
+            return Err("the selection is not in a list".into());
+        }
+        for (i, p) in paras.into_iter().enumerate() {
+            self.put_para(first + i, p)?;
+        }
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    /// Table structure edit relative to the cell holding paragraph `block` (a cell id). `op` is `row_above`, `row_below`,
+    /// `delete_row`, `col_left`, `col_right`, `delete_col`, `merge_right` or `split_cell`. The table is cloned, edited and swapped in, so a refusal
+    /// leaves the document untouched. Block ids of cell paragraphs shift afterwards; the host re-reads `blocks()`.
+    fn do_table_edit(&mut self, block: usize, op: &str) -> Result<(), String> {
+        use wordcraft_doc::props::VMerge;
+        if block < CELL_BASE {
+            return Err("the caret is not inside a table cell".into());
+        }
+        let [b, r, c, _] = self.cell_paras().nth(block - CELL_BASE).ok_or_else(|| format!("no cell paragraph {block}"))?;
+        let Some(Block::Table(t)) = self.doc.body.get(b).map(|x| &**x) else { return Err("the caret is not inside a table".into()) };
+        let mut t2 = t.clone();
+        let row = t2.rows.get(r).ok_or("no such row")?;
+        let grid_start: usize = row.cells.iter().take(c).map(|x| x.span()).sum();
+        let span = row.cells.get(c).ok_or("no such cell")?.span();
+        match op {
+            "row_above" | "row_below" => {
+                let n = t2.rows.len();
+                t2.insert_row(if op == "row_above" { r } else { r + 1 }, r);
+                if t2.rows.len() == n {
+                    return Err("the table has reached its row limit".into());
+                }
+            }
+            "delete_row" => {
+                if t2.rows.len() <= 1 {
+                    return Err("a table needs at least one row".into());
+                }
+                if t2.rows[r].cells.iter().any(|x| x.props.vmerge != VMerge::None) || t2.rows.iter().any(|row| row.cells.iter().any(|x| x.props.vmerge != VMerge::None)) {
+                    return Err("rows of a table with vertically merged cells cannot be deleted yet".into());
+                }
+                t2.delete_row(r);
+            }
+            "col_left" | "col_right" => {
+                let n = t2.grid.len();
+                t2.insert_col(if op == "col_left" { grid_start } else { grid_start + span });
+                if t2.grid.len() == n {
+                    return Err("the table has reached its column limit".into());
+                }
+            }
+            "delete_col" => {
+                if t2.grid.len() <= 1 {
+                    return Err("a table needs at least one column".into());
+                }
+                if t2.rows.iter().any(|row| row.cells.iter().any(|x| x.span() > 1 || x.props.vmerge != VMerge::None)) {
+                    return Err("columns of a table with merged cells cannot be deleted yet".into());
+                }
+                t2.delete_col(grid_start);
+            }
+            "merge_right" => {
+                let cells = &t2.rows[r].cells;
+                if c + 1 >= cells.len() {
+                    return Err("there is no cell to the right to merge with".into());
+                }
+                if cells[c].props.vmerge != VMerge::None || cells[c + 1].props.vmerge != VMerge::None {
+                    return Err("cells that are merged vertically cannot be merged yet".into());
+                }
+                t2.merge_right(r, c, c + 1);
+            }
+            "split_cell" => {
+                if t2.rows[r].cells[c].props.vmerge != VMerge::None {
+                    return Err("cells that are merged vertically cannot be split yet".into());
+                }
+                if span < 2 {
+                    return Err("only a merged cell can be split".into());
+                }
+                t2.split_cell(r, c, 2);
+            }
+            _ => return Err(format!("unknown table operation {op}")),
+        }
+        self.doc.body[b] = Arc::new(Block::Table(t2));
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    /// Inserts an empty `rows` x `cols` table (1-20 by 1-10) after the top-level block holding `block` (a paragraph, a table,
+    /// or a cell paragraph, which addresses its table), followed by an empty paragraph so the text can continue after it.
+    fn do_insert_table(&mut self, block: usize, rows: usize, cols: usize) -> Result<(), String> {
+        if !(1..=20).contains(&rows) || !(1..=10).contains(&cols) {
+            return Err("a new table has 1-20 rows and 1-10 columns".into());
+        }
+        if self.doc.body.len() >= 100_000 {
+            return Err("the document has too many blocks".into());
+        }
+        let top = if block >= CELL_BASE { self.cell_paras().nth(block - CELL_BASE).ok_or_else(|| format!("no cell paragraph {block}"))?[0] } else { block };
+        if top >= self.doc.body.len() {
+            return Err(format!("no block {block}"));
+        }
+        let mut styles = self.doc.styles.clone();
+        Self::ensure_style(&mut styles, "TableGrid")?;
+        let table = wordcraft_doc::Table::new(rows, cols, self.doc.last_section.text_width());
+        self.doc.styles = styles;
+        self.doc.body.insert(top + 1, Arc::new(Block::Table(table)));
+        self.doc.body.insert(top + 2, wordcraft_doc::para_block(wordcraft_doc::Paragraph::new()));
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    fn do_replace(&mut self, block: usize, start: usize, end: usize, text: &str) -> Result<(), String> {
+        self.do_replace_many(block, &[(start, end, text.to_string())])
+    }
+}
