+//! Experimental headless adapter. No DOM, egui, filesystem or UI thread access.
+use wasm_bindgen::prelude::*;
+use std::sync::Arc;
+use wordcraft_doc::para::OBJ;
+use wordcraft_doc::{Block, CharProps, Document, Pos, StoryRef};
+use wordcraft_layout::{DocLayout, LayoutCache, LayoutOptions};
+
+#[wasm_bindgen]
+pub struct DocSession {
+    doc: Document,
+    cache: LayoutCache,
+    pages: DocLayout,
+    snaps: std::collections::HashMap<u32, wordcraft_doc::Blocks>,
+    next_snap: u32,
+}
+
+impl DocSession {
+    fn from_bytes(bytes: &[u8]) -> Result<Self, String> {
+        if bytes.len() > 16 * 1024 * 1024 {
+            return Err("adapter input limit: 16 MiB".into());
+        }
+        let doc = wordcraft_docx::read(bytes).map_err(|e| e.to_string())?;
+        Ok(Self { doc, cache: LayoutCache::new(), pages: DocLayout::default(), snaps: Default::default(), next_snap: 1 })
+    }
+    fn do_insert(&mut self, block: usize, offset: usize, text: &str) -> Result<(), String> {
+        if text.len() > 1024 * 1024 {
+            return Err("adapter edit limit: 1 MiB".into());
+        }
+        self.doc.insert_text(&Pos::body(block, offset), text, &CharProps::default()).map_err(|e| e.to_string())?;
+        // Invalidate placed pages; paragraph cache is revision-aware upstream.
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    /// Top-level body blocks. A paragraph is `editable` only when it has no inline objects
+    /// (images, fields, equations, comment anchors), because their offsets are not text.
+    fn block_list(&self) -> String {
+        let items: Vec<_> = self
+            .doc
+            .body
+            .iter()
+            .enumerate()
+            .map(|(i, b)| match &**b {
+                Block::Para(p) => {
+                    let editable = !p.text.contains(OBJ) && p.objects.is_empty();
+                    serde_json::json!({"index": i, "kind": "para", "text": if editable { p.text.clone() } else { p.plain_text() }, "editable": editable})
+                }
+                Block::Table(_) => serde_json::json!({"index": i, "kind": "table", "editable": false}),
+            })
+            .collect();
+        serde_json::Value::Array(items).to_string()
+    }
+    /// Applies several non-overlapping replacements (UTF-8 byte ranges in the ORIGINAL paragraph text,
+    /// sorted ascending) to one top-level paragraph. Everything is done on a clone and committed only
+    /// if every hunk is valid, so a failure leaves the document unchanged. Text outside the hunks keeps
+    /// its runs untouched. Inserted text takes the formatting of the first replaced character; a pure
+    /// insertion takes the character before it (Word behaviour), or the character after at paragraph start.
+    fn do_replace_many(&mut self, block: usize, hunks: &[(usize, usize, String)]) -> Result<(), String> {
+        if hunks.is_empty() {
+            return Ok(());
+        }
+        if hunks.len() > 10_000 {
+            return Err("too many hunks".into());
+        }
+        let mut total = 0usize;
+        for (_, _, t) in hunks {
+            total += t.len();
+            if t.chars().any(|c| c == OBJ || c == '\n' || c == '\r') {
+                return Err("replacement text must not contain line breaks or object marks".into());
+            }
+        }
+        if total > 1024 * 1024 {
+            return Err("adapter edit limit: 1 MiB".into());
+        }
+        let Some(b) = self.doc.body.get(block) else { return Err(format!("no block {block}")) };
+        let Block::Para(orig) = &**b else { return Err(format!("block {block} is a table, not a paragraph")) };
+        if orig.text.contains(OBJ) || !orig.objects.is_empty() {
+            return Err(format!("paragraph {block} contains inline objects and cannot be edited as text"));
+        }
+        let mut prev_end = 0usize;
+        for (start, end, _) in hunks {
+            if start > end || *start < prev_end {
+                return Err("hunks must be ascending, non-overlapping, with start <= end".into());
+            }
+            for off in [*start, *end] {
+                if off > orig.text.len() || !orig.text.is_char_boundary(off) {
+                    return Err(format!("offset {off} is not a character boundary inside paragraph {block}"));
+                }
+            }
+            prev_end = *end;
+        }
+        let mut p = orig.clone();
+        for (start, end, text) in hunks.iter().rev() {
+            let (start, end) = (*start, *end);
+            let props = if start < end {
+                p.props_of_char(start).clone()
+            } else if start > 0 {
+                let prev = p.text[..start].char_indices().next_back().map(|(i, _)| i).unwrap_or(0);
+                p.props_of_char(prev).clone()
+            } else if !p.text.is_empty() {
+                p.props_of_char(0).clone()
+            } else {
+                p.mark.clone()
+            };
+            p.delete(start, end).map_err(|e| e.to_string())?;
+            if !text.is_empty() {
+                p.insert_text(start, text, &props).map_err(|e| e.to_string())?;
+            }
+        }
+        self.doc.body[block] = Arc::new(Block::Para(p));
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    fn plain_para(&self, block: usize) -> Result<&wordcraft_doc::Paragraph, String> {
+        match self.doc.body.get(block).map(|b| &**b) {
+            None => Err(format!("no block {block}")),
+            Some(Block::Table(_)) => Err(format!("block {block} is a table, not a paragraph")),
+            Some(Block::Para(p)) if p.text.contains(OBJ) || !p.objects.is_empty() => Err(format!("paragraph {block} contains inline objects and cannot be edited as text")),
+            Some(Block::Para(p)) if p.section.is_some() => Err(format!("paragraph {block} carries a section break and cannot be split or merged")),
+            Some(Block::Para(p)) => Ok(p),
+        }
+    }
+    /// Splits a top-level paragraph at a UTF-8 offset. The new paragraph copies the paragraph properties.
+    fn do_split(&mut self, block: usize, off: usize) -> Result<(), String> {
+        let mut p = self.plain_para(block)?.clone();
+        if off > p.text.len() || !p.text.is_char_boundary(off) {
+            return Err(format!("offset {off} is not a character boundary inside paragraph {block}"));
+        }
+        let tail = p.split_off(off).map_err(|e| e.to_string())?;
+        self.doc.body[block] = Arc::new(Block::Para(p));
+        self.doc.body.insert(block + 1, Arc::new(Block::Para(tail)));
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    /// Joins paragraph `block` onto the end of `block - 1`; the first paragraph keeps its properties.
+    fn do_merge(&mut self, block: usize) -> Result<(), String> {
+        if block == 0 {
+            return Err("there is no previous paragraph".into());
+        }
+        let tail = self.plain_para(block)?.clone();
+        let mut head = self.plain_para(block - 1)?.clone();
+        head.append(tail);
+        self.doc.body[block - 1] = Arc::new(Block::Para(head));
+        self.doc.body.remove(block);
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    fn do_replace(&mut self, block: usize, start: usize, end: usize, text: &str) -> Result<(), String> {
+        self.do_replace_many(block, &[(start, end, text.to_string())])
+    }
+}
+
+#[wasm_bindgen]
+impl DocSession {
+    pub fn blocks(&self) -> String {
+        self.block_list()
+    }
+    /// `hunks_json`: `[[start, end, "text"], ...]`, ascending offsets in the original paragraph.
+    pub fn replace_ranges(&mut self, block: usize, hunks_json: &str) -> Result<(), JsValue> {
+        let v: Vec<(usize, usize, String)> = serde_json::from_str(hunks_json).map_err(|e| JsValue::from_str(&format!("bad hunks: {e}")))?;
+        self.do_replace_many(block, &v).map_err(|e| JsValue::from_str(&e))
+    }
+    pub fn replace_range(&mut self, block: usize, utf8_start: usize, utf8_end: usize, text: &str) -> Result<(), JsValue> {
+        self.do_replace(block, utf8_start, utf8_end, text).map_err(|e| JsValue::from_str(&e))
+    }
+    /// Page-space hit test (page units, same space as `page_info`). JSON: `null` when nothing is hit,
+    /// `{"block":i,"off":utf8,"editable":bool}` for a top-level paragraph, `{"block":null,"editable":false}`
+    /// for text inside a table cell or another story. Never guesses: offsets come from the layout.
+    pub fn hit_test(&self, page: usize, x: f32, y: f32) -> String {
+        match self.pages.hit(page, x, y, StoryRef::Body) {
+            None => "null".into(),
+            Some(pos) if pos.path.depth() == 0 && pos.path.0.len() == 1 => {
+                let b = pos.path.last();
+                let editable = matches!(self.doc.body.get(b).map(|b| &**b), Some(Block::Para(p)) if !p.text.contains(OBJ) && p.objects.is_empty());
+                serde_json::json!({"block": b, "off": pos.off, "editable": editable}).to_string()
+            }
+            Some(_) => serde_json::json!({"block": null, "editable": false}).to_string(),
+        }
+    }
+    /// Caret rectangle for a top-level paragraph offset: `{"page","x","top","height"}` or `null`.
+    pub fn caret_at(&self, block: usize, utf8_off: usize) -> String {
+        match self.pages.caret(&Pos::body(block, utf8_off)) {
+            Some(c) => serde_json::json!({"page": c.page, "x": c.x, "top": c.top, "height": c.height}).to_string(),
+            None => "null".into(),
+        }
+    }
+    /// Highlight rectangles inside one top-level paragraph: `[[page,x,y,w,h],...]`.
+    pub fn selection_rects(&self, block: usize, a: usize, b: usize) -> String {
+        let r: Vec<_> = self
+            .pages
+            .selection_rects(&self.doc, &Pos::body(block, a), &Pos::body(block, b), 0)
+            .into_iter()
+            .map(|(pg, r)| serde_json::json!([pg, r.x, r.y, r.w, r.h]))
+            .collect();
+        serde_json::Value::Array(r).to_string()
+    }
+    pub fn split_block(&mut self, block: usize, utf8_off: usize) -> Result<(), JsValue> {
+        self.do_split(block, utf8_off).map_err(|e| JsValue::from_str(&e))
+    }
+    pub fn merge_with_previous(&mut self, block: usize) -> Result<(), JsValue> {
+        self.do_merge(block).map_err(|e| JsValue::from_str(&e))
+    }
+    /// Cheap structural snapshot of the body (blocks are shared, not copied). Used for undo of split/merge.
+    pub fn snapshot(&mut self) -> u32 {
+        let id = self.next_snap;
+        self.next_snap += 1;
+        self.snaps.insert(id, self.doc.body.clone());
+        id
+    }
+    pub fn restore(&mut self, id: u32) -> Result<(), JsValue> {
+        let b = self.snaps.get(&id).ok_or_else(|| JsValue::from_str("unknown snapshot"))?.clone();
+        self.doc.body = b;
+        self.pages = DocLayout::default();
+        Ok(())
+    }
+    #[wasm_bindgen(constructor)]
+    pub fn new(bytes: &[u8]) -> Result<DocSession, JsValue> {
+        Self::from_bytes(bytes).map_err(|e| JsValue::from_str(&e))
+    }
+    pub fn text(&self) -> String {
+        self.doc.plain_text(StoryRef::Body)
+    }
+    pub fn insert(&mut self, block: usize, utf8_byte_offset: usize, text: &str) -> Result<(), JsValue> {
+        self.do_insert(block, utf8_byte_offset, text).map_err(|e| JsValue::from_str(&e))
+    }
+    pub fn paginate(&mut self) -> usize {
+        self.pages = wordcraft_layout::layout(&self.doc, &mut self.cache, &LayoutOptions::default());
+        self.pages.pages.len()
+    }
+    pub fn page_info(&self) -> String {
+        serde_json::json!({"pages": self.pages.pages.iter().map(|p| serde_json::json!({"width":p.w,"height":p.h})).collect::<Vec<_>>(),
+            "cacheHits":self.cache.hits,"cacheMisses":self.cache.misses})
+        .to_string()
+    }
+    pub fn render_png(&self, page: usize, scale: f32) -> Result<Vec<u8>, JsValue> {
+        if !scale.is_finite() || !(0.1..=2.0).contains(&scale) {
+            return Err(JsValue::from_str("scale must be 0.1..2.0"));
+        }
+        let p = self.pages.pages.get(page).ok_or_else(|| JsValue::from_str("paginate first; invalid page"))?;
+        if p.w * scale > 2400.0 || p.h * scale > 2400.0 {
+            return Err(JsValue::from_str("adapter raster limit: 2400 px per side"));
+        }
+        Ok(wordcraft_render::render_page(&self.doc, p, scale, &Default::default()).to_png())
+    }
+    pub fn save(&self) -> Result<Vec<u8>, JsValue> {
+        wordcraft_docx::write(&self.doc).map_err(|e| JsValue::from_str(&e.to_string()))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const FIXTURE: &[u8] = include_bytes!("../../../spikes/somnia-documents/fixtures/sample.docx");
+    #[test]
+    fn open_edit_export_reopen() {
+        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
+        assert!(s.text().contains("Somnia Documents"));
+        s.do_insert(0, 0, "Edited: ").unwrap();
+        let saved = wordcraft_docx::write(&s.doc).unwrap();
+        let reopened = DocSession::from_bytes(&saved).unwrap();
+        assert_eq!(s.text(), reopened.text());
+        assert!(reopened.text().starts_with("Edited: "));
+    }
+    #[test]
+    fn malformed_package_rejected() {
+        assert!(DocSession::from_bytes(b"not a zip").is_err());
+    }
+    #[test]
+    fn bad_offset_and_path_rejected_without_mutation() {
+        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
+        let old = s.text();
+        assert!(s.do_insert(999, 0, "x").is_err());
+        assert!(s.do_insert(0, 999999, "x").is_err());
+        assert_eq!(old, s.text());
+    }
+    #[test]
+    fn blocks_list_paragraphs_and_tables() {
+        let s = DocSession::from_bytes(FIXTURE).unwrap();
+        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
+        let a = v.as_array().unwrap();
+        assert!(a.iter().any(|b| b["kind"] == "table" && b["editable"] == false));
+        assert!(a[0]["kind"] == "para" && a[0]["text"].as_str().unwrap().contains("Somnia Documents"));
+        for (i, b) in a.iter().enumerate() {
+            assert_eq!(b["index"], i);
+        }
+    }
+    #[test]
+    fn replace_range_roundtrips_and_is_atomic() {
+        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
+        let before = s.text();
+        s.do_replace(0, 0, "Somnia".len(), "Hello").unwrap();
+        assert!(s.text().starts_with("Hello Documents"));
+        let saved = wordcraft_docx::write(&s.doc).unwrap();
+        assert_eq!(DocSession::from_bytes(&saved).unwrap().text(), s.text());
+        let now = s.text();
+        assert!(s.do_replace(0, 3, 2, "x").is_err());
+        assert!(s.do_replace(0, 0, 99999, "x").is_err());
+        assert!(s.do_replace(999, 0, 0, "x").is_err());
+        assert!(s.do_replace(0, 0, 0, "a\nb").is_err());
+        assert_eq!(now, s.text());
+        assert_ne!(before, now);
+    }
+    fn run_props(s: &DocSession, block: usize) -> Vec<(usize, bool)> {
+        let Block::Para(p) = &*s.doc.body[block] else { panic!() };
+        p.runs.iter().map(|r| (r.len, r.props.bold.unwrap_or(false))).collect()
+    }
+    #[test]
+    fn multi_hunk_edit_is_atomic_and_keeps_untouched_runs() {
+        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
+        let t0 = match &*s.doc.body[0] { Block::Para(p) => p.text.clone(), _ => panic!() };
+        let runs_before = run_props(&s, 0);
+        // Two far-apart hunks; the text between them must keep its run structure.
+        let last = t0.len();
+        s.do_replace_many(0, &[(0, 0, "A".into()), (last, last, "Z".into())]).unwrap();
+        let t1 = match &*s.doc.body[0] { Block::Para(p) => p.text.clone(), _ => panic!() };
+        assert_eq!(t1, format!("A{t0}Z"));
+        let runs_after = run_props(&s, 0);
+        assert_eq!(runs_after.iter().map(|r| r.0).sum::<usize>(), t1.len());
+        // Bold of the original text survives (insertions inherit neighbours).
+        assert_eq!(runs_before.iter().any(|r| r.1), runs_after.iter().any(|r| r.1));
+        let snapshot = s.text();
+        // Second hunk invalid: nothing may change.
+        assert!(s.do_replace_many(0, &[(0, 1, "".into()), (5000, 5001, "x".into())]).is_err());
+        assert!(s.do_replace_many(0, &[(3, 4, "".into()), (2, 3, "".into())]).is_err());
+        assert_eq!(snapshot, s.text());
+    }
+    #[test]
+    fn insertion_at_paragraph_start_inherits_following_run() {
+        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
+        let first = run_props(&s, 0)[0];
+        s.do_replace(0, 0, 0, "X").unwrap();
+        let after = run_props(&s, 0)[0];
+        assert_eq!(after.1, first.1, "inserted text must share the formatting of what follows it");
+        assert_eq!(after.0, first.0 + 1);
+        let saved = wordcraft_docx::write(&s.doc).unwrap();
+        let again = DocSession::from_bytes(&saved).unwrap();
+        assert_eq!(run_props(&again, 0)[0], after, "formatting must survive DOCX export and reopen");
+    }
+    #[test]
+    fn replace_range_refuses_tables_and_non_boundaries() {
+        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
+        let v: serde_json::Value = serde_json::from_str(&s.block_list()).unwrap();
+        let t = v.as_array().unwrap().iter().find(|b| b["kind"] == "table").unwrap()["index"].as_u64().unwrap() as usize;
+        assert!(s.do_replace(t, 0, 0, "x").is_err());
+        s.do_replace(0, 0, 0, "é").unwrap();
+        let old = s.text();
+        assert!(s.do_replace(0, 1, 1, "x").is_err());
+        assert_eq!(old, s.text());
+        s.do_replace(0, 0, 2, "").unwrap();
+        assert!(!s.text().starts_with("é"));
+    }
+    #[test]
+    fn unicode_offsets_are_bytes_not_utf16() {
+        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
+        s.do_insert(0, 0, "é").unwrap();
+        assert!(s.do_insert(0, 1, "x").is_err());
+        s.do_insert(0, 2, "x").unwrap();
+        assert!(s.text().starts_with("éx"));
+    }
+    #[test]
+    fn hit_and_caret_roundtrip() {
+        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
+        s.paginate();
+        let c: serde_json::Value = serde_json::from_str(&s.caret_at(0, 3)).unwrap();
+        let (x, y) = (c["x"].as_f64().unwrap() as f32, (c["top"].as_f64().unwrap() + c["height"].as_f64().unwrap() / 2.0) as f32);
+        let h: serde_json::Value = serde_json::from_str(&s.hit_test(c["page"].as_u64().unwrap() as usize, x, y)).unwrap();
+        assert_eq!((h["block"].as_u64(), h["off"].as_u64()), (Some(0), Some(3)));
+        let r: serde_json::Value = serde_json::from_str(&s.selection_rects(0, 0, 4)).unwrap();
+        assert!(!r.as_array().unwrap().is_empty());
+    }
+    #[test]
+    fn split_merge_snapshot_roundtrip() {
+        let mut s = DocSession::from_bytes(FIXTURE).unwrap();
+        let before = s.text();
+        let snap0 = s.snapshot();
+        let n = s.doc.body.len();
+        s.do_split(1, 5).unwrap();
+        assert_eq!(s.doc.body.len(), n + 1);
+        assert_eq!(s.text().replace('\n', ""), before.replace('\n', ""));
+        s.do_merge(2).unwrap();
+        assert_eq!(s.text(), before);
+        s.do_split(1, 5).unwrap();
+        s.restore(snap0).unwrap();
+        assert_eq!(s.text(), before);
+        assert!(s.do_merge(0).is_err());
+        assert!(s.do_merge(4).is_err(), "block 3 is a table");
+        assert!(s.do_split(3, 0).is_err());
+        assert!(s.do_split(1, 99999).is_err());
+        let saved = wordcraft_docx::write(&s.doc).unwrap();
+        assert_eq!(DocSession::from_bytes(&saved).unwrap().text(), before);
+    }
+}
