+<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Somnia Documents · Worker proof</title>
+<style>body{font:15px system-ui;margin:0;background:#f8f9fb;color:#192238}header{padding:24px 32px}h1{font-size:24px;margin:0 0 8px}button,input{margin:5px}main{display:flex;gap:24px;padding:0 32px 32px}section{background:white;border-radius:20px;padding:20px;min-width:300px}pre{white-space:pre-wrap;max-width:510px;font-size:12px}img{width:595px;max-width:100%;box-shadow:0 2px 15px #ccd}#status{color:#6051cc}</style>
+<header><h1>Somnia Documents</h1><div>Headless Rust / WASM engine in a dedicated browser Worker. Integration spike, not the finished editor.</div><div id="status">Loading…</div></header>
+<main><section><button id="sample">Open fixture</button><input id="file" type="file" accept=".docx"><br><button id="edit">Insert "Edited: "</button><button id="save">Export DOCX</button><pre id="metrics"></pre><pre id="text"></pre></section><section><img id="page" alt="WordCraft raster of DOCX page one"></section></main>
+<script type="module">
+const worker=new Worker('./worker.js',{type:'module'}); let seq=0;const pending=new Map();
+worker.onmessage=({data})=>{const p=pending.get(data.id);pending.delete(data.id);data.ok?p.resolve(data.value):p.reject(new Error(data.error));};
+worker.onerror=e=>document.querySelector('#status').textContent='Worker error: '+e.message;
+const rpc=(op,args={})=>new Promise((resolve,reject)=>{const id=++seq;pending.set(id,{resolve,reject});worker.postMessage({id,op,...args},args.bytes?[args.bytes]:[]);});
+window.rpc=rpc;window.done=false;let imageUrl;
+async function show(v){document.querySelector('#metrics').textContent=JSON.stringify({...v,text:undefined},null,2);document.querySelector('#text').textContent=v.text;const img=await rpc('render'); if(imageUrl)URL.revokeObjectURL(imageUrl);imageUrl=URL.createObjectURL(new Blob([img.bytes],{type:'image/png'}));document.querySelector('#page').src=imageUrl; document.querySelector('#status').textContent=`${v.pages} page(s) · rendered off the UI thread`;return img;}
+async function open(bytes){const v=await rpc('open',{bytes});await show(v);window.done=true;window.latest=v;return v;}
+document.querySelector('#sample').onclick=async()=>open(await(await fetch('./fixtures/sample.docx')).arrayBuffer());
+document.querySelector('#file').onchange=async e=>open(await e.target.files[0].arrayBuffer());
+document.querySelector('#edit').onclick=async()=>show(await rpc('insert',{block:0,offset:0,text:'Edited: '}));
+document.querySelector('#save').onclick=async()=>{const s=await rpc('save');const u=URL.createObjectURL(new Blob([s.bytes]));const a=document.createElement('a');a.href=u;a.download='somnia-edited.docx';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);};
+open(await(await fetch('./fixtures/sample.docx')).arrayBuffer()).catch(e=>{document.querySelector('#status').textContent=e.message;window.error=String(e);});
+</script></html>
diff --git a/spikes/somnia-documents/web/worker.js b/spikes/somnia-documents/web/worker.js
new file mode 100644
index 0000000..6c79e6a
--- /dev/null
+++ b/spikes/somnia-documents/web/worker.js
@@ -0,0 +1,28 @@
+import init, { DocSession } from './pkg/wordcraft_somnia_worker.js';
+let session;
+const loaded = (async () => { const t = performance.now(); await init(); return performance.now()-t; })();
+self.onmessage = async ({data}) => {
+ const {id, op} = data;
+ try {
+  const initMs = await loaded;
+  const timed = fn => {const t=performance.now(); const result=fn(); return {result,ms:performance.now()-t};};
+  let value, transfer=[];
+  if(op==='open') {
+   if(session) {session.free();session=null;}
+   const opened=timed(()=>new DocSession(new Uint8Array(data.bytes))); session=opened.result;
+   const pages=timed(()=>session.paginate());
+   value={initMs,openMs:opened.ms,layoutMs:pages.ms,pages:pages.result,text:session.text(),info:JSON.parse(session.page_info())};
+  } else if(op==='insert') {
+   const edit=timed(()=>session.insert(data.block,data.offset,data.text));
+   const pages=timed(()=>session.paginate());
+   value={editMs:edit.ms,layoutMs:pages.ms,pages:pages.result,text:session.text(),info:JSON.parse(session.page_info())};
+  } else if(op==='render') {
+   const img=timed(()=>session.render_png(data.page??0,data.scale??1));
+   value={renderMs:img.ms,bytes:img.result.buffer}; transfer=[value.bytes];
+  } else if(op==='save') {
+   const saved=timed(()=>session.save()); value={saveMs:saved.ms,bytes:saved.result.buffer}; transfer=[value.bytes];
+  } else if(op==='close') {session?.free();session=null;value={closed:true};}
+  else throw new Error('Unknown operation');
+  self.postMessage({id,ok:true,value},transfer);
+ } catch(e) {self.postMessage({id,ok:false,error:String(e)});}
+};
